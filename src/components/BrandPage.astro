---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  slug: string
  h1: string
  intro: string
  brand: string
  garments: { name: string; best: string; watch: string; img: string }[]
  choose: { if: string; then: string }[]
  faqs: { q: string; a: string }[]
  links: { href: string; label: string }[]
}

const { title, description, slug, brand, h1, intro, garments, choose, faqs, links } = Astro.props
const url = `https://bighornthreads.com/brands/${slug}/`
const pic = (id: string) => `https://www.promoplace.com/ws/ws.dll/QPic?SN=${id.split('-')[0]}&P=${id.split('-')[1]}&RS=300`

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
    { '@type': 'ListItem', position: 2, name: 'Catalog', item: 'https://bighornthreads.com/catalog/' },
    { '@type': 'ListItem', position: 3, name: brand, item: url },
  ],
}
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout title={title} description={description} canonical={url}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="border-b border-hairline bg-concrete">
    <div class="mx-auto max-w-7xl px-4 pb-10 pt-10 sm:px-6 sm:pt-14 lg:px-8">
      <nav class="mb-5 font-mono text-xs text-ash" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold-700">Home</a><span class="px-2">/</span>
        <a href="/catalog/" class="hover:text-gold-700">Catalog</a><span class="px-2">/</span>
        <span class="text-gold-700">{brand}</span>
      </nav>
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="mb-4 max-w-3xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl">{h1}</h1>
          <p class="max-w-2xl text-lg leading-relaxed text-ash">{intro}</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-3">
          <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
          <a href="tel:+17029048923" class="px-2 py-3 font-mono text-sm font-medium text-charcoal hover:text-gold-700">702.904.8923</a>
        </div>
      </div>
      <h2 class="sr-only">{brand} garments compared</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {garments.map((g) => (
          <li class="flex gap-4 border border-hairline bg-panel p-4 lg:flex-col">
            <img src={pic(g.img)} alt={g.name} width="300" height="300" loading="lazy" decoding="async" class="h-28 w-28 shrink-0 object-contain lg:h-56 lg:w-full" />
            <div class="min-w-0">
              <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{g.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ash"><strong class="text-charcoal">For:</strong> {g.best}</p>
              <p class="mt-1 text-sm leading-relaxed text-ash"><strong class="text-charcoal">Order note:</strong> {g.watch}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-ash">Photos are from the supplier catalog. Colors and sizes change, so your quote confirms the exact style.</p>
    </div>
  </section>

  <section class="bg-paper py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-6 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Choosing your garments</h2>
      <ul class="space-y-4 text-lg leading-relaxed text-ash">
        {choose.map((c) => <li><strong class="text-charcoal">{c.if}</strong> {c.then}</li>)}
      </ul>
    </div>
  </section>

  <section class="bg-concrete py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-6 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">{brand} questions</h2>
      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-4 text-left">
              <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
              <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            </summary>
            <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-8 text-sm text-ash">See also: {links.map((l, i) => (<>{i > 0 && ', '}<a class="text-gold-700 underline" href={l.href}>{l.label}</a></>))}.</p>
    </div>
  </section>

  <section class="bg-charcoal">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-5 px-4 py-12 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-white">Get pricing for your order.</h2>
      <a href="/get-a-quote/" class="btn-primary shrink-0 text-base">Get a Quote</a>
    </div>
  </section>
</BaseLayout>
