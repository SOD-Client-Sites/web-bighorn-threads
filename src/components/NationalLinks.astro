---
// Points local and guide pages at the national product pages.
interface Props {
  heading?: string
  links: { href: string; label: string }[]
}
const { heading = 'Ordering from outside Nevada?', links } = Astro.props
---

<aside class="border-y border-hairline bg-panel py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{heading}</p>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {links.map((l) => <li><a href={l.href} class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">{l.label}</a></li>)}
    </ul>
  </div>
</aside>
