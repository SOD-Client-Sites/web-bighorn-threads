---
// Shared template for national product pages. Each page supplies its own copy and table.
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroProducts from '@/components/HeroProducts.astro'
import photos from '../../public/images/photos/manifest.json'

interface Props {
  title: string
  description: string
  path: string
  crumb: string
  photo?: string
  photoAt?: 'hero' | 'break'
  kicker: string
  h1: string
  h1Accent: string
  sub: string
  lead: string
  serviceName: string
  serviceType: string
  table: { heading: string; intro: string; head: [string, string, string]; rows: [string, string, string][] }
  decide: { heading: string; items: { title: string; desc: string }[] }
  body: { heading: string; paragraphs: string[] }
  quote: { text: string; who: string; what: string }
  faqs: { q: string; a: string }[]
  related: { href: string; title: string; desc: string }[]
}

const { title, description, path, crumb, photo, photoAt = 'break', kicker, h1, h1Accent, sub, lead, serviceName, serviceType, table, decide, body, quote, faqs, related } = Astro.props
const picked = photo ? photos.find((p) => p.slug === photo) : undefined
if (photo && !picked) throw new Error(`Unknown photo slug: ${photo}`)
const heroPhoto = picked && photoAt === 'hero'
const url = `https://bighornthreads.com${path}`

const steps = [
  { n: '01', title: 'Send the basics', desc: 'Your logo, the items you want, rough quantities, your date, and where the order ships.' },
  { n: '02', title: 'Get the quote', desc: 'You get the garments, decoration, price, minimum, and timing in writing.' },
  { n: '03', title: 'Approve the proof', desc: 'Check the colors, size, and logo placement. Nothing gets made until you approve.' },
  { n: '04', title: 'It ships to you', desc: 'The order goes to one address or several. We keep your logo file and garment details so a reorder matches.' },
]

const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
  { '@type': 'ListItem', position: 2, name: crumb, item: url },
] }
const serviceSchema = { '@context': 'https://schema.org', '@type': 'Service', name: serviceName, serviceType, description, provider: { '@id': 'https://bighornthreads.com/#organization' }, areaServed: { '@type': 'Country', name: 'United States' }, url }
const prose = '[&_a]:text-gold-700 [&_a]:underline [&_a]:decoration-gold-500/40 [&_a]:underline-offset-4 hover:[&_a]:decoration-gold-500'
---

<BaseLayout title={title} description={description} canonical={url}>
  <section class={`border-b border-hairline bg-concrete pt-16 ${heroPhoto ? '' : 'pb-20 sm:pb-28'}`}>
    <div class={`page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 ${heroPhoto ? 'pb-12 sm:pb-16' : ''}`}>
      <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold-600">Home</a>
        <span class="px-2 text-ash/60">/</span>
        <span class="text-gold-600">{crumb}</span>
      </nav>
      <p class="kicker mb-4">{kicker}</p>
      <h1 class="max-w-4xl font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-6xl">
        {h1} <span class="text-gold-600">{h1Accent}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">{sub}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
        <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-600">702.904.8923</a>
      </div>
      {!heroPhoto && <HeroProducts />}
    </div>
    {heroPhoto && <img src={picked.file} width={picked.width} height={picked.height} alt={picked.alt} fetchpriority="high" class="block aspect-[16/9] w-full object-cover lg:aspect-[21/9]" />}
  </section>

  <section class="border-b border-hairline bg-paper py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <p class="speakable-answer text-xl leading-relaxed text-charcoal sm:text-2xl">{lead}</p>
    </div>
  </section>

  <section class="bg-concrete py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">{table.heading}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">{table.intro}</p>
      </div>
      <div class="overflow-x-auto border border-hairline">
        <table class="w-full min-w-[560px] text-left">
          <thead>
            <tr class="bg-paper">
              {table.head.map((h) => <th scope="col" class="px-4 py-3 font-heading text-sm font-bold uppercase tracking-wider text-gold-700">{h}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline text-charcoal">
            {table.rows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-paper/60' : ''}>
                <td class="px-4 py-3 font-semibold">{row[0]}</td>
                <td class="px-4 py-3 text-sm">{row[1]}</td>
                <td class="px-4 py-3 text-sm text-ash">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-y border-hairline bg-paper py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-10 max-w-2xl font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">{decide.heading}</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {decide.items.map((item) => (
          <div class="border border-hairline bg-panel p-6">
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class={`mt-2 text-sm leading-relaxed text-ash ${prose}`} set:html={item.desc} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {picked && !heroPhoto && <img src={picked.file} width={picked.width} height={picked.height} alt={picked.alt} loading="lazy" decoding="async" class="block aspect-[16/9] w-full object-cover lg:aspect-[21/9]" />}

  <section class="bg-concrete py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">{body.heading}</h2>
      <div class={`space-y-5 text-lg leading-relaxed text-ash ${prose}`}>
        {body.paragraphs.map((p) => <p set:html={p} />)}
      </div>
      <figure class="mt-12 border border-hairline bg-panel p-6">
        <blockquote class="leading-relaxed text-charcoal">“{quote.text}”</blockquote>
        <figcaption class="mt-4 border-t border-hairline pt-4">
          <span class="block font-heading text-sm font-bold uppercase tracking-tight text-charcoal">{quote.who}</span>
          <span class="block font-mono text-xs text-ash">{quote.what}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="border-y border-hairline bg-paper py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">How ordering works</h2>
      <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s) => (
          <li class="border border-hairline bg-panel p-6">
            <span class="font-heading text-4xl font-extrabold leading-none text-gold-600">{s.n}</span>
            <h3 class="mt-4 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-concrete py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="kicker mb-3">FAQ</p>
      <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Common questions</h2>
      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
              <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
              <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </summary>
            <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-hairline bg-paper py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="kicker mb-6">Related</p>
      <div class="grid gap-5 md:grid-cols-3">
        {related.map((r) => (
          <a href={r.href} class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">{r.title}</h3>
            <p class="mt-2 text-sm text-ash">{r.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-16">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-concrete sm:text-4xl">Send your logo and quantities</h2>
      <p class="mb-8 text-lg text-navy-200">We ship anywhere in the US. Tell us the garment, how many, and your date, and we will send a price and a proof.</p>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
        <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>
