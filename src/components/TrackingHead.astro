---
// Analytics for both site layouts: GA4 + Meta Pixel (page view, lead, phone click),
// plus one per-session note of where the visitor came from, sent with lead forms
// so GHL records a source. No PII is stored in the browser.
---

<script is:inline>
  // Third-party loading is deferred: gtag and the Meta Pixel library load on first
  // interaction or 1.5s after load; their queued calls replay once loaded.
  // Turnstile loads only on pages that render a widget (the quote modal loads its own).
  ;(function () {
    var done = false
    function load (src) {
      var s = document.createElement('script')
      s.async = true
      s.src = src
      document.head.appendChild(s)
    }
    function loadThirdParty () {
      if (done) return
      done = true
      load('https://www.googletagmanager.com/gtag/js?id=G-ZGGY24PN1Z')
      load('https://connect.facebook.net/en_US/fbevents.js')
    }
    ;['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (e) {
      window.addEventListener(e, loadThirdParty, { once: true, passive: true })
    })
    window.addEventListener('load', function () { setTimeout(loadThirdParty, 1500) })
    document.addEventListener('DOMContentLoaded', function () {
      if (!document.querySelector('.cf-turnstile')) return
      load('https://challenges.cloudflare.com/turnstile/v0/api.js')
    })
  })()
</script>
<script is:inline>
  window.dataLayer = window.dataLayer || []
  function gtag(){window.dataLayer.push(arguments)}
  window.gtag = gtag
  gtag('js', new Date())
  gtag('config', 'G-ZGGY24PN1Z')

  ;(() => {
    const KEY = 'bighorn_source'
    const read = () => {
      try { return JSON.parse(sessionStorage.getItem(KEY)) } catch (_) { return null }
    }

    // Captured once, on the first page of the visit.
    if (!read()) {
      const params = new URL(window.location.href).searchParams
      const param = (key, max) => (params.get(key) || '').slice(0, max)
      let referrer = ''
      try {
        const ref = new URL(document.referrer)
        if (ref.hostname !== window.location.hostname) referrer = ref.hostname
      } catch (_) {}
      const source = {
        utm_source: param('utm_source', 120),
        utm_medium: param('utm_medium', 120),
        utm_campaign: param('utm_campaign', 200),
        click: params.has('gclid') ? 'gclid' : params.has('fbclid') ? 'fbclid' : '',
        referrer,
        landing: window.location.pathname.slice(0, 300),
      }
      try { sessionStorage.setItem(KEY, JSON.stringify(source)) } catch (_) {}
    }

    const source = () => read() || {}
    const trackLead = (form) => {
      window.gtag?.('event', 'generate_lead', { form })
      window.fbq?.('track', 'Lead', { form })
    }
    window.bighornTracking = { source, trackLead }

    document.addEventListener('click', (event) => {
      const phone = event.target instanceof Element && event.target.closest('a[href^="tel:"]')
      if (phone) window.gtag?.('event', 'phone_click', { page_path: window.location.pathname })
    })

    // Forms submitted as FormData (contact, get-a-quote) pick up the source automatically.
    document.addEventListener('formdata', (event) => {
      for (const [key, value] of Object.entries(source())) {
        if (value) event.formData.set(key, value)
      }
    })
  })()
</script>

<!-- Meta Pixel Code: queue stub only; fbevents.js loads with the deferred third-party scripts above -->
<script is:inline>
  !function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[]}(window);
  fbq('init', '401727073718157');
  fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=401727073718157&ev=PageView&noscript=1" /></noscript>
