---
import HeroProducts from '@/components/HeroProducts.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { heroPhotoForPath } from '@/data/pagePhotos'

const page = {
 title: 'Promotional Products Las Vegas | Custom Swag for Trade Shows & Events',
 description:
 'Promotional products for Las Vegas trade shows, corporate events, employee onboarding, and customer gifts. Bighorn handles sourcing, proofs, and decoration.',
 url: 'https://bighornthreads.com/promo-products-las-vegas/',
}

const stack = [
 { label: 'The catalog', body: 'We search our supplier catalog for options across drinkware, bags, tech, apparel, writing, awards, and event items.' },
 { label: 'The decoration', body: 'We tell you which method works on the item before you approve the order.' },
 { label: 'Use cases', body: 'Trade show booth giveaways, corporate event swag, employee onboarding kits, customer thank-you gifts, conference attendee bags, recruiting drives, milestone awards.' },
 { label: 'Program-ready', body: 'We keep your approved products and artwork on file for next time, then check stock and price when you reorder.' },
]

const categories = [
 { row: 'Drinkware', use: 'Stainless, insulated, and reusable options', notes: 'Method depends on the material and finish.' },
 { row: 'Bags', use: 'Totes, backpacks, duffels, and computer bags', notes: 'Embroidery, print, or transfer, depending on the bag.' },
 { row: 'Tech', use: 'Chargers, speakers, drives, and desk accessories', notes: 'We check the brand, specs, and stock on your quote.' },
 { row: 'Apparel', use: 'T-shirts, polos, hoodies, jackets, and hats', notes: 'We pick the method for the garment and your art.' },
 { row: 'Writing', use: 'Pens, notebooks, journals, and highlighters', notes: 'Depends on the product and the supplier.' },
 { row: 'Awards & gifts', use: 'Crystal, glass, plaques, recognition gifts, milestone tokens', notes: 'Laser engraving and color-fill. Year-end employee recognition programs.' },
 { row: 'Event SWAG', use: 'Lanyards, badge holders, tote bags, water bottles, hand sanitizer', notes: 'High-volume convention items, often ordered against an event date.' },
]

const eventTypes = [
 { name: 'Trade show booths', detail: 'Booth shirts and giveaways planned around who is walking the floor, your show date, and where it all ships.' },
 { name: 'Corporate events', detail: 'All-hands meetings, sales kickoffs, customer-appreciation dinners. Branded gifts that match event theme and exec-tier expectations.' },
 { name: 'Employee onboarding', detail: 'New-hire welcome kits: branded notebook, water bottle, pen, tote, t-shirt, lanyard, badge holder. Everything one team member needs day one.' },
 { name: 'Customer thank-you', detail: 'High-touch client gifts at contract signing or quarterly check-ins. Premium drinkware, leather notebooks, recognized brand-name items.' },
 { name: 'Recruiting drives', detail: 'Career-fair and new-hire items people will use, picked to fit your budget and your date.' },
 { name: 'Milestone & service awards', detail: 'Year-of-service recognition, project-completion gifts, retirement pieces. Engraved crystal, leather portfolios, or premium drinkware.' },
]

const promoCompare = [
 { topic: 'Selection', detail: 'Our supplier catalog covers drinkware, bags, tech, apparel, writing, awards, and event items. Send an idea or a specific brand and model.' },
 { topic: 'Decoration', detail: 'We recommend a method for each item. Production partners decorate it after you approve the proof.' },
 { topic: 'Price', detail: 'There is no published price list. The item, decoration, and quantity set the price, and the written quote shows it before you order.' },
 { topic: 'Minimums', detail: 'Each supplier sets the minimum for its item. Your quote lists the number.' },
 { topic: 'Timing', detail: 'Stock, decoration, and order size drive lead time. Send your event or show date first so the quote is built around it.' },
 { topic: 'Delivery', detail: 'Your account is run from Las Vegas, and orders ship nationwide, to your office or straight to the show.' },
 { topic: 'Reorders', detail: 'Approved products and artwork stay on file. Stock and price are checked again each time.' },
]

const faqs = [
 { q: 'What promotional products can you source?', a: 'We search our wholesale supplier catalog for drinkware, bags, tech, apparel, writing instruments, awards, and event items. Your quote lists the item, decoration, minimum, price, and timing.' },
 { q: 'What\'s the minimum order for promo products?', a: 'Each item has its own minimum, set by the supplier. Send the item or your idea and a rough count, and we will tell you the number.' },
 { q: 'How do you decorate promotional products?', a: 'We recommend a method for the item, and production partners do the work once you approve it.' },
 { q: 'Can I request promotional products for a Las Vegas trade show?', a: 'Yes. Send the show date, product ideas, quantities, artwork, and where it needs to ship. We will tell you what is available and what can make your date.' },
 { q: 'Can you source premium drinkware brands?', a: 'Send the brand, model, quantity, and deadline. We will check stock, how it can be decorated, and the price before you order.' },
 { q: 'What\'s the lead time on promotional products?', a: 'Item stock, decoration, and order size drive lead time. Common items with on-file artwork move quickly. Specialty or imported items take longer. Send your event date with your inquiry and we\'ll quote a real production timeline against the calendar.' },
 { q: 'Can you build a recurring promo program?', a: 'Yes. We keep your approved products and artwork on file for repeat orders, then check stock, price, and timing each time.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Promo Products Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-11-11',
 name: 'Promotional Products in Las Vegas',
 serviceType: 'Branded promotional products and corporate gifts',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-11-11',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={heroPhotoForPath('/promo-products-las-vegas/')?.file}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Promo Products</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Branded Goods
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Promotional Products in Las Vegas: <span class="text-gold-700">SWAG that earns shelf space.</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Promotional products for Las Vegas trade shows, corporate events, employee onboarding, and customer gifts. Bighorn manages selection, proofs, orders, and reorders.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <section class="border-b border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Promotional Items Las Vegas</p>
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight text-charcoal sm:text-3xl">Promotional products in Las Vegas: what to compare before you order</h2>
 <p class="mb-8 text-lg leading-relaxed text-charcoal">Bighorn Threads sources promotional products for Las Vegas trade shows, corporate events, onboarding kits, and client gifts. We search the supplier catalog, recommend a decoration for each item, and send a written quote with the item, minimum, price, and timing. Production partners decorate everything after you approve the proof.</p>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What buyers compare</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">How Bighorn handles it</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {promoCompare.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.topic}</td>
 <td class="px-6 py-5 align-top text-sm leading-relaxed text-ash">{r.detail}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Swag you can order again next year.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Categories</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What the catalog covers.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 The main categories, what is in each one, and how your logo gets on it.
 </p>
 </div>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Category</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What's Inside</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Decoration Method</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {categories.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Use Cases</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six ways to plan promotional products.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {eventTypes.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Promo products people keep using.
 </h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Promo works when the person getting it wants to keep it. A tumbler someone drinks from every day beats a pen that dies in a drawer, though a pen can be the right call for a big show crowd.
 </p>
 <p>
 Drinkware is a safe bet when it fits the crowd. Before you pick, look at the brand, the finish, how the logo goes on, and the total price. Engraving looks different on different finishes, so check the proof and the care instructions.
 </p>
 <p>
 Trade shows are their own problem. Most booths need something cheap for the crowd and something better for the people worth a real conversation. The right mix comes down to your audience, expected traffic, budget, show rules, and what your sales team wants to hand out.
 </p>
 <p>
 Repeat buyers often settle on a few standard items after the first few orders. Keeping approved products and art on file makes the next order easier, and we still check stock, price, and timing each time.
 </p>
 <p>
 For event-specific programs, see our <a href="/trade-show-apparel-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">trade show apparel guide</a> and <a href="/custom-lanyards-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom lanyards for trade shows, conferences, and staff</a>. For deeper reads on apparel and decoration, see our <a href="/blog/trade-show-apparel-booth-crew/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">booth-crew apparel playbook</a> and the <a href="/services/embroidery-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidery service page</a> for decoration specifics.
 </p>
 </div>
 </div>
 </section>

 <NationalLinks heading='Ordering from outside Nevada?' links={[{ href: '/corporate-swag/', label: 'Corporate swag and branded merchandise' }, { href: '/custom-embroidered-hats/', label: 'Custom embroidered hats' }, { href: '/employee-appreciation-gifts/', label: 'Employee appreciation gifts' }]} />
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Promo product questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/trade-show-apparel-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Trade Show Apparel</h3>
 <p class="mt-2 text-sm text-ash">Booth crew apparel that pairs with the giveaway items.</p>
 </a>
 <a href="/catalog/promotional-products/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Promo Catalog</h3>
 <p class="mt-2 text-sm text-ash">Picks from our supplier catalog, by category.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">Private storefront for ongoing promo + apparel programs.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to spec your promo program?</h2>
 <p class="mb-8 text-lg text-white/80">Send your event date, audience, and budget tier.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
