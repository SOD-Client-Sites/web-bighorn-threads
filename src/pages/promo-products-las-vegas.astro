---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Promotional Products in Las Vegas | Branded SWAG, Drinkware, Bags | Bighorn Threads',
 description:
 'Promotional products for Las Vegas trade shows, corporate events, employee onboarding, and customer gifts. Bighorn coordinates sourcing, proofs, and partner decoration.',
 hero: '/images/generated/product-stack.jpg',
 url: 'https://bighornthreads.com/promo-products-las-vegas/',
}

const stack = [
 { label: 'The catalog', body: 'Bighorn can search SAGE for current supplier options across drinkware, bags, tech, apparel, writing, awards, and event items.' },
 { label: 'The decoration', body: 'Bighorn coordinates the approved decoration through production partners. The available method is confirmed for the selected product before you approve the order.' },
 { label: 'Use cases', body: 'Trade show booth giveaways, corporate event swag, employee onboarding kits, customer thank-you gifts, conference attendee bags, recruiting drives, milestone awards.' },
 { label: 'Program-ready', body: 'Bighorn can document approved products and artwork for future orders. Each reorder receives a current availability, pricing, and production review.' },
]

const categories = [
 { row: 'Drinkware', use: 'Ask about current stainless, insulated, and reusable options', notes: 'Decoration depends on the exact material, finish, and manufacturer approval.' },
 { row: 'Bags', use: 'Ask about current totes, backpacks, duffels, and computer bags', notes: 'Embroidery, print, or transfer may be available by product.' },
 { row: 'Tech', use: 'Ask about current chargers, speakers, drives, and desk accessories', notes: 'Brand, electrical specifications, decoration, and availability require quote review.' },
 { row: 'Apparel', use: 'T-shirts, polos, hoodies, jackets, and hats', notes: 'Decoration is proposed for the exact garment and artwork.' },
 { row: 'Writing', use: 'Ask about current pens, notebooks, journals, and highlighters', notes: 'Decoration depends on the product, material, and supplier.' },
 { row: 'Awards & gifts', use: 'Crystal, glass, plaques, recognition gifts, milestone tokens', notes: 'Laser engraving and color-fill. Year-end employee recognition programs.' },
 { row: 'Event SWAG', use: 'Lanyards, badge holders, tote bags, water bottles, hand sanitizer', notes: 'High-volume convention items, often ordered against an event date.' },
]

const eventTypes = [
 { name: 'Trade show booths', detail: 'Plan booth apparel and giveaway items around the audience, event date, quantity, destination, and current supplier terms.' },
 { name: 'Corporate events', detail: 'All-hands meetings, sales kickoffs, customer-appreciation dinners. Branded gifts that match event theme and exec-tier expectations.' },
 { name: 'Employee onboarding', detail: 'New-hire welcome kits — branded notebook, water bottle, pen, tote, t-shirt, lanyard, badge holder. Everything one team member needs day one.' },
 { name: 'Customer thank-you', detail: 'High-touch client gifts at contract signing or quarterly check-ins. Premium drinkware, leather notebooks, recognized brand-name items.' },
 { name: 'Recruiting drives', detail: 'Compare career-fair and new-hire items by audience fit, usefulness, budget, availability, and delivery date.' },
 { name: 'Milestone & service awards', detail: 'Year-of-service recognition, project-completion gifts, retirement pieces. Engraved crystal, leather portfolios, or premium drinkware.' },
]

const faqs = [
 { q: 'What promotional products can you source?', a: 'Bighorn searches the SAGE wholesale promotional product catalog for drinkware, bags, tech, apparel, writing instruments, awards, and event items. Product availability, decoration, minimums, pricing, and timing are confirmed in the quote.' },
 { q: 'What\'s the minimum order for promo products?', a: 'Minimums vary by product, supplier, decoration, and current production requirements. Bighorn confirms the current minimum in your quote.' },
 { q: 'How do you decorate promotional products?', a: 'Bighorn recommends a decoration approach for the selected product and coordinates the approved work through production partners. Available methods are confirmed in the quote.' },
 { q: 'Can I request promotional products for a Las Vegas trade show?', a: 'Yes. Send the event date, product ideas, quantities, artwork, and required destination. Bighorn will confirm current availability, decoration, production, and fulfillment options.' },
 { q: 'Can you source premium drinkware brands?', a: 'Send the brand, model, quantity, and deadline you need. Bighorn will confirm current availability, approved decoration options, and commercial terms before you order.' },
 { q: 'What\'s the lead time on promotional products?', a: 'Lead time depends on item availability, decoration complexity, and order size. Common items with on-file artwork move quickly. Specialty or imported items take longer. Send your event date with your inquiry and we\'ll quote a real production timeline against the calendar.' },
 { q: 'Can you build a recurring promo program?', a: 'Bighorn can document approved products and artwork for repeat orders. Each reorder receives a current review for availability, pricing, decoration, and timing.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Promo Products Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Promotional Products in Las Vegas',
 serviceType: 'Branded promotional products and corporate gifts',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>
 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Promo Products</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Branded Goods
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Promotional Products in Las Vegas <span class="text-gold-400">— SWAG that earns shelf space, not landfill space.</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn Threads coordinates promotional products for Las Vegas trade shows, corporate events, employee onboarding, and customer gifts. Production partners perform the approved decoration. Bighorn manages selection, proofs, orders, and reorders.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A promo program, not a one-off swag bag.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Categories</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Where the SAGE catalog gets us.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 The major promo verticals, the brands inside each, and the decoration method that fits the substrate.
 </p>
 </div>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Category</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What's Inside</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Decoration Method</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {categories.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Use Cases</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six ways to plan promotional products.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {eventTypes.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Promo products that get used, not thrown out.
 </h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Promotional products work best when the item is useful to the intended recipient. Compare product quality, audience fit, quantity, decoration, delivery, and total cost before choosing between low-cost giveaways and premium branded items.
 </p>
 <p>
 Drinkware can be a strong candidate when it fits the audience and occasion. Compare the current product, brand, finish, decoration, care instructions, minimum, delivery, and total quoted cost. Engraving results and durability depend on the exact material and finish, so approve the product-specific proof and care guidance.
 </p>
 <p>
 Trade shows are a distinct planning case. A giveaway mix can range from high-volume items to products reserved for qualified prospects. The right mix depends on audience, expected traffic, qualifying questions, budget, event rules, delivery date, and what the sales team wants each lead category to receive.
 </p>
 <p>
 Recurring promo programs often settle into a small set of standard products after the first few orders. Keeping approved products and artwork on file can simplify future orders. Every reorder still needs a current review for availability, pricing, decoration, and timing.
 </p>
 <p>
 For event-specific programs, see our <a href="/trade-show-apparel-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">trade show apparel guide</a>. For deeper reads on apparel and decoration, see our <a href="/blog/trade-show-apparel-booth-crew/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">booth-crew apparel playbook</a> and the <a href="/services/embroidery-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidery service page</a> for decoration specifics.
 </p>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Promo product questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/trade-show-apparel-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Trade Show Apparel</h3>
 <p class="mt-2 text-sm text-ash">Booth crew apparel that pairs with the giveaway items.</p>
 </a>
 <a href="/catalog/promotional-products/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Promo Catalog</h3>
 <p class="mt-2 text-sm text-ash">Curated picks from the SAGE catalog by category.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">Private storefront for ongoing promo + apparel programs.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to spec your promo program?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your event date, audience, and budget tier.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
