---
import BaseLayout from '@/layouts/BaseLayout.astro'

const post = {
  title: 'How Much Does It Cost to Embroider a Shirt? What Drives the Price',
  description:
    'What drives embroidery cost: artwork, stitch count, garment, placements, quantity, digitizing, and production-partner terms. Request a current Las Vegas quote.',
  category: 'Pricing',
  readTime: '9 min read',
  date: 'May 9, 2026',
  isoDate: '2026-05-09',
  image: '/images/generated/service-embroidery.jpg',
  slug: 'how-much-to-embroider-a-shirt',
}

const faqs = [
  {
    q: 'How much does it cost to embroider a shirt?',
    a: "Embroidery pricing depends on the artwork, estimated stitch count, garment, placements, quantity, digitizing, and production-partner terms. Send your logo, product, quantity, and deadline for a current quote.",
  },
  {
    q: 'What is the average cost to embroider a logo on a shirt?',
    a: "There's no reliable average without the artwork and order details. The quote should identify the garment, decoration, placements, quantity, digitizing, and any applicable fees.",
  },
  {
    q: 'How much does custom embroidery cost for work shirts?',
    a: "It depends on the exact garment, artwork, placement, quantity, and partner terms. Protective garments also require employer and manufacturer review before decoration. Send the approved product and logo for a current quote.",
  },
  {
    q: 'What is a digitizing fee for embroidery?',
    a: "Digitizing converts logo artwork into a stitch file. The fee, ownership, retention, delivery, reuse, and repeat-order terms depend on the selected production partner. Confirm each term in writing.",
  },
  {
    q: 'How much does it cost to embroider 50 shirts?',
    a: "Pricing for 50 shirts still depends on the garment, artwork, placements, digitizing, and current partner quote. Quantity can affect pricing, but no fixed discount or fee applies to every order.",
  },
  {
    q: 'Is embroidery cheaper than screen printing for work shirts?',
    a: "The lower-cost method depends on artwork, quantity, garment, placements, and the selected partner. Compare written quotes for the same approved product and design rather than relying on a universal quantity threshold.",
  },
  {
    q: 'How long does embroidery take on a shirt?',
    a: 'Timing depends on garment availability, artwork, digitizing, proof approval, quantity, partner capacity, and delivery. Send the complete order and required date for a written schedule.',
  },
  {
    q: 'Where can I get custom embroidered shirts in Las Vegas?',
    a: 'Bighorn Threads coordinates embroidery through selected production partners for Las Vegas businesses. File retention, rush availability, pricing, and timing depend on the partner and final quote. Send your logo, product, quantity, and deadline.',
  },
]

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.title,
      description: post.description,
      image: `https://bighornthreads.com${post.image}`,
      datePublished: post.isoDate,
      dateModified: '2026-08-21',
      author: { '@type': 'Organization', name: 'Bighorn Threads', url: 'https://bighornthreads.com/' },
      publisher: {
        '@type': 'Organization',
        name: 'Bighorn Threads',
        logo: { '@type': 'ImageObject', url: 'https://bighornthreads.com/images/logos/bighorn-logo-color.png' },
      },
      mainEntityOfPage: `https://bighornthreads.com/blog/${post.slug}/`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bighornthreads.com/blog/' },
        { '@type': 'ListItem', position: 3, name: post.title, item: `https://bighornthreads.com/blog/${post.slug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
}
---

<BaseLayout title={post.title} description={post.description} canonical={`https://bighornthreads.com/blog/${post.slug}/`} ogImage={post.image} type="article" publishedDate={post.isoDate}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="bg-concrete">
    <header class="border-b border-hairline bg-paper">
      <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-12 sm:px-6 sm:pt-24 lg:px-8">
        <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
          <a href="/" class="hover:text-gold-700">Home</a><span class="px-2">/</span><a href="/blog/" class="hover:text-gold-700">Blog</a>
        </nav>
        <span class="mb-3 inline-block text-xs font-bold uppercase tracking-[0.2em] text-gold-600">{post.category}</span>
        <h1 class="mb-6 font-heading text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">{post.title}</h1>
        <p class="mb-8 text-xl leading-relaxed text-ash">What actually drives the price — stitch count, the garment you pick, quantity, and a one-time digitizing fee — so you can read any embroidery quote you get.</p>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-hairline pt-6 font-mono text-sm text-ash">
          <span class="text-gold-600">Bighorn Threads</span><span aria-hidden="true">&middot;</span><span>{post.readTime}</span><span aria-hidden="true">&middot;</span><time datetime={post.isoDate}>{post.date}</time>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-4 pt-10 sm:px-6 lg:px-8">
      <img src={post.image} alt="Multi-head commercial embroidery machine stitching company logos onto branded work shirts in Las Vegas" width="1200" height="675" loading="eager" class="w-full border border-hairline object-cover" />
    </div>

    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">

      <!-- Answer-first box — what AEO surfaces pull first -->
      <aside class="mb-10 border border-hairline bg-panel p-7">
        <p class="mb-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gold-600">Direct Answer</p>
        <p class="text-lg leading-relaxed text-charcoal sm:text-xl"><strong>Embroidery cost depends on the complete order.</strong> Artwork, stitch count, garment, placements, quantity, digitizing, and partner terms all matter. Send the details to <a href="/get-a-quote/" class="text-gold-600 underline-offset-2 hover:underline">Bighorn Threads</a> for a current quote.</p>
      </aside>

      <!-- YouTube Short embed -->
      <div class="mb-14">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-gold-600">Watch: 60-Second Pricing Breakdown</p>
        <div class="relative mx-auto aspect-[9/16] max-w-[320px] overflow-hidden border border-hairline">
          <iframe
            src="https://www.youtube.com/embed/609b499a02e6425da4ef256541e4d6fc"
            title="How Much Does It Cost to Embroider a Shirt? — Bighorn Threads Las Vegas"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="absolute inset-0 h-full w-full"
          ></iframe>
        </div>
      </div>

      <!-- Quantity driver — qualitative, quote-led -->
      <h2 id="quantity-cost" class="mt-4 mb-6 font-heading text-3xl font-bold tracking-tight">How Quantity Shapes Your Per-Piece Cost</h2>
      <p class="mb-10 text-lg leading-relaxed text-charcoal">Quantity can affect pricing, but the result depends on the product and partner quote. Compare the same garment, artwork, placements, and delivery terms across options.</p>

      <h2 id="stitch-count" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">1. Stitch Count — the Real Cost Driver</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Stitch count is one common pricing input. Garment handling, placements, quantity, digitizing, and partner terms can also affect the quote.</p>
      <ul class="mb-6 list-none space-y-3 text-lg text-charcoal">
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Simple bold logo:</strong> often easier to reproduce at small sizes</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Left-chest logo:</strong> a common placement that still needs an artwork review</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Detailed logo:</strong> may require simplification or a larger placement</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Large placement:</strong> can increase stitches, handling, and production time</span></li>
      </ul>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Two logos at the same physical size can have very different stitch counts depending on fill density and detail. If you want to bring per-piece cost down, the fastest lever is simplifying your logo for embroidery. See <a href="/blog/logo-digitizing-101-embroidery/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">logo digitizing 101</a> for how that works.</p>

      <h2 id="garment" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">2. The Shirt Itself</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">The blank you pick is the other half of your number. Garments climb in cost from basic tees up to FR-rated workwear:</p>
      <ul class="mb-6 list-none space-y-3 text-lg text-charcoal">
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Basic work t-shirt</strong> (Gildan, Hanes): an economical workhorse blank — the value pick</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Work polo</strong> (Port Authority K500, Red Kap): the everyday crew standard, a step up from a tee</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Performance polo</strong> (Carhartt Force, Nike Dri-FIT): moisture-wicking and tougher — a premium blank</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>FR-rated work shirt</strong> (Bulwark, Carhartt FR): flame-resistant and the most expensive blank by a wide margin</span></li>
      </ul>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">For trade-specific recommendations — which shirt fits which crew — see <a href="/industries/electrical-contractors-las-vegas/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">electrical contractors</a>, <a href="/industries/plumbing-hvac-las-vegas/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">plumbing & HVAC</a>, and <a href="/industries/general-contractors-las-vegas/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">general contractors</a>.</p>

      <h2 id="digitizing" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">3. Confirm Digitizing and File Terms</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal"><strong>Digitizing</strong> converts logo artwork into a stitch file. Cost, file ownership, retention, delivery, and repeat-order fees depend on the selected production partner and quote.</p>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">A well-digitized file strongly affects embroidery quality. Poor digitizing can cause pulled stitches, bad registration, and blurry logos. Confirm file ownership, retention, and any repeat-order fees in the written quote.</p>

      <h2 id="complexity" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">4. Multiple Placements</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">A single left-chest logo is the base case. Each extra placement — right chest name, sleeve hit, back yoke — means re-hooping the shirt and a separate machine pass, so each one adds to your per-shirt cost. Common add-ons:</p>
      <ul class="mb-6 list-none space-y-3 text-lg text-charcoal">
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Right-chest name:</strong> a small per-shirt add-on (it's usually just text)</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Sleeve hit:</strong> a small per-shirt add-on for one more pass</span></li>
        <li class="flex gap-3"><span class="text-gold-600 font-bold">→</span><span><strong>Back yoke logo:</strong> the biggest add-on — a larger hit means more stitches</span></li>
      </ul>

      <h2 id="quantity" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">5. Quantity Discounts</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Quantity breaks, minimums, and small-order fees vary by product and production partner. Ask for the exact quantity options in writing. Our <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">minimum-order guide</a> explains which details to confirm.</p>

      <h2 id="how-long" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">How Long Does Embroidery Take?</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Timing depends on product availability, artwork, digitizing, proof approval, quantity, partner capacity, and delivery. Bighorn confirms the proposed schedule in writing.</p>

      <h2 id="vs-screen-printing" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">Embroidery vs Screen Printing — Which Is Cheaper?</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Compare both methods against the same garment, artwork, placement, quantity, and deadline. The selected production partner should confirm compatibility and pricing for the exact order.</p>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Full breakdown: <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">Screen printing vs. embroidery for construction crews</a>.</p>

      <h2 id="get-quote" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">Where to Get Custom Embroidered Shirts in Las Vegas</h2>
      <p class="mb-6 text-lg leading-relaxed text-charcoal"><strong>Bighorn Threads</strong> manages embroidery programs for Las Vegas contractors and service businesses. Selected production partners handle digitizing and embroidery. Your quote confirms file retention, rush availability, pricing, and timing.</p>
      <p class="mb-6 text-lg leading-relaxed text-charcoal">Three things to send for an accurate quote:</p>
      <ol class="mb-8 list-decimal pl-6 space-y-3 text-lg leading-relaxed text-charcoal">
        <li>Your logo (PDF, AI, PNG — any format works to start)</li>
        <li>Quantity and shirt type (or tell us your crew's use case)</li>
        <li>Placements needed (left chest only, or additional positions)</li>
      </ol>

      <div class="border border-hairline bg-gold-500/5 p-7 sm:p-9">
        <h2 class="mb-3 font-heading text-2xl font-bold tracking-tight text-charcoal">Get an embroidery quote in Las Vegas</h2>
        <p class="mb-5 text-lg leading-relaxed text-charcoal">Bighorn Threads coordinates embroidered work shirts and polos through selected production partners. FR garments require employer and manufacturer approval. Send your logo, product, quantity, and deadline for a current quote.</p>
        <a href="/get-a-quote/" class="inline-flex min-h-[48px] items-center gap-2 bg-gold-500 px-7 py-3 text-base font-bold text-charcoal transition-all hover:bg-gold-600">Get a Quote →</a>
      </div>

      <!-- Full FAQ section for AEO -->
      <div class="mt-16 space-y-5">
        <h2 class="font-heading text-2xl font-bold tracking-tight">Embroidery Pricing — Frequently Asked Questions</h2>
        {faqs.map((faq) => (
          <div class="border border-hairline bg-panel p-6">
            <h3 class="mb-3 font-semibold text-charcoal">{faq.q}</h3>
            <p class="leading-relaxed text-charcoal">{faq.a}</p>
          </div>
        ))}
      </div>

      <!-- Related reading -->
      <div class="mt-16 border-t border-hairline pt-12">
        <p class="mb-6 text-xs font-bold uppercase tracking-widest text-gold-600">Related Reading</p>
        <ul class="space-y-3 text-lg">
          <li><a href="/blog/logo-digitizing-101-embroidery/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">Logo Digitizing 101: What It Is and Why It Matters</a></li>
          <li><a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">Screen Printing vs Embroidery for Construction Crews</a></li>
          <li><a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">Minimum Order Quantities — What to Expect</a></li>
          <li><a href="/blog/custom-embroidered-t-shirts-buyer-guide/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">Custom Embroidered T-Shirts Buyer's Guide</a></li>
          <li><a href="/services/embroidery-las-vegas/" class="text-gold-600 underline decoration-gold-600/40 underline-offset-4 hover:decoration-gold-600">Custom Embroidery Services — Las Vegas</a></li>
        </ul>
      </div>

    </div>
  </article>
</BaseLayout>
