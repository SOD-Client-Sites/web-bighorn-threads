const post = {
 title: 'DTF Printing vs Screen Printing for Custom Apparel: When to Use Which',
 description:
 'Compare DTF and screen printing by fabric, color, artwork, quantity, feel, care, partner capacity, and current written pricing.',
 category: 'Decoration Methods',
 readTime: '8 min read',
 date: 'May 9, 2026',
 isoDate: '2026-05-09',
 image: '/images/og-default.jpg',
 slug: 'dtf-printing-vs-screen-printing-custom-apparel',
}

const faqs = [
 { q: 'What is DTF printing?', a: 'DTF printing transfers approved artwork from a prepared film onto a compatible garment. Ask us for the fabric compatibility, finish, and care instructions on your order.' },
 { q: 'DTF vs screen printing: which is better?', a: 'Choose by garment, fabric, color, artwork, quantity, feel, care, price, and partner capacity. Compare written quotes for the same garment, artwork, and quantity.' },
 { q: 'How long does DTF last?', a: 'There is no universal wash count. The garment, the transfer, and the care set how long it lasts. Ask for current manufacturer or partner documentation when durability matters.' },
 { q: 'Does DTF work on dark fabrics?', a: 'Yes. This is one of DTF\'s biggest advantages over sublimation. DTF prints with white-ink underlayers that allow color saturation on black, navy, and dark gray fabrics. Sublimation can\'t do this; screen printing requires extra "underbase" steps that add cost. DTF handles dark fabrics natively.' },
 { q: 'Can DTF print on cotton?', a: 'It may be compatible with selected cotton and other garments. We confirm the fabric, transfer, finish, and care instructions before you approve.' },
 { q: 'What\'s the minimum order for DTF?', a: 'Your quote lists the minimum for your product and artwork. Send the quantity you need and request a written quote.' },
 { q: 'How much does DTF cost compared to screen printing?', a: 'DTF usually wins on small runs and many-color art, and screen printing wins as the count rises. Where they cross depends on your garment and colors, so ask for both prices.' },
 { q: 'Does DTF have a feel on the fabric?', a: 'Yes, DTF prints have a slight raised surface feel because the adhesive layer sits on top of the fabric. It\'s less pronounced than heat-transfer vinyl but more noticeable than properly cured screen-printed plastisol or sublimation. For most apparel users this is unnoticeable; for premium soft-feel programs, screen printing with discharge or water-based inks delivers a softer hand.' },
]

const schema = {
 '@context': 'https://schema.org',
 '@graph': [
 { '@type': 'Article', headline: post.title, description: post.description, image: `https://bighornthreads.com${post.image}`, datePublished: post.isoDate, dateModified: '2026-11-11', author: { '@type': 'Organization', name: 'Bighorn Threads', url: 'https://bighornthreads.com/' }, publisher: { '@type': 'Organization', name: 'Bighorn Threads', logo: { '@type': 'ImageObject', url: 'https://bighornthreads.com/images/logos/bighorn-logo-color.png' } }, mainEntityOfPage: `https://bighornthreads.com/blog/${post.slug}/` },
 { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bighornthreads.com/blog/' }, { '@type': 'ListItem', position: 3, name: post.title, item: `https://bighornthreads.com/blog/${post.slug}/` }] },
 { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
 ],
}

const speakableSchema = {
