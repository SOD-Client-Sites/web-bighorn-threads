---
import BaseLayout from '@/layouts/BaseLayout.astro'

const post = {
 title: 'What Is a Company Shirt? A Plain-English Guide to Branded Workwear',
 description:
 'A company shirt is a branded shirt that identifies a business — typically a polo, tee, work shirt, or hoodie with the company logo embroidered or screen-printed on the chest. Here\'s what to call them, when to use which, and how to pick the right one for your crew.',
 category: 'Glossary',
 readTime: '7 min read',
 date: 'May 9, 2026',
 isoDate: '2026-05-09',
 image: '/images/generated/service-embroidery.jpg',
 slug: 'what-is-a-company-shirt',
}

const faqs = [
 { q: 'What is a company shirt?', a: 'A company shirt is any branded shirt that identifies a business — typically a polo, t-shirt, work shirt, or hoodie with the company name and logo applied via embroidery or screen printing. Crews wear them so customers, suppliers, and sub-contractors can identify the business at a glance.' },
 { q: 'What are company shirts called?', a: 'They go by several names: branded apparel, corporate apparel, custom workwear, uniform shirts, logo wear, or company uniforms. In trades and construction, "crew shirts" or "service shirts" are common. The category is broader than just t-shirts — it includes polos, button-downs, hoodies, jackets, hi-vis vests, and hats.' },
 { q: 'What\'s the difference between embroidered and screen-printed company shirts?', a: 'Embroidery uses thread. Screen printing uses ink. Compare the exact garment, artwork, placement, quantity, care, durability needs, setup, and current quote before choosing a method.' },
 { q: 'How many company shirts does a crew member need?', a: 'Choose the issue quantity from the work schedule, laundering, climate, replacement policy, garment service life, budget, and employee needs.' },
 { q: 'Do small businesses need company shirts?', a: 'Branded apparel may help customers identify a small business team. The effect depends on the business, service, presentation, and customer experience. Apparel alone does not guarantee sales.' },
]

