// Category accent colors — small doses only (eyebrow label + top hairline).
// Tuned to read clearly on the navy-950 card background.
const categoryColors: Record<string, string> = {
 Compliance: '#f0b34e',
 'Decoration Methods': '#6bb3d6',
 Brands: '#c6a0e0',
 Products: '#7ecaa1',
 'Crew Outfitting': '#e89a6b',
 Operations: '#9aa8d6',
 Operational: '#9aa8d6',
 'How-To': '#6bccb8',
 'Use Cases': '#d98fae',
 Comparison: '#b6c46b',
 Trades: '#e0b36b',
 'Local Guides': '#8fc8d8',
 Glossary: '#a6b2bf',
 Pricing: '#7ecb7e',
 Industries: '#d6a36b',
}
const accentFor = (category: string) => categoryColors[category] ?? '#c19b3d'
const postPath = (slug: string) =>
 slug === 'screen-printing-vs-embroidery-construction'
 ? '/screen-printing-vs-embroidery-construction-las-vegas/'
 : `/blog/${slug}/`

const blogSchema = {
 '@context': 'https://schema.org',
 '@type': 'Blog',
 '@id': 'https://bighornthreads.com/blog/#blog',
 name: 'Field Notes — Bighorn Threads',
 description: 'Educational planning guides for Las Vegas construction and trade apparel, including decoration, ordering models, and employer product approval.',
 url: 'https://bighornthreads.com/blog/',
 inLanguage: 'en-US',
 publisher: { '@id': 'https://bighornthreads.com/#organization' },
 blogPost: posts.map((p) => ({
 '@type': 'BlogPosting',
 '@id': `https://bighornthreads.com${postPath(p.slug)}`,
 headline: p.title,
 description: p.excerpt,
 datePublished: new Date(p.date).toISOString(),
 url: `https://bighornthreads.com${postPath(p.slug)}`,
 author: { '@type': 'Organization', name: 'Bighorn Threads' },
 })),
}

const itemListSchema = {
 '@context': 'https://schema.org',
 '@type': 'ItemList',
 '@id': 'https://bighornthreads.com/blog/#itemlist',
 numberOfItems: posts.length,
 itemListElement: posts.map((p, i) => ({
 '@type': 'ListItem',
 position: i + 1,
 url: `https://bighornthreads.com${postPath(p.slug)}`,
 name: p.title,
 })),
}
