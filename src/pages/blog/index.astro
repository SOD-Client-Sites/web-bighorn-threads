// Fifteen legacy categories roll up into five topics for the filter.
const topics = [
 { id: 'compliance', name: 'Compliance & safety', image: 'public-works-crew', categories: ['Compliance'] },
 { id: 'decoration', name: 'Decoration & artwork', image: 'screen-printing-closeup', categories: ['Decoration Methods', 'How-To'] },
 { id: 'products', name: 'Products & brands', image: 'embroidered-caps', categories: ['Products', 'Brands', 'Comparison'] },
 { id: 'programs', name: 'Crew programs', image: 'new-hire-kit', categories: ['Crew Outfitting', 'Operations', 'Operational', 'Use Cases', 'Trades', 'Industries'] },
 { id: 'buying', name: 'Buying basics', image: 'shipping-box', categories: ['Local Guides', 'Glossary', 'Pricing'] },
].map((t) => ({ ...t, posts: posts.filter((p) => t.categories.includes(p.category)) }))

const featured = [
 { slug: 'how-to-outfit-a-construction-crew-vegas', image: 'home-hero-jobsite-crew' },
 { slug: 'company-store-vs-bulk-ordering', image: 'company-store-phone' },
 { slug: 'screen-printing-vs-embroidery-construction', image: 'screen-printing-closeup' },
].map((f) => ({ ...posts.find((p) => p.slug === f.slug)!, photo: photo(f.image) }))

// CSS-only filter: all posts stay in the HTML, the checked radio hides the other groups.
const filterCss = topics
 .map((t) => `.topic-browser:has(#filter-${t.id}:checked) .topic-group:not([data-topic="${t.id}"]){display:none}`)
 .join('')
const pillClass = 'topic-pill inline-flex min-h-[44px] cursor-pointer items-center gap-2 border border-hairline bg-panel px-4 py-2 font-subheading text-lg font-semibold text-charcoal hover:border-charcoal'

const postPath = (slug: string) =>
 slug === 'screen-printing-vs-embroidery-construction'
 ? '/screen-printing-vs-embroidery-construction-las-vegas/'
 : `/blog/${slug}/`

const blogSchema = {
 '@context': 'https://schema.org',
 '@type': 'Blog',
 '@id': 'https://bighornthreads.com/blog/#blog',
 name: 'Field Notes, Bighorn Threads',
 description: 'Educational planning guides for Las Vegas construction and trade apparel, including decoration, ordering models, and employer product approval.',
 url: 'https://bighornthreads.com/blog/',
 inLanguage: 'en-US',
 publisher: { '@id': 'https://bighornthreads.com/#organization' },
 blogPost: posts.map((p) => ({
 '@type': 'BlogPosting',
 '@id': `https://bighornthreads.com${postPath(p.slug)}`,
 headline: p.title,
 description: p.excerpt,
 datePublished: new Date(p.date).toISOString(),
 url: `https://bighornthreads.com${postPath(p.slug)}`,
 author: { '@type': 'Organization', name: 'Bighorn Threads' },
 })),
}

const itemListSchema = {
 '@context': 'https://schema.org',
 '@type': 'ItemList',
 '@id': 'https://bighornthreads.com/blog/#itemlist',
 numberOfItems: posts.length,
 itemListElement: posts.map((p, i) => ({
 '@type': 'ListItem',
 position: i + 1,
 url: `https://bighornthreads.com${postPath(p.slug)}`,
 name: p.title,
 })),
}
