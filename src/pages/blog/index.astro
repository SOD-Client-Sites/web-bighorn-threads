 </div>
 <div class="grid gap-6 lg:grid-cols-[2fr_1fr_1fr]">
 {featured.map((post, i) => (
 <a href={postPath(post.slug)} class="group block">
 <img src={post.photo.file} alt={post.photo.alt} width="1376" height="768" fetchpriority={i === 0 ? 'high' : undefined} decoding="async" class="aspect-[3/2] w-full object-cover lg:h-64 lg:aspect-auto" />
 <p class="spec mt-4 text-gold-700">{post.readTime}</p>
 <h2 class:list={['mt-1 font-subheading font-bold leading-tight text-charcoal group-hover:text-gold-700', i === 0 ? 'text-3xl' : 'text-2xl']}>{post.title}</h2>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- Posts by topic, with filter -->
 <section class="topic-browser bg-paper py-12 sm:py-14">
 <style is:inline set:html={filterCss}></style>
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-4xl font-extrabold uppercase tracking-tight text-charcoal">All guides</h2>
 <fieldset class="mb-8 flex flex-wrap gap-2">
 <legend class="sr-only">Filter guides by topic</legend>
 <label class={pillClass}><input type="radio" name="topic" class="sr-only" checked />All <span class="spec text-ash">{posts.length}</span></label>
 {topics.map((t) => (
 <label class={pillClass}><input type="radio" name="topic" id={`filter-${t.id}`} class="sr-only" />{t.name} <span class="spec text-ash">{t.posts.length}</span></label>
 ))}
 </fieldset>
 {topics.map((t) => (
 <div data-topic={t.id} class="topic-group grid gap-4 border-t-2 border-charcoal py-8 lg:grid-cols-[4fr_8fr] lg:gap-12">
 <div>
 <h3 class="font-heading text-3xl font-bold uppercase text-charcoal">{t.name}</h3>
 <img src={photo(t.image).file} alt={photo(t.image).alt} width="1376" height="768" loading="lazy" decoding="async" class="mt-4 hidden aspect-[3/2] w-full object-cover lg:block" />
 </div>
 <ul class="divide-y divide-hairline">
 {t.posts.map((post) => (
 <li>
 <a href={postPath(post.slug)} class="group block py-3">
 <span class="block font-subheading text-xl font-semibold leading-snug text-charcoal group-hover:text-gold-700">{post.title}</span>
 <span class="mt-0.5 hidden text-base leading-relaxed text-ash sm:block">{post.excerpt}</span>
 </a>
 </li>
 ))}
 </ul>
 </div>
 ))}
 <p class="border-t border-hairline pt-6 text-sm text-ash">Sample photos. They do not show Bighorn customers or staff.</p>
 </div>
 </section>
 <style>
 .topic-pill:has(input:checked) { background: var(--color-charcoal); border-color: var(--color-charcoal); color: #fff; }
 .topic-pill:has(input:checked) .spec { color: #fff; }
 .topic-pill:has(input:focus-visible) { outline: 2px solid var(--color-gold-500); outline-offset: 2px; }
 </style>

 <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

 <!-- CTA band -->
 <section class="border-t border-hairline bg-paper py-16">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <p class="kicker mb-3 justify-center">Get Started</p>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">
 Ready to outfit your crew?
 </h2>
 <p class="mb-8 text-lg text-ash">
 Tell us the crew, the garments, and the date. Terms come back in writing.
 </p>
 <a href="/contact/" class="btn-primary text-base">
 Request a Quote
 </a>
 </div>
 </section>
</BaseLayout>
