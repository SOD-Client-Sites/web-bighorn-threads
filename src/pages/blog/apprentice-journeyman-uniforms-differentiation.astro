---
import BaseLayout from '@/layouts/BaseLayout.astro'

const post = {
 title: 'Apprentice & Journeyman Uniforms: Differentiation in Crew Programs',
 description:
 'A planning guide to role identifiers for apprentice and journeyman apparel. Confirm titles, colors, hard-hat rules, and protective apparel with the employer, site, program, and manufacturer.',
 category: 'Crew Outfitting',
 readTime: '8 min read',
 date: 'May 9, 2026',
 isoDate: '2026-05-09',
 image: '/images/generated/kit-electrical.jpg',
 slug: 'apprentice-journeyman-uniforms-differentiation',
}

const faqs = [
 { q: 'Why differentiate apprentices from journeymen visually?', a: 'An employer may use approved role identifiers to support recognition and training. Confirm the program rules in writing. Apparel does not replace supervision, qualifications, records, or task authorization.' },
 { q: 'What apprentice and journeyman shirt identifiers can an employer consider?', a: 'Options can include approved shirt colors, title embroidery, or year-level identifiers. The employer and apprenticeship program must confirm accurate titles, permissions, and workplace use.' },
 { q: 'Should apprentice shirts have year designation?', a: 'An employer may use a year designation if the apprenticeship program confirms it is accurate. Apparel does not replace training records, supervision, qualification checks, or task authorization.' },
 { q: 'Can a shirt say JOURNEYMAN?', a: 'Use a title only when the employer and applicable program confirm the wearer currently holds it. Document the approved wording before production.' },
 { q: 'Do non-union shops differentiate apprentices and journeymen?', a: 'Yes — merit shops use the same patterns. The titles might differ ("helper," "tech 1," "tech 2," "lead tech," "master tech") but the visual differentiation logic is identical. Service plumbing companies often use 3-5 tier programs with embroidered tier names on each shirt.' },
 { q: 'What hard hat colors are used for apprentices?', a: 'Hard-hat colors and identifiers vary by employer and site. The employer selects the exact helmet from its hazard assessment. Any marking requires current written manufacturer approval and must follow site policy.' },
 { q: 'How does this work with protective shirts?', a: 'The employer selects required protective apparel from its hazard assessment. Any identifier or decoration requires current written approval for the exact garment, materials, method, and placement.' },
 { q: 'Should apprentice apparel be a lower quality garment?', a: 'Choose each garment from the role, work, employer policy, hazard assessment, fit, care, and budget. Protective requirements apply to the wearer and task regardless of title.' },
]

const schema = {
 '@context': 'https://schema.org',
 '@graph': [
 { '@type': 'Article', headline: post.title, description: post.description, image: `https://bighornthreads.com${post.image}`, datePublished: post.isoDate, dateModified: '2026-08-21', author: { '@type': 'Organization', name: 'Bighorn Threads', url: 'https://bighornthreads.com/' }, publisher: { '@type': 'Organization', name: 'Bighorn Threads', logo: { '@type': 'ImageObject', url: 'https://bighornthreads.com/images/logos/bighorn-logo-color.png' } }, mainEntityOfPage: `https://bighornthreads.com/blog/${post.slug}/` },
 { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' }, { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bighornthreads.com/blog/' }, { '@type': 'ListItem', position: 3, name: post.title, item: `https://bighornthreads.com/blog/${post.slug}/` }] },
 { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
 ],
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: `https://bighornthreads.com/blog/${post.slug}/`,
 name: post.title,
 speakable: {
  '@type': 'SpeakableSpecification',
  cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout title={post.title} description={post.description} canonical={`https://bighornthreads.com/blog/${post.slug}/`} ogImage={post.image} type="article" publishedDate={post.isoDate}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
