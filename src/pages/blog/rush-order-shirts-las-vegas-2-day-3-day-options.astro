const post = {
 title: 'Rush Order Shirts in Las Vegas — What\'s Realistic and What Affects Speed',
 description:
 'What actually determines how fast a rush order of custom shirts can go in Las Vegas — artwork, blanks, decoration method, and quantity. What breaks a rush, and how to give yourself the best shot. Call us with your deadline.',
 category: 'Operational',
 readTime: '7 min read',
 date: 'May 9, 2026',
 isoDate: '2026-05-09',
 image: '/images/generated/service-screen-printing.jpg',
 slug: 'rush-order-shirts-las-vegas-2-day-3-day-options',
}

const faqs = [
 { q: 'What determines how fast a rush order can go?', a: 'Your spec does. Print-ready vector artwork, blanks already in stock, a decoration method that suits the job, and a quantity the press can handle all push a rush faster. Anything missing slows it down. Call us with the details and we\'ll tell you straight whether your timeline works.' },
 { q: 'Can I get custom shirts on a tight deadline in Las Vegas?', a: 'Often, yes — for smaller batches on stock blank tees with a print-ready vector logo, decorated with DTF or heat transfer vinyl. The fastest tier breaks down on embroidery, large quantities, unusual blanks, or complex multi-color screen printing. Send us the job and we\'ll give you a real answer.' },
 { q: 'How much does a rush order cost extra?', a: 'A rush surcharge may apply, and we quote it up front. What you pay depends on the spec and how much it disrupts the schedule. There are no surprise fees — you see the number before you approve.' },
 { q: 'What breaks a rush order?', a: 'Five things: (1) raster logos that need vectorizing, (2) embroidery without an existing digitized file, (3) blanks that aren\'t in local stock, (4) art revisions after approval, and (5) order quantity beyond press capacity for that decoration method. Each one adds time.' },
 { q: 'Can you embroider shirts on a rush?', a: 'It\'s harder. Embroidery needs a digitized stitch file (.DST, .EXP, .PES), and digitizing takes time unless we already have your file from a prior order. A fast embroidery turn is realistic mainly for repeat customers with a stored file. First-time embroidery needs more runway.' },
 { q: 'How do I give my rush the best shot?', a: 'Send print-ready vector artwork, confirm your blank and color early, lock the art so there are no revisions, and tell us the real deadline. The cleaner the spec, the faster we can move. Call us and we\'ll walk through it.' },
 { q: 'What\'s the largest rush order that\'s realistic?', a: 'It depends on the decoration method and press capacity. Small batches move fastest. Larger runs need more press time, and past a certain size the press only runs so fast — no surcharge changes that. Tell us your quantity and we\'ll tell you what\'s realistic.' },
 { q: 'Should I rush order or just plan ahead?', a: 'Plan ahead if you can. A possible rush surcharge, substitution risk on blanks, and fewer decoration options make rush orders more expensive and more constrained. Use rush when an event date is locked or a job pivots — not as your default. A standard run gives you full vendor and decoration options.' },
]

