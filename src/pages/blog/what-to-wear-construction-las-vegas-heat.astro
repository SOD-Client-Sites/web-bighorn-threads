const post = {
 title: 'What to Wear for Construction Work in Las Vegas Heat: Fabric, Color, Sun Protection, and PPE',
 description:
 'What should construction crews wear in Las Vegas heat? Lightweight, light-colored, loose-fitting clothing, UPF-rated long sleeves, and the lightest hi-vis or FR garment that meets the hazard. A workwear guide for Nevada summer job sites.',
 category: 'Compliance',
 readTime: '8 min read',
 date: 'November 11, 2026',
 isoDate: '2026-11-11',
 image: '/images/og-default.jpg',
 slug: 'what-to-wear-construction-las-vegas-heat',
}

const link = 'text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600'

const faqs = [
 { q: 'What should construction workers wear in Las Vegas heat?', a: 'OSHA advises lightweight, light-colored, loose-fitting clothing. In practice that means a vented, moisture-wicking long-sleeve shirt with a UPF rating, a hat or hard hat with a brim or shade attachment, and the lightest hi-vis or FR garment that still meets the hazard assessment.' },
 { q: 'Are long sleeves or short sleeves better in desert heat?', a: 'Light long sleeves usually work better outdoors in the Las Vegas sun. They block direct sun on the arms and cut sunburn risk. A thin, loose, wicking fabric keeps the trade-off small. Short sleeves can make sense in shaded or indoor work.' },
 { q: 'What does a UPF rating on a work shirt mean?', a: 'UPF measures how much ultraviolet radiation a fabric blocks. ASTM D6603 labeling groups UPF 15 to 24 as good, 25 to 39 as very good, and 40 to 50+ as excellent protection. A typical light cotton tee offers much less than a UPF-rated shirt.' },
 { q: 'Does Nevada law say what workers must wear in the heat?', a: 'Nevada\'s heat illness regulation, R131-24, requires covered employers to complete a written job hazard analysis for heat exposure and to address controls. It does not prescribe a specific shirt. Clothing choices belong in the employer\'s plan alongside water, rest, shade, and training.' },
 { q: 'Is there FR clothing made for hot weather?', a: 'Yes. Several brands make lighter-weight FR and arc-rated shirts with vented designs for hot climates. The arc rating or NFPA 2112 certification on the label still has to meet the hazard assessment. A lighter shirt that falls below the required rating is not a substitute.' },
 { q: 'Do cooling towels and vests replace a heat plan?', a: 'No. Cooling accessories can add comfort, but water, rest, shade, acclimatization, training, and emergency response remain the core of heat illness prevention. Clothing is one input, not the plan.' },
]

