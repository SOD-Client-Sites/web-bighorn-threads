---
import BaseLayout from '@/layouts/BaseLayout.astro'

const post = {
 title: 'How Many Shirts Should You Order Per Crew Member? A Vegas Planning Guide',
 description:
 'Plan branded shirt quantities for a Las Vegas construction crew by role, schedule, laundering, replacement policy, season, and budget.',
 category: 'Operations',
 readTime: '8 min read',
 date: 'Apr 14, 2026',
 isoDate: '2026-04-14',
 image: '/images/generated/workwear-flatlay.jpg',
 slug: 'how-many-shirts-per-crew-member-vegas',
}

const faqs = [
 { q: 'How many shirts should you order per construction crew member?', a: 'There is no universal quantity. Start with workdays between laundry cycles, role, garment policy, season, replacement process, and available budget. Build a roster-based estimate, then request current product and pricing options.' },
 { q: 'Is ordering only two shirts per crew member a mistake?', a: 'It may create a tight laundry rotation, but the right quantity depends on schedule, laundry access, garment care, and replacement policy. Review the exact garment manufacturer\'s care guidance.' },
 { q: 'How many shirts do foremen and office staff need?', a: 'Set quantities by each role\'s schedule, dress requirements, laundry cycle, and approved product list. Client-facing roles may need a different product mix from field roles.' },
 { q: 'How should you adjust shirt quantities for Vegas summer?', a: 'Review the employer\'s heat plan, work schedule, garment changes, laundering, and replacement needs. The employer must approve fabric, coverage, visibility, and sun-protection requirements.' },
 { q: 'How do you build crew turnover into an apparel order?', a: 'Use your hiring history and replacement policy to set a documented buffer. A proposed company store may support recurring orders, but products, inventory, fees, approvals, timing, and delivery depend on the written program.' },
 { q: 'How many garments does it take to outfit a 30-person Vegas crew for a year?', a: 'Build a role-based roster and multiply each approved item by the planned issue quantity. Add only the buffer supported by your hiring and replacement history. Product availability and pricing require a current quote.' },
]

const schema = {
 '@context': 'https://schema.org',
 '@graph': [
 {
 '@type': 'Article',
 headline: post.title,
 description: post.description,
 image: `https://bighornthreads.com${post.image}`,
 datePublished: post.isoDate,
 dateModified: '2026-08-21',
 author: { '@type': 'Organization', name: 'Bighorn Threads', url: 'https://bighornthreads.com/' },
 publisher: { '@type': 'Organization', name: 'Bighorn Threads', logo: { '@type': 'ImageObject', url: 'https://bighornthreads.com/images/logos/bighorn-logo-color.png' } },
 mainEntityOfPage: `https://bighornthreads.com/blog/${post.slug}/`,
 },
 {
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://bighornthreads.com/blog/' },
 { '@type': 'ListItem', position: 3, name: post.title, item: `https://bighornthreads.com/blog/${post.slug}/` },
 ],
 },
 {
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
 },
 {
 '@type': 'WebPage',
 url: `https://bighornthreads.com/blog/${post.slug}/`,
 speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.speakable-answer'] },
 },
 ],
}
---

<BaseLayout title={post.title} description={post.description} canonical={`https://bighornthreads.com/blog/${post.slug}/`} ogImage={post.image} type="article" publishedDate={post.isoDate}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />

 <article class="bg-concrete">
 <header class="border-b border-hairline bg-paper">

 <div class="relative mx-auto max-w-3xl px-4 pt-20 pb-12 sm:px-6 sm:pt-24 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2">/</span>
 <a href="/blog/" class="hover:text-gold-700">Blog</a>
 </nav>

 <span class="mb-3 inline-block text-xs font-bold uppercase tracking-[0.2em] text-gold-600">{post.category}</span>
 <h1 class="mb-6 font-heading text-3xl font-bold leading-tight tracking-tight sm:text-4xl lg:text-5xl">{post.title}</h1>
 <p class="mb-8 text-xl leading-relaxed text-ash">
 A planning worksheet for Las Vegas crews, organized by role, season, laundry cycle, replacement policy, and budget.
 </p>

 <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-hairline pt-6 font-mono text-sm text-ash">
 <span class="text-gold-600">Bighorn Threads Team</span>
 <span aria-hidden="true">&middot;</span>
 <span>{post.readTime}</span>
 <span aria-hidden="true">&middot;</span>
 <time datetime={post.isoDate}>{post.date}</time>
 </div>
 </div>
 </header>

 <div class="mx-auto max-w-4xl px-4 pt-10 sm:px-6 lg:px-8">
 <img src={post.image} alt="Stack of folded branded construction shirts in various sizes" width="1200" height="675" loading="eager" class="w-full border border-hairline object-cover" />
 </div>

 <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
 <aside class="mb-12 border border-hairline bg-panel p-6 lg:sticky lg:top-24">
 <h2 class="mb-4 font-mono text-xs font-bold uppercase tracking-[0.2em] text-gold-600">In this article</h2>
 <ol class="space-y-2 font-mono text-sm text-charcoal">
 <li><a href="#the-formula" class="hover:text-gold-700">1. Build a role-based estimate</a></li>
 <li><a href="#by-role" class="hover:text-gold-700">2. By role: field, foreman, office</a></li>
 <li><a href="#vegas-summer" class="hover:text-gold-700">3. Vegas summer adjustment</a></li>
 <li><a href="#turnover" class="hover:text-gold-700">4. Building in turnover</a></li>
 <li><a href="#actual-math" class="hover:text-gold-700">5. Build the roster worksheet</a></li>
 </ol>
 </aside>

 <p class="speakable-answer mb-6 text-lg leading-relaxed text-charcoal">
 The right quantity starts with one question: <em>how many garments does each role need between laundry cycles?</em> Add the work schedule, approved products, replacement policy, and roster before setting the order.
 </p>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 The example below is a worksheet, not a universal prescription. Adjust it to the employer's actual program.
 </p>

 <h2 id="the-formula" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">1. Build a Role-Based Starting Estimate</h2>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 A field-crew worksheet might review:
 </p>

 <ul class="mb-6 list-disc space-y-2 pl-6 text-lg leading-relaxed text-charcoal">
 <li><strong>Daily-wear tees or polos</strong> based on workdays and laundry access</li>
 <li><strong>Secondary garments</strong> based on employer-approved coverage and job needs</li>
 <li><strong>Outerwear</strong> based on role, season, and work conditions</li>
 </ul>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Document the assumptions behind each quantity. Include laundry frequency, garment changes, replacement approvals, and expected hiring.
 </p>

 <div class="my-10 border-l-4 border-gold-500 bg-gold-500/5 p-6">
 <p class="mb-2 font-mono text-xs font-bold uppercase tracking-[0.2em] text-gold-600">Reality check</p>
 <p class="text-lg leading-relaxed text-charcoal">
 A tight rotation may increase laundering and replacement frequency. The exact effect depends on the garment, use, care, and manufacturer guidance. Compare current quotes instead of assuming a fixed savings rate.
 </p>
 </div>

 <h2 id="by-role" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">2. By Role: Field, Foreman, Office</h2>

 <h3 class="mt-8 mb-3 font-heading text-xl font-bold">Field crew (laborers, journeymen, apprentices)</h3>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Review work tees, approved visibility layers, and weather garments. Compare manufacturer materials and care instructions for the actual work conditions.
 </p>

 <h3 class="mt-8 mb-3 font-heading text-xl font-bold">Foreman / Superintendent</h3>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Foremen may need client-facing polos, service shirts, or outerwear. Set quantities from their schedule and laundry cycle. Use employer-approved role identification where appropriate.
 </p>

 <h3 class="mt-8 mb-3 font-heading text-xl font-bold">Office / Project Manager</h3>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Office and project staff may need a smaller or different mix. Review their schedule, dress requirements, and ordering cadence.
 </p>

 <h2 id="vegas-summer" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">3. The Vegas Summer Adjustment</h2>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Vegas heat can change work schedules, garment changes, and laundry needs. The employer's heat plan and hazard assessment control apparel choices.
 </p>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Summer planning questions include:
 </p>

 <ul class="mb-6 list-disc space-y-2 pl-6 text-lg leading-relaxed text-charcoal">
 <li>How many garment changes does the employer's plan support?</li>
 <li>Which approved products meet coverage, visibility, and sun-protection requirements?</li>
 <li>How will the team handle laundering, damaged items, and seasonal layers?</li>
 </ul>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Compare the exact product's fabric, care, fit, and manufacturer performance data. The employer approves the final warm-weather garment.
 </p>

 <h2 id="turnover" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">4. Building Turnover Into the Order</h2>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Hiring and turnover can change the size mix. Use your own records to set a practical buffer.
 </p>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Two approaches work:
 </p>

 <h3 class="mt-8 mb-3 font-heading text-xl font-bold">Option A: Set a documented buffer</h3>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Review recent hiring, size distribution, replacement history, and product lead times. Use those records to set the buffer instead of a universal percentage.
 </p>

 <h3 class="mt-8 mb-3 font-heading text-xl font-bold">Option B: Request a company-store proposal</h3>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 A company store may present approved products and ordering rules. Inventory, payment, approvals, fees, timing, and delivery depend on the written setup. See <a href="/blog/company-store-vs-bulk-ordering/" class="text-gold-600 underline hover:text-gold-700">Bulk Ordering vs Company Store</a> for the comparison questions.
 </p>

 <h2 id="actual-math" class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">5. Build the Roster Worksheet</h2>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Separate the roster by role. For each role, document the approved products and planned issue quantity.
 </p>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 <strong>Field roles:</strong> roster count multiplied by each approved daily-wear, secondary, and outerwear quantity
 </p>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 <strong>Foreman roles:</strong> roster count multiplied by each approved client-facing and worksite garment
 </p>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 <strong>Office roles:</strong> roster count multiplied by each approved polo, service shirt, or outerwear quantity
 </p>

 <div class="my-10 border-l-4 border-gold-500 bg-gold-500/5 p-6">
 <p class="mb-2 font-mono text-xs font-bold uppercase tracking-[0.2em] text-gold-600">Total planned order</p>
 <p class="text-lg leading-relaxed text-charcoal">
 Add the role subtotals and only the buffer supported by your records. Your actual product mix, availability, decoration, delivery, and pricing require a current quote.
 </p>
 </div>

 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 For a more detailed breakdown by trade — electrical, roofing, plumbing — see our <a href="/industries/" class="text-gold-600 underline hover:text-gold-700">industries pages</a>. Each trade has a standard kit specific to the work and the gear we recommend by role.
 </p>

 <div class="my-12 border border-hairline bg-gold-500/5 p-8 text-center">
 <h3 class="mb-3 font-heading text-2xl font-bold text-charcoal">Need help speccing your crew's kit?</h3>
 <p class="mb-6 text-base text-ash">Send us your roster and we'll build out a recommended kit and a quote</p>
 <a href="/get-a-quote/" class="inline-flex min-h-[48px] items-center gap-2 bg-gold-500 px-7 py-3 text-base font-bold text-charcoal transition-all hover:bg-gold-600">Get a Quote</a>
 </div>

 <h2 class="mt-12 mb-4 font-heading text-3xl font-bold tracking-tight">The Short Version</h2>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Build quantities by role, laundry cycle, season, replacement policy, hiring history, and approved products. Treat any company store as a separate written proposal.
 </p>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">
 Review the plan throughout the year. Product availability, roster changes, and replacement needs can change.
 </p>

 <div class="mt-16 border border-hairline bg-panel p-6">
 <div class="flex items-start gap-4">
 <div class="flex h-14 w-14 shrink-0 items-center justify-center border border-hairline bg-gold-500/10">
 <span class="font-mono text-lg font-bold text-gold-600">BT</span>
 </div>
 <div>
 <p class="mb-1 font-heading text-lg font-bold text-charcoal">Bighorn Threads Team</p>
 <p class="text-sm leading-relaxed text-charcoal">Bighorn manages Las Vegas crew-apparel programs and coordinates production through selected partners. <a href="/industries/general-contractors-las-vegas/" class="text-gold-600 underline hover:text-gold-700">See general-contractor planning options.</a></p>
 </div>
 </div>
 </div>
 </div>
 </article>

 <section class="border-t border-hairline bg-panel py-16">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-bold tracking-tight sm:text-4xl">Spec your crew's kit. We'll build the order.</h2>
 <p class="mb-8 text-lg text-ash">Send your roster, we'll send back recommended kits and a quote.</p>
 <a href="/get-a-quote/" class="inline-flex min-h-[44px] items-center justify-center bg-gold-500 px-8 py-4 text-lg font-bold text-charcoal transition-all hover:bg-gold-600">Get a Quote</a>
 </div>
 </section>
</BaseLayout>
