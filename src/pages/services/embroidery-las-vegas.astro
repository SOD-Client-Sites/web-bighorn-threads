---
import HeroProducts from '@/components/HeroProducts.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Embroidery Las Vegas | Polos, Hats & Uniforms | Bighorn Threads',
 description:
 'Custom embroidery in Las Vegas for polos, hats, jackets, and uniforms. Logo digitizing, thread matching, and production through vetted partners, all confirmed in a written quote.',
}

const process = [
 { step: '01', title: 'Quote + file setup', body: 'Send your logo. We work with the partner on the embroidery file and put any setup cost in your quote.' },
 { step: '02', title: 'Proof + approval', body: 'You see a proof or sample, depending on the program, and approve it before production starts.' },
 { step: '03', title: 'Production handoff', body: 'The partner stitches what you approved: the garment, artwork, placement, and color.' },
 { step: '04', title: 'Final handoff', body: 'We go over finishing and delivery options with you before production starts.' },
]

const placements = [
 { name: 'Left chest', detail: 'The usual spot. Final width depends on the garment and logo.' },
 { name: 'Right chest', detail: 'Across from the left chest. Often used for a name next to the logo.' },
 { name: 'Sleeve', detail: 'Cap sleeve or full sleeve. Good for cert badges or a second logo.' },
 { name: 'Back yoke / center back', detail: 'For larger logos on jackets, hoodies, and outerwear.' },
 { name: 'Hat front', detail: 'How much room you get depends on the cap.' },
 { name: 'Hat side / back', detail: 'Smaller secondary marks on cap side panels or rear strap area.' },
]

const stitchTypes = [
 { count: 'Lower stitch count', label: 'Simple mark', notes: 'Bold shapes with little detail can take fewer stitches.' },
 { count: 'Moderate stitch count', label: 'Detailed mark', notes: 'Fine type, several colors, and complex shapes can add stitches.' },
 { count: 'Higher stitch count', label: 'Large or dense design', notes: 'Large placements and dense fills can add production time.' },
]

const faqs = [
 {
 q: 'What\'s the minimum order for embroidery?',
 a: 'Your quote lists the minimum for the garment and method. Send the quantity you need and we will quote the available options.',
 },
 {
 q: 'How much does digitizing cost?',
 a: 'Your quote lists any setup charge for your artwork, and whether the file can be reused on later orders.',
 },
 {
 q: 'Can you embroider on FR (flame-resistant) shirts without voiding the rating?',
 a: 'Only if the garment maker allows it. Send the exact shirt and your safety program’s requirements first, and we will check the maker’s instructions for thread, backing, and placement.',
 },
 {
 q: 'How long does an embroidery order take?',
 a: 'Quantity, stock, and artwork readiness decide it. Tell us your deadline and we will quote the schedule.',
 },
 {
 q: 'What thread colors can you match?',
 a: 'Send your brand colors and we will find the closest thread. Thread comes in set colors, so an exact match is not always possible, and the proof shows what you will get.',
 },
 {
 q: 'Do you do name embroidery for service uniforms?',
 a: 'Yes. Send a roster with spellings and we keep it with your order for reorders.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://bighornthreads.com/services/' },
 { '@type': 'ListItem', position: 3, name: 'Embroidery', item: 'https://bighornthreads.com/services/embroidery-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Embroidery in Las Vegas',
 serviceType: 'Embroidery on apparel and headwear',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/services/embroidery-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/services/" class="hover:text-gold-700">Services</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Embroidery</span>
 </nav>

 <p class="kicker mb-3">Service</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Custom embroidery in Las Vegas <span class="text-gold-700">on polos, hats, and service uniforms.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Left-chest logos, cap fronts, and name embroidery for Las Vegas teams, from construction crews to hospitality staff. Send your logo, garment, quantity, and deadline and we return a written quote. We manage approvals and reorders, and production partners do the stitching.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/services/screen-printing-las-vegas/" class="btn-secondary">
 Compare to Screen Printing
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Quick Answer — liftable -->
 <section class="border-b border-hairline bg-concrete py-12">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <aside class="border border-hairline bg-gold-500/5 p-7">
 <p class="mb-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gold-700">Quick Answer</p>
 <p class="text-lg leading-relaxed text-charcoal sm:text-xl">We handle the garment, artwork, proof, and reorders for Las Vegas crews. Your quote lists price, minimums, and timing, plus any setup or rush cost.</p>
 </aside>
 </div>
 </section>

 <!-- Process — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">From logo to delivery, step by step.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {process.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="mb-4 block font-mono text-xs font-bold tracking-wider text-gold-600">{p.step}</span>
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Placements — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Placements</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Where the logo goes.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 These work on most garments. Your proof shows exactly where the logo goes.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {placements.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{p.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Stitch counts — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Pricing Logic</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Stitch count can affect embroidery pricing.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Bigger or denser logos take more thread and machine time, so they can cost more.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-paper">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Stitches</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Category</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {stitchTypes.map((s) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-600">{s.count}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold uppercase tracking-tight text-charcoal">{s.label}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{s.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom embroidery for Las Vegas teams and crews: what makes a program work long-term.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-charcoal">
 <p>
Embroidery gives polos, work shirts, jackets, caps, and bags a stitched finish. The garment, thread, and backing set how it holds up. We handle the artwork and proof, and partners stitch what you approved. For staff shirts, see <a href="/custom-polo-shirts-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">polo shirt embroidery in Las Vegas</a>.
 </p>
 <p>
Digitizing turns your logo into stitch-by-stitch instructions for the machine. The file has to suit the garment, size, and placement, and we work it out with the partner. Your quote shows any setup fee and whether the file can be reused.
 </p>
 <p>
 Left chest, sleeve, back yoke, and cap are the common spots. The room you have varies by garment, and the proof shows the final size. Specialty techniques get their own quote.
 </p>
 <p>
 FR garments have stricter rules. Any embroidery must follow that garment maker's instructions and your company's safety program, and the thread, backing, and placement can all matter. Send us the spec first. We need a partner qualified for that work before we take the order.
 </p>
 <p>
 If you reorder the same gear, a company store keeps your approved garments and logos on file.
 </p>
 <p>
 For deeper reads, see <a href="/blog/what-is-embroidery-buyers-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">what is embroidery, buyer's guide</a> and <a href="/blog/how-much-to-embroider-a-shirt/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how much to embroider a shirt in Las Vegas</a>. On file prep: <a href="/blog/embroidery-file-formats-explained/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">embroidery file formats explained</a>, <a href="/blog/vector-logo-file-setup-for-embroidery/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">vector logo file setup</a>, and <a href="/blog/logo-digitizing-101-embroidery/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">logo digitizing 101</a>. Choosing methods? See <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">screen printing vs embroidery for construction crews</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Start With the Garment</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-hats-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Hats Las Vegas</h3>
 <p class="mt-2 text-sm text-ash">Richardson 112, Flexfit, New Era, and beanies with flat or puff embroidery.</p>
 </a>
 <a href="/custom-uniforms-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Uniforms</h3>
 <p class="mt-2 text-sm text-ash">Embroidered polos, work shirts, and scrubs by team.</p>
 </a>
 <a href="/custom-work-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Work Shirts</h3>
 <p class="mt-2 text-sm text-ash">Left-chest logo and name on industrial twill.</p>
 </a>
 </div>
 </div>
 </section>

 <NationalLinks heading='Ordering from outside Nevada?' links={[{ href: '/custom-polo-shirts/', label: 'Custom polo shirts' }, { href: '/custom-embroidered-hats/', label: 'Custom embroidered hats' }, { href: '/custom-quarter-zips-jackets/', label: 'Quarter-zips and jackets' }]} />
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Embroidery questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/screen-printing-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Screen Printing</h3>
 <p class="mt-2 text-sm text-ash">For volume t-shirt orders and bold graphic prints.</p>
 </a>
 <a href="/services/rush-orders-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Rush Orders</h3>
 <p class="mt-2 text-sm text-ash">Rush embroidery on repeat orders.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Embroidery vs Screen Print</h3>
 <p class="mt-2 text-sm text-ash">Decision guide for picking the right method.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to embroider your crew's gear?</h2>
 <p class="mb-8 text-lg text-white/80">Send your logo for a quote.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
