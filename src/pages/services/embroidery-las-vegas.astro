---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Embroidery in Las Vegas | Bighorn Threads',
 description:
 'Plan custom embroidery in Las Vegas for polos, hats, jackets, and uniforms. Bighorn coordinates approved artwork and production through selected partners.',
 hero: '/images/generated/service-embroidery.jpg',
}

const process = [
 { step: '01', title: 'Quote + file setup', body: 'Send your logo. We coordinate any production-ready embroidery file with the selected partner and confirm setup costs in your quote.' },
 { step: '02', title: 'Proof + approval', body: 'We coordinate the proof or sample step available for your program. You approve the documented result before production starts.' },
 { step: '03', title: 'Production handoff', body: 'The selected partner follows the approved garment, artwork, placement, and color specification.' },
 { step: '04', title: 'Final handoff', body: 'We confirm the finishing and delivery options available for the approved program before production starts.' },
]

const placements = [
 { name: 'Left chest', detail: 'A common option. Final width depends on the garment, artwork, and approved proof.' },
 { name: 'Right chest', detail: 'Mirror to LC, often used for name embroidery alongside left-chest logo.' },
 { name: 'Sleeve', detail: 'Cap sleeve or full sleeve. Good for cert badges or secondary brand marks.' },
 { name: 'Back yoke / center back', detail: 'For larger logos on jackets, hoodies, and outerwear.' },
 { name: 'Hat front', detail: 'Available space depends on the cap construction and approved production file.' },
 { name: 'Hat side / back', detail: 'Smaller secondary marks on cap side panels or rear strap area.' },
]

const stitchTypes = [
 { count: 'Lower stitch count', label: 'Simple mark', notes: 'Bold shapes and limited detail may require fewer stitches. Quote required.' },
 { count: 'Moderate stitch count', label: 'Detailed mark', notes: 'Fine type, multiple colors, and complex shapes can add stitches. Quote required.' },
 { count: 'Higher stitch count', label: 'Large or dense design', notes: 'Large placements and dense fills can add production time. Quote required.' },
]

const faqs = [
 {
 q: 'What\'s the minimum order for embroidery?',
 a: 'Minimums depend on the garment, decoration method, and selected production partner. Send the quantity you need and we will quote the available options.',
 },
 {
 q: 'How much does digitizing cost?',
 a: 'Setup costs depend on the artwork and selected production partner. The quote confirms file preparation, setup, reuse, and retention terms for the approved program.',
 },
 {
 q: 'Can you embroider on FR (flame-resistant) shirts without voiding the rating?',
 a: 'Protective apparel must follow the exact garment manufacturer\'s current instructions and the employer\'s safety program. We coordinate only after those requirements and the selected partner\'s qualifications are confirmed.',
 },
 {
 q: 'How long does an embroidery order take?',
 a: 'It depends on quantity, garment availability, artwork readiness, production capacity, and delivery. Tell us your deadline and we will quote the schedule the selected partner can support.',
 },
 {
 q: 'What thread colors can you match?',
 a: 'Available thread colors and color-matching tolerances depend on the selected production partner. The proof documents the approved color specification for that order.',
 },
 {
 q: 'Do you do name embroidery for service uniforms?',
 a: 'Name and title embroidery can be quoted when the selected partner supports it. We can organize the approved roster and placement details for managed reorders.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://bighornthreads.com/services/' },
 { '@type': 'ListItem', position: 3, name: 'Embroidery', item: 'https://bighornthreads.com/services/embroidery-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Embroidery in Las Vegas',
 serviceType: 'Embroidery on apparel and headwear',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/services/embroidery-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/45"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/services/" class="hover:text-gold-400">Services</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Embroidery</span>
 </nav>

 <p class="kicker mb-3">Service</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom Embroidery <span class="text-gold-400">on Polos, Hats, and Service Uniforms.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Managed locally through selected production partners. Minimums, color matching, timing, and protective-apparel requirements are confirmed in your quote.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/services/screen-printing-las-vegas/" class="inline-flex min-h-[48px] items-center gap-2 border border-gold-500 px-6 py-3 font-subheading text-sm font-semibold uppercase tracking-wide text-gold-400 transition-colors hover:bg-gold-500 hover:text-charcoal">
 Compare to Screen Printing
 </a>
 </div>
 </div>
 </section>

 <!-- Quick Answer — liftable -->
 <section class="border-b border-hairline bg-concrete py-12">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <aside class="border border-hairline bg-gold-500/5 p-7">
 <p class="mb-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gold-700">Quick Answer</p>
 <p class="text-lg leading-relaxed text-charcoal sm:text-xl">Bighorn Threads manages custom embroidery programs for Las Vegas construction crews through selected production partners. We coordinate the garment, approved artwork, proof, production handoff, and reorder specification. Minimums, setup costs, rush options, and protective-apparel requirements are confirmed for each program.</p>
 </aside>
 </div>
 </section>

 <!-- Process — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">From logo to delivery, step by step.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {process.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="mb-4 block font-mono text-xs font-bold tracking-wider text-gold-600">{p.step}</span>
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Placements — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Placements</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Where the logo goes.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Common placements that work across many garments. We will document the approved position in your proof and production specification.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {placements.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{p.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Stitch counts — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Pricing Logic</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Stitch count can affect embroidery pricing.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Bigger or denser logos can require more thread and machine time. The partner confirms the production file and price in writing.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-paper">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Stitches</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Category</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {stitchTypes.map((s) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-600">{s.count}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold uppercase tracking-tight text-charcoal">{s.label}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{s.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom embroidery for Las Vegas teams and crews — what makes a program work long-term.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-charcoal">
 <p>
Embroidery gives polos, work shirts, jackets, caps, and bags a stitched finish. Suitability and care depend on the exact garment, thread, backing, and decoration specification. Bighorn Threads coordinates approved artwork and production through selected partners. Each order follows the written proof and quote.
 </p>
 <p>
Digitizing converts approved artwork into stitch-by-stitch production instructions. The file must account for the garment, size, thread, backing, and placement. Bighorn coordinates file preparation with the selected partner. The quote confirms any setup, reuse, and retention terms.
 </p>
 <p>
 Left chest, sleeve, back yoke, and cap placements are common options. The available area varies by garment construction and size. The selected partner confirms dimensions in the proof. Specialty techniques require a separate written quote.
 </p>
 <p>
 For FR-rated garments, every modification must follow the exact manufacturer's current instructions and the employer's safety program. Thread, backing, placement, and the complete decoration system can matter. We require the relevant specification and a production partner qualified for that work before coordinating a protective-apparel order.
 </p>
 <p>
 For long-term programs, a proposed store could organize approved garments and decoration specifications if the selected platform and configuration do. No platform has been selected or launched. Sizing profiles, allowances, minimums, pricing, fulfillment, reorder terms, and implementation require separate written approval.
 </p>
 <p>
 For deeper reads, see <a href="/blog/what-is-embroidery-buyers-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">what is embroidery — buyer's guide</a> and <a href="/blog/how-much-to-embroider-a-shirt/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how much to embroider a shirt in Las Vegas</a>. On file prep: <a href="/blog/embroidery-file-formats-explained/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">embroidery file formats explained</a>, <a href="/blog/vector-logo-file-setup-for-embroidery/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">vector logo file setup</a>, and <a href="/blog/logo-digitizing-101-embroidery/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">logo digitizing 101</a>. Choosing methods? See <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">screen printing vs embroidery for construction crews</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Embroidery questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/screen-printing-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Screen Printing</h3>
 <p class="mt-2 text-sm text-ash">For volume t-shirt orders and bold graphic prints.</p>
 </a>
 <a href="/services/rush-orders-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Rush Orders</h3>
 <p class="mt-2 text-sm text-ash">rush embroidery on repeat orders.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Embroidery vs Screen Print</h3>
 <p class="mt-2 text-sm text-ash">Decision guide for picking the right method.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to embroider your crew's gear?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo for a quote.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
