---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import NationalLinks from '@/components/NationalLinks.astro'

const page = {
 title: 'Custom Screen Printing Las Vegas | T-Shirt Printing for Crews | Bighorn Threads',
 description:
 'Custom screen printing in Las Vegas for crews, teams, and events. Send artwork, garment, quantity, and deadline for a written quote; production runs through vetted local partners.',
}

const process = [
 { step: '01', title: 'Quote + artwork', body: 'Send your logo, garment needs, quantities, and deadline. We put the order together for you to review.' },
 { step: '02', title: 'Proof + approval', body: 'Check the product, artwork, print method, timing, and price, then approve the order.' },
 { step: '03', title: 'Partner production', body: 'Our partner prints what you approved. We stay your contact.' },
 { step: '04', title: 'Order completion', body: 'We finish the steps listed in your quote and help when it\'s time to reorder.' },
]

const inkTypes = [
 { name: 'Plastisol', best: 'Bold, punchy graphics on cotton or blended tees. Most jobs.', notes: 'Sits on top of the fabric. Bright, opaque, durable through rough use.' },
 { name: 'Water-based', best: 'Soft hand-feel, vintage / faded look, super-soft tees.', notes: 'Sinks into the fabric. Slightly less opaque on dark garments. Premium feel.' },
 { name: 'Discharge', best: 'Dark cotton tees where you want zero ink feel.', notes: 'Removes the dye and replaces it with new color. Cotton only. Soft as untreated.' },
 { name: 'Synthetic-compatible', best: 'Polyester and nylon performance garments that can take this ink.', notes: 'The garment and ink have to be checked together before printing.' },
]

const garments = ['T-shirts (cotton + blends)', 'Long-sleeve tees', 'Hoodies + crewnecks', 'Compatible polyester garments', 'Tote bags + canvas', 'Compatible workwear', 'Polos with suitable print areas']

const minimums = [
 { count: 'Quantity', best: 'Your quote lists the minimum.' },
 { count: 'Artwork', best: 'Each color and print location adds to the job.' },
 { count: 'Garment', best: 'Fabric, color, and construction decide which print approach fits.' },
 { count: 'Timing', best: 'We give you a date once we\'ve reviewed the whole order.' },
]

const faqs = [
 {
 q: 'What\'s the minimum order for screen printing?',
 a: 'Screens take setup, so printing has a higher minimum than embroidery or DTF. Send the garment, your logo, and a rough count, and we\'ll give you the number.',
 },
 {
 q: 'How much does screen printing cost?',
 a: 'The garment, quantity, number of colors, and print locations set the cost. Send your garment choice, quantity, and artwork, and Bighorn will return a written quote.',
 },
 {
 q: 'How fast can you turn around a rush order?',
 a: 'Send your date first. We check garment stock and press time, then tell you if it works and what a rush would cost.',
 },
 {
 q: 'Can you Pantone-match exact brand colors?',
 a: 'Send the Pantone number with your artwork. Ink mixes closely on most garments, and we\'ll tell you if the fabric color will shift it.',
 },
 {
 q: 'Do you screen print on FR (flame-resistant) shirts?',
 a: 'Sometimes. Your safety lead picks the garment, and the maker has to allow printing on it. Many FR programs use embroidery instead. Send us the exact shirt.',
 },
 {
 q: 'How many colors can you print in one job?',
 a: 'Each color needs its own screen, so more colors cost more. If your logo has many colors or gradients, we may suggest DTF instead.',
 },
 {
 q: 'Will the print last?',
 a: 'A properly cured print on a good shirt lasts a long time. Washing cold and skipping the hot dryer helps, and hard jobsite use wears out any print faster.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://bighornthreads.com/services/' },
 { '@type': 'ListItem', position: 3, name: 'Screen Printing', item: 'https://bighornthreads.com/services/screen-printing-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Screen Printing in Las Vegas',
 serviceType: 'Screen printing on apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/services/screen-printing-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/services/" class="hover:text-gold-700">Services</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Screen Printing</span>
 </nav>

 <p class="kicker mb-3">Service</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Custom screen printing in Las Vegas <span class="text-gold-700">for crews, teams &amp; contractors.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Bulk tees, hi-vis, and work shirts with your logo. Send your artwork, garment needs, quantity, and deadline for a written quote.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/services/embroidery-las-vegas/" class="btn-secondary">
 Compare to Embroidery
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Quick Answer — liftable -->
 <section class="border-b border-hairline bg-concrete py-12">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <aside class="border border-hairline bg-gold-500/5 p-7">
 <p class="mb-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gold-700">Quick Answer</p>
 <p class="text-lg leading-relaxed text-charcoal sm:text-xl">We run custom screen printing orders for Las Vegas crews, contractors, and teams. Production partners do the printing. We handle the artwork, proof, quote, and reorders.</p>
 </aside>
 </div>
 </section>

 <!-- Choosing a screen printer — answer-first -->
 <section class="border-b border-hairline bg-paper py-16">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight text-charcoal sm:text-3xl">What should you look for in a screen printing company?</h2>
 <p class="mb-6 text-lg leading-relaxed text-charcoal">Look for a written quote that spells out the garment, ink, colors, print locations, setup, and unit price. You should approve a proof before anything prints. Ask who does the printing, whether they can make your date, and whether they keep your artwork on file for reorders.</p>
 <ul class="space-y-3 text-base leading-relaxed text-ash">
 <li><strong class="text-charcoal">Written terms.</strong> Your quote lists price, minimums, and timing before you approve.</li>
 <li><strong class="text-charcoal">Proof first.</strong> You check the product, artwork, and method before production.</li>
 <li><strong class="text-charcoal">One contact.</strong> You call us, even though a partner runs the press.</li>
 <li><strong class="text-charcoal">Right ink for the garment.</strong> Plastisol, water-based, discharge, and synthetic-compatible inks each suit different fabrics.</li>
 </ul>
 <p class="mt-6 text-base leading-relaxed text-ash">For a longer checklist, read the <a href="/blog/screen-printing-shop-las-vegas-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">screen printing shop Las Vegas guide</a> and <a href="/how-to-choose-custom-apparel-company/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how to choose a custom apparel company</a>.</p>
 </div>
 </section>

 <!-- Process — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">From quote to completion, step by step.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {process.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="mb-4 block font-mono text-xs font-bold tracking-wider text-gold-600">{p.step}</span>
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Ink types — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Ink Selection</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Four ink families. We pick the one that fits the job.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 These are the common ink types. What's available depends on the garment, artwork, use, and partner.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {inkTypes.map((ink) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">{ink.name}</h3>
 <p class="mb-3 text-sm leading-relaxed text-gold-600">Best for: {ink.best}</p>
 <p class="text-sm leading-relaxed text-ash">{ink.notes}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Garments + Minimums — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Garments</p>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">What can be screen printed.</h2>
 <p class="mb-6 text-lg leading-relaxed text-ash">
 Cotton, blends, and some synthetics can all be printed. We check your garment when we review the order.
 </p>
 <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
 {garments.map((g) => (
 <li class="flex items-start gap-2 text-sm text-ash">
 <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 bg-gold-500"></span>
 {g}
 </li>
 ))}
 </ul>
 </div>

 <div>
 <p class="kicker mb-3">Minimums &amp; Pricing</p>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Built around real order sizes.</h2>
 <div class="space-y-3">
 {minimums.map((m) => (
 <div class="border border-hairline bg-panel p-4">
 <span class="mb-1 block font-mono text-sm font-bold text-gold-600">{m.count}</span>
 <p class="text-sm text-ash">{m.best}</p>
 </div>
 ))}
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom screen printing for Las Vegas trades, crews, and brand programs.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-charcoal">
 <p>
 Screen printing fits shirts, hoodies, and sweatshirts when the artwork suits the method. Cost comes down to the garment, quantity, colors, and print locations.
 </p>
 <p>
 Plastisol sits on top of the fabric and can print opaque. Water-based ink soaks into the fabric for a softer feel. Discharge only works on certain dyed cottons.
 </p>
 <p>
 Artwork, colors, and print locations set the setup. We check every reorder again, since garment stock and production needs can change.
 </p>
 <p>
 Construction crews often pick heavier work tees for daily wear. Hi-vis and FR take more checking. Your company picks the garment, and any print needs approval from your company and the manufacturer. Send us the garment spec and jobsite rules before you order.
 </p>
 <p>
 If you have a fixed event or start date, tell us up front. We'll check garment stock and partner capacity against it.
 </p>
 <p>
 New to the method? Read <a href="/blog/what-is-screen-printing/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">what is screen printing, primer</a>. On ink choice: <a href="/blog/plastisol-vs-water-based-ink-workwear/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">plastisol vs water-based ink for workwear</a> and <a href="/blog/dtf-printing-vs-screen-printing-custom-apparel/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">DTF vs screen printing</a>. On other methods: <a href="/blog/sublimation-printing-custom-apparel-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">sublimation printing, when it fits</a>, <a href="/dtf-printing-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">direct-to-film transfers</a> for small full-color runs, and the broader <a href="/blog/screen-printing-shop-las-vegas-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">screen printing shop Las Vegas guide</a>. On order size: <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">minimum order quantities</a>. On cost: <a href="/cost-custom-apparel-team-of-50/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">cost of custom apparel for a team of 50</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Start With the Garment</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-t-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom T-Shirts Las Vegas</h3>
 <p class="mt-2 text-sm text-ash">Blanks, methods, and pricing for crews, events, and teams.</p>
 </a>
 <a href="/custom-work-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Work Shirts</h3>
 <p class="mt-2 text-sm text-ash">Printed and embroidered work shirts for trade crews.</p>
 </a>
 <a href="/custom-uniforms-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Uniforms</h3>
 <p class="mt-2 text-sm text-ash">Owned uniform programs for every department.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Screen printing questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">When you want stitched logos for polos, hats, and outerwear.</p>
 </a>
 <a href="/services/rush-orders-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Rush Orders</h3>
 <p class="mt-2 text-sm text-ash">Have a fixed date? Ask us if it can be done.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which is right for construction gear?</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Send your logo, get a quote back.</h2>
 <p class="mb-8 text-lg text-white/80">Send your artwork, quantities, garment needs, and deadline.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
 <NationalLinks heading='Related product guides' links={[{ href: '/custom-screen-printed-shirts/', label: 'Custom screen printed shirts' }, { href: '/custom-hoodies/', label: 'Custom logo hoodies' }]} />
</BaseLayout>
