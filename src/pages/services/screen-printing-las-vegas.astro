---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Screen Printing in Las Vegas | Bighorn Threads',
 description:
 'Plan custom screen printing for Las Vegas crews and teams. Bighorn coordinates garments, artwork, proofs, order details, and production through partners.',
 hero: '/images/generated/service-screen-printing.jpg',
}

const process = [
 { step: '01', title: 'Quote + artwork', body: 'Send your logo, garment needs, quantities, and deadline. Bighorn prepares the order for review.' },
 { step: '02', title: 'Proof + approval', body: 'Review the product, artwork, decoration method, timing, and commercial terms before approving the order.' },
 { step: '03', title: 'Partner production', body: 'A production partner performs the approved screen printing. Bighorn remains your account contact.' },
 { step: '04', title: 'Order completion', body: 'Bighorn coordinates the completion steps documented in your quote and provides reorder support.' },
]

const inkTypes = [
 { name: 'Plastisol', best: 'Bold, punchy graphics on cotton or blended tees. Most jobs.', notes: 'Sits on top of the fabric. Bright, opaque, durable through rough use.' },
 { name: 'Water-based', best: 'Soft hand-feel, vintage / faded look, super-soft tees.', notes: 'Sinks into the fabric. Slightly less opaque on dark garments. Premium feel.' },
 { name: 'Discharge', best: 'Dark cotton tees where you want zero ink feel.', notes: 'Removes the dye and replaces it with new color. Cotton only. Soft as untreated.' },
 { name: 'Synthetic-compatible', best: 'Compatible performance polyester and nylon garments.', notes: 'The garment and ink system must be reviewed together before production.' },
]

const garments = ['T-shirts (cotton + blends)', 'Long-sleeve tees', 'Hoodies + crewnecks', 'Compatible polyester garments', 'Tote bags + canvas', 'Compatible workwear', 'Polos with suitable print areas']

const minimums = [
 { count: 'Quantity', best: 'Minimums depend on the garment, artwork, decoration, and production partner.' },
 { count: 'Artwork', best: 'Each color and print location affects the production specification.' },
 { count: 'Garment', best: 'Fabric, color, and construction determine which print approach fits.' },
 { count: 'Timing', best: 'Current production timing is confirmed after the complete order review.' },
]

const faqs = [
 {
 q: 'What\'s the minimum order for screen printing?',
 a: 'Minimums depend on the garment, artwork, print locations, quantity, and production partner. Bighorn confirms the current minimum in your quote.',
 },
 {
 q: 'How fast can you turn around a rush order?',
 a: 'Send your complete order and required date. Bighorn will confirm current timing and any related terms before you approve the order.',
 },
 {
 q: 'Can you Pantone-match exact brand colors?',
 a: 'Include the required Pantone reference with your artwork. Bighorn will confirm the available color-matching approach with the production partner before approval.',
 },
 {
 q: 'Do you screen print on FR (flame-resistant) shirts?',
 a: 'The employer must select the exact protective garment. Current manufacturer and employer approval for the proposed decoration method, materials, and placement is required before production.',
 },
 {
 q: 'How many colors can you print in one job?',
 a: 'Color capacity depends on the artwork, garment, print locations, and production partner. Bighorn will recommend an available method before you approve the order.',
 },
 {
 q: 'Will the print last?',
 a: 'Print life depends on the garment, ink system, use, and care. Share how the apparel will be worn and washed so Bighorn can recommend an appropriate option.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://bighornthreads.com/services/' },
 { '@type': 'ListItem', position: 3, name: 'Screen Printing', item: 'https://bighornthreads.com/services/screen-printing-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Screen Printing in Las Vegas',
 serviceType: 'Screen printing on apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/services/screen-printing-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/45"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/services/" class="hover:text-gold-400">Services</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Screen Printing</span>
 </nav>

 <p class="kicker mb-3">Service</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom Screen Printing <span class="text-gold-400">for Vegas Teams, Crews & Contractors.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn coordinates screen-printed apparel through production partners. Send your artwork, garment needs, quantity, and deadline for an order-specific quote.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/services/embroidery-las-vegas/" class="inline-flex min-h-[48px] items-center gap-2 border border-gold-500 px-6 py-3 font-subheading text-sm font-semibold uppercase tracking-wide text-gold-400 transition-colors hover:bg-gold-500 hover:text-charcoal">
 Compare to Embroidery
 </a>
 </div>
 </div>
 </section>

 <!-- Quick Answer — liftable -->
 <section class="border-b border-hairline bg-concrete py-12">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <aside class="border border-hairline bg-gold-500/5 p-7">
 <p class="mb-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gold-700">Quick Answer</p>
 <p class="text-lg leading-relaxed text-charcoal sm:text-xl">Bighorn Threads coordinates custom screen printing for Las Vegas crews, contractors, and teams. Production partners perform the approved printing. Bighorn manages the artwork, proof, quote, order, and reorder communication.</p>
 </aside>
 </div>
 </section>

 <!-- Process — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">From quote to completion, step by step.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {process.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="mb-4 block font-mono text-xs font-bold tracking-wider text-gold-600">{p.step}</span>
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Ink types — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Ink Selection</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Four ink families. We pick the one that fits the job.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 These are common screen-printing ink families. Available options depend on the garment, artwork, intended use, and production partner.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {inkTypes.map((ink) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">{ink.name}</h3>
 <p class="mb-3 text-sm leading-relaxed text-gold-600">Best for: {ink.best}</p>
 <p class="text-sm leading-relaxed text-ash">{ink.notes}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Garments + Minimums — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Garments</p>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">What can be screen printed.</h2>
 <p class="mb-6 text-lg leading-relaxed text-ash">
 Cotton, blends, and compatible synthetics can suit different screen-printing needs. Bighorn confirms garment suitability during the order review.
 </p>
 <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
 {garments.map((g) => (
 <li class="flex items-start gap-2 text-sm text-ash">
 <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 bg-gold-500"></span>
 {g}
 </li>
 ))}
 </ul>
 </div>

 <div>
 <p class="kicker mb-3">Minimums &amp; Pricing</p>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Built around real order sizes.</h2>
 <div class="space-y-3">
 {minimums.map((m) => (
 <div class="border border-hairline bg-panel p-4">
 <span class="mb-1 block font-mono text-sm font-bold text-gold-600">{m.count}</span>
 <p class="text-sm text-ash">{m.best}</p>
 </div>
 ))}
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom screen printing for Las Vegas trades, crews, and brand programs.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-charcoal">
 <p>
 Screen printing can fit shirts, hoodies, sweatshirts, and other compatible garments with artwork designed for the method. Cost depends on the garment, quantity, colors, and print locations. Bighorn coordinates the approved order through a production partner and confirms current terms in writing.
 </p>
 <p>
 The right ink type depends on the garment, artwork, intended use, and desired feel. Plastisol sits on top of the fabric and can produce an opaque print. Water-based ink penetrates compatible fabric for a softer feel. Discharge is limited to compatible dyed cotton. Available ink systems are confirmed for the specific order.
 </p>
 <p>
 Screen-printing setup depends on the artwork, number of colors, and print locations. Bighorn includes the applicable production terms in the quote. Reorders receive a current review because garment availability and production requirements can change.
 </p>
 <p>
 Construction crews often choose heavier work tees for daily use. Safety-rated garments require additional review. Send the approved garment specification, jobsite requirements, and decoration request before ordering hi-vis or FR apparel.
 </p>
 <p>
 If your order has a fixed event or start date, include it with the first inquiry. Bighorn confirms garment availability, partner capacity, timing, and completion terms after reviewing the complete order.
 </p>
 <p>
 New to the method? Read <a href="/blog/what-is-screen-printing/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">what is screen printing — primer</a>. On ink choice: <a href="/blog/plastisol-vs-water-based-ink-workwear/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">plastisol vs water-based ink for workwear</a> and <a href="/blog/dtf-printing-vs-screen-printing-custom-apparel/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">DTF vs screen printing</a>. On other methods: <a href="/blog/sublimation-printing-custom-apparel-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">sublimation printing — when it fits</a> and the broader <a href="/blog/screen-printing-shop-las-vegas-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">screen printing shop Las Vegas guide</a>. On order size: <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">minimum order quantities</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Screen printing questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">When you want stitched logos for polos, hats, and outerwear.</p>
 </a>
 <a href="/services/rush-orders-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Rush Orders</h3>
 <p class="mt-2 text-sm text-ash">Have a fixed date? Ask us to review the order and confirm timing.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which is right for construction gear?</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Send your logo, get a quote back.</h2>
 <p class="mb-8 text-lg text-navy-200">Send your artwork, quantities, garment needs, and deadline.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
