---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Rush Custom Apparel in Las Vegas | Bighorn Threads',
 description:
 'Ask about a rush apparel order in Las Vegas. Bighorn checks product availability, partner capacity, timing, and rush costs before you approve the quote.',
}

const factors = [
 { title: 'Product availability', desc: 'Stock depends on the supplier. Specialty products and unusual colors can add time.' },
 { title: 'Decoration method', desc: 'Each method has its own setup, quantity, and capacity limits. The partner tells us what fits your date.' },
 { title: 'Artwork readiness', desc: 'Print-ready vector art on file is fastest. New artwork that needs vectorizing or digitizing adds time before production starts.' },
 { title: 'Order size and complexity', desc: 'One color in one location is quicker than several colors in several locations. Large quantities and mixed methods take longer.' },
]

const eligible = [
 { yes: true, item: 'Simple apparel orders when the product is available and the partner has room' },
 { yes: true, item: 'Repeat orders with approved artwork already on file' },
 { yes: true, item: 'Common garment styles the supplier has in stock' },
 { yes: true, item: 'One decoration location with a ready file' },
 { yes: false, item: 'Protective apparel without employer and manufacturer approval' },
 { yes: false, item: 'Specialty fabrics requiring custom ink' },
 { yes: false, item: 'Multi-process jobs (screen + embroidery + DTF combined)' },
 { yes: false, item: 'Items not on hand requiring multi-day shipping from supplier' },
]

const faqs = [
 {
 q: 'Do you charge a rush fee?',
 a: 'Sometimes. Any rush fee depends on the selected partner and requested schedule. We include it in the quote before you approve the order.',
 },
 {
 q: 'Can you rush orders with new artwork?',
 a: 'Possibly. New artwork can add production-file and proofing time. We confirm the available schedule with the selected partner before you approve it.',
 },
 {
 q: 'What makes a rush embroidery order different from screen printing?',
 a: 'Embroidery needs a digitized stitch file before anything can be sewn. A new logo adds digitizing and proofing time before stitching starts, so an approved digitized logo already on file is usually the fastest path to a rush embroidery slot. We confirm the selected partner\'s embroidery capacity the same way as any other method before quoting a schedule. See custom embroidery in Las Vegas for how embroidery orders run.',
 html: 'Embroidery needs a digitized stitch file before anything can be sewn. A new logo adds digitizing and proofing time before stitching starts, so an approved digitized logo already on file is usually the fastest path to a rush embroidery slot. We confirm the selected partner\'s embroidery capacity the same way as any other method before quoting a schedule. See <a href="/services/embroidery-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">custom embroidery in Las Vegas</a> for how embroidery orders run.',
 },
 {
 q: 'How big can a rush order be?',
 a: 'It depends on the garment, artwork, quantity, decoration method, partner capacity, and delivery path. Send the full specification and we will quote what is currently available.',
 },
 {
 q: 'What if my deadline is impossible?',
 a: 'We will not promise an unconfirmed date. If the requested schedule is unavailable, we can quote a different product, method, delivery plan, or split schedule when a partner supports it.',
 },
 {
 q: 'Will rush production lower the quality?',
 a: 'A rush should not change the approved specification. We confirm the selected partner, proof, and available quality controls before you approve production.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://bighornthreads.com/services/' },
 { '@type': 'ListItem', position: 3, name: 'Rush Orders', item: 'https://bighornthreads.com/services/rush-orders-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Rush Custom Apparel Production',
 serviceType: 'Rush screen printing and embroidery',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/services/rush-orders-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/services/" class="hover:text-gold-700">Services</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Rush Orders</span>
 </nav>

 <p class="kicker mb-3">Service</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Rush Custom Apparel <span class="text-gold-700">With Terms Confirmed Up Front.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Tell us your deadline, your spec, and your quantity. We'll tell you straight whether it works, what it costs, and any rush surcharge before you commit.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="tel:+17029048923" class="btn-primary text-base">
 Call Now: 702.904.8923
 </a>
 <a href="/contact/" class="btn-secondary">
 Submit Rush Quote
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Factors — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What Drives Turnaround</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Four things that decide what's possible.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Every rush quote comes down to these. Send us the details and we can give you a real answer.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {factors.map((f) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">{f.title}</h3>
 <p class="text-base leading-relaxed text-ash">{f.desc}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- What works rush — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What Fits Rush</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">What we can and can't turn fast.</h2>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <ul class="divide-y divide-hairline">
 {eligible.map((e) => (
 <li class="flex items-start gap-4 px-6 py-4">
 <span class={e.yes ? 'mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center bg-gold-500/15 text-gold-700' : 'mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center bg-paper text-ash'}>
 {e.yes ? (
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
 ) : (
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
 )}
 </span>
 <span class={e.yes ? 'text-base text-charcoal' : 'text-base text-ash line-through decoration-hairline'}>{e.item}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Rush custom apparel orders in Las Vegas: what's actually possible, and what isn't.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-charcoal">
 <p>
 Rush orders are normal in the Las Vegas trades. Trade shows hand out booth assignments weeks before the event. Ribbon cuttings move around. New hires show up Monday for a job quoted Friday. We'll tell you what's realistic when you ask, so you don't find out the day before delivery.
 </p>
 <p>
 What decides it is supplier stock, partner capacity, decoration method, artwork, quantity, and delivery. Common products can move faster once we know they're in stock. Specialty products and protective apparel often take longer.
 </p>
 <p>
 Call us with the deadline, quantity, artwork, garment, decoration method, and destination. We'll check with the partner and quote your options and any rush cost before you commit.
 </p>
 <p>
 We can't promise a rush until we've checked the artwork, stock, partner capacity, and shipping. Repeat orders can move faster when the approved artwork is on file. Your quote gives the date the partner can support.
 </p>
 <p>
 If deadlines are a constant problem, a company store can cut repeated setup work. We keep your approved specs together and handle each order with the partner.
 </p>
 <p>
 For more, see <a href="/blog/rush-order-shirts-las-vegas-whats-possible/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">rush order shirts in Las Vegas, what's actually possible</a>. And for a common rush use case, our <a href="/blog/trade-show-apparel-booth-crew/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">trade show apparel for booth crews</a> guide covers what to ship and when.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Rush order questions.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 {f.html ? <p class="pb-5 text-base leading-relaxed text-ash" set:html={f.html} /> : <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>}
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/screen-printing-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Screen Printing</h3>
<p class="mt-2 text-sm text-ash">Ink and garment options, with timing in your quote.</p>
 </a>
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Embroidery</h3>
<p class="mt-2 text-sm text-ash">How embroidery setup affects a rush.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">For GCs</h3>
<p class="mt-2 text-sm text-ash">Crew uniforms and onboarding kits with quoted timing.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Got a deadline? Pick up the phone.</h2>
 <p class="mb-8 text-lg text-white/80">We'll tell you what can make your date and quote any rush charge up front.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="tel:+17029048923" class="btn-primary text-base">Call 702.904.8923</a>
 <a href="/get-a-quote/" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">Submit Quote Form</a>
 </div>
 </div>
 </section>
</BaseLayout>
