---
import HeroProducts from '@/components/HeroProducts.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProofStrip from '@/components/ProofStrip.astro'

const page = {
 title: 'Custom Work & Staff Polo Shirts Las Vegas | Embroidered & Printed',
 description:
 'Custom logo polos for Las Vegas teams: embroidered or screen printed work polos and staff uniform polos. Compare Port Authority, Carhartt, Nike and more, then send your logo and quantity for a quote.',
 url: 'https://bighornthreads.com/custom-polo-shirts-las-vegas/',
}

const stack = [
 { label: 'The blank', body: 'Compare Port Authority, Sport-Tek, Carhartt, Nike, Cutter & Buck, and other polos by role, fit, fabric, care, and budget.' },
  { label: 'The decoration', body: 'Choose a chest logo and, if you want, a name. Production partners stitch what you approve.' },
  { label: 'Sizing', body: 'Size ranges, tall sizes, and women\'s cuts vary by brand and stock.' },
  { label: 'Program-ready', body: 'A private company store lets your team reorder approved polos when they need them. A new hire picks a size and HR stops chasing approvals.' },
]

const blanks = [
 { row: 'Port Authority K500', use: 'Pique-knit polo for office and service teams', notes: 'Ask about colors and sizes' },
 { row: 'Port Authority K540', use: 'Performance fabric for hot-weather service work', notes: 'Ask about fabric, care, colors, and sizes' },
 { row: 'Sport-Tek ST650', use: 'Performance polo for crews', notes: 'Ask about stock and decoration' },
 { row: 'Carhartt polo options', use: 'Brand-name polos for trade and service roles', notes: 'Tell us the fit, fabric, pocket, and layering you need' },
 { row: 'Nike Dri-FIT', use: 'Brand-name performance polo', notes: 'Ask about models, fit, and stock' },
 { row: 'Cutter & Buck DryTec', use: 'Executive-tier polo, golf-shirt feel', notes: 'For VP, owner, and high-touch sales roles' },
]

const placements = [
 { name: 'Left chest logo', detail: 'The usual spot. Final size depends on the logo and polo.' },
 { name: 'Right chest name', detail: 'A common way to identify staff. Your proof shows the final text and size.' },
 { name: 'Sleeve mark', detail: 'Cap sleeve or full sleeve, for cert badges, a second logo, or project IDs.' },
 { name: 'Back yoke', detail: 'For larger logos on heavier polos. Common on jacket programs that match the polo line.' },
]

const faqs = [
 { q: 'Should custom polo shirts be embroidered or screen printed?', a: 'Embroidery is the usual choice on polos. Screen printing can work for large art or big runs. We recommend a method for your logo, and you see a proof before anything gets made.' },
 { q: 'How much does it cost to embroider a polo shirt?', a: 'Cost depends on the blank, decoration method, logo size, and order quantity. See our embroidery cost breakdown for the factors that drive price, or send your logo and quantity for a quote.', html: 'Cost depends on the blank, decoration method, logo size, and order quantity. See our <a href="/blog/how-much-to-embroider-a-polo/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidery cost breakdown</a> for the factors that drive price, or send your logo and quantity for a quote.' },
 { q: 'Is there a minimum order quantity for custom polos?', a: 'It depends on the polo and how it is decorated. See our guide to minimum order quantities for embroidery and screen printing, or tell us how many you need and we will tell you what works.', html: 'It depends on the polo and how it is decorated. See our <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">guide to minimum order quantities for embroidery and screen printing</a>, or tell us how many you need and we will tell you what works.' },
 { q: 'How long does a custom polo order take?', a: 'It depends on your quantity, whether the polo is in stock, how fast the proof gets approved, and how busy the production partner is. A logo we already have approved saves the most time. For a fixed date, see our rush order options and fast-turnaround guide.', html: 'It depends on your quantity, whether the polo is in stock, how fast the proof gets approved, and how busy the production partner is. A logo we already have approved saves the most time. For a fixed date, see our <a href="/services/rush-orders-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">rush order options</a> and <a href="/fastest-turnaround-custom-apparel/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">fast-turnaround guide</a>.' },
 { q: 'What\'s the best polo blank for Las Vegas summer?', a: 'Look at lightweight performance polos, and tell us whether the crew works indoors or out. A shirt is only one part of a heat plan, and employers still have to follow current rules on water, rest, shade, and training.' },
 { q: 'Can you embroider names on every polo?', a: 'Yes, where the polo allows it. Your quote shows what names add to the price and schedule.' },
  { q: 'Do you offer women\'s cut polos?', a: 'Yes, many lines come in women\'s cuts. We check styles, colors, and sizes for your order.' },
  { q: 'Can you match my Pantone brand color in the thread?', a: 'We get as close as the partner\'s thread colors allow, and you see the proposed match before production.' },
  { q: 'Can you set up a company store for our polos?', a: 'Yes. We set up a private store with your approved polos and logo, so your people can order their own sizes. Ask about spending limits per employee, and your proposal will say what your store can do.' },
 { q: 'Can you screen print polo shirts instead of embroidering them?', a: 'Yes. Screen printing suits larger or multi-color artwork and higher quantities, while embroidery suits small chest logos and a more finished look on knit polos. We recommend a method based on your artwork, fabric, and quantity, and you approve a proof before production. See our screen printing service in Las Vegas for the full process.', html: 'Yes. Screen printing suits larger or multi-color artwork and higher quantities, while embroidery suits small chest logos and a more finished look on knit polos. We recommend a method based on your artwork, fabric, and quantity, and you approve a proof before production. See our <a href="/services/screen-printing-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">screen printing service in Las Vegas</a> for the full process.' },
 { q: 'What is the difference between work polos and uniform polos?', a: 'Work polos are chosen for durability and comfort on active or outdoor roles, often in performance fabrics. Uniform polos prioritize a consistent look across a team, usually with matching colors, logo placement, and optional employee names. Some teams run both: a work polo for the field and a uniform polo for customer-facing staff.' },
 { q: 'Where can I get custom polo shirts in Las Vegas?', a: 'Bighorn Threads is a Las Vegas-based supplier of custom logo polos for staff and work crews. We arrange embroidered or screen printed polos from brands like Port Authority, Carhartt and Nike through our production partners, serve Henderson, Summerlin and North Las Vegas, and ship nationwide.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Polo Shirts Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-11-11',
 name: 'Custom Embroidered Polo Shirts in Las Vegas',
 serviceType: 'Embroidered company polo shirts for service trades and customer-facing staff',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-11-11',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Custom Polo Shirts</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Branded Apparel
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Custom Polo Shirts in Las Vegas, embroidered or screen printed.
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Embroidered polos, screen printed polos, work polos, and uniform polo shirts for Las Vegas teams. Pick the brand, style, and sizes, and we get your logo set up and the polos made through our production partners.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A polo program your team will wear.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Blanks table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
        <p class="kicker mb-3">Polo Options</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Pick the polo that matches the role.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Different roles can wear different polos in one program. Your quote lists price, minimums, and timing.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Blank</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Use Case</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {blanks.map((b) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{b.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{b.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{b.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Placements -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Logo Placements</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Where the logo and name go.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {placements.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{p.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <ProofStrip tone="paper" />

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom polos for Vegas service crews and customer-facing staff.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Polos work for service technicians, account managers, sales reps, <a href="/casino-hospitality-uniforms-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">casino floor and hospitality staff</a>, and other customer-facing roles across the valley, from <a href="/service-areas/henderson-nv/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Henderson</a> and <a href="/service-areas/summerlin/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Summerlin</a> to <a href="/service-areas/north-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">North Las Vegas</a>. Embroidery gives a clean chest logo. Other methods can fit better depending on the fabric, artwork, quantity, and budget.
 </p>
 <p>
          Let the work setting guide the choice. Compare cotton-poly and performance polos for indoor and outdoor roles.
 </p>
 <p>
          Names help customers know who they're talking to. The usual layout is the logo on the left chest and the name on the right.
 </p>
 <p>
          For a long-running program, we set up a private company store with your polos and logo loaded, so people order their own sizes. Ask about allowances per employee. See <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how the company store program works</a> for the details.
 </p>
 <p>
 For deeper reads on polos and embroidery, see our <a href="/blog/custom-polo-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom polo shirts buyer's guide</a>, the <a href="/blog/port-authority-polos-vs-alternatives/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Port Authority vs alternatives comparison</a>, and the <a href="/blog/how-much-to-embroider-a-polo/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidery cost breakdown</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- Where to get polos -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Local Answer</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">Where can I get custom polo shirts in Las Vegas?</h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p class="speakable-answer">Bighorn Threads is a Las Vegas-based supplier of custom logo polos for staff and work crews. We arrange embroidered or screen printed polos from brands like Port Authority, Carhartt and Nike through our production partners, serve Henderson, Summerlin and North Las Vegas, and ship nationwide.</p>
 <p>Here is how a polo order works, from the first email to reorders:</p>
 <ol class="list-decimal space-y-3 pl-6">
 <li><strong class="text-charcoal">Send your logo, quantity and size range.</strong> A rough count by role is enough to start.</li>
 <li><strong class="text-charcoal">We recommend a method and a polo.</strong> Embroidery suits most chest logos, and screen printing can fit large art or big runs. We match the polo to the role and the work setting.</li>
 <li><strong class="text-charcoal">You approve the proof.</strong> It shows the logo placement, size and proposed thread colors. Nothing gets made until you approve it.</li>
 <li><strong class="text-charcoal">Our production partners make the order.</strong> Your quote lists the price, minimums and timing for the polo and decoration you picked.</li>
 <li><strong class="text-charcoal">Reorder through a private company store (optional).</strong> Your team orders approved polos in their own sizes, so a new hire doesn't start a new project.</li>
 </ol>
 <p>Service areas: <a href="/service-areas/henderson-nv/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Henderson</a>, <a href="/service-areas/summerlin/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Summerlin</a> and <a href="/service-areas/north-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">North Las Vegas</a>. Outside Nevada, see <a href="/custom-polo-shirts/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom polo shirts shipped nationwide</a>.</p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Build the Program</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-uniforms-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Uniforms Las Vegas</h3>
 <p class="mt-2 text-sm text-ash">Polos are one piece. See the full owned uniform program by team.</p>
 </a>
 <a href="/custom-work-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Work Shirts</h3>
 <p class="mt-2 text-sm text-ash">Twill and FR shirts with your logo for field crews.</p>
 </a>
 <a href="/custom-hats-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Hats</h3>
 <p class="mt-2 text-sm text-ash">Match the cap to the polo line.</p>
 </a>
 </div>
 </div>
 </section>

 <NationalLinks heading='Ordering from outside Nevada?' links={[{ href: '/custom-polo-shirts/', label: 'Custom polo shirts' }, { href: '/company-uniforms/', label: 'Company uniforms' }, { href: '/custom-quarter-zips-jackets/', label: 'Quarter-zips and jackets' }]} />
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Polo questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 {f.html ? <p class="pb-5 text-base leading-relaxed text-ash" set:html={f.html} /> : <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>}
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Embroidery</h3>
          <p class="mt-2 text-sm text-ash">How embroidery works for your polo order.</p>
 </a>
 <a href="/brands/port-authority-polos-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Port Authority Polos</h3>
 <p class="mt-2 text-sm text-ash">A closer look at the K500, K540, and L-line cuts.</p>
 </a>
 <a href="/catalog/polos/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Polo Catalog</h3>
          <p class="mt-2 text-sm text-ash">Compare available cuts, fabrics, and sizes for your team.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to outfit your team in branded polos?</h2>
 <p class="mb-8 text-lg text-white/80">Send your logo, count, and blank preference.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
