---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'DTF, DTG (Direct-to-Garment) & Dye Sublimation Printing in Las Vegas | Bighorn Threads',
 description:
 'Direct-to-film (DTF), direct-to-garment (DTG), and dye sublimation printing in Las Vegas for small runs, full-color logos, and mixed-product orders. Quoted in writing, produced through vetted partners.',
 url: 'https://bighornthreads.com/dtf-printing-las-vegas/',
}

const stack = [
 { label: 'The method', body: 'A design is printed onto PET film, combined with adhesive, cured, and heat-pressed onto a qualifying garment.' },
 { label: 'Where it can fit', body: 'DTF is worth comparing for smaller runs, detailed artwork, mixed products, and some dark fabrics.' },
 { label: 'Product compatibility', body: 'The fabric, finish, and transfer decide whether DTF will work.' },
 { label: 'Decoration program', body: 'One artwork file can often cover several products. We check each fabric and placement before it runs.' },
]

const dtfVsOthers = [
 { row: 'DTF', meaning: 'Full-color transfer on compatible products', use: 'Small runs, full-color art, and mixed garments' },
 { row: 'Screen printing', meaning: 'Spot-color inks, very large runs', use: 'Larger single-design runs, bold one-to-three color graphics' },
 { row: 'Embroidery', meaning: 'Stitched thread, dimensional finish', use: 'Polos, jackets, hats, FR garments, premium logo placement' },
 { row: 'DTG (direct-to-garment)', meaning: 'Inkjet directly onto cotton', use: 'Cotton-only runs, photo prints; struggles on poly and dark fabrics' },
 { row: 'Sublimation', meaning: 'Dye into white polyester only', use: 'White or light polyester; cannot decorate cotton or dark fabric' },
 { row: 'Heat-transfer vinyl', meaning: 'Cut vinyl applied with heat', use: 'Names, numbers, simple shapes; not for full color or fine detail' },
]

const useCases = [
 { name: 'Small-run team apparel', detail: 'DTF can be worth comparing for smaller full-color orders. The quote confirms minimums and setup charges.' },
 { name: 'Photo + gradient logos', detail: 'Brand marks with shadows, gradients, or photographic elements that screen printing can\'t hold cleanly.' },
 { name: 'Mixed garment programs', detail: 'One artwork file may support several qualifying tees, hoodies, polos, hats, or tote bags.' },
 { name: 'Dark-fabric decoration', detail: 'A white underbase can support full-color artwork on some black, navy, charcoal, or forest garments.' },
 { name: 'Event and gang-sheet orders', detail: 'Gang sheets can support some event or name-addition workflows. Confirm transfer, application, and storage requirements.' },
 { name: 'Reorder planning', detail: 'Ask whether approved transfers can support future reorders. Product availability and application terms still apply.' },
]

const dtfLocal = [
 { topic: 'What you get', detail: 'Finished, decorated products: tees, hoodies, hats, totes, or workwear. Gang-sheet transfers for events or name additions can be quoted on request.' },
 { topic: 'Price', detail: 'There is no published price list. The garment, print size, number of placements, and quantity set the price, and you see it in writing before anything runs.' },
 { topic: 'Minimums', detail: 'DTF needs no screens, so small counts are practical. The quote lists any minimum and setup charge.' },
 { topic: 'Fabrics', detail: 'Cotton, polyester, blends, canvas, and many dark garments. Each product and placement is checked first. Safety-rated garments need a separate written review.' },
 { topic: 'Location', detail: 'Your account is run from Las Vegas. Orders ship nationwide, and pickup can be arranged when the job allows it. You approve a proof before production starts.' },
 { topic: 'Artwork', detail: 'Send a vector or high-resolution file. DTF can carry gradients, shadows, and photo elements, and the proof shows the result first.' },
]

const dtgVsDtf = [
 { q: 'Which costs more?', a: 'It depends on the garment, artwork size, and quantity. When both methods fit, the quote prices them side by side.' },
 { q: 'Does DTG feel like plastic?', a: 'No. DTG ink soaks into the fibers and feels soft. A DTF transfer sits on the surface as a thin, flexible layer you can feel.' },
 { q: 'Do the prints crack?', a: 'Either one can wear early if it is washed or dried wrong. Follow the written care instructions for the approved garment.' },
 { q: 'Which handles dark shirts?', a: 'Usually DTF. A white underbase lets full-color art sit on some black, navy, and charcoal garments.' },
 { q: 'Best fabric for DTG?', a: 'Cotton-rich tees and hoodies. On polyester and many dark garments, DTF is usually the safer choice.' },
 { q: 'How do you tell them apart?', a: 'Run a hand over the print. DTG follows the fabric texture. DTF has a smooth, slightly raised surface with a crisp edge.' },
]

const faqs = [
 { q: 'What is DTF printing?', a: 'Direct-to-film printing places artwork on a PET film with adhesive, then applies the transfer to a qualifying garment with heat and pressure. It can support detailed, full-color artwork on many products.' },
 { q: 'DTF vs screen printing: which one should I use?', a: 'DTF can fit smaller or detailed orders. Screen printing can fit larger single-design runs. Compare both methods using the exact product, artwork, quantity, care needs, setup, and quoted price.' },
 { q: 'How durable is a DTF print?', a: 'The transfer, the garment, and the washing set how long it lasts. Follow the written care instructions for the approved product and decoration.' },
 { q: 'What fabrics can you DTF on?', a: 'DTF can work on many cotton, polyester, blend, denim, canvas, and synthetic products. Coatings, heat sensitivity, seams, and construction can affect suitability. Check the garment before production.' },
 { q: 'Can DTF print on FR garments?', a: 'Do not assume a standard DTF transfer is acceptable on a safety-rated garment. The employer and safety professional should verify the garment, decoration method, placement, and current manufacturer guidance in writing.' },
 { q: 'What\'s the minimum DTF order?', a: 'DTF has no screens, so it handles small counts well. Your quote lists any minimum and setup charge.' },
 { q: 'Where can I get DTF printing in Las Vegas?', a: 'Bighorn Threads runs the account from Las Vegas and arranges DTF decoration. Send your artwork, product list, quantity, and needed date for review.' },
 { q: 'Do you offer DTG printing in Las Vegas?', a: 'Yes. Direct-to-garment (DTG) prints ink straight into cotton-rich tees and hoodies and suits photo-style or full-color artwork in small quantities. Bighorn quotes DTG alongside DTF so you can compare cost, feel, and durability on the exact garment.' },
 { q: 'Do you do dye sublimation printing in Las Vegas?', a: 'Yes. Dye sublimation bonds ink into white or light polyester, so it is the right method for all-over jerseys, performance polos, and event apparel that needs edge-to-edge color. Bighorn arranges sublimation and confirms garment, artwork, and timing in your quote.' },
 { q: 'What is the difference between DTF and heat-transfer vinyl?', a: 'Both are heat-applied. DTF prints a full-color design onto film that is pressed onto the garment, so it handles detailed logos and gradients. Heat-transfer vinyl is cut from solid-color sheets, so it suits names, numbers, and simple shapes rather than full-color artwork.' },
 { q: 'Do you offer heat-press transfer services in Las Vegas?', a: 'Bighorn arranges heat-applied decoration, including DTF transfers and heat-transfer vinyl for names and numbers. Send the artwork, garment, and quantity, and the quote confirms the method, minimum, and timing.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'DTF Printing Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'DTF Printing in Las Vegas',
 serviceType: 'Direct-to-film, direct-to-garment, and dye sublimation apparel printing',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">DTF Printing</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Decoration Method
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 DTF printing in Las Vegas <span class="text-gold-700">for small runs, full-color logos, and mixed orders.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Direct-to-film transfers handle short runs, detailed artwork, and orders that mix tees, hoodies, and workwear. We also quote DTG and dye sublimation when they fit the job better.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <section class="border-b border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">DTF Printing Las Vegas</p>
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight text-charcoal sm:text-3xl">DTF printing and DTF transfers in Las Vegas: what the quote covers</h2>
 <p class="mb-8 text-lg leading-relaxed text-charcoal">Bighorn Threads arranges DTF printing for Las Vegas businesses, teams, and events. Production partners print your full-color artwork on film and heat-press it onto the tees, hoodies, hats, or workwear you choose. DTF needs no screens, so short runs and mixed-product orders work well. Every job gets a written quote with price, minimum, and timing.</p>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What buyers compare</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">How it works with Bighorn</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {dtfLocal.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.topic}</td>
 <td class="px-6 py-5 align-top text-sm leading-relaxed text-ash">{r.detail}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Built for variety and short runs.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Method Comparison</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">DTF vs every other <span class="text-gold-600">decoration method.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 No single method fits every order. Bighorn recommends a method based on the product, artwork, quantity, and care needs.
 </p>
 </div>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Method</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Strength</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">When to Pick It</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {dtfVsOthers.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Where DTF Wins</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six order patterns DTF was built for.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {useCases.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 DTF printing for Vegas teams, events, and small-batch programs.
 </h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Direct-to-film printing creates a transfer that gets heat-applied to a compatible product. The process can support full-color artwork on some light and dark garments. The transfer, fabric, application, and care set how it feels, looks, and lasts.
 </p>
 <p>
 Screen printing and DTF use different production steps and pricing models. DTF may reduce color-related setup on some smaller or complex-art orders. Screen printing may price better at higher quantities. The artwork, product, and quantity set the actual breakpoint.
 </p>
 <p>
 DTF can reproduce gradients, photographic elements, and complex artwork. Resolution, garment texture, and application still limit fine detail. Review a proof before approving production.
 </p>
 <p>
 DTF can support many common apparel fabrics, including some cotton, polyester, and blended products. Coatings, heat sensitivity, seams, texture, and garment construction can change the result. Mixed-product orders require review by product and placement.
 </p>
 <p>
 Safety-rated garments need a separate written review. Do not add DTF, embroidery, or any other decoration based on a general rule. Verify the exact garment, method, placement, materials, and current manufacturer guidance with the employer's safety professional. For deeper reads, see our <a href="/blog/dtf-printing-vs-screen-printing-custom-apparel/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">DTF vs screen printing comparison</a>, the <a href="/services/screen-printing-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">screen-printing service page</a>, and our <a href="/welder-uniforms-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">welder uniforms guide</a>.
 </p>
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">DTF vs DTG vs Sublimation</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Three digital methods, <span class="text-gold-600">one Las Vegas quote.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Direct-to-film, direct-to-garment, and dye sublimation solve different problems. Tell us the garment and the artwork and we quote the method that fits, not a default method.
 </p>
 </div>
 <div class="grid gap-6 md:grid-cols-3">
 <div class="border border-hairline bg-panel p-6">
 <p class="font-mono text-xs font-bold uppercase tracking-wider text-gold-600">DTF · Direct to film</p>
 <h3 class="mt-3 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">Many fabrics, small runs</h3>
 <p class="mt-3 text-base leading-relaxed text-ash">Full-color transfers on cotton, poly, blends, canvas, and dark garments. Best for short runs, mixed products, and detailed logos.</p>
 </div>
 <div class="border border-hairline bg-panel p-6">
 <p class="font-mono text-xs font-bold uppercase tracking-wider text-gold-600">DTG · Direct to garment</p>
 <h3 class="mt-3 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">Photo-quality on cotton</h3>
 <p class="mt-3 text-base leading-relaxed text-ash">Ink printed straight into cotton-rich tees and hoodies with a soft hand. Best for one-offs, samples, and full-color art in low quantities.</p>
 </div>
 <div class="border border-hairline bg-panel p-6">
 <p class="font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Sublimation · Dye sub</p>
 <h3 class="mt-3 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">Edge-to-edge on polyester</h3>
 <p class="mt-3 text-base leading-relaxed text-ash">Ink bonded into light polyester for all-over jerseys, performance polos, and event apparel. Nothing to crack or peel. Best on white or light poly.</p>
 </div>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">DTG vs DTF</p>
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight text-charcoal sm:text-3xl">DTG vs DTF: which is better for your shirts?</h2>
 <p class="mb-8 text-lg leading-relaxed text-charcoal">Neither wins on every shirt. DTG prints ink directly into cotton-rich garments for a soft, photo-style print in small quantities. DTF prints the design on film and heat-applies it, so it suits more fabrics, dark garments, and mixed-product orders. Bighorn Threads quotes both and recommends one based on the garment, artwork, and quantity.</p>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-paper">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Question</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Short answer</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {dtgVsDtf.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.q}</td>
 <td class="px-6 py-5 align-top text-sm leading-relaxed text-ash">{r.a}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p class="mt-6 text-base leading-relaxed text-ash">Comparing against larger runs or stitched logos? Read <a href="/screen-printing-vs-dtg-vs-embroidery/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">screen printing vs DTG vs embroidery</a>.</p>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Dye Sublimation</p>
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight text-charcoal sm:text-3xl">Dye sublimation printing in Las Vegas: what it does and when to choose it</h2>
 <p class="mb-8 text-lg leading-relaxed text-charcoal">Bighorn Threads arranges dye sublimation in Las Vegas for all-over jerseys, performance polos, and event apparel. Heat bonds the dye into white or light polyester, so color can run edge to edge with nothing on the surface to crack or peel. Sublimation cannot decorate cotton or dark fabric.</p>
 <ul class="space-y-4 text-base leading-relaxed text-ash">
 <li><strong class="text-charcoal">Best uses.</strong> All-over and edge-to-edge designs, team jerseys, performance polos, and event shirts with full-color backgrounds, where a print sitting on the surface would feel heavy.</li>
 <li><strong class="text-charcoal">Garment limits.</strong> White or light polyester only. The dye bonds to polyester fibers, not cotton, and it cannot show on a dark shirt, so those go to DTF or screen printing instead.</li>
 <li><strong class="text-charcoal">Sublimation or DTF?</strong> Choose sublimation when the design covers the whole garment and the fabric is light polyester. Choose DTF for cotton, dark colors, a logo in one spot, or an order that mixes product types.</li>
 <li><strong class="text-charcoal">What to send for a quote.</strong> Your artwork, the garment or style, the quantity, and the date you need it. The written quote confirms the method, minimum, and timing. Not sure sublimation fits? Send the design anyway and we will tell you which method suits it.</li>
 </ul>
 <p class="mt-6 text-base leading-relaxed text-ash">Our <a href="/blog/sublimation-printing-custom-apparel-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">sublimation printing guide</a> covers the process in more detail.</p>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">DTF printing questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/screen-printing-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Printing</h3>
 <p class="mt-2 text-sm text-ash">For high-volume single-design runs where setup cost amortizes out.</p>
 </a>
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Stitched decoration for qualifying polos, jackets, hats, and bags.</p>
 </a>
 <a href="/catalog/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Catalog</h3>
 <p class="mt-2 text-sm text-ash">Browse products, then confirm DTF suitability by item.</p>
 </a>
 </div>
