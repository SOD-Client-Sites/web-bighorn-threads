---
import { photo } from '@/data/pagePhotos'
import StoreMock from '@/components/StoreMock.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const link = 'text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500'
const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'

const faqs = [
 {
 q: 'What is a company store for team apparel?',
 a: 'A company store is a private online store where your employees order approved, company-branded apparel. You choose what goes in it, and they choose their sizes. If you also want budgets or approvals, ask. We’ll tell you what your store can do before you commit.',
 },
 {
 q: 'Is a company store the same as a uniform program?',
 a: 'No. The store is how people order. A uniform program sets what each role wears and when it gets replaced. You can run one through the other. See uniform program cost per employee for budgeting.',
 html: `No. The store is how people order. A uniform program sets what each role wears and when it gets replaced. You can run one through the other. See <a href="/uniform-program-cost-per-employee/" class="${link}">uniform program cost per employee</a> for budgeting.`,
 },
 {
 q: 'Who offers branded company stores for teams?',
 a: 'Bighorn Threads sets up company stores for teams across the US from our office in Las Vegas. Production partners make the gear, and your written proposal spells out what your store includes.',
 },
 {
 q: 'How long does it take to launch a store?',
 a: 'The two things that move the date are how many products you want and how fast your logo files and approvals come back. Give us your target date and we’ll tell you if it’s realistic.',
 },
 {
 q: "What's the minimum crew size?",
 a: 'There’s no fixed number. Tell us your headcount and how often you reorder, and we’ll tell you whether a store makes sense or a regular order is the better call.',
 },
 {
 q: 'Do you charge a monthly fee?',
 a: 'If there’s a setup or monthly fee, you’ll see it in the proposal before you agree to anything.',
 },
 {
 q: 'Can we limit what employees order?',
 a: 'Yes, they only see the products you approve. Tell us if you also need limits by role or spending, and we will tell you what your store can do.',
 },
 {
 q: 'Can you ship to job sites?',
 a: 'We ship anywhere in the US. Job sites, a main office, or people’s homes all work. Tell us where gear needs to go and we’ll price the shipping.',
 },
 {
 q: 'How do we add new employees?',
 a: 'Tell us how often you hire and who should manage access. We’ll show you how adding someone would work before you commit.',
 },
 {
 q: 'What if we want to change our approved products?',
 a: 'Tell us what you want to add or remove. We check availability, decoration, and price, then update the store.',
 },
 {
 q: 'Do you integrate with our payroll or benefits system?',
 a: 'Ask early. If you need a payroll or benefits connection, we will tell you plainly whether it can be done and what it would take.',
 },
]

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-11-11',
 name: 'Company Stores for Teams',
 serviceType: 'Online team-apparel store',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: 'Private online stores where teams order approved, company-branded apparel, shipped anywhere in the US.',
 audience: {
 '@type': 'BusinessAudience',
 name: 'Corporate, education, healthcare, government, hospitality, and field teams, including general contractors, HVAC, plumbing, electrical, and multi-location companies',
 },
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/company-stores/',
 datePublished: '2026-07-08',
 dateModified: '2026-11-11',
 name: 'A private store for your team’s gear',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}

const steps = [
 { title: 'Tell us about your team', body: 'Your logo, your headcount, who needs what, and where it should ship.' },
 { title: 'Pick the gear', body: 'We suggest products for each role. You decide what goes in the store.' },
 { title: 'Review the proposal', body: 'See what the store does, who handles what, and every charge in writing.' },
 { title: 'Open it to your team', body: 'Check it yourself first, then send your people the link.' },
]

const fits = [
 { title: 'Contractors with several crews', body: 'Stop collecting sizes from every foreman and fill new-hire gear from one place.', html: `Stop collecting sizes from every foreman and fill new-hire gear from one place. See <a href="/company-stores/contractors-las-vegas/" class="${link}">company stores for contractors</a>.` },
 { title: 'Service trades', body: 'HVAC, plumbing, and electrical techs can get the same starter kit by role.' },
 { title: 'Companies with several locations', body: 'Keep the same logo and the same polo at every location, from one catalog.', html: `Keep the same logo and the same polo at every location, from one catalog.` },
 { title: 'Uniform programs', body: 'Give each role its approved uniforms and sizes in one place.', html: `Give each role its approved <a href="/custom-uniforms-las-vegas/" class="${link}">custom uniforms</a> and sizes in one place.` },
]

const questions = [
 'What will I pay to set it up, and is there a monthly charge?',
 'Is anything held in inventory, and who pays for it if it does not sell?',
 'Who answers when an employee has a sizing or shipping problem?',
 'What reports will I get, and can my office export them?',
 'Can I set budgets or approvals by role?',
]
---

<BaseLayout
 title="Company Stores for Branded Team Apparel | Bighorn Threads"
 description="A private online store for your team's approved branded apparel. Your people pick their own sizes. See how a company store works and what to ask before you set one up."
>
 <section class="bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-14 pt-12 sm:px-6 lg:px-8 lg:pt-16">
 <p class="kicker mb-4">Company stores</p>
 <h1 class="max-w-4xl font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-6xl lg:text-7xl">A private store for your team's gear</h1>
 <p class="speakable-answer mt-6 max-w-2xl text-lg leading-relaxed text-charcoal sm:text-xl">
 A company store is a private online store where employees order approved, company-branded apparel. You choose what goes in it and your people pick their own sizes, so you stop chasing them by email.
 </p>
 <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/demo/" class="btn-primary text-base">
 See a Demo Store
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 <a href="tel:+17029048923" class="px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal hover:text-gold-700">702.904.8923</a>
 </div>
  <StoreMock />
 </div>
 </section>

 <section id="how-it-works" class="scroll-mt-20 border-y border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-10 font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">How we set one up</h2>
 <ol class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
 {steps.map((step, i) => (
 <li class="border-t-2 border-charcoal pt-4">
 <span class="font-mono text-sm text-gold-700">Step {i + 1}</span>
 <h3 class="mt-1 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">{step.title}</h3>
 <p class="mt-2 leading-relaxed text-ash">{step.body}</p>
 </li>
 ))}
 </ol>
 </div>
 </section>

 <section class="border-b border-hairline bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <h2 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">How does a private company store for employee apparel work, and what should you ask first?</h2>
 <p class="mt-5 max-w-3xl text-lg leading-relaxed text-charcoal">A private company store from Bighorn Threads is an online store only your employees use. You approve the products, your people pick their sizes and order, production partners make the gear, and it ships to job sites, offices, or homes anywhere in the US. Any setup, monthly, or shipping charge is listed in the written proposal.</p>
 <div class="mt-8 grid gap-8 md:grid-cols-2">
 <div class="border-t-2 border-charcoal pt-4">
 <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-charcoal">How it works</h3>
 <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-ash">
 <li>You choose the products for each role, and employees see only those.</li>
 <li>Employees enter their own sizes, so nobody collects them by email.</li>
 <li>Orders ship to one address or several: a main office, job sites, or homes.</li>
 <li>To change the lineup, we check availability, decoration, and price, then update the store.</li>
 </ul>
 </div>
 <div class="border-t-2 border-charcoal pt-4">
 <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-charcoal">What to ask before you set one up</h3>
 <ul class="mt-3 list-disc space-y-2 pl-5 leading-relaxed text-ash">
 <li>What does setup cost, and is there a monthly charge?</li>
 <li>Is inventory held, and who pays if it does not sell?</li>
 <li>Who handles sizing and shipping problems?</li>
 <li>Can you set budgets or approvals by role?</li>
 <li>Does it need a payroll or benefits connection? Ask early.</li>
 </ul>
 </div>
 </div>
 <p class="mt-8 max-w-3xl leading-relaxed text-ash">A store earns its keep when you reorder or hire often. For a single start date, a bulk order is usually simpler. Compare the two in <a href="/blog/company-store-vs-bulk-ordering/" class={link}>company stores vs. bulk ordering</a>, or walk through the <a href="/company-stores/setup-guide-las-vegas/" class={link}>setup guide</a>.</p>
 </div>
 </section>

 <section class="bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Where a store makes sense</h2>
 <p class="mt-4 max-w-2xl text-lg text-ash">If you place one order a year, you probably do not need one. A store earns its keep when you reorder often or hire often.</p>
 <ul class="mt-8 divide-y divide-hairline border-y border-hairline">
 {fits.map((fit) => (
 <li class="flex flex-col gap-1 py-5 sm:flex-row sm:gap-6">
 <h3 class="shrink-0 font-heading text-lg font-bold uppercase tracking-tight text-charcoal sm:w-72">{fit.title}</h3>
 {fit.html ? <p class="leading-relaxed text-ash" set:html={fit.html} /> : <p class="leading-relaxed text-ash">{fit.body}</p>}
 </li>
 ))}
 </ul>
 </div>
 </section>

 <section class="bg-concrete pt-0"><div class="mx-auto grid max-w-7xl gap-4 px-4 pb-14 sm:grid-cols-2 sm:px-6 lg:px-8"><img src="/images/photos/company-store-phone.webp" alt={photo('company-store-phone').alt} width="1376" height="768" loading="lazy" decoding="async" class=" aspect-[3/2] w-full object-cover" /><img src="/images/photos/shipping-box.webp" alt={photo('shipping-box').alt} width="1376" height="768" loading="lazy" decoding="async" class=" aspect-[3/2] w-full object-cover" /></div></section>

 <section class="border-y border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto grid max-w-5xl gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
 <div>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">What it costs</h2>
 <p class="mt-5 text-lg leading-relaxed text-charcoal">
 You pay for the gear and the decoration. Any setup, monthly, payment, or shipping charge is listed in your proposal. Your products and your store setup drive the total, so we price each store instead of publishing a rate card.
 </p>
 <a href="/contact/?interest=pricing" class="btn-secondary mt-6 text-sm">Ask for pricing</a>
 </div>
 <div>
 <h2 class="font-heading text-2xl font-extrabold uppercase tracking-tight">Ask any store provider this</h2>
 <ul class="mt-5 space-y-3">
 {questions.map((q) => (
 <li class="flex gap-3 leading-relaxed text-charcoal"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 bg-gold-500"></span><span>{q}</span></li>
 ))}
 </ul>
 <p class="mt-6 text-ash">
 Read our <a href="/company-stores/setup-guide-las-vegas/" class={link}>setup guide</a>, <a href="/blog/company-store-vs-bulk-ordering/" class={link}>company stores vs. bulk ordering</a>, <a href="/branded-onboarding-kits-las-vegas/" class={link}>new-hire onboarding kits</a>, or <a href="/is-branded-apparel-worth-it/" class={link}>whether branded apparel is worth it</a>.
 </p>
 </div>
 </div>
 </section>

 <section id="faq" class="scroll-mt-20 bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-8 font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Questions owners ask</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((item) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <span class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.q}</span>
 <svg class="h-5 w-5 flex-shrink-0 text-gold-700 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 {item.html ? <p class="pb-5 leading-relaxed text-ash" set:html={item.html} /> : <p class="pb-5 leading-relaxed text-ash">{item.a}</p>}
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-t border-hairline bg-paper">
 <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Want to see one?</h2>
 <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/demo/" class="btn-primary text-base">See a Demo Store</a>
 <a href="tel:+17029048923" class="px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal hover:text-gold-700">702.904.8923</a>
 </div>
 </div>
 </section>

 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>
