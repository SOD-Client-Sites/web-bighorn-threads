---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import crewVegas from '@/assets/generated/crew-vegas.jpg'
import foremanCloseup from '@/assets/generated/founder-steve-desk.jpg'
import productStack from '@/assets/generated/product-stack.jpg'

const faqs = [
 {
 q: 'What is a company store for team apparel?',
 a: 'A company store is a possible online ordering model for an apparel program. Bighorn can scope a proposal after the platform, catalog, users, payment, inventory, fulfillment, administration, and fees are verified.',
 },
 {
 q: 'Who offers branded company stores for teams?',
 a: 'Bighorn Threads can scope a proposed company-store program with Las Vegas account support. Platform features, service areas, production, fulfillment, and administrative responsibilities require written confirmation.',
 },
 {
 q: 'How long does it take to launch a store?',
 a: 'No launch timeline is published. A proposal can set a target after the platform, catalog, artwork, integrations, responsibilities, and acceptance tests are defined.',
 },
 {
 q: "What's the minimum crew size?",
 a: 'There is no published universal crew-size minimum. Store eligibility, setup, and order minimums depend on the selected products, decoration methods, and program configuration.',
 },
 {
 q: 'Do you charge a monthly fee?',
 a: 'Setup, platform, user, product, decoration, payment, and shipping charges are confirmed in the written proposal. Ask for the complete fee schedule before approval.',
 },
 {
 q: 'Can we limit what employees order?',
 a: 'Catalog, access, role, approval, and spending controls can be scoped for the program. The proposal identifies which controls are supported by the selected store configuration.',
 },
 {
 q: 'Can you ship to job sites?',
 a: 'Available delivery destinations, split shipments, user-entered addresses, and related charges are confirmed in the fulfillment terms for each program.',
 },
 {
 q: 'How do we add new employees?',
 a: 'User enrollment depends on the selected platform. The proposal must verify supported invitation, import, access, and allowance workflows before launch.',
 },
 {
 q: 'What if we want to change our approved products?',
 a: 'Catalog changes are reviewed for product availability, decoration requirements, pricing, and production timing. The program terms define the change process.',
 },
 {
 q: 'Do you integrate with our payroll or benefits system?',
 a: 'Available billing, payment, allowance, payroll, and benefits integrations depend on the selected platform and program. The proposal identifies what is included and what requires separate implementation.',
 },
]

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Company Stores for Teams',
 serviceType: 'Planning for a proposed online team-apparel store',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description:
 'Planning for a proposed team-apparel store with Las Vegas account support. Platform, pricing, inventory, fulfillment, and administration require written confirmation.',
 audience: {
 '@type': 'BusinessAudience',
 name: 'Corporate, education, healthcare, government, hospitality, and field teams — including general contractors, HVAC, plumbing, electrical, and multi-location companies',
 },
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/company-stores/',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'A Managed Store for Approved Team Apparel',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
