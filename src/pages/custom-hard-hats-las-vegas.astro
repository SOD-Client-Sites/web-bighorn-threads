---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Hard Hats in Las Vegas | Bighorn Threads',
 description:
 'Plan branding for employer-selected hard hats. Bighorn can coordinate a proposed decal review with the helmet manufacturer and production partner.',
 hero: '/images/generated/kit-electrical.jpg',
 url: 'https://bighornthreads.com/custom-hard-hats-las-vegas/',
}

const stack = [
 { label: 'Employer-selected model', body: 'Your employer selects the exact hard hat for the workplace. Send the current model information with your request.' },
 { label: 'Manufacturer review', body: 'The helmet manufacturer must confirm whether the proposed decal material, size, and placement are permitted.' },
 { label: 'Scoped production', body: 'Bighorn can ask a production partner to quote a manufacturer-approved decal plan. Availability and terms are confirmed in writing.' },
 { label: 'Order documentation', body: 'The proposal can record the selected model, approved artwork, quantity, and current production terms for review.' },
]

const reviewPlan = [
 { row: 'Hard-hat selection', owner: 'Employer', confirm: 'Exact manufacturer and model selected for the workplace' },
 { row: 'Branding permission', owner: 'Helmet manufacturer', confirm: 'Current written instructions for the proposed decal' },
 { row: 'Artwork and quote', owner: 'Bighorn and production partner', confirm: 'Proposed size, placement, quantity, availability, and price' },
 { row: 'Final approval', owner: 'Employer', confirm: 'Written plan reviewed before production' },
]

const brandingReview = [
 { label: 'Start with the exact model', body: 'Manufacturer instructions can vary by product. A general brand name is not enough for review.' },
 { label: 'Submit the proposed artwork', body: 'Include the logo, requested size, color, material, and placement for written review.' },
 { label: 'Wait for written confirmation', body: 'Do not treat a catalog image or prior order as approval for a new model or application.' },
 { label: 'Review every reorder', body: 'Product availability and manufacturer instructions can change. Confirm the current terms before each run.' },
]

const faqs = [
 { q: 'Who selects the hard hat?', a: 'The employer selects the exact manufacturer and model for the workplace. Bighorn does not prescribe protective equipment.' },
 { q: 'Who approves the logo application?', a: 'The helmet manufacturer must permit the proposed material and placement. The employer reviews that written guidance before production.' },
 { q: 'Can Bighorn recommend a hard hat for our job?', a: 'Bighorn can quote branding after receiving the employer-selected model. Product selection stays with the employer and its safety lead.' },
 { q: 'Can you add a company logo or worker name?', a: 'Bighorn can scope a proposed layout. Availability depends on the exact model, manufacturer permission, and production-partner terms.' },
 { q: 'Does a prior decorated order approve the next one?', a: 'No. Confirm the current product and manufacturer instructions before each production run.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Hard Hats Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Hard Hats in Las Vegas',
 serviceType: 'Branding coordination for employer-selected hard hats',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Custom Hard Hats</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Hard Hat Branding Planning
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom Hard Hats in Las Vegas <span class="text-gold-400">with selection and branding reviewed first.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Your employer selects the exact hard hat. Bighorn can coordinate a proposed decal plan for manufacturer review.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Stack — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A documented plan before production.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Responsibility table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Selection Responsibility</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Who confirms <span class="text-gold-600">each decision.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 The employer selects the hard hat. The manufacturer reviews branding. Bighorn scopes the proposed order.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Decision</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Owner</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Confirm Before Production</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {reviewPlan.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.owner}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.confirm}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Branding review -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Branding Review</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Review the exact proposal with the manufacturer.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {brandingReview.map((d) => (
 <div class="border border-hairline bg-panel p-6">
 <div class="mb-3 flex items-center gap-2">
 <h3 class="font-heading text-base font-bold uppercase tracking-tight text-charcoal">{d.label}</h3>
 </div>
 <p class="text-sm leading-relaxed text-ash">{d.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom hard hats for Vegas crews — what makes a program work long-term.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A custom hard-hat request starts with the exact model selected by the employer. The proposed branding must follow the helmet manufacturer's current written instructions.
 </p>
 <p>
 Review the applicable <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1926/1926.100" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener" target="_blank">OSHA head-protection rule</a> and the exact manufacturer's instructions. Your employer remains responsible for selection, inspection, and use.
 </p>
 <p>
 For a repeat program, document the exact model and manufacturer-reviewed artwork. Bighorn can request current production terms from selected partners for each order.
 </p>
 <p>
 For deeper compliance reads, see our <a href="/blog/custom-hard-hats-las-vegas-buyer-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom hard hats buyer's guide</a> and the <a href="/blog/custom-hard-hats-osha-z89-decals-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">OSHA Z89 decal guide</a>. For the pairing with hi-vis programs, see our <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 Class 2 vs Class 3 guide</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Hard hat questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Plan branded apparel around the employer's approved product list.</p>
 </a>
 <a href="/industries/data-center-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Data Center Contractors</h3>
 <p class="mt-2 text-sm text-ash">Review site requirements before requesting branded equipment or apparel.</p>
 </a>
 <a href="/catalog/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Catalog</h3>
 <p class="mt-2 text-sm text-ash">Browse apparel options, then request current product and decoration terms.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to brand your crew's hard hats?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo, count, and employer-selected hard-hat model.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
