---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Scrubs & Healthcare Uniforms in Las Vegas | Embroidered Medical Apparel — Bighorn Threads',
 description:
 'Custom embroidered scrubs, lab coats, and medical staff apparel for Las Vegas hospitals, clinics, dental offices, and multi-site groups. Facility logo, name and credentials, color-coded by role. Company stores for healthcare teams. Get a quote.',
 hero: '/images/generated/service-embroidery.jpg',
 url: 'https://bighornthreads.com/healthcare-uniforms-scrubs-las-vegas/',
}

const roles = [
 { label: 'Clinical staff', body: 'Embroidered scrubs with facility logo, name, and credentials — color-coded by role or department so patients and staff read the team at a glance.' },
 { label: 'Providers', body: 'Branded lab coats and consultation jackets, embroidered with name and title, in weights that hold a professional look all day.' },
 { label: 'Front desk & admin', body: 'Polos, blouses, and button-downs that match the clinical look without scrubs — a consistent brand from the waiting room in.' },
 { label: 'Lab & support', body: 'Durable branded coats and tops built for lab and support roles — and the hard, frequent washing they take.' },
]

const faqs = [
 { q: 'Where can I get custom embroidered scrubs and lab coats in Las Vegas?', a: 'Bighorn Threads embroiders scrubs, lab coats, and medical staff apparel for Las Vegas hospitals, clinics, dental offices, and multi-site groups. We add your facility logo, employee names, and credentials, and can color-code by role or department. Decoration is done to hold up through repeated medical laundering.' },
 { q: 'Can you color-code scrubs by department or role?', a: 'Yes — color-coding is one of the most useful things we set up for healthcare teams. Assigning a color to each role or department helps patients and staff identify who does what at a glance. We keep the facility logo and name embroidery consistent across every color so the whole team still reads as one brand.' },
 { q: 'Can you embroider names and credentials on medical apparel?', a: 'Yes. Standard layout is the facility logo on one chest and the employee name with credentials (RN, MA, DDS, and the like) on the other, or on the sleeve. We keep placement and lettering consistent across the team so it looks deliberate, not improvised.' },
 { q: 'Do you set up company stores for multi-site healthcare groups?', a: 'Yes. A company store is a private branded shop carrying only your approved scrubs and apparel. Each location or department orders its own sizes from one catalog, gear ships direct, and you hold no inventory. It keeps a multi-site group consistent across every clinic, with budgets and approvals you control.' },
 { q: 'Will embroidery hold up to medical laundering?', a: 'Yes — that\'s why embroidery is the standard for healthcare apparel. Stitched logos and names survive frequent, high-temperature washing far better than printed decoration, which can crack or fade. We pick thread and placement that keep the mark sharp over the garment\'s working life.' },
 { q: 'Do you work with dental and specialty practices, not just hospitals?', a: 'Absolutely. We outfit dental offices, specialty clinics, urgent care, veterinary practices, and physical-therapy and wellness groups across the valley — single locations and multi-site organizations alike. The program scales to fit the size of your team.' },
 { q: 'What areas do you serve?', a: 'Bighorn Threads is based in Las Vegas and serves healthcare teams across Las Vegas, Henderson, North Las Vegas, and Summerlin, with local pickup or direct shipping. Send your logo and the roles you\'re outfitting for a quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Scrubs & Healthcare Uniforms Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Scrubs & Healthcare Uniforms in Las Vegas',
 serviceType: 'Embroidered scrubs, lab coats, and medical staff apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 areaServed: [
 { '@type': 'City', name: 'Las Vegas' },
 { '@type': 'City', name: 'Henderson' },
 { '@type': 'City', name: 'North Las Vegas' },
 { '@type': 'City', name: 'Summerlin' },
 ],
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Healthcare Uniforms & Scrubs</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Healthcare
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom scrubs & healthcare uniforms in Las Vegas <span class="text-gold-400">— embroidered, color-coded, consistent.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Scrubs, lab coats, and staff apparel — your facility logo, names, and credentials, color-coded by role and built to take medical laundering.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Liftable answer -->
 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="text-xl leading-relaxed text-charcoal sm:text-2xl">
 Bighorn Threads embroiders custom scrubs, lab coats, and medical staff apparel for Las Vegas hospitals, clinics, dental offices, and multi-site groups. We add your facility logo, names, and credentials, color-code by role, and decorate to survive medical laundering.
 </p>
 </div>
 </section>

 <!-- Roles -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Every Role On The Team</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From the front desk to the floor.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {roles.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded scrubs do two jobs: identity and trust.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A patient who can tell the nurse from the tech from the front-desk coordinator feels looked after. Branded, color-coded scrubs make the team legible — who does what, who to ask, who's in charge. Add your facility logo and it reads as a real organization, not a roster of strangers in random scrubs.
 </p>
 <p>
 The trick is keeping it consistent. Across a clinic — let alone a multi-site group — scrubs drift fast: different colors, off-brand logos, names done five different ways. We fix that by digitizing your logo in-house and holding your standards on file, so every garment matches whether it's ordered today or next year.
 </p>
 <p>
 Embroidery is the right call for healthcare. It survives the frequent, high-temperature washing medical apparel goes through, where printed decoration cracks and fades. Lab coats and clinical wear also have a hygiene dimension — staff apparel is part of the controls that limit contamination, alongside the <a href="https://www.osha.gov/bloodborne-pathogens" rel="noopener" target="_blank" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">OSHA bloodborne pathogens</a> standards your facility already works under and broader <a href="https://www.cdc.gov/infection-control/hcp/" rel="noopener" target="_blank" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">CDC infection-control</a> guidance.
 </p>
 <p>
 For a multi-site group, a <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store</a> is the clean way to run it. Each location orders its own sizes from one approved catalog, gear ships direct, and you hold no inventory. New hires order their scrubs on day one, and the brand stays consistent across every clinic.
 </p>
 <p>
 We're a Las Vegas shop, so you reach a real person who knows your account. See how <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company stores</a> work, or explore the full <a href="/industries/healthcare/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">healthcare</a> program.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Healthcare apparel questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/healthcare/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Healthcare</h3>
 <p class="mt-2 text-sm text-ash">The full vertical — every healthcare team we outfit.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">Keep multi-site teams consistent, zero inventory.</p>
 </a>
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">In-house digitizing that holds up through medical wash.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Outfitting a clinic or a whole group?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo and the roles you're outfitting. We'll build the program with you.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Free Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
