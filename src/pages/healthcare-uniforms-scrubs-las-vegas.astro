---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Scrubs & Healthcare Uniforms in Las Vegas | Embroidered Medical Apparel — Bighorn Threads',
 description:
 'Custom embroidered scrubs, lab coats, and medical staff apparel planning for Las Vegas healthcare teams. Bighorn coordinates approved products and decoration through production partners. Get a quote.',
 hero: '/images/generated/service-embroidery.jpg',
 url: 'https://bighornthreads.com/healthcare-uniforms-scrubs-las-vegas/',
}

const roles = [
 { label: 'Clinical staff', body: 'Consider scrubs with an approved facility logo, name, credentials, and role-based colors.' },
 { label: 'Providers', body: 'Branded lab coats and consultation jackets, embroidered with name and title, in weights that hold a professional look all day.' },
 { label: 'Front desk & admin', body: 'Polos, blouses, and button-downs that match the clinical look without scrubs — a consistent brand from the waiting room in.' },
 { label: 'Lab & support', body: 'Compare branded coats and tops against each role, laundering process, and facility requirement.' },
]

const faqs = [
 { q: 'Where can I get custom embroidered scrubs and lab coats in Las Vegas?', a: 'Bighorn Threads coordinates embroidered scrubs, lab coats, and medical staff apparel through production partners. You can specify a facility logo, employee names, credentials, and colors by role or department.' },
 { q: 'Can you color-code scrubs by department or role?', a: 'Color-coding can help distinguish roles or departments. Bighorn coordinates the approved colors, products, artwork, and decoration specification through production partners.' },
 { q: 'Can you embroider names and credentials on medical apparel?', a: 'Names and credentials may be available on qualifying garments. The quote confirms artwork, placement, lettering, minimums, and production requirements.' },
 { q: 'Do you set up company stores for multi-site healthcare groups?', a: 'Bighorn can review company-store options for an approved apparel catalog. Platform, ordering, budget, inventory, and fulfillment capabilities must be confirmed before setup.' },
 { q: 'Will embroidery hold up to medical laundering?', a: 'Durability depends on the garment, thread, construction, decoration, wash temperature, chemicals, and drying process. Confirm the facility laundering protocol and follow the current manufacturer care instructions.' },
 { q: 'Do you work with dental and specialty practices, not just hospitals?', a: 'Bighorn provides Las Vegas account management for hospitals, dental offices, specialty clinics, urgent care, veterinary practices, and wellness groups. Product and program terms are confirmed by quote.' },
 { q: 'What areas do you serve?', a: 'Bighorn is based in Las Vegas. Confirm product availability, pickup, shipping, delivery, and service-area terms in your written quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Scrubs & Healthcare Uniforms Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Scrubs & Healthcare Uniforms in Las Vegas',
 serviceType: 'Embroidered scrubs, lab coats, and medical staff apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Healthcare Uniforms & Scrubs</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Healthcare
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom scrubs & healthcare uniforms in Las Vegas <span class="text-gold-400">— embroidered, color-coded, consistent.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Scrubs, lab coats, and staff apparel with an approved facility logo, names, credentials, and role colors. Product and decoration choices should match your laundering requirements.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Liftable answer -->
 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="text-xl leading-relaxed text-charcoal sm:text-2xl">
 Bighorn Threads coordinates custom scrubs, lab coats, and medical staff apparel for Las Vegas healthcare teams. Production partners apply your approved logo, names, credentials, and role colors.
 </p>
 </div>
 </section>

 <!-- Roles -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Every Role On The Team</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From the front desk to the floor.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {roles.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded scrubs do two jobs: identity and trust.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A patient who can tell the nurse from the tech from the front-desk coordinator feels looked after. Branded, color-coded scrubs make the team legible — who does what, who to ask, who's in charge. Add your facility logo and it reads as a real organization, not a roster of strangers in random scrubs.
 </p>
 <p>
 The trick is keeping it consistent. Across a clinic, scrubs can drift into different colors, off-brand logos, and mismatched names. Bighorn coordinates digitizing through a production partner against the logo standard you approve.
 </p>
 <p>
 Embroidery can work well for healthcare apparel, but laundering conditions matter. Compare the garment, thread, decoration, and care instructions against your facility process. Your safety and infection-control leads should verify requirements under applicable <a href="https://www.osha.gov/bloodborne-pathogens" rel="noopener" target="_blank" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">OSHA bloodborne pathogens</a> standards and <a href="https://www.cdc.gov/infection-control/hcp/" rel="noopener" target="_blank" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">CDC infection-control</a> guidance.
 </p>
 <p>
 A multi-site group can evaluate a <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store</a> as one possible ordering model. Available catalog, user, budget, inventory, and fulfillment capabilities depend on the selected platform and program.
 </p>
 <p>
 Bighorn provides Las Vegas account management and coordinates production through partners. Review <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company-store planning</a> or explore the <a href="/industries/healthcare/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">healthcare apparel</a> guide.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Healthcare apparel questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/healthcare/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Healthcare</h3>
 <p class="mt-2 text-sm text-ash">Planning considerations for healthcare apparel programs.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">Review ordering-platform options for multi-site teams.</p>
 </a>
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Partner-coordinated digitizing based on your approved logo standard.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Outfitting a clinic or a whole group?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo, roles, quantities, and laundering requirements. We'll prepare a recommendation.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
