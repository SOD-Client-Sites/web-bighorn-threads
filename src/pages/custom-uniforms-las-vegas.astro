---
import HeroProducts from '@/components/HeroProducts.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProofStrip from '@/components/ProofStrip.astro'

const page = {
 title: 'Custom Uniforms Las Vegas | Work & Staff Uniforms You Own | Bighorn Threads',
 description:
 'Custom uniforms in Las Vegas for construction crews, casinos and hospitality, healthcare, and service teams. Embroidered polos, work shirts, hi-vis, and scrubs you own outright with no rental contract. Quoted in writing.',
 url: 'https://bighornthreads.com/custom-uniforms-las-vegas/',
}

const stack = [
 { label: 'Yours to keep', body: 'You buy the uniforms and keep them. You skip the weekly rental bill and the multi-year contract, and headcount changes cost you nothing extra.' },
 { label: 'One standard, every department', body: 'Front of house, back of house, field, and office each get the right garment with the same logo, thread colors, and placement.' },
 { label: 'Sizing and names handled', body: 'Give us your size run, including tall and big sizes, and we find a garment that covers it. Names can be embroidered for customer-facing roles.' },
 { label: 'Reorders without the chase', body: 'A private company store holds your approved uniforms in one place, so a new hire picks a size and orders without starting over.' },
]

const teams = [
 { row: 'Construction and trades', use: 'Work shirts, hi-vis tees and vests, FR shirts, hard hats, jackets', notes: 'Logos on ANSI 107 and NFPA 70E items must follow the manufacturer\'s instructions. See the construction apparel page.' },
 { row: 'Casino and hospitality', use: 'Dealer shirts, server and bartender polos, host vests, housekeeping and valet uniforms', notes: 'The proof shows your department colors and dress standards.' },
 { row: 'Healthcare and clinics', use: 'Embroidered scrubs, lab coats, admin polos, fleece', notes: 'Logo and clinic name on the chest, role or credential on the sleeve where policy allows.' },
 { row: 'HVAC, plumbing, electrical service', use: 'Performance polos, button-down work shirts, quarter-zips, caps', notes: 'Name on the right chest so customers know who is at the door.' },
 { row: 'Corporate and office', use: 'Polos, quarter-zips, button-downs, softshell jackets', notes: 'Executive-tier options for sales and leadership, standard tier for staff.' },
 { row: 'Events and staffing', use: 'Printed tees, polos, lanyards, aprons', notes: 'Tell us the event date and we will tell you what can make it.' },
]

const faqs = [
 { q: 'How much do custom uniforms cost in Las Vegas?', a: 'Cost depends on the garment, the decoration method, the number of logo placements, and quantity. A basic embroidered polo program costs less per piece than a multi-placement FR or hi-vis program. Bighorn quotes the exact garment and decoration in writing so you can compare tiers before approving.' },
 { q: 'Is it better to rent uniforms or buy them?', a: 'Rental programs from national providers bundle laundering and replacement into a weekly fee under a multi-year contract, with a limited garment catalog. Buying custom uniforms means you choose the brands and styles, own the garments, and reorder only when you need to. If your team can wash its own uniforms, price owning against your rental invoice before you renew.' },
 { q: 'What is the minimum order for custom uniforms?', a: 'Minimums depend on the garment and decoration method. Embroidery generally allows smaller runs than screen printing. Your quote lists the minimum and any setup charge.' },
 { q: 'Should uniform logos be embroidered or screen printed?', a: 'Embroidery is the standard for polos, button-downs, jackets, and caps because it holds up to repeated washing and looks like a finished uniform. Screen printing suits tees and hi-vis where a larger, bolder logo makes sense. Most programs use both by garment.' },
 { q: 'Can you put employee names on uniforms?', a: 'Yes. Name embroidery on the right chest is common for service technicians, dealers, and front-of-house staff. You check names, titles, and credentials on the proof first.' },
 { q: 'Can you match our property or brand colors?', a: 'Thread and ink colors are matched to your brand standard as closely as the garment and the partner thread library allow. You review the proposed match on the proof before anything is produced.' },
 { q: 'How fast can you deliver custom uniforms in Las Vegas?', a: 'It depends on whether the garment is in stock and how much room the production partner has. We check both before giving you a ship date. If you have a hard date, tell us up front. See the fast turnaround page for what affects the schedule.' },
 { q: 'Where can I get custom uniforms in Las Vegas?', a: 'Bighorn Threads supplies custom uniforms for Las Vegas and Henderson businesses with a contact in Las Vegas and production through our partners. Send your logo, headcount by role, and any dress-code or safety requirements for a written quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Uniforms Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-09-10',
 dateModified: '2026-09-10',
 name: 'Custom Uniforms in Las Vegas',
 serviceType: 'Custom branded work and staff uniforms for Las Vegas businesses',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 areaServed: [{ '@type': 'City', name: 'Las Vegas' }, { '@type': 'City', name: 'Henderson' }, { '@type': 'City', name: 'North Las Vegas' }],
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-09-10',
 dateModified: '2026-09-10',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 lang="en"
 alternates={[
 { hreflang: 'en', href: page.url },
 { hreflang: 'es', href: 'https://bighornthreads.com/es/uniformes-personalizados-las-vegas/' },
 { hreflang: 'x-default', href: page.url },
 ]}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Custom Uniforms</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Uniform Programs
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Custom uniforms in Las Vegas <span class="text-gold-700">your team owns.</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Bighorn Threads supplies custom uniforms for Las Vegas businesses: embroidered polos and work shirts for crews, front-of-house and back-of-house uniforms for casinos and restaurants, scrubs for clinics, and hi-vis for field teams. You buy the uniforms outright, we manage logos, sizing, and reorders, and every order is quoted in writing.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A uniform program you own.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Teams table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Uniforms by Team</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">The right uniform for each role, one logo standard.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 A casino floor, a jobsite, and a clinic need different garments. You can still run them all through one account with one logo file.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Team</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Typical Uniform</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {teams.map((t) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{t.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{t.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{t.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <ProofStrip tone="paper" />

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Owning your uniforms in Las Vegas: what changes, and what to plan for.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Rental programs bundle garments, laundering, and replacement into a weekly fee under a multi-year contract, and you pick from what the fleet carries. Uniform stores sell blanks and send you elsewhere for the logo. With Bighorn, you choose brand-name garments, production partners do the embroidery or printing, and you own the result.
 </p>
 <p>
 When you own, you stop paying each week for garments sitting in a locker. You take on the laundry and the reorders. That trade favors owning if your crew washes its own workwear or your property has in-house laundry. If you need heavily soiled garments industrially laundered every week, a rental program can still make sense. Read <a href="/branded-merchandise-vs-print-on-demand/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how owned programs compare to other buying models</a> before you decide.
 </p>
 <p>
 Field crews need moisture-wicking polos or performance work shirts from May through September, and employers must follow the <a href="/safety-compliance/nevada-osha-heat-rules-2026/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Nevada OSHA heat-illness rules</a> for water, rest, and shade regardless. Casinos and restaurants run 24-hour shifts, so staff need enough uniforms to get through the laundry cycle. Clinics need scrubs that hold color through hot washes. We work through these with you before the proof.
 </p>
 <p>
 Embroidery is the default for polos, button-downs, jackets, and caps because it holds up to repeated washing and looks like a uniform. Screen printing carries larger logos on tees and hi-vis. Your company selects any flame-resistant or ANSI-rated garment, and the logo must follow the manufacturer's instructions and get your company's approval; see the <a href="/safety-compliance/nfpa-70e-embroidery-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">NFPA 70E embroidery guide</a> and the <a href="/safety-compliance/ansi-107-hi-vis-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 hi-vis guide</a>.
 </p>
 <p>
 A <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">private company store</a> keeps approved garments and your logo in one place, so outfitting a new hire does not start from scratch. Pages by department: <a href="/casino-hospitality-uniforms-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">casino and hospitality uniforms</a>, <a href="/branded-apparel-construction-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">construction and trade apparel</a>, <a href="/healthcare-uniforms-scrubs-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">healthcare uniforms and scrubs</a>, <a href="/welder-uniforms-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">welder uniforms</a>, <a href="/blog/hvac-uniforms-service-tech-apparel/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">HVAC and service-tech apparel</a>, and <a href="/brands/red-kap-work-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom Red Kap work shirts and industrial uniforms</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <NationalLinks heading='Ordering from outside Nevada?' links={[{ href: '/company-uniforms/', label: 'Company uniforms' }, { href: '/custom-company-shirts/', label: 'Custom company shirts' }, { href: '/custom-polo-shirts/', label: 'Custom polo shirts' }, { href: '/industries/gaming-hospitality/', label: 'Gaming and hospitality uniforms' }, { href: '/industries/government/', label: 'Government uniforms' }, { href: '/restaurant-uniforms/', label: 'Restaurant uniforms' }, { href: '/hotel-uniforms/', label: 'Hotel uniforms' }]} />
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Custom uniform questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Go Deeper</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/casino-hospitality-uniforms-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Casino & Hospitality Uniforms</h3>
 <p class="mt-2 text-sm text-ash">Dealer shirts, server polos, and department color standards for Las Vegas properties.</p>
 </a>
 <a href="/custom-polo-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Polo Shirts</h3>
 <p class="mt-2 text-sm text-ash">The workhorse uniform piece: brands, fabrics, and logo placements compared.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">How reorders, sizes, and budgets run once the uniform standard is set.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to put your team in uniform?</h2>
 <p class="mb-8 text-lg text-white/80">Send your logo, headcount by role, and any dress-code or safety requirements.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
