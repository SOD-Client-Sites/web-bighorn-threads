---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Lanyards in Las Vegas | Trade Show, Conference, Staff ID | Bighorn Threads',
 description:
 'Custom lanyards in Las Vegas for trade shows, conferences, corporate ID, hospital teams, and schools. Compare eligible materials, decoration, hardware, and current quote terms.',
 hero: '/images/generated/service-branded-apparel.jpg',
 url: 'https://bighornthreads.com/custom-lanyards-las-vegas/',
}

const stack = [
 { label: 'The decoration', body: 'Compare silk-screen, dye-sublimation, woven, and other eligible methods. The production partner confirms compatibility with your exact art, material, quantity, and budget.' },
 { label: 'The hardware', body: 'Bulldog clips, swivel hooks, lobster claws, breakaway releases, badge reels, and double-end clips may be options. Confirm current availability, compatibility, and applicable policies.' },
 { label: 'Width range', body: 'Compare widths against the exact badge, artwork, attachment, comfort goal, and venue policy. Available sizes depend on the selected product and current quote.' },
 { label: 'Materials', body: 'Polyester, recycled rPET, bamboo, cotton, and other materials may be available. Confirm current product data, claims, care, and availability.' },
]

const decorations = [
 { row: 'Silk-screen print', use: 'Spot-color artwork on eligible lanyards', notes: 'Confirm color limits, setup, material compatibility, use, care, and current pricing.' },
 { row: 'Dye-sublimation (full color)', use: 'Photographic, gradient, or multicolor artwork', notes: 'Confirm printable area, color handling, material, use, care, and current pricing.' },
 { row: 'Woven', use: 'Textile-style logos on eligible products', notes: 'Confirm art limits, material, feel, use, care, availability, and current pricing.' },
 { row: 'Heat transfer', use: 'Full-color art on eligible products', notes: 'Confirm setup, material compatibility, durability expectations, use, care, and current pricing.' },
]

const useCases = [
 { name: 'Trade show attendee badges', detail: 'A lanyard may carry show, host, or sponsor branding. Confirm badge weight, artwork, hardware, venue rules, quantity, and schedule.' },
 { name: 'Corporate office ID', detail: 'Staff ID may use a clip or badge reel with approved company branding. Confirm the badge, hardware, employer policy, and current product.' },
 { name: 'Hospital and clinical staff', detail: 'Medical and clinical ID with optional breakaway hardware. Confirm the employer\'s current safety policy first.' },
 { name: 'School and university', detail: 'Student, faculty, and visitor ID with eligible logo, color, and hardware options.' },
 { name: 'Conference and event staff', detail: 'Approved "STAFF" or "CREW" labels and colorways may help distinguish event roles. Confirm venue and organizer requirements.' },
 { name: 'VIP and sponsor tiers', detail: 'Different approved materials, colors, or artwork may distinguish VIP, speaker, sponsor, or executive attendee tiers.' },
]

const faqs = [
 { q: 'Which lanyard width should I choose?', a: 'Choose width after reviewing the exact badge, artwork, attachment, comfort goal, and venue or employer policy. The production partner confirms available sizes, compatibility, product data, and current pricing.' },
 { q: 'Should I use silk-screen, dye-sublimation, or woven?', a: 'Match the method to the exact artwork, lanyard material, printable area, quantity, use, care, deadline, and current quote. The production partner should confirm compatible options before approval.' },
 { q: 'What lanyard hardware do I need for a heavy badge?', a: 'Select hardware from the exact badge weight, attachment, movement, use, and applicable policy. Review the product manufacturer\'s current load and safety information. The production partner must confirm compatibility.' },
  { q: 'Are breakaway safety lanyards required?', a: 'Requirements vary by employer, venue, and work setting. Check the applicable policy before choosing hardware for your program.' },
 { q: 'Can I order eco-friendly or sustainable lanyards?', a: 'Products marketed with recycled or other environmental attributes may be available. Verify the exact material, certification, claim, country of origin, decoration compatibility, availability, and current quote before using sustainability language.' },
  { q: 'What\'s the minimum lanyard order?', a: 'Minimums depend on the product, decoration method, and production partner. Share your quantity so we can confirm suitable options.' },
  { q: 'How long does a lanyard order take?', a: 'Timelines depend on product availability, production capacity, and shipping. Share your event date so we can confirm a current estimate.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Lanyards Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Lanyards in Las Vegas',
 serviceType: 'Branded lanyards for trade shows, conferences, corporate ID, and staff identification',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>
 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Custom Lanyards</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Convention SWAG
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
	 Custom Lanyards in Las Vegas <span class="text-gold-400">for trade shows, conferences, and staff ID.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
	 Compare eligible decoration, widths, materials, and hardware for your exact badge program. Your quote confirms current products, terms, and timing.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
	 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A lanyard program planned around your Vegas event.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Decoration Methods</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Pick the method that <span class="text-gold-600">matches the art.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
          Three core decoration methods can support different art and event needs. Bighorn coordinates the approved method through a selected production partner.
 </p>
 </div>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Method</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">When to Use</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {decorations.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Use Cases</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six places lanyards do the work of identification.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {useCases.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom lanyards for Vegas conventions, conferences, and staff ID.
 </h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
	 Las Vegas hosts trade shows across construction, building products, HVAC, equipment, hospitality, and consumer categories. A lanyard can carry attendee credentials and approved event branding. Build the order from the event roster, badge, sponsor requirements, venue policy, and schedule.
 </p>
 <p>
	 Match width and hardware to the exact badge, attachment, weight, movement, comfort goal, and venue policy. Review current manufacturer documentation for any load or safety claim. The production partner should confirm available products and compatibility in writing.
 </p>
 <p>
	 Match decoration to the exact art, lanyard material, printable area, use, care, quantity, deadline, and budget. Silk-screen, dye-sublimation, woven, and heat-transfer methods may each fit different orders. The current quote should document compatible options, setup, pricing, and timing.
 </p>
 <p>
          Breakaway behavior depends on the exact product and current manufacturer documentation. Requirements vary by employer, venue, and role. Check the applicable policy and product data before approving hardware.
 </p>
 <p>
 For event-paired apparel, see our <a href="/trade-show-apparel-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">trade show apparel guide</a>. For broader event SWAG including drinkware, bags, and tech, see the <a href="/promo-products-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">promo products hub</a>.
 </p>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Lanyard questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/trade-show-apparel-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Trade Show Apparel</h3>
 <p class="mt-2 text-sm text-ash">Booth crew apparel that pairs with the badge program.</p>
 </a>
 <a href="/promo-products-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Promo Products Hub</h3>
 <p class="mt-2 text-sm text-ash">Drinkware, bags, tech — the full event SWAG range.</p>
 </a>
 <a href="/custom-yeti-drinkware-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Yeti Drinkware</h3>
 <p class="mt-2 text-sm text-ash">Higher-tier giveaway for qualified leads or sponsor gifting.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to brand your lanyards?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your art, quantity, and event date.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
