---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Lanyards in Las Vegas | Trade Show, Conference, Staff ID | Bighorn Threads',
 description:
 'Custom lanyards in Las Vegas for trade shows, conferences, corporate ID, hospital teams, and schools. Compare eligible materials, decoration, hardware, and current quote terms.',
 url: 'https://bighornthreads.com/custom-lanyards-las-vegas/',
}

const stack = [
 { label: 'The decoration', body: 'Silk-screen for simple logos, dye-sublimation for full color, woven for a textile look.' },
 { label: 'The hardware', body: 'Bulldog clips, swivel hooks, lobster claws, breakaway releases, and badge reels. Tell us what the badge weighs and we’ll suggest one.' },
 { label: 'Width range', body: 'A long logo needs a wider strap, and a heavy badge sits better on one too.' },
 { label: 'Materials', body: 'Polyester is the usual choice. Ask about recycled rPET, bamboo, or cotton if that matters to your event.' },
]

const decorations = [
 { row: 'Silk-screen print', use: 'Spot-color artwork on eligible lanyards', notes: 'Usually the value pick for one or two colors.' },
 { row: 'Dye-sublimation (full color)', use: 'Photographic, gradient, or multicolor artwork', notes: 'The ink goes into the fabric, so gradients and photos work.' },
 { row: 'Woven', use: 'Textile-style logos on eligible products', notes: 'The design is woven in, so keep the art simple.' },
 { row: 'Heat transfer', use: 'Full-color art on eligible products', notes: 'Another way to get full color. Ask us to price it against dye-sublimation.' },
]

const useCases = [
 { name: 'Trade show attendee badges', detail: 'Sponsor or show branding on every attendee’s neck. Check the sponsor’s logo rules and your badge weight.' },
 { name: 'Corporate office ID', detail: 'A company-branded lanyard with a clip or badge reel for daily ID.' },
 { name: 'Hospital and clinical staff', detail: 'Staff ID, often with breakaway hardware. Check your facility’s policy first.' },
 { name: 'School and university', detail: 'Student, faculty, and visitor ID with eligible logo, color, and hardware options.' },
 { name: 'Conference and event staff', detail: 'A “STAFF” or “CREW” print and a different color make roles easy to spot.' },
 { name: 'VIP and sponsor tiers', detail: 'A different color or material for VIPs, speakers, and sponsors.' },
]

const faqs = [
 { q: 'Which lanyard width should I choose?', a: 'Go wider for long logos and heavy badges, and narrower for small ID cards. Send the badge size and logo and we’ll suggest one.' },
 { q: 'Should I use silk-screen, dye-sublimation, or woven?', a: 'Silk-screen for simple logos, dye-sublimation for full color, woven for a textured look.' },
 { q: 'What lanyard hardware do I need for a heavy badge?', a: 'A metal clip or swivel hook usually holds better than plastic. Tell us what the badge weighs and we’ll check the options.' },
  { q: 'Are breakaway safety lanyards required?', a: 'Requirements vary by employer, venue, and work setting. Check the applicable policy before choosing hardware for your program.' },
 { q: 'Can I order eco-friendly or sustainable lanyards?', a: 'Yes, ask about recycled rPET, bamboo, or cotton. If you plan to make an environmental claim at your event, get the product’s documentation first.' },
  { q: 'What\'s the minimum lanyard order?', a: 'Your quote lists the minimum for the product and method. Share your quantity so we can confirm suitable options.' },
  { q: 'How long does a lanyard order take?', a: 'Stock, production capacity, and shipping drive the timeline. Send your event date and we’ll tell you if it works.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Lanyards Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Lanyards in Las Vegas',
 serviceType: 'Branded lanyards for trade shows, conferences, corporate ID, and staff identification',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Custom Lanyards</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Convention SWAG
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
	 Custom Lanyards in Las Vegas <span class="text-gold-700">for trade shows, conferences, and staff ID.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
	 Printed or woven lanyards with the clip your badge needs, planned back from your event date.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
	 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A lanyard program planned around your Vegas event.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Decoration Methods</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Pick the method that <span class="text-gold-600">matches the art.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
          Your art usually decides it.
 </p>
 </div>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Method</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">When to Use</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {decorations.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Use Cases</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six places lanyards do the work of identification.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {useCases.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom lanyards for Vegas conventions, conferences, and staff ID.
 </h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
	 Las Vegas hosts trade shows across construction, building products, HVAC, equipment, hospitality, and consumer categories. Start with the attendee count, the badge you’ll hang from it, and the date the lanyards need to reach the show.
 </p>
 <p>
	 A heavy badge needs a wider strap and a sturdier clip, while a thin one works with almost anything.
 </p>
 <p>
	 For a one- or two-color logo, silk-screen is the usual pick. Photos and gradients point to dye-sublimation, and a woven lanyard gives a more textile look.
 </p>
 <p>
          Breakaway clips release under pull, so they’re common for staff who work around people or equipment. Check whether your employer or venue requires them.
 </p>
 <p>
 For event-paired apparel, see our <a href="/trade-show-apparel-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">trade show apparel guide</a>. For broader event SWAG including drinkware, bags, and tech, see the <a href="/promo-products-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">promo products hub</a>.
 </p>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Lanyard questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/trade-show-apparel-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Trade Show Apparel</h3>
 <p class="mt-2 text-sm text-ash">Booth crew apparel that pairs with the badge program.</p>
 </a>
 <a href="/promo-products-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Promo Products Hub</h3>
 <p class="mt-2 text-sm text-ash">Drinkware, bags, tech: the full event SWAG range.</p>
 </a>
 <a href="/custom-yeti-drinkware-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Yeti Drinkware</h3>
 <p class="mt-2 text-sm text-ash">Higher-tier giveaway for qualified leads or sponsor gifting.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to brand your lanyards?</h2>
 <p class="mb-8 text-lg text-white/80">Send your art, quantity, and event date.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
