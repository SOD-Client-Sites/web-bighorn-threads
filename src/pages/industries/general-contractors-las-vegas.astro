---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'General Contractor Uniforms & Crew Apparel Las Vegas | Bighorn Threads',
 description:
 'Crew uniforms, sub branding, hi-vis, and new-hire kits for Las Vegas general contractors, with one contact from quote to delivery.',
 h1Pre: 'General Contractors',
}

const challenges = [
 { num: '01', title: 'Sub-crew identification', body: 'Put your company name and each crew’s role on what they wear, so you can tell whose people are whose on a busy site.' },
 { num: '02', title: 'New-hire turnover', body: 'A set kit for each role means you don’t pick products from scratch every time someone starts. Send the sizes and the start date.' },
 { num: '03', title: 'Foreman vs field differentiation', body: 'Use a different color or decoration to set foremen apart. If they’re in hi-vis, your job’s required class comes first.' },
 { num: '04', title: 'Trade show and event deadlines', body: 'Send the product, quantity, logo, and date early. We’ll tell you whether a rush is possible before you order.' },
]

const kits = [
 { role: 'Field Crew', items: 'Polos, tees, outerwear, or headwear as requested', notes: 'A starting point. Your quote lists the exact products and quantities.' },
 { role: 'Foreman / Supervisor', items: 'Collared shirts, outerwear, or the hi-vis class your job requires', notes: 'Your safety lead signs off on anything protective.' },
 { role: 'Office / Project Manager', items: 'Polos, quarter-zips, outerwear, or accessories', notes: 'The layer people wear to client meetings and job walks.' },
 { role: 'New Hire Onboarding', items: 'Tees, polos, headwear, and any safety apparel your job requires', notes: 'Send the sizes and start date, and we’ll confirm stock and timing.' },
]

const faqs = [
 {
 q: 'Can you outfit our subs in our brand without going through their procurement?',
 a: 'Yes. Send the approved products, who gets billed, and the sizes, and we can run it as a bulk order. Tell us if you’d rather have a store, and we’ll say what it can do.',
 },
 {
 q: 'How fast can you turn around 100 polos for a Monday job walk?',
 a: 'Your logo files, stock on the polo, and that week’s production schedule decide it. Call with the deadline and the style, and we’ll tell you straight whether it works and what any rush charge would be.',
 },
 {
 q: 'Do you stock common Carhartt and Port Authority items?',
 a: 'We don’t hold stock, but we can quote Carhartt K87 and K84 tees, Port Authority K500 polos, and Carhartt hoodies. We check sizes and lead times with suppliers when you order.',
 },
 {
 q: 'Can a company store handle multiple cost centers (jobs, divisions)?',
 a: 'Tell us how you split costs by job, division, or PO. We’ll put in writing what your store can report before setup.',
 },
 {
 q: 'Can you handle trade shows and AGC events?',
 a: 'Yes. We do apparel and merch for booths and show crews. Send the show date and venue, and we’ll tell you whether it can get there in time.',
 },
 {
 q: 'Do you offer pricing tiers based on annual spend?',
 a: 'Tell us your expected annual volume and we’ll ask suppliers for volume pricing, then show you what we can offer.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'General Contractors', item: 'https://bighornthreads.com/industries/general-contractors-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for General Contractors',
 serviceType: 'Branded apparel and crew uniforms',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'General Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/general-contractors-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">General Contractors</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Crew Uniforms, Sub Branding, and Onboarding Kits <span class="text-gold-700">for Vegas GCs.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 From a small framing outfit to a large commercial GC, we manage your products, logo, and reorders, and production partners do the decoration.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/company-stores/" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 See Company Stores
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Most general contractors outfit by role: field shirts for crews, polos for project teams, and the hi-vis class the job calls for. We help you build that list and get your logo on it.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Why GCs hire us — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why GCs Hire Us</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four problems <span class="text-gold-600">GCs run into.</span></h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {challenges.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="mb-4 inline-block font-mono text-xs font-bold tracking-wider text-gold-600">{c.num}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-base leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Standard kits — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Starter Kits by Role</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Plan kits by role. <span class="text-gold-600">Confirm every order.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Set a kit for each role, then send a new hire’s sizes and start date. We confirm stock and delivery on each order.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-paper">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Role</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Example Items</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {kits.map((k) => (
 <tr>
 <td class="px-6 py-5 align-top">
 <span class="font-heading text-base font-bold text-charcoal">{k.role}</span>
 </td>
 <td class="px-6 py-5 align-top text-sm text-charcoal">{k.items}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{k.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Planning branded apparel for Las Vegas general contractors.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A general contractor usually needs one program that covers field crews, project managers, and the people clients meet. You get one contact in Las Vegas who keeps the products and logo straight.
 </p>
 <p>
 A field-crew package might be a tee, work pants, and headwear, with lighter fabrics for summer and your heat plan in mind. Tell us the brands you like and we’ll price them. Hard hat decals need an OK from your safety lead and the helmet maker first.
 </p>
 <p>
 Project managers and superintendents usually want something different from field crews: polos, quarter-zips, or softshells. You’ll see logo placement and any names on a proof before you approve.
 </p>
 <p>
 Crews near vehicles or traffic often need hi-vis. Tell us the class your site requires, and we can quote Class 2 and Class 3 options from brands such as ML Kishigo and Radians. The logo goes where the manufacturer allows it.
 </p>
 <p>
 Larger teams can use a company store built around an approved list. Your plan spells out allowances, reports, and shipping. FR and other protective gear still come from your hazard assessment.
 </p>
 <p>
 For practical planning, see <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how to outfit a construction crew in Vegas</a> and <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how many shirts per crew member</a>. The <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">new hire workwear checklist</a> covers order inputs. The <a href="/blog/ppe-branded-workwear-regulations-construction-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">PPE and branded workwear regulations guide</a> summarizes employer and manufacturer review considerations.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions GCs <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR, hi-vis, and service uniforms for electrical crews.</p>
 </a>
 <a href="/industries/roofing-solar-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Roofing &amp; Solar</h3>
 <p class="mt-2 text-sm text-ash">Crew apparel for rooftop heat and long days in the sun.</p>
 </a>
 <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">How to Outfit a Crew</h3>
 <p class="mt-2 text-sm text-ash">What each role needs, how many, and how to order.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Ready to standardize <span class="text-gold-400">your crew's gear?</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Send your logo and the gear you want, and we’ll send back price and timing.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
