---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'General Contractor Uniforms and Crew Apparel | Las Vegas',
 description:
 'Branded workwear and apparel-program planning for Las Vegas general contractors. Bighorn coordinates approved products and decoration through production partners.',
 h1Pre: 'General Contractors',
 hero: '/images/generated/kit-gc.jpg',
}

const challenges = [
 { num: '01', title: 'Sub-crew identification', body: 'Role and company identification can be included in an apparel plan. Employers determine what identification, protective apparel, and site controls are required.' },
 { num: '02', title: 'New-hire turnover', body: 'Role-based kits can reduce repetitive product and sizing work. Delivery options and timing depend on the selected products and production partner.' },
 { num: '03', title: 'Foreman vs field differentiation', body: 'Color or decoration can distinguish roles when the employer approves the layout. Hi-vis class must be selected by the employer for the exact hazard and product.' },
 { num: '04', title: 'Trade show and event deadlines', body: 'Share the product, quantity, artwork, and deadline early. Bighorn confirms any rush option with the selected production partner before you order.' },
]

const kits = [
 { role: 'Field Crew', items: 'Polos, tees, outerwear, or headwear as requested', notes: 'Example categories only. Products, quantities, decoration, and protective requirements are confirmed in writing.' },
 { role: 'Foreman / Supervisor', items: 'Collared shirts, outerwear, or employer-selected hi-vis', notes: 'Any role differentiation and protective product must be approved by the employer.' },
 { role: 'Office / Project Manager', items: 'Polos, quarter-zips, outerwear, or accessories', notes: 'Exact products, quantities, use, care, availability, and decoration are confirmed in the quote.' },
 { role: 'New Hire Onboarding', items: 'Requested tees, polos, headwear, or employer-selected safety apparel', notes: 'Example categories only. Availability, quantities, platform capabilities, and delivery timing require written confirmation.' },
]

const faqs = [
 {
 q: 'Can you outfit our subs in our brand without going through their procurement?',
 a: 'Bighorn can plan a sub-tier or bulk-order approach around the approved products, billing contact, and sizes you provide. Store, payment, and delivery capabilities require written confirmation during setup.',
 },
 {
 q: 'How fast can you turn around 100 polos for a Monday job walk?',
 a: 'It depends on artwork readiness, blank availability, and how the rest of the production queue is sitting that week. Call us with the deadline and the spec — we\'ll tell you straight whether it works and what any rush surcharge would be.',
 },
 {
 q: 'Do you stock common Carhartt and Port Authority items?',
 a: 'Bighorn can quote Carhartt K87 and K84 t-shirts, Port Authority K500 polos, and Carhartt SUP01 hoodies. Sizes, product availability, and lead times depend on current supplier and production partner capacity.',
 },
 {
 q: 'Can a company store handle multiple cost centers (jobs, divisions)?',
 a: 'Job, division, and PO tracking can be included in the requested program scope. Bighorn confirms the available reporting and cost-allocation workflow in writing before setup.',
 },
 {
 q: 'What about major industry trade shows, major industry trade shows, or local AGC events?',
 a: 'Bighorn manages apparel and merchandise requests for booths and trade-show crews. Product availability, production, and delivery timing require written confirmation.',
 },
 {
 q: 'Do you offer pricing tiers based on annual spend?',
 a: 'Share your projected annual volume and Bighorn can request volume pricing and production options from the selected partners. Pricing and capacity are confirmed in each written quote.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'General Contractors', item: 'https://bighornthreads.com/industries/general-contractors-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for General Contractors',
 serviceType: 'Branded apparel and crew uniforms',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'General Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/general-contractors-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">General Contractors</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Crew Uniforms, Sub Branding, and Onboarding Kits <span class="text-gold-400">for Vegas GCs.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Whether you run a small framing outfit or a large commercial GC, Bighorn manages approved products, artwork, and reorders. Production partners handle decoration. Rush timing requires written confirmation.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/company-stores/" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 See Company Stores
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 General contractors can organize apparel by role, such as field shirts, polos for project teams, and employer-selected hi-vis where the job requires it. Bighorn helps define the requested catalog and coordinates partner artwork and decoration. Product performance depends on the exact item, use, care, employer requirements, and manufacturer instructions. Store, allowance, rush, and delivery capabilities are confirmed in writing for the proposed program.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Why GCs hire us — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why GCs Hire Us</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four apparel-program problems <span class="text-gold-600">to plan for.</span></h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {challenges.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="mb-4 inline-block font-mono text-xs font-bold tracking-wider text-gold-600">{c.num}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-base leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Standard kits — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Example Kit Categories</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Plan kits by role. <span class="text-gold-600">Confirm every order.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Bighorn can organize approved kit details by role. Send the new hire's sizes and required date. Product availability, decoration, and delivery terms are confirmed for each order.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-paper">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Role</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Example Items</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {kits.map((k) => (
 <tr>
 <td class="px-6 py-5 align-top">
 <span class="font-heading text-base font-bold text-charcoal">{k.role}</span>
 </td>
 <td class="px-6 py-5 align-top text-sm text-charcoal">{k.items}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{k.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Planning branded apparel for Las Vegas general contractors.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 General contractors often need one apparel program to serve field crews, project managers, and client-facing leadership. Bighorn provides Las Vegas account management, helps organize the requested products and artwork, and coordinates production through selected partners.
 </p>
 <p>
 A proposed field-crew package might include a tee, work pants, and headwear, with other fabric options considered for hot weather. Product performance depends on the exact item, work, fit, care, employer heat plan, and manufacturer instructions. Bighorn can quote requested brands and decoration methods after supplier availability, partner capacity, pricing, and artwork are reviewed. Hard-hat products and any decoration must be approved by the employer and helmet manufacturer before use.
 </p>
 <p>
 Project managers and superintendents may need a different product mix from field crews. Polos, quarter-zips, and softshells are examples to evaluate based on brand standards, job duties, supplier availability, and the written quote. Decoration placement and employee personalization are confirmed with the production partner before approval.
 </p>
 <p>
 Hi-vis may be part of an employer or site specification where crews work near vehicles, civil operations, or traffic. Bighorn can source proposed Class 2 and Class 3 products from brands such as ML Kishigo and Radians. The employer selects the required class, and each product and decoration placement must be reviewed against current manufacturer instructions before approval.
 </p>
 <p>
 For larger teams, Bighorn can scope a company-store workflow around an approved catalog and the sizes supplied by the client. Access, allowances, reporting, reorder, payment, production, fulfillment, and delivery capabilities must be confirmed in the written program plan. Employers remain responsible for hazard assessment and selection of any FR or other protective product, with decoration reviewed against current manufacturer instructions.
 </p>
 <p>
 For practical planning, see <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how to outfit a construction crew in Vegas</a> and <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how many shirts per crew member</a>. The <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">new hire workwear checklist</a> covers order inputs. The <a href="/blog/ppe-branded-workwear-regulations-construction-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">PPE and branded workwear regulations guide</a> summarizes employer and manufacturer review considerations.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions GCs <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected FR, hi-vis, and service-uniform options coordinated through production partners.</p>
 </a>
 <a href="/industries/roofing-solar-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Roofing &amp; Solar</h3>
 <p class="mt-2 text-sm text-ash">Branded apparel options reviewed against employer heat plans and manufacturer instructions.</p>
 </a>
 <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">How to Outfit a Crew</h3>
 <p class="mt-2 text-sm text-ash">A planning guide for products, quantities, roles, artwork, and current order terms.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Ready to standardize <span class="text-gold-400">your crew's gear?</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Send your logo and requested products. We will confirm availability, pricing, and partner production terms.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
