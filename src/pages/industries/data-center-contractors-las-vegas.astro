---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Workwear for Data Center Contractors in Las Vegas | Bighorn Threads',
 description:
 'Hi-vis, arc-rated gear, commissioning polos, and NDA-friendly branding for Las Vegas data center contractors.',
 h1Pre: 'Data Center Contractors',
}

const compliance = [
 {
 code: 'NFPA 70E',
 title: 'Arc-rated apparel for switchgear and medium-voltage work',
 body: '<a href="https://www.bulwarkprotection.com/" rel="noopener" class="text-gold-700 hover:underline">Bulwark</a>, <a href="https://www.carhartt.com/category/mens/fr-flame-resistant-clothing.html" rel="noopener" class="text-gold-700 hover:underline">Carhartt FR</a>, and other FRC shirts offer published ratings. See <a href="https://www.nfpa.org/codes-and-standards/all-codes-and-standards/list-of-codes-and-standards/detail?code=70E" rel="noopener" class="text-gold-700 hover:underline">NFPA 70E</a>. Your safety lead picks the garment, and we arrange the logo work once it’s approved.',
 },
 {
 code: 'NFPA 2112',
 title: 'Flash-fire garments, when your assessment calls for them',
 body: 'Your site hazard assessment picks the garment. We’ll add a logo once the manufacturer confirms the method and placement.',
 },
 {
 code: 'ANSI/ISEA 107 Class 2 + 3',
 title: 'Hi-vis for the civil and steel phases',
 body: 'You choose the required visibility class under <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a>. We check each garment and logo placement against the maker’s instructions.',
 },
]

const gear = [
 { name: 'FR and arc-rated apparel', detail: 'Rating from your hazard assessment · logo needs written approval', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=549020207&RS=300' },
 { name: 'Hi-vis Class 2 + Class 3', detail: 'The class your site requires · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=913213443&RS=300' },
 { name: 'Commissioning polos', detail: 'Port Authority K500 · embroidered chest · tour-ready for client walkthroughs', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
 { name: 'Hard hat decals', detail: 'Needs an OK from your safety lead and the helmet maker first', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52649&P=596831160&RS=300' },
]

const useCases = [
 'Multi-trade GC crews on new build: electrical, mechanical, controls, fiber',
 'Electrical teams in the PPE your safety lead specifies for each task',
 'Commissioning teams transitioning from hi-vis to clean polos at turnover',
 'NDA-controlled orders with job-site-only branding (no public company marks)',
 '24/7 ops crews for colo tenants running day/night shift uniforms',
 'Visitor / vendor badged polos for controlled-access facility tours',
 'Foreman and superintendent differentiation across dozens of subs',
 'Multi-site programs for approved contractor locations',
]

const faqs = [
 {
 q: 'Can you quote the electrical PPE our safety lead specified?',
 a: 'Yes. Send us the product spec and we’ll quote it. Any logo needs an OK from your safety lead and the garment maker before production.',
 },
 {
 q: 'Some of our data center clients have NDAs, can we order without showing the end-client\'s name?',
 a: 'Yes. We can use your company logo, an approved project code, or no project mark at all. Tell us your NDA terms and we’ll put the handling in writing.',
 },
 {
 q: 'What\'s the difference between construction-phase uniforms and operations uniforms for a data center?',
 a: 'Construction leans toward hi-vis and protective gear, while operations leans toward polos and clean service wear. Your hazard assessment decides the protective part, and we can set up the gear by phase and role.',
 },
 {
 q: 'Do you handle ESD-safe or cleanroom-adjacent apparel?',
 a: 'Send us your site’s cleanroom, ESD, or FR spec and we’ll quote the approved product. We can’t tell you whether a garment is right for a controlled environment. That call belongs to your site team.',
 },
 {
 q: 'Our GC runs multiple data center projects at once. Can you standardize uniforms across job sites?',
 a: 'A company store is the usual way. Every site orders from one approved list, so the logo and the polo stay the same across jobs. Your proposal covers access and shipping.',
 },
 {
 q: 'We\'ve got a commissioning deadline. What\'s your rush turnaround on embroidered polos?',
 a: 'Call with the date first. Stock, how ready your logo is, quantity, and production capacity decide it, and we’ll tell you the timing and any rush charge before you order.',
 },
 {
 q: 'Can you brand hard hats?',
 a: 'Only with approval from your safety lead and the helmet maker, since adhesives and placement can affect a hard hat. Send us the approved material, size, and placement, and we’ll quote the decals.',
 },
 {
 q: 'Can you work with GCs on Vegas data center campuses?',
 a: 'Yes. You get one contact in Las Vegas, and your product, safety, NDA, and delivery requirements go in the written scope.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Data Center Contractors', item: 'https://bighornthreads.com/industries/data-center-contractors-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Data Center Contractors',
 serviceType: 'Branded apparel coordination for data center construction and operations',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: {
 '@type': 'BusinessAudience',
 audienceType: 'Data Center Contractors and Mission-Critical Builders',
 },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/data-center-contractors-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Data Center Contractors</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre} · Las Vegas Valley</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Mission-Critical Uniforms for <span class="text-gold-700">Vegas Data Center Builds.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 FR apparel to your spec, ANSI/ISEA 107 hi-vis, and commissioning polos. One contact runs it, and production partners make it.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Data center crews wear different gear by phase and role. Your site hazard assessment sets the protection, and we handle FR apparel, hi-vis, commissioning polos, and NDA-friendly branding.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Vegas DC context — paper -->
 <section class="border-y border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">What Makes These Jobs Different</p>
 <h2 class="mb-6 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Many trades, <span class="text-gold-600">one controlled site.</span></h2>
 <p class="mb-5 text-lg leading-relaxed text-ash">
 A data center job can bring civil, electrical, mechanical, controls, fiber, commissioning, and operations teams through one site, and each phase can call for different identification, branding, and protective gear.
 </p>
 <p class="mb-5 text-lg leading-relaxed text-ash">
 Your site safety team sets the protective requirements, and the project owner may add security and branding rules. We quote from those written requirements.
 </p>
 <p class="text-lg leading-relaxed text-ash">
 Send your safety spec, branding rules, NDA requirements, quantity, and deadline, and we’ll put it all in one written quote.
 </p>
 </div>
 </section>

 <!-- Compliance hero strip — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">We speak your safety officer's <span class="text-gold-600">language.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Your spec may come from the prime contractor, the client, or both. Your safety lead sets the requirements, and we find garments that meet them and keep the approved details for repeat orders.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Product options: paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">data center builds.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Split hi-vis, FR apparel, commissioning polos, and operations gear by phase or role.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for data center contractors.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 What people wear changes between construction, commissioning, and operations. A company store can keep it organized, and your proposal says what it can do.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 <a href="/services/rush-orders-las-vegas/" class="btn-secondary text-sm">Rush Orders →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear for Las Vegas data center contractors.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 On a controlled site, what people wear may need to identify the contractor, trade, role, or project code. Protective requirements still come from your hazard assessment.
 </p>
 <p>
 Civil and structural crews may need ANSI/ISEA 107 garments, and commissioning teams usually wear something cleaner. Put quantities, class, colors, logos, and project identifiers in your spec.
 </p>
 <p>
 No single rating fits every data center task, so we start from your assessment and written spec. Logo method and placement get checked with your safety lead and the garment maker. If you need paperwork, ask early.
 </p>
 <p>
 Commissioning teams often want performance polos for client walkthroughs. You’ll see placement and project identifiers on a proof, and we’ll give you timing in writing.
 </p>
 <p>
 A company store can hold your approved list, and you can ask about allowances.
 </p>
 <p>
 For a focused breakdown of site-specific workwear programs at hyperscaler builds, see our <a href="/blog/branded-workwear-data-center-contractors-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">branded workwear for data center contractors in Las Vegas</a> guide.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions data center contractors <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related Reading</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR shirts, hi-vis, and service uniforms for Vegas electrical crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew gear, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/blog/nfpa-70e-fr-shirts-vegas-electricians/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">NFPA 70E Shirt Guide</h3>
 <p class="mt-2 text-sm text-ash">A primer on arc-flash apparel to go over with your safety lead.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo <span class="text-gold-400">and your deadline.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Include your safety, branding, and product requirements, and we’ll come back with a written quote.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
