---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Workwear for Data Center Contractors in Las Vegas',
 description:
 'Apparel-program planning for Las Vegas data-center contractors. Bighorn coordinates employer-approved products and decoration through selected production partners.',
 h1Pre: 'Data Center Contractors',
 hero: '/images/generated/kit-electrical.jpg',
}

const compliance = [
 {
 code: 'NFPA 70E',
 title: 'Arc-rated apparel for switchgear and medium-voltage work',
 body: '<a href="https://www.bulwarkprotection.com/" rel="noopener" class="text-gold-700 hover:underline">Bulwark</a>, <a href="https://www.carhartt.com/category/mens/fr-flame-resistant-clothing.html" rel="noopener" class="text-gold-700 hover:underline">Carhartt FR</a>, and other FRC shirts offer published ratings. See <a href="https://www.nfpa.org/codes-and-standards/all-codes-and-standards/list-of-codes-and-standards/detail?code=70E" rel="noopener" class="text-gold-700 hover:underline">NFPA 70E</a>. Your employer selects the garment. Bighorn coordinates approved decoration through a selected production partner.',
 },
 {
 code: 'NFPA 2112',
 title: 'Flash-fire garments only when the employer identifies that hazard',
 body: 'Employers must select protective garments from current manufacturer documentation and the site hazard assessment. Bighorn can coordinate approved products and partner decoration after the manufacturer confirms the proposed method and placement.',
 },
 {
 code: 'ANSI/ISEA 107 Class 2 + 3',
 title: 'Hi-vis for the civil and steel phases',
 body: 'The employer selects the required visibility class under <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a>. Each proposed garment and decoration placement must be approved against current manufacturer instructions before use.',
 },
]

const gear = [
 { name: 'Employer-selected protective apparel', detail: 'The task-specific hazard assessment and complete PPE system control; decoration requires exact written approval', img: '/images/generated/kit-electrical.jpg' },
 { name: 'Hi-vis Class 2 + Class 3', detail: 'Employer-selected class · manufacturer-approved decoration placement', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Commissioning polos', detail: 'Port Authority K500 · embroidered chest · tour-ready for client walkthroughs', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Hard hat decal coordination', detail: 'Employer and helmet-manufacturer approval required before application', img: '/images/generated/kit-office-sales.jpg' },
]

const useCases = [
 'Multi-trade GC crews on new build — electrical, mechanical, controls, fiber',
 'Electrical teams using the complete PPE system selected by the employer for the exact task',
 'Commissioning teams transitioning from hi-vis to clean polos at turnover',
 'NDA-controlled orders with job-site-only branding (no public company marks)',
 '24/7 ops crews for colo tenants running day/night shift uniforms',
 'Visitor / vendor badged polos for controlled-access facility tours',
 'Foreman and superintendent differentiation across dozens of subs',
 'Multi-site programs for approved contractor locations',
]

const faqs = [
 {
 q: 'Can you quote the electrical PPE selected by our employer for a data center task?',
 a: 'Bighorn can request a quote after receiving the employer-approved product specification. The employer selects the complete PPE system, and the exact garment and decoration require current manufacturer and employer approval before production.',
 },
 {
 q: 'Some of our data center clients have NDAs — can we order without showing the end-client\'s name?',
 a: 'An NDA-aware order can use your company logo, an approved project code, or no public project mark. Bighorn confirms artwork, access, record handling, and production terms in the written scope.',
 },
 {
 q: 'What\'s the difference between construction-phase uniforms and operations uniforms for a data center?',
 a: 'Programs can be planned by phase and role, but the employer owns the hazard assessment and protective-product selection. Bighorn coordinates approved apparel and decoration through production partners after the written specification is received.',
 },
 {
 q: 'Do you handle ESD-safe or cleanroom-adjacent apparel?',
 a: 'Cleanroom, ESD-control, and FR requirements must come from the employer and site specification. Bighorn does not determine whether a garment is suitable for a hazard or controlled environment, but can quote an approved product request.',
 },
 {
 q: 'Our GC runs multiple data center projects at once. Can you standardize uniforms across job sites?',
 a: 'A proposed store could organize an approved catalog if the selected platform and configuration do. No platform has been selected or launched. User access, ordering, payment, inventory, production, shipping, reorder review, implementation, and capabilities require separate written approval.',
 },
 {
 q: 'We\'ve got a commissioning deadline. What\'s your rush turnaround on embroidered polos?',
 a: 'Rush options depend on product availability, artwork readiness, quantity, and production partner capacity. Share the deadline early. Bighorn confirms timing and cost in writing.',
 },
 {
 q: 'Can you brand hard hats and decals to OSHA placement rules?',
 a: 'Any hard-hat decal, adhesive, size, and placement must be approved by the employer and helmet manufacturer. Bighorn can coordinate a quoted decal request after that written approval is provided.',
 },
 {
 q: 'Do you work with the GCs building the major Vegas data center campuses?',
 a: 'Bighorn provides Las Vegas account management and can plan apparel for data-center contractors. Product, safety, NDA, production, and delivery requirements are documented in the written scope.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Data Center Contractors', item: 'https://bighornthreads.com/industries/data-center-contractors-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Data Center Contractors',
 serviceType: 'Branded apparel coordination for data center construction and operations',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: {
 '@type': 'BusinessAudience',
 audienceType: 'Data Center Contractors and Mission-Critical Builders',
 },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/data-center-contractors-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Data Center Contractors</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre} · Las Vegas Valley</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Mission-Critical Uniforms for <span class="text-gold-400">Vegas Data Center Builds.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Compare employer-approved FR apparel, ANSI/ISEA 107 hi-vis options, and commissioning polos. Bighorn coordinates selected products and decoration through production partners.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Data center contractors may need different apparel by phase and role. Employers select protective products from the site hazard assessment. Bighorn can coordinate approved FR apparel, hi-vis options, commissioning polos, and NDA-aware branding through selected production partners.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Vegas DC context — paper -->
 <section class="border-y border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Vegas Market Context</p>
 <h2 class="mb-6 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">The data center wave <span class="text-gold-600">is here.</span></h2>
 <p class="mb-5 text-lg leading-relaxed text-ash">
 Data center projects can involve civil, electrical, mechanical, controls, fiber, commissioning, and operations teams. Each phase can require different identification, branding, and protective-apparel specifications.
 </p>
 <p class="mb-5 text-lg leading-relaxed text-ash">
 The employer and site safety team define protective-apparel requirements. Project owners may also set security and branding rules. Bighorn uses those written requirements to prepare an apparel-program quote.
 </p>
 <p class="text-lg leading-relaxed text-ash">
 Bighorn provides Las Vegas account management for contractor apparel programs and coordinates approved products and decoration through production partners. Share the employer safety specification, branding rules, NDA requirements, quantity, and deadline so each term can be confirmed in writing.
 </p>
 </div>
 </section>

 <!-- Compliance hero strip — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">We speak your safety officer's <span class="text-gold-600">language.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Data center builds can use safety specifications from the prime contractor, client, or both. Your safety lead owns those requirements. Bighorn can source options and coordinate approved product and decoration details for repeat orders.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Product options: paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to consider for <span class="text-gold-600">data center builds.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 A program can separate employer-approved hi-vis, FR apparel, commissioning polos, and operations gear by phase or role.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for data center contractors.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Apparel needs can change between construction, commissioning, and operations. A company-store workflow may help organize approved products, but capabilities and terms require written confirmation.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 <a href="/services/rush-orders-las-vegas/" class="btn-secondary text-sm">Rush Orders →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear for Las Vegas data center contractors — the real spec.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Data center work can bring several trades onto one controlled site. Apparel may need to identify the contractor, trade, role, or approved project code. Protective requirements still come from the employer's hazard assessment and current manufacturer documentation.
 </p>
 <p>
 Civil and structural crews may need employer-selected ANSI/ISEA 107 garments. Commissioning teams may use different approved apparel. Garment quantities, visibility class, colors, decoration, and project identifiers belong in the written specification.
 </p>
 <p>
 Electrical work requires an employer-led hazard assessment. No single rating fits every data center task. Bighorn can quote selected FR products after receiving the written specification. Decoration methods, placement, and supporting documentation require manufacturer, employer, and production-partner confirmation.
 </p>
 <p>
 Commissioning teams can request performance polos or other approved presentation apparel. Product availability, logo placement, project identifiers, quantity, proofing, production capacity, and timing require written confirmation.
 </p>
 <p>
 A proposed company store could support approved products and allowances if the selected platform and configuration do. No platform has been selected or launched. Decoration, delivery, batching, pricing, timing, implementation, and capabilities require separate written approval.
 </p>
 <p>
 For a focused breakdown of site-specific workwear programs at hyperscaler builds, see our <a href="/blog/branded-workwear-data-center-contractors-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">branded workwear for data center contractors in Las Vegas</a> guide.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions data center contractors <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related Reading</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR shirts, hi-vis, and service uniforms for Vegas electrical crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew gear, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/blog/nfpa-70e-fr-shirts-vegas-electricians/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">NFPA 70E Shirt Guide</h3>
 <p class="mt-2 text-sm text-ash">An educational primer for discussing arc-flash apparel with your safety lead.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo. <span class="text-gold-400">Share your deadline and project requirements.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Talk with the Las Vegas account team about the written safety, branding, product, and timing requirements.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
