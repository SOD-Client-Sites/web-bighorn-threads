---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Workwear for Electrical Contractors in Las Vegas | Bighorn Threads',
 description:
 'FR shirts, hi-vis, and service uniforms for Las Vegas electrical contractors, with logos done the way the garment maker allows.',
 h1Pre: 'Electrical Contractors',
}

const compliance = [
 {
 code: 'NFPA 70E',
 title: 'Arc-rated apparel for the field',
 body: '<a href="https://www.bulwarkprotection.com/" rel="noopener" class="text-gold-700 hover:underline">Bulwark</a>, <a href="https://www.carhartt.com/category/mens/fr-flame-resistant-clothing.html" rel="noopener" class="text-gold-700 hover:underline">Carhartt FR</a>, and other FRC shirts offer published ratings. See the <a href="https://www.nfpa.org/codes-and-standards/all-codes-and-standards/list-of-codes-and-standards/detail?code=70E" rel="noopener" class="text-gold-700 hover:underline">NFPA 70E standard</a>. Your safety lead picks the garment, and we arrange the logo work once the method is approved.',
 },
 {
 code: 'ANSI/ISEA 107',
 title: 'Hi-vis for service crews and roadside work',
 body: 'You choose the required visibility class under <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a>. We check each garment and logo placement against the maker’s instructions.',
 },
 {
 code: 'OSHA 1910.269',
 title: 'PPE to your spec sheet',
 body: 'Your safety manager sets the gear required under <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1910/1910.269" rel="noopener" class="text-gold-700 hover:underline">OSHA 1910.269</a>. We can quote PIP, ML Kishigo, Bulwark, Wrangler Riggs, and others, and we check stock on each order.',
 },
]

const gear = [
 { name: 'Arc-rated shirts', detail: 'Rating from your hazard assessment · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=549020207&RS=300' },
 { name: 'Hi-vis shirts', detail: 'The class your job requires · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=913213443&RS=300' },
 { name: 'Branded service polos', detail: 'Your brand and color · embroidered after you approve the proof', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
 { name: 'Hard hat stickers', detail: 'Needs an OK from your safety lead and the helmet maker first', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52649&P=596831160&RS=300' },
]

const useCases = [
 'Service truck crew uniforms with embroidered name + company logo',
 'New-hire kits with the garments and quantities you set',
 'Apprentice gear allowances tied to hour milestones',
 'Foreman and supervisor differentiation (color, embroidery vs print)',
 'Trade show + IBEW event apparel for Las Vegas locals',
 'Branded swag for journeyman recruiting drives',
]

const faqs = [
 {
 q: 'Can you embroider an FR shirt?',
 a: 'Often, yes, but your safety lead and the garment maker have to OK the method, materials, and placement first, because decoration can affect the rating. Send us their approval and we’ll set it up.',
 },
 {
 q: 'What\'s the minimum order for hi-vis Class 2 shirts?',
 a: 'The garment and decoration method set it. Send your size list and deadline, and we’ll give you the minimum, stock, and timing.',
 },
 {
 q: 'Do you do rush orders for service trucks getting wrapped or new fleets?',
 a: 'Call with the date first. Stock, how ready your logo is, quantity, and production capacity decide it, and we’ll tell you the timing and any rush charge before you order.',
 },
 {
 q: 'What brands can you get for electrical contractors?',
 a: 'We don’t hold stock, but we can quote Bulwark, Carhartt FR, PIP, ML Kishigo, and others to your spec. We check sizes and price on each order.',
 },
 {
 q: 'Can you set up a company store so my apprentices can order their own gear?',
 a: 'Yes. Your crew orders approved gear in their own sizes. Tell us about allowances and who approves what, and your proposal will say what the store can do.',
 },
 {
 q: 'Can you customize hard hats?',
 a: 'Only with approval from your safety lead and the helmet maker, since adhesives and placement can affect a hard hat. Send us the approved material, size, and placement, and we’ll quote the decals.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Electrical Contractors', item: 'https://bighornthreads.com/industries/electrical-contractors-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Electrical Contractors',
 serviceType: 'Branded apparel coordination for electrical contractors',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: {
 '@type': 'BusinessAudience',
 audienceType: 'Electrical Contractors',
 },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/electrical-contractors-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Electrical Contractors</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 FR Shirts, Hi-Vis, and Service Uniforms <span class="text-gold-700">Built for Vegas Electrical Crews.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Arc-rated and hi-vis gear plus branded service polos for Las Vegas electrical crews. Your hazard assessment sets the protection, and we quote garments that meet it.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Las Vegas electrical crews typically wear arc-rated FR shirts, hi-vis, and service polos. Your safety lead sets the PPE, and we handle the garments and the logo work through production partners.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance hero strip — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">We speak your safety manager's <span class="text-gold-600">language.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Your safety officer or master electrician sets the requirements. We find garments that meet them and keep the approved details for repeat orders.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- What we make — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">electrical crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Start here with your safety lead, then tell us the exact garments you want.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases / typical orders — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for electrical shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Order in bulk or set up a company store. Your quote or proposal lists the terms.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 FR and service workwear for Las Vegas electrical contractors.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Electrical work usually falls under NFPA 70E, and your hazard assessment sets the protection. No single garment rating fits every task, so we start from your written spec.
 </p>
 <p>
 A job title or voltage doesn’t set a PPE category on its own. Your task-specific assessment does: the garment, rating, layers, and visibility class. Send us that spec and we’ll quote it.
 </p>
 <p>
 A logo can affect how an FR garment performs, so your safety lead and the garment maker approve the method, materials, and placement before production. If you need paperwork for your files, ask early.
 </p>
 <p>
 Solar electrical crews work the same way: your assessment sets the rating, then we quote FR and hi-vis options to match.
 </p>
 <p>
 A company store lets crews order approved gear in their own sizes, and you can ask about allowances.
 </p>
 <p>
 To go over with your safety lead, see our <a href="/blog/nfpa-70e-fr-shirts-vegas-electricians/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">NFPA 70E FR shirts for Vegas electricians</a> guide. For telling roles apart, our <a href="/blog/apprentice-journeyman-uniforms-differentiation/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">apprentice vs journeyman uniforms</a> and <a href="/blog/foreman-supervisor-shirts-visual-authority/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">foreman and supervisor shirts for visual authority</a> guides have examples.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions electrical contractors <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related Reading</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/data-center-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Data Center Contractors</h3>
 <p class="mt-2 text-sm text-ash">Hi-vis, arc-rated gear, and commissioning polos for data center crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew gear, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/blog/nfpa-70e-fr-shirts-vegas-electricians/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">NFPA 70E Shirt Guide</h3>
 <p class="mt-2 text-sm text-ash">A primer on arc-flash apparel to go over with your safety lead.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo <span class="text-gold-400">for a quote.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Send your logo and the garment spec from your safety lead, and we’ll quote the gear and the logo work.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
