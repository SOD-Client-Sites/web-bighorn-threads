---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Plumbing and HVAC Service Uniforms | Las Vegas',
 description:
 'Branded-apparel planning for Las Vegas plumbing and HVAC contractors. Bighorn coordinates approved products and decoration through selected production partners.',
 h1Pre: 'Plumbing & HVAC',
 hero: '/images/generated/kit-plumbing-hvac.jpg',
}

const compliance = [
 {
 code: 'Role Identification',
 title: 'Plan identification by role',
 body: 'A service-apparel plan can include approved company, technician, title, and contact details. The client approves the final artwork and decides which identifiers fit each role.',
 },
 {
 code: 'NV State Contractor Board',
 title: 'Review license-number artwork',
 body: 'License-number decoration can be requested. The contractor remains responsible for current Nevada requirements and final placement. Bighorn coordinates the client-approved artwork with the selected production partner. See <a href="https://nscb.nv.gov/" rel="noopener" class="text-gold-700 hover:underline">NSCB licensing information</a>.',
 },
 {
 code: 'OSHA / NIOSH Heat Stress',
 title: 'Review apparel within the heat plan',
 body: 'HVAC techs face serious heat exposure in Las Vegas attics. Bighorn can quote moisture-wicking polos and lightweight long-sleeves. Employers must select apparel within their heat plan. See <a href="https://www.osha.gov/heat-exposure" rel="noopener" class="text-gold-700 hover:underline">OSHA guidance</a> and <a href="https://www.cdc.gov/niosh/topics/heatstress/" rel="noopener" class="text-gold-700 hover:underline">NIOSH guidance</a>.',
 },
]

const gear = [
 { name: 'Embroidered service polos', detail: 'Requested brand and color · partner embroidery after proof approval', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Mechanic-style work shirts', detail: 'Requested Red Kap, Dickies, or comparable product, with partner decoration confirmed after proof approval', img: '/images/generated/kit-plumbing-hvac.jpg' },
 { name: 'Branded service tees', detail: 'Requested tee, color, use, quantity, and partner printing confirmed in the quote', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Tech name patches + tags', detail: 'Requested patch method and placement reviewed for the exact garment and production partner', img: '/images/generated/service-company-stores.jpg' },
]

const useCases = [
 'Residential service techs in embroidered polos with name + title (lead tech, journeyman, apprentice)',
 'Commercial mechanical crews in heavier work shirts with company name patch',
 'Install crews in branded tees and hi-vis when working new construction sites',
 'Dispatcher and office staff in lighter-weight branded polos for the front counter',
 'Apprentice / helper differentiation by polo color or sleeve embroidery',
 'Branded swag for trade shows, AGC events, and home shows around the valley',
]

const faqs = [
 {
 q: 'Can you do name embroidery on every shirt and still do it without slowing the order down?',
 a: 'Name embroidery is available on selected garments through production partners. Bighorn coordinates the approved names and placement. Your quote confirms pricing and timing for the final roster.',
 },
 {
 q: 'What\'s better for service techs — embroidered polos or mechanic-style work shirts?',
 a: 'Compare the exact polo and work shirt for job duties, employer requirements, fit, fabric, decoration, care process, and manufacturer instructions. Patch compatibility and product performance must be confirmed for the quoted garment.',
 },
 {
 q: 'Do you stock moisture-wicking polos for Vegas summer?',
 a: 'Bighorn can quote requested performance polos after reviewing current supplier availability, sizes, colors, pricing, and production partner capacity.',
 },
 {
 q: 'How do you handle name changes when a tech leaves or a new one starts?',
 a: 'Removable name patches may fit selected work-shirt programs. Production partners can also decorate replacement polos when needed. Your quote confirms garment compatibility, pricing, and timing.',
 },
 {
 q: 'Can you put our license number and service line on every shirt?',
 a: 'License and service-line artwork can be requested. The contractor approves legal requirements, content, and placement. Garment compatibility, decoration method, proof, pricing, and timing are confirmed in the quote.',
 },
 {
 q: 'Do you set up company stores for plumbing and HVAC shops?',
 a: 'A company-store program can be proposed for plumbing and HVAC shops. Catalog, allowance, access, payment, artwork retention, production, fulfillment, and delivery capabilities depend on the approved platform and written plan.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Plumbing & HVAC', item: 'https://bighornthreads.com/industries/plumbing-hvac-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Plumbing and HVAC Contractors',
 serviceType: 'Branded service uniforms and embroidered apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Plumbing and HVAC Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/plumbing-hvac-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Plumbing &amp; HVAC</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Service Tech Uniform Planning <span class="text-gold-400">for Plumbing and HVAC.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn helps Las Vegas plumbing and HVAC shops plan requested polos, work shirts, name patches, and branded apparel. We coordinate approved products and decoration through production partners after availability and terms are confirmed.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Plumbing and HVAC shops can compare embroidered polos, work shirts, name patches, and branded tees by role. The employer approves any identification, protective apparel, and heat-plan requirements. Product performance depends on the exact garment, work, fit, care, and current manufacturer instructions. Bighorn coordinates approved artwork and decoration through production partners.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance / trust strip — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why It Matters</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Define the apparel <span class="text-gold-600">for each role.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Service teams may request company, technician, title, or license information on approved garments. The client confirms the identifiers, placement, brand standards, and legal requirements before production.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- What we make — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to consider for <span class="text-gold-600">plumbing and HVAC shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Many shops use polos for residential service and work shirts for install crews. Bighorn can manage approved product and artwork details. Each reorder remains subject to current product availability and the approved proof.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for service shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Bulk orders and company-store workflows can both be considered. Store capabilities, minimums, pricing, production, fulfillment, and delivery terms require written confirmation.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded uniforms for Las Vegas plumbing, HVAC, and mechanical service crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Service-trade uniforms are part technician identification and part marketing. Work shirts, pants, logos, and name patches are product and decoration options to review for each role. Bighorn provides Las Vegas account management and coordinates the approved request through production partners; garment performance and laundry suitability must be confirmed with the manufacturer and laundry provider.
 </p>
 <p>
 Red Kap SP14, PT20, PT88, and SY24 products are examples a service team may request for review. Confirm current specifications, sizes, colors, supplier availability, decoration compatibility, and laundry-provider acceptance for the exact item. The employer selects apparel within its heat plan, and manufacturer instructions govern use and care.
 </p>
 <p>
 Plumbing roles may require different pants or shirts based on the exact tasks, fit, wear points, care process, and employer requirements. Red Kap PT88 or <a href="https://www.carhartt.com/" rel="noopener" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Carhartt</a> B324 products are examples to compare using current manufacturer specifications. Any pocket decoration must be reviewed for garment compatibility and approved in the partner proof.
 </p>
 <p>
 Snap-front work shirts, jackets, and caps are examples to evaluate for service teams. Product choice, availability, decoration placement, and delivery timing are confirmed in the written quote. For deadline-sensitive requests, see <a href="/services/rush-orders-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">rush-order planning</a>.
 </p>
 <p>
 Red Kap is one option to review with an industrial laundry provider. Laundry tagging, decoration, inventory codes, and handling terms require written confirmation from the laundry provider and production partner. Bighorn can also plan a <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">company-store program</a> around approved products and employee sizes.
 </p>
 <p>
 For a deeper breakdown of truck-rolled service tech apparel, our <a href="/blog/hvac-uniforms-service-tech-apparel/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">HVAC uniforms — service tech apparel</a> guide covers fabric weight, decoration placement, and ride-along kit specifically for service crews. To differentiate tech levels at a glance, see <a href="/blog/apprentice-journeyman-uniforms-differentiation/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">apprentice vs journeyman uniforms</a> and <a href="/blog/foreman-supervisor-shirts-visual-authority/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">foreman and supervisor shirts for visual authority</a>. New techs starting Monday? Hand them our <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">new hire workwear checklist</a> for what to issue on day one.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions plumbing and HVAC shops <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected FR and hi-vis options with manufacturer-approved decoration.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which method holds up on service-tech apparel.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo. <span class="text-gold-400">Request current options.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Talk to a real human who knows service-tech apparel.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
