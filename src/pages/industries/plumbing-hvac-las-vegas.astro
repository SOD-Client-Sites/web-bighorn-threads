---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import NationalLinks from '@/components/NationalLinks.astro'

const page = {
 title: 'Plumbing & HVAC Service Uniforms Las Vegas | Bighorn Threads',
 description:
 'Service polos, work shirts, name patches, and branded tees for Las Vegas plumbing and HVAC shops.',
 h1Pre: 'Plumbing & HVAC',
}

const compliance = [
 {
 code: 'Role Identification',
 title: 'Plan identification by role',
 body: 'Put the company, tech name, title, or contact details on the shirt. You decide what each role shows and approve the final artwork.',
 },
 {
 code: 'NV State Contractor Board',
 title: 'Review license-number artwork',
 body: 'We can add your license number. You’re responsible for meeting current Nevada requirements, so check placement and wording before you approve the proof. See <a href="https://nscb.nv.gov/" rel="noopener" class="text-gold-700 hover:underline">NSCB licensing information</a>.',
 },
 {
 code: 'OSHA / NIOSH Heat Stress',
 title: 'Fit gear to your heat plan',
 body: 'HVAC techs face serious heat in Las Vegas attics. We can quote moisture-wicking polos and lightweight long-sleeves to fit your heat plan. See <a href="https://www.osha.gov/heat-exposure" rel="noopener" class="text-gold-700 hover:underline">OSHA guidance</a> and <a href="https://www.cdc.gov/niosh/topics/heatstress/" rel="noopener" class="text-gold-700 hover:underline">NIOSH guidance</a>.',
 },
]

const gear = [
 { name: 'Embroidered service polos', detail: 'Your brand and color · embroidered after you approve the proof', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
 { name: 'Mechanic-style work shirts', detail: 'Red Kap, Dickies, or similar · decorated after you approve the proof', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=68414&P=945769040&RS=300' },
 { name: 'Branded service tees', detail: 'Your tee and color · printed after you approve the proof', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=722090562&RS=300' },
 { name: 'Tech name patches + tags', detail: 'Sewn or removable patches · we check the fit on your garment', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=68414&P=106695816&RS=300' },
]

const useCases = [
 'Residential service techs in embroidered polos with name + title (lead tech, journeyman, apprentice)',
 'Commercial mechanical crews in heavier work shirts with company name patch',
 'Install crews in branded tees and hi-vis when working new construction sites',
 'Dispatcher and office staff in lighter-weight branded polos for the front counter',
 'Apprentice / helper differentiation by polo color or sleeve embroidery',
 'Branded swag for trade shows, AGC events, and home shows around the valley',
]

const faqs = [
 {
 q: 'Can you do name embroidery on every shirt and still do it without slowing the order down?',
 a: 'Send a clean roster up front and it’ll go faster. Your quote lists the price and timing for names on that roster.',
 },
 {
 q: 'What\'s better for service techs, embroidered polos or mechanic-style work shirts?',
 a: 'Polos look sharper at the door, and work shirts hold up better on messy installs and take patches well. Many shops use both by role.',
 },
 {
 q: 'Can you get moisture-wicking polos for Vegas summer?',
 a: 'Yes. We don’t hold stock, but we can quote performance polos and check sizes and colors with suppliers when you order.',
 },
 {
 q: 'How do you handle name changes when a tech leaves or a new one starts?',
 a: 'Removable name patches work well on many work shirts, so a uniform can pass to the next tech. On polos, we order a replacement with the new name.',
 },
 {
 q: 'Can you put our license number and service line on every shirt?',
 a: 'Yes. You’re responsible for the legal requirements, wording, and placement, and you’ll check it all on a proof first.',
 },
 {
 q: 'Do you set up company stores for plumbing and HVAC shops?',
 a: 'Yes. Techs order approved gear in their own sizes. Tell us about allowances and who approves what, and your plan will say what the store can do.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Plumbing & HVAC', item: 'https://bighornthreads.com/industries/plumbing-hvac-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Plumbing and HVAC Contractors',
 serviceType: 'Branded service uniforms and embroidered apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Plumbing and HVAC Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/plumbing-hvac-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Plumbing &amp; HVAC</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Plumbing &amp; HVAC service tech uniforms
 <span class="text-gold-700"> for Las Vegas routes.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Polos, work shirts, and name patches for Las Vegas plumbing and HVAC shops. We run the order and the approvals, and production partners do the decoration.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Most plumbing and HVAC shops outfit by role: embroidered polos for service calls, work shirts for installs, name patches for techs, and branded tees for hot days. You approve the artwork and we handle the rest.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance / trust strip — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why It Matters</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Define the apparel <span class="text-gold-600">for each role.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 A homeowner should see who’s at the door. You decide what goes on the shirt and approve it before anything gets made.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- What we make — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">plumbing and HVAC shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Many shops use polos for residential service and work shirts for install crews. We keep your approved details on hand and check stock on each reorder.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for service shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Order in bulk or set up a company store. Your quote or proposal lists the terms.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded uniforms for Las Vegas plumbing, HVAC, and mechanical service crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A service uniform identifies your tech and markets your company at every door. Choose work shirts, pants, logos, and name patches by role. If a laundry service washes the gear, confirm the garment works for them.
 </p>
 <p>
 Red Kap SP14, PT20, PT88, and SY24 are common places to start. We’ll check current sizes, colors, and whether your logo works on the exact item.
 </p>
 <p>
 Plumbers kneel and crawl, so pants matter. Red Kap PT88 or <a href="https://www.carhartt.com/" rel="noopener" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Carhartt</a> B324 pants are good ones to compare. If you want a logo on a pocket, you’ll see it on a proof first.
 </p>
 <p>
 Snap-front work shirts, jackets, and caps round out most service kits. Your quote lists the products, placement, and delivery. Short on time? See <a href="/services/rush-orders-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">rush-order planning</a>.
 </p>
 <p>
 If you use an industrial laundry, ask them about Red Kap and how they handle tags and inventory codes. We can also plan a <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">company-store program</a> so techs order their own sizes.
 </p>
 <p>
 For a deeper breakdown of truck-rolled service tech apparel, our <a href="/blog/hvac-uniforms-service-tech-apparel/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">HVAC uniforms: service tech apparel</a> guide covers fabric weight, decoration placement, and ride-along kit specifically for service crews. To differentiate tech levels at a glance, see <a href="/blog/apprentice-journeyman-uniforms-differentiation/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">apprentice vs journeyman uniforms</a> and <a href="/blog/foreman-supervisor-shirts-visual-authority/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">foreman and supervisor shirts for visual authority</a>. New techs starting Monday? Hand them our <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">new hire workwear checklist</a> for what to issue on day one.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions plumbing and HVAC shops <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR, hi-vis, and service uniforms for electrical crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which method holds up on service-tech apparel.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo. <span class="text-gold-400">We’ll send options.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Tell us how many techs you have and what they wear now.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
 <NationalLinks heading='Related product guides' links={[{ href: '/plumber-uniforms/', label: 'Plumber uniforms' }, { href: '/hvac-uniforms/', label: 'HVAC uniforms' }]} />
</BaseLayout>
