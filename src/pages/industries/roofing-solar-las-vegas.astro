---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Roofing and Solar Crew Apparel | Las Vegas',
 description:
 'Planning options for branded shirts, employer-selected hi-vis, layers, and service polos for Las Vegas roofing and solar crews.',
 h1Pre: 'Roofing & Solar',
 hero: '/images/generated/kit-roofing.jpg',
}

const conditions = [
 { num: '110°+', label: 'Rooftop ambient', body: 'Vegas rooftop work can expose crews to extreme heat. Bighorn can quote moisture-wicking blends and long-sleeve hi-vis options. Your employer must choose apparel within its heat plan. See <a href="https://www.osha.gov/heat-exposure" rel="noopener" class="text-gold-700 hover:underline">OSHA heat exposure guidance</a>.' },
 { num: 'Plan', label: 'Work schedule', body: 'The employer\'s heat plan controls schedules, breaks, hydration, and work practices. Apparel is only one part of that plan.' },
 { num: 'Review', label: 'Sun exposure', body: 'The employer should review coverage, fabric, fit, and manufacturer data within its heat and sun-protection plan. See <a href="https://www.cdc.gov/niosh/topics/heatstress/" rel="noopener" class="text-gold-700 hover:underline">NIOSH heat stress guidance</a>.' },
]

const gear = [
 { name: 'Employer-approved long-sleeve hi-vis', detail: 'Confirm UPF, visibility class, certificate, and decoration rules', img: '/images/generated/kit-roofing.jpg' },
 { name: 'Employer-approved hi-vis tees', detail: 'Confirm fabric, class, certificate, fit, and decoration', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Branded crew hoodies', detail: 'Heavyweight · for 5 AM starts · embroidered or printed', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Solar installer service polos', detail: 'Customer-facing roles · Port Authority · embroidered', img: '/images/generated/service-company-stores.jpg' },
]

const useCases = [
 'Solar install crews with customer-facing branding (homeowner sees the company)',
 'Roof tear-off crews using visibility garments selected by the employer',
 'Service / repair techs in branded service polos with name embroidery',
 'Sales reps doing site walks in lighter branded button-downs',
 'Office staff and project managers in matched but lighter-weight gear',
 'Trade-show + industry event apparel for SEIA and NABCEP events',
]

const faqs = [
 {
 q: 'What\'s the best fabric for Vegas rooftop work in summer?',
 a: 'Polyester and poly-cotton blends are common warm-weather options. Bighorn can quote hi-vis garments from ML Kishigo, Pioneer, and other brands. Your employer must approve fabric, garment class, and sun-protection requirements.',
 },
 {
 q: 'Can you do solar-installer-specific branding (NABCEP cert, manufacturer partner badges)?',
 a: 'Bighorn can quote approved identifiers after the customer confirms permission to use each mark. Placement, product, artwork, and decoration depend on the brand rules and written quote.',
 },
 {
 q: 'How fast can you turn around 50 hi-vis shirts for a new crew starting Monday?',
 a: 'Share the approved product, size list, artwork, destination, and required date. Bighorn confirms current partner capacity, timing, and any rush fee in writing.',
 },
 {
 q: 'Do you stock hi-vis in non-standard sizes (XS for smaller crews, 5XL+)?',
 a: 'Available sizes vary by garment, color, supplier, and production partner. Share the full size list before ordering. Bighorn will confirm current availability and any special-order terms in the quote.',
 },
 {
 q: 'Can roofing crews use a company store like GCs do?',
 a: 'A proposed company store may support approved products and employee allowances. Inventory, payment, approval, delivery, and fulfillment features depend on the written setup.',
 },
 {
 q: 'Do you handle Tyvek or coverall branding for tear-off crews?',
 a: 'Bighorn can request partner quotes for compatible decoration on selected coveralls. Your employer and the garment manufacturer must approve the method and placement. Case quantities and availability vary by product.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Roofing & Solar', item: 'https://bighornthreads.com/industries/roofing-solar-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Roofing and Solar Crews',
 serviceType: 'Sun-protective branded apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Roofing and Solar Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/roofing-solar-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Roofing &amp; Solar</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Roofing and Solar Crew Apparel <span class="text-gold-400">Planned for Vegas Work.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Compare branded shirts, employer-selected hi-vis, layers, and service polos. Bighorn manages the Las Vegas account and coordinates production through selected partners.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Roofing and solar apparel must follow the employer's heat plan, hazard assessment, and worksite rules. The employer selects all visibility, sun-protection, arc-rated, flame-resistant, and protective garments. Bighorn coordinates approved products and decoration through production partners.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Conditions — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Vegas Conditions</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Plan for changing conditions <span class="text-gold-600">on Vegas rooftops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Heat, sun, fit, coverage, visibility, and care all affect the selection. Compare manufacturer data only after the employer defines the requirements.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {conditions.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-baseline gap-3">
 <span class="font-heading text-4xl font-extrabold text-gold-600">{c.num}</span>
 <span class="spec text-ash">{c.label}</span>
 </div>
 <p class="text-base leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to compare for <span class="text-gold-600">roofing and solar crews.</span></h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Role-based configurations <span class="text-gold-600">to review.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Customer-facing and field roles may use different approved products. The employer controls all protective requirements. Bighorn can quote the documented mix.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear planning for Las Vegas roofing and solar crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Roofing and solar crews can face serious heat exposure in Las Vegas. The employer's heat plan and hazard assessment control apparel choices. Bighorn can quote performance shirts, sun-protection options, caps, and selected FR garments. Manufacturer data and the employer's specification govern the final choice.
 </p>
 <p>
 Long-sleeve performance shirts are one option to compare within the employer's heat and sun-protection plan. Review the exact product's UPF claim, fabric, fit, coverage, care, and compatibility with any visibility requirement.
 </p>
 <p>
 Color, fabric, fit, and coverage can affect comfort. The employer should evaluate the complete garment within its heat plan. Bighorn can coordinate approved artwork on the selected product through a production partner.
 </p>
 <p>
 Solar electrical work requires an employer-led hazard assessment. No single rating fits every task. Bighorn can quote selected Bulwark, Carhartt FR, and Wrangler FR products after receiving the written specification. Approved production partners handle decoration.
 </p>
 <p>
 The employer selects all head protection. Never add a decal or identifier without approval from the exact helmet manufacturer. Bighorn can request a partner quote after receiving the approved material, size, and placement. Caps may be quoted only for settings where the employer permits them.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions roofing and solar crews <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected protective apparel with manufacturer-reviewed decoration.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and rapid onboarding.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which decoration method holds up on a Vegas job site.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Outfit your crew for <span class="text-gold-400">the rooftop, not the office.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Send the approved products, size list, artwork, destination, and deadline for a current quote.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
