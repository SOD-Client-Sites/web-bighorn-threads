---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Roofing & Solar Crew Apparel Las Vegas | Bighorn Threads',
 description:
 'Branded shirts, hi-vis, layers, and service polos for Las Vegas roofing and solar crews.',
 h1Pre: 'Roofing & Solar',
}

const conditions = [
 { num: '110°+', label: 'Rooftop ambient', body: 'Vegas rooftops get extremely hot. We can quote moisture-wicking blends and long-sleeve hi-vis to fit your heat plan. See <a href="https://www.osha.gov/heat-exposure" rel="noopener" class="text-gold-700 hover:underline">OSHA heat exposure guidance</a>.' },
 { num: 'Plan', label: 'Work schedule', body: 'Clothing is one part of a heat plan. Schedules, breaks, and hydration do more of the work.' },
 { num: 'Review', label: 'Sun exposure', body: 'Check coverage, fabric, fit, and the maker’s UPF data against your heat and sun plan. See <a href="https://www.cdc.gov/niosh/topics/heatstress/" rel="noopener" class="text-gold-700 hover:underline">NIOSH heat stress guidance</a>.' },
]

const gear = [
 { name: 'Long-sleeve hi-vis', detail: 'The class you need · check UPF on the exact garment', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=373505618&RS=300' },
 { name: 'Hi-vis tees', detail: 'The class you need · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=913213443&RS=300' },
 { name: 'Branded crew hoodies', detail: 'Heavyweight · for 5 AM starts · embroidered or printed', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=786780311&RS=300' },
 { name: 'Solar installer service polos', detail: 'Customer-facing roles · Port Authority · embroidered', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
]

const useCases = [
 'Solar install crews with customer-facing branding (homeowner sees the company)',
 'Roof tear-off crews in the hi-vis class you specify',
 'Service / repair techs in branded service polos with name embroidery',
 'Sales reps doing site walks in lighter branded button-downs',
 'Office staff and project managers in matched but lighter-weight gear',
 'Trade-show + industry event apparel for SEIA and NABCEP events',
]

const faqs = [
 {
 q: 'What\'s the best fabric for Vegas rooftop work in summer?',
 a: 'Polyester and poly-cotton blends are the usual picks for heat. We can quote hi-vis options from ML Kishigo, Pioneer, and others, and your safety lead makes the final call on fabric and class.',
 },
 {
 q: 'Can you do solar-installer-specific branding (NABCEP cert, manufacturer partner badges)?',
 a: 'Yes, once you’ve confirmed you have permission to use each mark. Their brand rules may set placement, so send those with your artwork.',
 },
 {
 q: 'How fast can you turn around 50 hi-vis shirts for a new crew starting Monday?',
 a: 'Send the shirt, sizes, logo, ship-to, and date. We’ll tell you the timing and any rush fee in writing.',
 },
 {
 q: 'Can you get hi-vis in non-standard sizes (XS, 5XL+)?',
 a: 'It varies by garment and color. Send your full size list up front and we’ll tell you what’s available and whether anything is a special order.',
 },
 {
 q: 'Can roofing crews use a company store like GCs do?',
 a: 'Yes. Your crew orders approved gear in their own sizes. Tell us about allowances and who approves what, and your proposal will say what the store can do.',
 },
 {
 q: 'Do you handle Tyvek or coverall branding for tear-off crews?',
 a: 'We can price decoration on coveralls that allow it, once your safety lead and the garment maker OK the method and placement. Case quantities vary by product.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Roofing & Solar', item: 'https://bighornthreads.com/industries/roofing-solar-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Roofing and Solar Crews',
 serviceType: 'Sun-protective branded apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Roofing and Solar Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/roofing-solar-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Roofing &amp; Solar</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Roofing and Solar Crew Apparel <span class="text-gold-700">Planned for Vegas Work.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Branded shirts, hi-vis, layers, and service polos for roofing and solar crews. One Las Vegas contact runs the order, and production partners make it.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Roofing and solar crews need gear that fits your heat plan, hazard assessment, and site rules. Your safety lead picks anything protective, and we get your logo on it the way the maker allows.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Conditions — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Vegas Conditions</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Plan for conditions <span class="text-gold-600">on Vegas rooftops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Heat, sun, fit, coverage, visibility, and care all affect the choice. Set your requirements first, then compare garments.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {conditions.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-baseline gap-3">
 <span class="font-heading text-4xl font-extrabold text-gold-600">{c.num}</span>
 <span class="spec text-ash">{c.label}</span>
 </div>
 <p class="text-base leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">roofing and solar crews.</span></h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Setups by role <span class="text-gold-600">for roofing and solar.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Customer-facing and field roles usually wear different gear. Tell us who does what and we’ll quote the mix.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear planning for Las Vegas roofing and solar crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Las Vegas roofing and solar crews work in serious heat, so your heat plan and hazard assessment come first. We can quote performance shirts, sun-protection options, caps, and FR garments to your spec.
 </p>
 <p>
 Long-sleeve performance shirts are a common choice. Check the UPF claim, fabric, fit, and whether the shirt meets any visibility requirement you have.
 </p>
 <p>
 Color, fabric, fit, and coverage all affect comfort, so have a few people try the garment before you order the whole crew.
 </p>
 <p>
 Solar electrical work needs its own hazard assessment, since no single rating fits every task. Send the written spec and we’ll quote Bulwark, Carhartt FR, and Wrangler FR options.
 </p>
 <p>
 Don’t add a decal to a hard hat without the helmet maker’s approval. Send us the approved material, size, and placement and we’ll quote it. Caps work where your site allows them.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions roofing and solar crews <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR, hi-vis, and service uniforms for electrical crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and rapid onboarding.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which decoration method holds up on a Vegas job site.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Outfit your crew for <span class="text-gold-400">the rooftop, not the office.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Send your logo, the gear, sizes, ship-to address, and deadline for a quote.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
