---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Oil, Gas, and Mechanical Contractor Apparel | Las Vegas',
 description:
 'Apparel-program planning for Las Vegas oil, gas, and mechanical contractors. Bighorn coordinates employer-approved products and decoration through production partners.',
 h1Pre: 'Oil, Gas & Mechanical',
 hero: '/images/generated/kit-datacenter.jpg',
}

const compliance = [
 {
 code: 'NFPA 2112',
 title: 'FR coveralls and shirts for oil, gas, and process work',
 body: '<a href="https://www.bulwarkprotection.com/" rel="noopener" class="text-gold-700 hover:underline">Bulwark</a>, <a href="https://www.carhartt.com/category/mens/fr-flame-resistant-clothing.html" rel="noopener" class="text-gold-700 hover:underline">Carhartt FR</a>, and other manufacturers publish information for specific garments. See <a href="https://www.nfpa.org/codes-and-standards/all-codes-and-standards/list-of-codes-and-standards/detail?code=2112" rel="noopener" class="text-gold-700 hover:underline">NFPA 2112</a>. Your employer selects the garment using the task-specific hazard assessment and exact current manufacturer documentation. Bighorn coordinates approved decoration through a selected production partner.',
 },
 {
 code: 'NFPA 70E',
 title: 'Arc-rated apparel for mission-critical electrical work',
 body: 'Employers must select arc-rated layers from the site hazard assessment and current manufacturer documentation. Bighorn can quote approved products and coordinate decoration through production partners after the proposed method and placement are approved.',
 },
 {
 code: 'Mission-Critical Standards',
 title: 'Data center & mission-critical apparel programs',
 body: 'Mechanical and electrical contractors working in Henderson and North Las Vegas data centers may use site-specific identification programs. The facility, general contractor, and employer define access and identification rules. Bighorn can coordinate an approved nonprotective uniform plan.',
 },
]

const gear = [
 { name: 'Employer-selected FR coveralls', detail: 'Requested brand and rating · manufacturer-approved decoration only', img: '/images/generated/kit-datacenter.jpg' },
 { name: 'Employer-selected arc-rated shirts', detail: 'Exact rating selected through the task hazard assessment · current manufacturer instructions control decoration', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Mechanical service polos', detail: 'For commissioning + service techs · Port Authority · embroidered chest', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Branded jackets + outerwear', detail: 'For overnight cuts in data centers + cool desert nights · embroidered logo', img: '/images/generated/service-company-stores.jpg' },
]

const useCases = [
 'Data center MEP service techs in branded polos with embroidered name + cert badges',
 'Employer-selected arc-rated apparel for generator and switchgear service tasks when required',
 'Employer-selected FR apparel for pipeline and process mechanical tasks when required',
 'Commissioning teams in branded jackets for cool overnight cutover work',
 'Field service supervisors in differentiated polos or jacket colorway',
 'Apparel for ASHRAE, AMCA, and mechanical-trade events around the valley',
]

const faqs = [
 {
 q: 'Can you embroider an employer-selected FR coverall?',
 a: 'Bighorn coordinates approved FR decoration through selected production partners. Your employer and the garment manufacturer must approve the method, materials, and placement before production.',
 },
 {
 q: 'Do you handle data center and mission-critical contractor apparel programs?',
 a: 'A program can include branded polos, jackets, and approved credential identification for selected roles. Any protective layer must come from the employer\'s task-specific hazard assessment, and the exact current manufacturer documentation must permit the proposed decoration.',
 },
 {
 q: 'What\'s the difference between NFPA 2112 and NFPA 70E garments?',
 a: 'NFPA 2112 addresses flash-fire hazards. NFPA 70E addresses electrical arc-flash hazards. They use different rating systems. Your employer identifies the hazard and required protection. Bighorn can quote garments that match the written specification.',
 },
 {
 q: 'How fast can you turn around 30 FR coveralls for a new pipeline crew?',
 a: 'Sizes, availability, partner capacity, decoration, and lead time are confirmed in the written quote. Share the approved garment specification and deadline as early as possible.',
 },
 {
 q: 'Do you offer pricing tiers for accounts spending qualifying annually?',
 a: 'Share the projected annual volume and Bighorn can request pricing and capacity options from production partners. Contract pricing, fees, and scheduling are confirmed in writing and are not guaranteed in advance.',
 },
 {
 q: 'Can you set up a company store with FR-only filtering for field crews?',
 a: 'A role-based company store can be requested around an employer-approved product list. Access, filtering, allowances, ordering, payment, production, fulfillment, and delivery capabilities must be confirmed in writing during setup.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Oil, Gas & Mechanical', item: 'https://bighornthreads.com/industries/oil-gas-mechanical-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Oil, Gas, and Mechanical Contractors',
 serviceType: 'Branded apparel program coordination for oil, gas, and mechanical contractors',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Oil, Gas, and Mechanical Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/oil-gas-mechanical-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Oil, Gas &amp; Mechanical</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 FR Coveralls, Service Polos, and Mission-Critical <span class="text-gold-400">Apparel for Vegas Mechanical Contractors.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn helps Las Vegas oil, gas, and mechanical contractors plan requested apparel and coordinates approved decoration through production partners. Employers select protective products from the hazard assessment and current manufacturer documentation.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Some employers specify garments with multiple published ratings for particular hazards. The employer must select the exact garment and rating, and the manufacturer must approve any proposed decoration method and placement. Bighorn coordinates only the approved product and decoration request.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">We speak NFPA, ASTM, and <span class="text-gold-600">your safety officer's language.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Mechanical contractors can work under strict PPE specifications. The employer and safety officer own those requirements. Bighorn can source garment options and coordinate approved details for repeat orders.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to consider for <span class="text-gold-600">oil, gas, and mechanical crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Data center MEP service contractors and pipeline or process mechanical operations can organize apparel by role. The employer selects all protective garments through its task-specific hazard assessment. Bighorn can coordinate approved nonprotective uniforms and quote the exact written protective-apparel specification.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for mechanical and process contractors.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Program examples may include branded polos or jackets for selected service roles and employer-selected protective apparel for tasks with identified hazards. Job title or equipment name alone does not determine a rating. The employer defines each role's kit using a task-specific hazard assessment and exact current manufacturer documentation.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Employer-selected protective workwear for Las Vegas oil, gas, and industrial mechanical crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Oil, gas, and industrial mechanical work can involve flash-fire and electrical hazards. The employer's hazard assessment determines required protection. Bighorn Threads manages apparel programs and coordinates approved decoration through selected production partners. No single garment rating fits every task.
 </p>
 <p>
 Bulwark and other manufacturers publish garment ratings and care instructions for specific products. Employers should compare the exact current documents with the task-specific hazard assessment and obtain qualified safety approval before purchase. Bighorn does not prescribe a PPE category or combination, but can quote the exact approved product request.
 </p>
 <p>
 Welding hazards require an employer-led PPE assessment. Bighorn can quote selected FR base layers after receiving the written garment specification. Specialty welding PPE remains outside Bighorn's scope. Any branded patch or decoration requires manufacturer and employer approval.
 </p>
 <p>
 Industrial mechanical and instrumentation work can involve several hazards. The employer's assessment determines the required layers and ratings. Bighorn can quote selected garment options. Any decoration and supporting documentation require manufacturer, employer, and production-partner confirmation.
 </p>
 <p>
 Turnaround crews can require decorated FR gear with a prime contractor logo and project identifier. Bighorn can coordinate a crew package after receiving the written garment specification. Product availability, decoration, delivery destinations, and timing are confirmed in the quote. A company store may support ongoing programs with approved products and employee allowances.
 </p>
 <p>
 For educational buyer's-guide reading, see our <a href="/blog/nfpa-2112-fr-coveralls-buyer-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">NFPA 2112 FR coveralls buyer guide</a>, our <a href="/blog/welder-uniforms-fr-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">welder uniforms and FR shirts for Las Vegas welders</a>, and our overview of <a href="/blog/bulwark-fr-shirts-vegas-heat/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Bulwark FR shirts in Vegas heat</a>. Review any product with your safety lead and the exact current manufacturer documentation.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions oil, gas, and mechanical contractors <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected FR and hi-vis options with manufacturer-approved decoration.</p>
 </a>
 <a href="/industries/plumbing-hvac-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Plumbing &amp; HVAC</h3>
 <p class="mt-2 text-sm text-ash">Service tech uniforms with embroidered name + title.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Decoration considerations to review for employer-selected FR garments.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo and <span class="text-gold-400">approved garment specification.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">We will quote the requested product and coordinate only employer-approved, manufacturer-approved decoration.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
