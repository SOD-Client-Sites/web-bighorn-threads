---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Oil, Gas & Mechanical Contractor Apparel Las Vegas | Bighorn Threads',
 description:
 'FR coveralls, arc-rated shirts, and service polos for Las Vegas oil, gas, and mechanical contractors, quoted to your spec.',
 h1Pre: 'Oil, Gas & Mechanical',
}

const compliance = [
 {
 code: 'NFPA 2112',
 title: 'FR coveralls and shirts for oil, gas, and process work',
 body: '<a href="https://www.bulwarkprotection.com/" rel="noopener" class="text-gold-700 hover:underline">Bulwark</a>, <a href="https://www.carhartt.com/category/mens/fr-flame-resistant-clothing.html" rel="noopener" class="text-gold-700 hover:underline">Carhartt FR</a>, and other manufacturers publish information for specific garments. See <a href="https://www.nfpa.org/codes-and-standards/all-codes-and-standards/list-of-codes-and-standards/detail?code=2112" rel="noopener" class="text-gold-700 hover:underline">NFPA 2112</a>. Your safety lead picks the garment from your hazard assessment, and we arrange the logo work once it’s approved.',
 },
 {
 code: 'NFPA 70E',
 title: 'Arc-rated apparel for mission-critical electrical work',
 body: 'Your site hazard assessment sets the arc-rated layers. We quote those products and add a logo once the method and placement are approved.',
 },
 {
 code: 'Mission-Critical Standards',
 title: 'Data center & mission-critical apparel programs',
 body: 'Mechanical and electrical contractors working in Henderson and North Las Vegas data centers may use site-specific identification programs. The facility and general contractor set access and identification rules. We can build the everyday uniforms around them.',
 },
]

const gear = [
 { name: 'FR coveralls', detail: 'Your brand and rating · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=779020111&RS=300' },
 { name: 'Arc-rated shirts', detail: 'Rating from your hazard assessment · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=549020207&RS=300' },
 { name: 'Mechanical service polos', detail: 'For commissioning + service techs · Port Authority · embroidered chest', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
 { name: 'Branded jackets + outerwear', detail: 'For overnight cuts in data centers + cool desert nights · embroidered logo', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=524481216&RS=300' },
]

const useCases = [
 'Data center MEP service techs in branded polos with embroidered name + cert badges',
 'Arc-rated apparel for generator and switchgear service, when your assessment calls for it',
 'FR apparel for pipeline and process work, when your assessment calls for it',
 'Commissioning teams in branded jackets for cool overnight cutover work',
 'Field service supervisors in differentiated polos or jacket colorway',
 'Apparel for ASHRAE, AMCA, and mechanical-trade events around the valley',
]

const faqs = [
 {
 q: 'Can you embroider an FR coverall?',
 a: 'Often, yes, but your safety lead and the garment maker have to OK the method, materials, and placement first, because decoration can affect the rating. Send us their approval and we’ll set it up.',
 },
 {
 q: 'Do you handle data center and mission-critical contractor apparel programs?',
 a: 'Yes. Branded polos, jackets, and credential identification are the usual starting point. Protective layers come from your hazard assessment, and a logo goes on only if the garment maker allows it.',
 },
 {
 q: 'What\'s the difference between NFPA 2112 and NFPA 70E garments?',
 a: 'NFPA 2112 addresses flash-fire hazards. NFPA 70E addresses electrical arc-flash hazards. They use different rating systems. Your hazard assessment says which applies, and we can quote garments to that written spec.',
 },
 {
 q: 'How fast can you turn around 30 FR coveralls for a new pipeline crew?',
 a: 'Send your garment spec and deadline as early as you can. We’ll come back with sizes, stock, and lead time in a written quote.',
 },
 {
 q: 'Do you offer pricing tiers for high-volume accounts?',
 a: 'Tell us your expected annual volume and we’ll ask for pricing and capacity options. We’ll put what we can offer in writing.',
 },
 {
 q: 'Can you set up a company store with FR-only filtering for field crews?',
 a: 'Ask for it. Send your approved product list and who should see what, and your proposal will say whether your store can do it.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Oil, Gas & Mechanical', item: 'https://bighornthreads.com/industries/oil-gas-mechanical-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Oil, Gas, and Mechanical Contractors',
 serviceType: 'Branded apparel program coordination for oil, gas, and mechanical contractors',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Oil, Gas, and Mechanical Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/oil-gas-mechanical-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Oil, Gas &amp; Mechanical</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 FR Coveralls, Service Polos, and Mission-Critical <span class="text-gold-700">Apparel for Vegas Mechanical Contractors.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 For Las Vegas oil, gas, and mechanical contractors. Your hazard assessment sets the protection, we quote the garments, and production partners do the logo work once it’s approved.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Some jobs call for one garment with more than one published rating. Your safety lead picks the exact garment and rating, and the logo goes on only the way the manufacturer approves.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">We speak NFPA, ASTM, and <span class="text-gold-600">your safety officer's language.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Your safety officer sets the PPE requirements. We find garments that meet them and keep the approved details for repeat orders.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">oil, gas, and mechanical crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Data center service crews and pipeline or process operations usually outfit by role. We handle everyday uniforms and quote protective gear to your written spec.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for mechanical and process contractors.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Most programs mix branded polos or jackets for service roles with protective apparel for tasks that need it. A job title doesn’t set a rating, so build each role’s kit from your hazard assessment.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 FR and service workwear for Las Vegas oil, gas, and mechanical crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Oil, gas, and industrial mechanical work can involve flash-fire and electrical hazards, and no single garment rating fits every task. Your hazard assessment sets the protection.
 </p>
 <p>
 Bulwark and other makers publish ratings and care instructions for each product. Have your safety team compare them with your assessment. We don’t prescribe PPE, but we’ll quote exactly what they approve.
 </p>
 <p>
 Welding needs its own PPE assessment. Send a written spec and we’ll quote FR base layers. We don’t supply specialty welding PPE, and any branded patch needs an OK from your safety lead and the maker.
 </p>
 <p>
 Instrumentation and industrial mechanical work can involve several hazards, so your assessment sets the layers and ratings. If you need paperwork for your files, ask early.
 </p>
 <p>
 Turnaround crews often need FR gear with a prime contractor logo and project identifier. Send the written spec and we’ll quote a crew package, including where it ships and when. For ongoing programs, ask about a company store.
 </p>
 <p>
 For more, see our <a href="/blog/nfpa-2112-fr-coveralls-buyer-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">NFPA 2112 FR coveralls buyer guide</a>, our <a href="/blog/welder-uniforms-fr-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">welder uniforms and FR shirts for Las Vegas welders</a>, and our overview of <a href="/blog/bulwark-fr-shirts-vegas-heat/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Bulwark FR shirts in Vegas heat</a>. Go over any product with your safety lead.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions oil, gas, and mechanical contractors <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR, hi-vis, and service uniforms for electrical crews.</p>
 </a>
 <a href="/industries/plumbing-hvac-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Plumbing &amp; HVAC</h3>
 <p class="mt-2 text-sm text-ash">Service tech uniforms with embroidered name + title.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">What to check before decorating FR garments.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your logo and <span class="text-gold-400">your garment spec.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">We’ll quote the gear and the logo work, once your safety lead and the garment maker approve it.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
