---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Steel & Iron Worker Apparel Las Vegas | Bighorn Threads',
 description:
 'Crew tees, hi-vis, FR shirts, and hard hat decals for Las Vegas steel and rebar crews, built around your safety spec.',
 h1Pre: 'Steel & Iron Workers',
}

const compliance = [
 {
 code: 'ANSI/ISEA 107 Class 2',
 title: 'Hi-vis you can see from the crane and the ground',
 body: 'Your site safety plan sets the hi-vis class. Check the current <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a> requirements and the garment’s certificate before you order.',
 },
 {
 code: 'Your Hazard Assessment',
 title: 'Task-specific protective apparel selection',
 body: 'Welding, cutting, flash-fire, and electrical hazards each call for different protection. Your safety lead picks the full system for the task, and any logo gets their OK and the maker’s first.',
 },
 {
 code: 'OSHA 1926 Subpart R',
 title: 'Steel erection gear to spec',
 body: 'Your safety lead sets fall protection and PPE under the <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1926/1926SubpartR" rel="noopener" class="text-gold-700 hover:underline">OSHA requirements</a>. Get the manufacturer’s OK before adding anything to protective equipment.',
 },
]

const gear = [
 { name: 'Hi-vis long-sleeves', detail: 'The class your site requires · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=373505618&RS=300' },
 { name: 'FR shirts', detail: 'The rating you specify · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=549020207&RS=300' },
 { name: 'Heavyweight crew tees', detail: 'For rebar and rough-iron crews · heavy cotton · screen-printed back', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=722090562&RS=300' },
 { name: 'Hard hat stickers + decals', detail: 'Your helmets · material and placement the maker approves', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52649&P=596831160&RS=300' },
]

const useCases = [
 'Erection crews in the hi-vis class your site requires, with your logo',
 'Welder-fitter teams in the protective garments your safety lead specifies',
 'Rebar crews in heavyweight branded tees',
 'Foreman and connector differentiation by colorway or sleeve embroidery',
 'Hard hat decals: company logo, ironworker local affiliation, journeyman vs apprentice',
 'Apparel for IW Local 433 events, AISC conferences, and ironworker training programs',
]

const faqs = [
 {
 q: 'Can you embroider on FR welding shirts without voiding the rating?',
 a: 'Often, yes, but your safety lead and the garment maker have to OK the method, materials, and placement first, because decoration can affect the rating. Send us their approval and we’ll set it up.',
 },
 {
 q: 'What\'s the right hi-vis spec for ironworkers walking iron?',
 a: 'Your site safety plan sets the ANSI class. Tell us the class and we’ll quote ML Kishigo and Pioneer options in the colors and sizes you need.',
 },
 {
 q: 'Do you do hard hat decals for IW Local 433 and Local 416?',
 a: 'Tell us the exact helmet and we’ll quote them. The helmet maker has to OK the decal material, adhesive, size, and placement first.',
 },
 {
 q: 'How fast can you turn around 30 hi-vis shirts for an erection job starting Monday?',
 a: 'Send the garment spec, quantity, logo, ship-to, and date. We’ll check stock and production capacity and tell you straight.',
 },
 {
 q: 'What protective-apparel brands can you quote for welding-adjacent work?',
 a: 'Send us the spec from your safety lead and we’ll find options that meet it. We check rating, certificate, and sizes on the exact model.',
 },
 {
 q: 'Can you do branded gear for ironworker apprenticeship or training programs?',
 a: 'Yes. Tell us the program, the gear, and how many, and we’ll send a written quote.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Steel & Iron Workers', item: 'https://bighornthreads.com/industries/steel-iron-workers-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Steel and Iron Worker Crews',
 serviceType: 'Hi-vis, FR-rated, and branded ironworker apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Steel Erectors and Ironworkers' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/steel-iron-workers-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Steel &amp; Iron Workers</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Branded apparel for Las Vegas steel crews.
 <span class="text-gold-700"> Built around your safety spec.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Send your written garment and PPE requirements, and we’ll get your logo on the right gear through our production partners.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Steel and ironworking crews need different gear by task. Your safety lead picks the hi-vis, FR, and protective products, and we run the order and the logo work.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Three things to settle for <span class="text-gold-600">ironworker apparel.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Steel erection can involve hi-vis, FR, and fall-protection requirements. Your safety lead sets them, and we find garments that fit the spec.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">steel and iron crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Start with your safety spec for each role, then pick visibility garments, protective shirts, and crew tees.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Common setups <span class="text-gold-600">for steel and iron crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 What people wear changes by role and task. Your safety lead sets the protective requirements first.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear for Las Vegas structural steel, iron, and welding crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Structural steel and iron work means heat, welding, cutting, rigging, and abrasion. Your hazard assessment drives the PPE, and we handle the workwear around it.
 </p>
 <p>
 Your hazard assessment says whether someone needs flame-resistant clothing and what rating applies. Check the garment’s certificate, fit, and care instructions before you approve it.
 </p>
 <p>
 If you want a logo on protective layers, your safety lead and the garment maker approve the patch, thread, backing, and placement first.
 </p>
 <p>
 Pants for steel work need to handle abrasion and heat. Compare the Carhartt B324 and Bulwark PEW2. We don’t sell boots.
 </p>
 <p>
 For a full crew, send the products by role, sizes, how replacements work, your logo, where it ships, and the schedule. If you want a company store, your proposal covers access, inventory, and reorders.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions steel and iron crews <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR, hi-vis, and service uniforms for electrical crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which decoration method holds up on hi-vis and FR.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send your spec. <span class="text-gold-400">We'll send the quote.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Your quote lists the product, decoration, availability, and timing.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
