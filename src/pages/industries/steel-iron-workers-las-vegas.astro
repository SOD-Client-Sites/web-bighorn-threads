---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Steel and Iron Worker Apparel | Las Vegas',
 description:
 'Planning for branded apparel used by Las Vegas steel and rebar crews. Employers select PPE and protective garments before Bighorn coordinates decoration.',
 h1Pre: 'Steel & Iron Workers',
 hero: '/images/generated/kit-steel.jpg',
}

const compliance = [
 {
 code: 'ANSI/ISEA 107 Class 2',
 title: 'Hi-vis at height — visible from the crane and the ground',
 body: 'The employer and site safety plan determine the required high-visibility class and product. Review the current <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a> requirements and the exact garment certificate before ordering.',
 },
 {
 code: 'Employer Hazard Assessment',
 title: 'Task-specific protective apparel selection',
 body: 'Welding, cutting, flash-fire, and electrical hazards are not interchangeable. The employer must identify the exact hazard and select the complete protective system under the applicable requirements and current product documentation. Any decoration requires employer and manufacturer approval before production.',
 },
 {
 code: 'OSHA 1926 Subpart R',
 title: 'Steel erection apparel reviewed against the spec',
 body: 'The employer selects fall protection and PPE under the applicable <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1926/1926SubpartR" rel="noopener" class="text-gold-700 hover:underline">OSHA requirements</a>. Obtain manufacturer approval before adding identifiers or decoration to any protective equipment.',
 },
]

const gear = [
 { name: 'Employer-selected hi-vis long-sleeves', detail: 'Confirm class, certificate, striping, fit, and decoration rules', img: '/images/generated/kit-steel.jpg' },
 { name: 'Employer-selected protective shirts', detail: 'Confirm rating, garment instructions, and approved decoration', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Heavyweight crew tees', detail: 'For rebar and rough-iron crews · 6.1oz cotton · screen-printed back', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Hard hat stickers + decals', detail: 'Employer-selected helmets · manufacturer-approved material and placement', img: '/images/generated/service-company-stores.jpg' },
]

const useCases = [
 'Erection crews using employer-selected visibility garments and approved decoration',
 'Welder-fitter teams using employer-selected protective garments and approved identifiers',
 'Rebar crews comparing heavyweight branded tees for their work conditions',
 'Foreman and connector differentiation by colorway or sleeve embroidery',
 'Hard hat decals — company logo, ironworker local affiliation, journeyman vs apprentice',
 'Apparel for IW Local 433 events, AISC conferences, and ironworker training programs',
]

const faqs = [
 {
 q: 'Can you embroider on FR welding shirts without voiding the rating?',
 a: 'Bighorn coordinates approved FR decoration through selected production partners. Your employer and the garment manufacturer must approve the method, materials, and placement before production.',
 },
 {
 q: 'What\'s the right hi-vis spec for ironworkers walking iron?',
 a: 'Your employer and traffic-control plan determine the required ANSI class. Bighorn can quote selected ML Kishigo and Pioneer garments. Colors, sizes, and availability depend on the current product and partner quote.',
 },
 {
 q: 'Do you do hard hat decals for IW Local 433 and Local 416?',
 a: 'Bighorn can request a quote for hard hat decals after the employer identifies the exact helmet. The manufacturer must approve the decal material, adhesive, size, and placement.',
 },
 {
 q: 'How fast can you turn around 30 hi-vis shirts for an erection job starting Monday?',
 a: 'Share the complete product specification, quantity, artwork, destination, and required date. Bighorn confirms current product and production-partner availability in writing.',
 },
 {
 q: 'What protective-apparel brands can you quote for welding-adjacent work?',
 a: 'Bighorn can request current options after your safety lead supplies the required garment specification. Product ratings, certificates, sizes, and availability must be verified for the exact model.',
 },
 {
 q: 'Can you do branded gear for ironworker apprenticeship or training programs?',
 a: 'Bighorn can quote a training-program apparel plan. Products, pricing, file retention, decoration, and repeat-order terms are confirmed in writing.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Steel & Iron Workers', item: 'https://bighornthreads.com/industries/steel-iron-workers-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Steel and Iron Worker Crews',
 serviceType: 'Hi-vis, FR-rated, and branded ironworker apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Steel Erectors and Ironworkers' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/steel-iron-workers-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Steel &amp; Iron Workers</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Branded Apparel for Steel Crews. <span class="text-gold-400">Planned Around the Approved Spec.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Plan branded apparel around the employer's written garment and PPE requirements. Bighorn coordinates approved products and decoration through selected production partners.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Las Vegas structural steel and ironworking crews may need different apparel by task. The employer selects any high-visibility, flame-resistant, or protective product. Bighorn coordinates the approved order and decoration through selected production partners.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Compliance — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Compliance &amp; Spec</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Three requirements to review for <span class="text-gold-600">ironworker apparel.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Steel erection can involve hi-vis, FR, and fall-protection requirements. Your employer selects compatible PPE. Bighorn can source garment options and coordinate approved decoration after the safety lead provides the specification.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {compliance.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to compare for <span class="text-gold-600">steel and iron crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Start with the employer's role-based specification. Then compare approved visibility garments, protective shirts, and branded crew tees.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Configurations to review <span class="text-gold-600">for steel and iron crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Product mixes can differ by role and task. The employer decides protective requirements before Bighorn coordinates product and decoration options.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear for Las Vegas structural steel, iron, and welding crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Structural steel and iron work can involve heat, welding, cutting, rigging, and abrasion. The employer's hazard assessment controls PPE and apparel choices. Bighorn manages workwear programs and coordinates approved decoration through selected production partners.
 </p>
 <p>
 The employer's hazard assessment determines whether a worker needs flame-resistant clothing and which rating applies. Verify the exact product certificate, fit, care instructions, and worksite requirements before approving a garment.
 </p>
 <p>
 Protective layers and welding PPE remain employer-controlled. If decoration is requested, the exact garment manufacturer and employer must approve the proposed patch, thread, backing, method, and placement.
 </p>
 <p>
 Pants for structural steel work may need abrasion and heat features. Carhartt B324 and Bulwark PEW2 are options to compare. Boots remain outside Bighorn's scope. Your employer determines any hi-vis requirement. Bighorn coordinates approved garment decoration through selected production partners.
 </p>
 <p>
 For a full-crew program, document the products required by role, size list, replacement process, artwork, destination, and schedule. Company-store access, inventory responsibility, reorder rules, production, and fulfillment depend on the written program setup.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions steel and iron crews <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected FR and hi-vis products with manufacturer-reviewed decoration.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which decoration method holds up on hi-vis and FR.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Send the approved spec. <span class="text-gold-400">We'll coordinate the quote.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Your quote confirms the product, partner, decoration, availability, and timing.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
