---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Landscaping Crew Apparel & Workwear Las Vegas | Bighorn Threads',
 description:
 'Branded long-sleeves, tees, polos, hats, and hi-vis for Las Vegas landscaping crews.',
 h1Pre: 'Landscaping',
}

const conditions = [
 { num: 'HEAT', label: 'Exposure planning', body: '<a href="https://www.osha.gov/heat-exposure" rel="noopener" class="text-gold-700 hover:underline">OSHA heat guidance</a> covers how to evaluate and control heat exposure. Clothing is only one part of a heat plan.' },
 { num: 'UPF', label: 'Published ratings', body: 'Some garments carry a published UPF rating. Check the rating on the exact garment before it goes in your sun and heat plan.' },
 { num: 'PPE', label: 'Your call', body: 'Traffic, chemicals, and power tools each create different hazards, so protective gear comes from your hazard assessment. See <a href="https://www.cdc.gov/niosh/topics/heatstress/" rel="noopener" class="text-gold-700 hover:underline">NIOSH heat stress resources</a> for more.' },
]

const gear = [
 { name: 'Published-UPF long-sleeves', detail: 'Check the rating on the exact shirt · screen printed or embroidered', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=373505618&RS=300' },
 { name: 'Crew tees (poly-cotton)', detail: 'Your fabric, sizes, and colors · printed after you approve the proof', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=722090562&RS=300' },
 { name: 'Branded service polos', detail: 'For account managers + design-build leads · embroidered logo', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
 { name: 'Hi-vis vests + hats', detail: 'The class your job requires · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=116377398&RS=300' },
]

const useCases = [
 'Maintenance crews in branded long-sleeves with company logo on the back',
 'Design-build and installation crews in branded work shirts and tees',
 'Account managers and estimators in embroidered service polos for client walk-throughs',
 'Pre-dawn winter starts in branded hoodies and quarter-zips for cool desert mornings',
 'Spray techs and applicators in a different color from the rest of the crew',
 'Branded swag for HOA presentations, property-manager pitches, and home shows',
]

const faqs = [
 {
 q: 'What\'s the best fabric for landscapers working through Vegas summer?',
 a: 'Polyester and poly-cotton blends are the usual picks. We can quote long-sleeves with published UPF ratings to fit your heat plan.',
 },
 {
 q: 'Can you do residential vs commercial branding split for the same company?',
 a: 'Yes. Use different garments or colors for each team and keep the same logo on all of them.',
 },
 {
 q: 'How many shirts do I need per crew member per season?',
 a: 'Start from how often shirts get washed, how long shifts run, and how fast they wear out. Tell us what you’ve landed on and we’ll quote it, or see our guide to shirts per crew member.',
 },
 {
 q: 'Can you get hi-vis for crews working near streets?',
 a: 'Yes. Tell us the class your job requires. The logo method and placement have to fit the garment maker’s instructions.',
 },
 {
 q: 'Can you set up a company store so foremen can order direct?',
 a: 'Yes. Foremen or crew members order from your approved list. Tell us the budgets you want, and your proposal will say what the store can do.',
 },
 {
 q: 'How fast can you turn around a 30-shirt order for a new crew starting Monday?',
 a: 'Call with the date first. Stock, how ready your logo is, quantity, and production capacity decide it, and we’ll tell you the timing and any rush charge before you order.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Landscaping', item: 'https://bighornthreads.com/industries/landscaping-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Landscaping Crews',
 serviceType: 'Branded apparel program coordination for landscaping crews',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Landscaping Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/landscaping-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Landscaping</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Branded Crew Apparel for <span class="text-gold-700">Las Vegas Landscaping Teams.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Long-sleeves, performance tees, polos, and hats with your logo for Las Vegas landscaping companies. We run the order, and production partners make it.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Las Vegas landscaping crews usually wear branded tees, long-sleeves, polos, hats, and hi-vis, chosen by role. We quote the branded gear. Protective gear for heat, chemicals, traffic, or power tools comes from your hazard assessment.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Conditions — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Vegas Conditions</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to plan for in <span class="text-gold-600">Mojave work.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Heat, sun, irrigation water, roadside work, chemicals, and power equipment all come with the job. Once you’ve set the safety requirements, we’ll help you pick the branded gear around them.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {conditions.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-baseline gap-3">
 <span class="font-heading text-4xl font-extrabold text-gold-600">{c.num}</span>
 <span class="spec text-ash">{c.label}</span>
 </div>
 <p class="text-base leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">landscaping crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Common picks for crews in Las Vegas, Henderson, Summerlin, and Boulder City. Choose by role, and your quote will confirm stock and logo work.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for landscaping teams.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Most teams set tees, long-sleeves, and polos by role. Check your safety and licensing rules for spray techs and applicators.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear for Las Vegas landscaping and grounds-maintenance crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Las Vegas sun, thorny desert plants, irrigation water, soil, and chemicals are hard on clothes. We outfit landscaping companies, HOA grounds crews, golf course operations, irrigation specialists, and tree service teams. No one garment suits every role, so start with what each crew does and your heat plan.
 </p>
 <p>
 For outdoor crews, compare lightweight long-sleeves and shirts with published UPF ratings. Color, fabric, coverage, and even a large print can change comfort, so try a shirt before you order for the whole crew.
 </p>
 <p>
 Supervisors, account managers, and design consultants who meet clients usually do well in a branded polo, with a logo and a name if you want one.
 </p>
 <p>
 Chainsaws, chemicals, and traffic call for a hazard assessment and safety controls beyond what a branded shirt can do, and we don’t prescribe specialty PPE. Pick pants and shorts by role and task, and we’ll quote the everyday gear.
 </p>
 <p>
 Hats help with sun, and your work zone sets the hi-vis requirement. We can quote hats and vests, with your logo on them where the maker allows it.
 </p>
 <p>
 Go over our <a href="/blog/nevada-osha-heat-rules-2026-workwear/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Nevada OSHA heat rules and workwear</a> guide with your safety lead. Landscape design and installation teams may also consider <a href="/blog/custom-embroidered-aprons-trade-businesses/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">custom embroidered aprons for trade businesses</a> where they make sense for the task.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions landscaping crews <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/roofing-solar-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Roofing &amp; Solar</h3>
 <p class="mt-2 text-sm text-ash">Crew apparel for rooftop heat and long days in the sun.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which method suits outdoor crew gear.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Outfit your crew for <span class="text-gold-400">the desert, not the catalog.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Send your logo and the gear you want, and we’ll send back price and timing.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
