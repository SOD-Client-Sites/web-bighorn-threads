---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Landscaping Crew Apparel and Branded Workwear | Las Vegas',
 description:
 'Branded-apparel planning for Las Vegas landscaping companies. Bighorn coordinates requested products and decoration through selected production partners.',
 h1Pre: 'Landscaping',
 hero: '/images/generated/kit-landscaping.jpg',
}

const conditions = [
 { num: 'HEAT', label: 'Exposure planning', body: '<a href="https://www.osha.gov/heat-exposure" rel="noopener" class="text-gold-700 hover:underline">OSHA heat guidance</a> describes employer responsibilities for evaluating and controlling heat exposure. Apparel is only one consideration in the employer\'s complete heat plan.' },
 { num: 'UPF', label: 'Published ratings', body: 'Some garments carry a manufacturer-published UPF rating. The employer should verify the exact current product documentation and decide whether that garment belongs in its sun and heat program.' },
 { num: 'PPE', label: 'Employer selection', body: 'Work near traffic, chemicals, tools, or vegetation can create different hazards. The employer selects any protective apparel through a task-specific hazard assessment. See <a href="https://www.cdc.gov/niosh/topics/heatstress/" rel="noopener" class="text-gold-700 hover:underline">NIOSH heat stress resources</a> for additional educational context.' },
]

const gear = [
 { name: 'Published-UPF long-sleeves', detail: 'Verify the exact current manufacturer rating · employer-approved fabric and coverage · approved decoration only', img: '/images/generated/kit-landscaping.jpg' },
 { name: 'Crew tees (poly-cotton)', detail: 'Requested fabric, sizes, and colors · partner screen printing after proof approval', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Branded service polos', detail: 'For account managers + design-build leads · embroidered logo', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Hi-vis vests + hats', detail: 'Employer selects any required class from the task-specific hazard assessment · manufacturer-approved decoration', img: '/images/generated/service-company-stores.jpg' },
]

const useCases = [
 'Maintenance crews in branded long-sleeves with company logo on the back',
 'Design-build and installation crews in employer-approved branded apparel',
 'Account managers and estimators in embroidered service polos for client walk-throughs',
 'Pre-dawn winter starts in branded hoodies and quarter-zips for cool desert mornings',
 'Spray-tech and applicator roles differentiated under the employer-approved uniform plan',
 'Branded swag for HOA presentations, property-manager pitches, and home shows',
]

const faqs = [
 {
 q: 'What\'s the best fabric for landscapers working through Vegas summer?',
 a: 'Polyester and poly-cotton blends are common warm-weather options. Bighorn can quote long-sleeves with published UPF ratings. Your employer must approve fabric, coverage, and heat-plan requirements.',
 },
 {
 q: 'Can you do residential vs commercial branding split for the same company?',
 a: 'A nonprotective uniform plan can use different employer-approved garments by team while keeping the same logo system. Product cost, visibility, decoration, and availability depend on the exact current product and quote.',
 },
 {
 q: 'How many shirts do I need per crew member per season?',
 a: 'The right quantity depends on shift length, laundry cadence, replacement policy, season, and role. Bighorn can quote the quantities your employer selects and confirm reorder terms in writing.',
 },
 {
 q: 'Do you stock hi-vis for crews working near streets or commercial properties?',
 a: 'Bighorn can quote employer-selected hi-vis products. The employer selects the required class, and the garment manufacturer must approve each proposed decoration method and placement before production.',
 },
 {
 q: 'Can you set up a company store so foremen can order direct?',
 a: 'A proposed company store could support approved products and crew budgets if the selected platform and configuration do. No platform has been selected or launched. Implementation, delivery, fulfillment, and capabilities require separate written approval.',
 },
 {
 q: 'How fast can you turn around a 30-shirt order for a new crew starting Monday?',
 a: 'Rush options depend on product availability, artwork readiness, quantity, and production partner capacity. Bighorn confirms timing and any surcharge in writing before you order.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Landscaping', item: 'https://bighornthreads.com/industries/landscaping-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Landscaping Crews',
 serviceType: 'Branded apparel program coordination for landscaping crews',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Landscaping Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/landscaping-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Landscaping</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Branded Crew Apparel Planning for <span class="text-gold-400">Las Vegas Landscaping Teams.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn helps Las Vegas landscaping companies plan requested long-sleeves, performance tees, polos, and other branded apparel. We coordinate approved products and decoration through production partners after availability and terms are confirmed.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Las Vegas landscaping companies may consider branded tees, long-sleeves, polos, hats, and employer-selected hi-vis garments by role. Bighorn can quote requested products, but the employer must choose any heat, sun, chemical, roadside, or tool-related protective apparel through a task-specific hazard assessment and exact current manufacturer documentation.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Conditions — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Vegas Conditions</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Apparel factors to review for <span class="text-gold-600">Mojave work.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Las Vegas landscaping work can involve heat, sun, irrigation moisture, roadside exposure, chemicals, and powered equipment. Bighorn helps compare requested branded-apparel options after the employer defines the hazards and required controls.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {conditions.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-baseline gap-3">
 <span class="font-heading text-4xl font-extrabold text-gold-600">{c.num}</span>
 <span class="spec text-ash">{c.label}</span>
 </div>
 <p class="text-base leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to consider for <span class="text-gold-600">landscaping crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 These are examples for apparel-program planning in Las Vegas, Henderson, Summerlin, and Boulder City. The employer selects products by role, and each quote confirms current product information, decoration, availability, and partner terms.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options <span class="text-gold-600">for landscaping teams.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Teams may organize tees, long-sleeves, and polos by role. Employers decide whether spray-tech or applicator roles need distinct apparel under their safety and licensing programs.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear for Las Vegas landscaping and grounds-maintenance crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Landscaping in Las Vegas can expose apparel to sun, desert vegetation, irrigation moisture, soil, and job-specific chemicals. Bighorn Threads coordinates branded-apparel programs for landscaping companies, HOA grounds-maintenance crews, golf course operations, irrigation specialists, and tree service teams. There is no universal baseline garment. The employer evaluates each role and chooses products using its heat program, task-specific hazard assessment, and exact current manufacturer documentation.
 </p>
 <p>
 For outdoor roles, employers may compare lightweight long-sleeves, products with published UPF ratings, and other garments within the full heat and sun-exposure plan. Color, fabric, coverage, and decoration can affect comfort and performance. The employer should review the exact current manufacturer documentation and approve the selected SKU before Bighorn coordinates decoration.
 </p>
 <p>
 For client-facing roles such as supervisors, account managers, and design consultants, a branded polo is one nonprotective uniform option. Bighorn can quote requested styles and coordinate an approved logo or employee name. Garment comfort, durability, and care claims depend on the exact current manufacturer documentation and should be evaluated by the buyer.
 </p>
 <p>
 Pants, shorts, and specialty protective equipment must be selected by role and task. Work involving chainsaws, chemicals, traffic, or other hazards requires an employer-led hazard assessment and appropriate safety controls outside the branded-apparel decision. Bighorn does not prescribe specialty PPE. It can quote employer-selected ordinary garments and coordinate approved decoration where the manufacturer permits it.
 </p>
 <p>
 Hats and caps can support an employer's sun-protection plan. Hi-vis requirements depend on the work zone and hazard assessment. Bighorn can quote selected hats and vests. Production partners handle approved decoration after the employer and manufacturer confirm the garment and placement.
 </p>
 <p>
 Review our educational <a href="/blog/nevada-osha-heat-rules-2026-workwear/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Nevada OSHA heat rules and workwear</a> guide with your safety lead. Landscape design and installation teams may also consider <a href="/blog/custom-embroidered-aprons-trade-businesses/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">custom embroidered aprons for trade businesses</a> when the employer determines they are appropriate for the task.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions landscaping crews <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/roofing-solar-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Roofing &amp; Solar</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected apparel options for outdoor roofing and solar crews.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Decoration options to review for outdoor crew gear.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Outfit your crew for <span class="text-gold-400">the desert, not the catalog.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Send your logo and requested products. We will confirm availability, pricing, and partner production terms.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
