---
import HeroProducts from '@/components/HeroProducts.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const problems = [
  {
    title: 'Chasing Sizes by Email.',
    desc: 'Someone in ops spends days collecting shirt sizes in a spreadsheet. A new hire starts and it happens again.',
  },
  {
    title: 'Swag Nobody Wears.',
    desc: 'Cheap blanks ordered in bulk sit in a closet in the wrong sizes. Your logo ends up on gear people throw out.',
  },
  {
    title: 'Brand Drift Across Vendors.',
    desc: 'Marketing buys polos one place and HR buys onboarding kits another. Now your logo comes in two different blues.',
  },
  {
    title: 'New-Hire Kits Done by Hand.',
    desc: 'Every start date means a manual order, a guess at sizes, and a scramble to get gear there in time.',
  },
]

const storeSteps = [
  {
    n: '01',
    meta: 'Setup',
    title: 'We Plan Your Branded Store',
    desc: 'Tell us what your team should be able to order, who gets access, and any budgets. We put it in a written plan, including what the store can and can’t do.',
  },
  {
    n: '02',
    meta: 'Ongoing',
    title: 'Your People Order Their Own Sizes',
    desc: 'Your people pick their own sizes from the approved list. Your plan says who can order what.',
  },
  {
    n: '03',
    meta: 'Ongoing',
    title: 'Delivery Options and Budget Controls',
    desc: 'Tell us where gear needs to go and any spending limits you want. We tell you in writing what your store supports, and production partners fill the orders.',
  },
]

const offerings = [
  {
    title: 'Company Uniforms & Custom Company Shirts',
    desc: 'Embroidered polos, button-ups, and custom company shirts for front desk, sales, service, and office staff. One logo standard across every location.',
    tag: 'Uniforms',
  },
  {
    title: 'Custom Embroidered Jackets & Quarter-Zips',
    desc: 'Softshells, fleece jackets, vests, and custom quarter-zips with your logo embroidered. The layer people wear to client meetings.',
    tag: 'Outerwear',
  },
  {
    title: 'Branded Merchandise & Custom Swag',
    desc: 'Drinkware, bags, hats, tech, and desk gear with your logo. Includes names people recognize, like Port Authority and YETI.',
    tag: 'Swag',
  },
  {
    title: 'Corporate Gifts With Your Logo',
    desc: 'Client gifts and employee appreciation gifts picked for who is getting them. Kits can ship to one office or to each recipient.',
    tag: 'Gifts',
  },
  {
    title: 'New-Hire Onboarding Kits',
    desc: 'A welcome kit of approved apparel and merchandise, sized by the new hire and shipped to their home or office.',
    tag: 'Onboarding',
  },
  {
    title: 'Conference & Trade-Show Swag',
    desc: 'Matching booth-staff apparel and trade-show promotional items, shipped to your office or straight to the venue.',
    tag: 'Events',
  },
]

const faqs = [
  {
    q: 'Do you ship corporate apparel nationwide?',
    a: 'Yes. Bighorn Threads is based in Las Vegas and ships custom corporate apparel, company uniforms, and branded merchandise anywhere in the United States, to one office, several locations, or individual employees.',
  },
  {
    q: 'What is the minimum order for custom corporate apparel?',
    a: 'Minimums depend on the order: the garment, the decoration method, and the quantity. Send your logo, the items you want, and rough quantities, and the quote lists the minimum for that order.',
  },
  {
    q: 'Embroidery or screen printing for company shirts?',
    a: 'Embroidery is the standard for polos, jackets, quarter-zips, and hats because it looks professional and holds up to washing. Screen printing fits larger runs of t-shirts and event apparel. The quote recommends a method for each item.',
  },
  {
    q: 'What is a company store?',
    a: 'A private online store with your approved products and logo, where your people order their own sizes. Your setup plan covers payment and shipping.',
  },
  {
    q: 'Do we need a minimum number of people to start?',
    a: 'There is no set number. Tell us your headcount and we will tell you whether a store makes sense or a regular order is the better call.',
  },
  {
    q: 'Can remote employees order gear to their home?',
    a: 'You can ask for home delivery or several locations. We ship anywhere in the US, and your setup plan lists the shipping cost and how ordering works.',
  },
  {
    q: 'Can we cap how much each person spends?',
    a: 'Ask for it. Budgets, allowances, and approvals depend on the store setup, and your proposal says which ones you get.',
  },
  {
    q: 'How do reorders and onboarding kits work?',
    a: 'Your approved products and logo are the starting point for every reorder, and new hires pick their own sizes. We check stock and price each time.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
    { '@type': 'ListItem', position: 3, name: 'Corporate', item: 'https://bighornthreads.com/industries/corporate/' },
  ],
}

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Custom corporate apparel and company uniforms',
  serviceType: 'Custom corporate apparel, company uniforms, branded merchandise, and corporate gifts',
  provider: { '@id': 'https://bighornthreads.com/#organization' },
  areaServed: { '@type': 'Country', name: 'United States' },
  url: 'https://bighornthreads.com/industries/corporate/',
}

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'
---

<BaseLayout
  title="Custom Corporate Apparel & Company Uniforms | Shipped Nationwide | Bighorn Threads"
  description="Custom corporate apparel, company uniforms, branded merchandise, and corporate gifts with your logo. Embroidered polos, jackets, and quarter-zips, shipped anywhere in the US."
  canonical="https://bighornthreads.com/industries/corporate/"
>
  <!-- ════ HERO — concrete (no photographic band) ════ -->
  <section class="bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
    <div class="page-hero-grid mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
        <a href="/" class="hover:text-gold-600">Home</a>
        <span class="px-2 text-ash/60">/</span>
        <a href="/industries/" class="hover:text-gold-600">Industries</a>
        <span class="px-2 text-ash/60">/</span>
        <span class="text-gold-600">Corporate</span>
      </nav>

      <div class="max-w-3xl">
        <p class="kicker mb-5 flex items-center gap-2.5">
          <span class="h-px w-8 bg-gold-500"></span>
          For Corporate &amp; Office Teams
        </p>
        <h1 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Custom corporate apparel &amp; company uniforms,
 <span class="text-gold-600"> shipped anywhere in the US.</span>
 </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
          Embroidered polos, jackets, quarter-zips, company shirts, branded merchandise, and corporate gifts
          with your logo. One account team in Las Vegas runs the order, production partners make it, and it ships to
          any office or employee in the country. Add a company store when your team reorders often.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/get-started/corporate/" class="btn-primary text-base">
            Build my company store plan
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
          </a>
          <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-600">
            <svg class="h-4 w-4 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            702.904.8923
          </a>
        </div>
      </div>
     <HeroProducts />
 </div>
 </section>

  <!-- ════ THE PROBLEM — paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">The Problem</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Branded gear shouldn’t be <span class="text-gold-600">an ops headache.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          If you run office or people ops, you know the drill. Branded apparel turns into a spreadsheet
          you maintain by hand. It eats your time and your brand pays for it.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {problems.map((item) => (
          <div class="border border-hairline bg-panel p-7">
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ HOW A COMPANY STORE WORKS — concrete ════ -->
  <section class="bg-concrete py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl">
        <p class="kicker mb-3">How It Works</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          How a company store works <span class="text-gold-600">for your team.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          You pick the products and we write up how the store will work and what it costs. Once you
          say go, your people order and production partners fill it.
        </p>
      </div>

      <ol class="grid gap-5 md:grid-cols-3">
        {storeSteps.map((step) => (
          <li class="border border-hairline bg-panel p-7">
            <div class="mb-5 flex items-baseline justify-between">
              <span class="font-heading text-5xl font-extrabold leading-none text-gold-600">{step.n}</span>
              <span class="spec border border-hairline px-2 py-1 text-ash">{step.meta}</span>
            </div>
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{step.desc}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8">
        <a href="/get-started/corporate/" class="btn-secondary text-sm">
          Build my company store plan
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════ WHAT YOU CAN PUT IN THE STORE — paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">What We Brand</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Corporate apparel, swag &amp; gifts <span class="text-gold-600">we brand.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          Pick the gear that fits your team. Your quote covers what is in stock, how many, and
          how it ships.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {offerings.map((item) => (
          <div class="flex flex-col border border-hairline bg-panel p-6">
            <span class="spec mb-3 inline-block self-start border border-hairline px-2 py-1 text-ash">{item.tag}</span>
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ FAQ — concrete ════ -->
  <NationalLinks heading='Related product guides' links={[{ href: '/company-uniforms/', label: 'Company uniforms' }, { href: '/custom-company-shirts/', label: 'Custom company shirts' }, { href: '/custom-polo-shirts/', label: 'Custom polo shirts' }, { href: '/custom-quarter-zips-jackets/', label: 'Quarter-zips and jackets' }, { href: '/corporate-swag/', label: 'Corporate swag and branded merchandise' }, { href: '/custom-embroidered-hats/', label: 'Custom embroidered hats' }, { href: '/employee-appreciation-gifts/', label: 'Employee appreciation gifts' }, { href: '/custom-hoodies/', label: 'Custom logo hoodies' }, { href: '/custom-screen-printed-shirts/', label: 'Custom screen printed shirts' }, { href: '/industries/government/', label: 'Government uniforms' }, { href: '/industries/gaming-hospitality/', label: 'Gaming and hospitality uniforms' }]} />
 <section class="bg-concrete py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <p class="kicker mb-3">FAQ</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Company stores, <span class="text-gold-600">answered.</span>
        </h2>
      </div>

      <div class="divide-y divide-hairline border-y border-hairline">
        {faqs.map((item) => (
          <details class="group">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
              <span class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.q}</span>
              <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </summary>
            <p class="pb-5 leading-relaxed text-ash">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ CTA BAND — paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start gap-6 border border-hairline bg-charcoal p-8 sm:flex-row sm:items-center sm:justify-between sm:p-12">
        <div class="max-w-xl">
          <p class="kicker mb-3">Get Started</p>
          <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-concrete sm:text-4xl">
            Ready to give your team <span class="text-gold-400">a real company store?</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-navy-200">
            Your people pick their own sizes and you stop keeping the spreadsheet. Tell us about
            your team and we’ll build your plan.
          </p>
        </div>
        <a href="/get-started/corporate/" class="btn-primary shrink-0 text-base">
          Build my company store plan
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>
