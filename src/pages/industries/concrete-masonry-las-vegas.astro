---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Concrete & Masonry Crew Apparel Las Vegas | Bighorn Threads',
 description:
 'Heavyweight tees, double-knee pants, hi-vis, and foreman polos for Las Vegas concrete and masonry crews.',
 h1Pre: 'Concrete & Masonry',
}

const challenges = [
 {
 code: 'Heavy-Wear Fabrics',
 title: 'Compare materials for the actual work conditions',
 body: 'Abrasion and hard washing wear gear out fastest. We can quote heavyweight cotton and blends from <a href="https://www.carhartt.com/" rel="noopener" class="text-gold-700 hover:underline">Carhartt</a> and other brands.',
 },
 {
 code: 'Cement Resistance',
 title: 'Review garment care around concrete work',
 body: 'Concrete work can expose garments to abrasive and alkaline materials. Clothing won’t protect against <a href="https://www.osha.gov/silica-crystalline" rel="noopener" class="text-gold-700 hover:underline">respirable silica hazards</a>. Follow your safety program and the garment’s care instructions.',
 },
 {
 code: 'ANSI/ISEA 107 Class 2',
 title: 'Hi-vis for the work zone',
 body: 'Your traffic-control plan sets the visibility class. Check the current <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a> requirements and the garment’s certificate, and we’ll put the logo where the maker allows it.',
 },
]

const gear = [
 { name: 'Heavyweight branded tees', detail: 'Carhartt K87 or Gildan 2000 · 6.1oz cotton or poly-blend · screen-printed back', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=722090562&RS=300' },
 { name: 'Hi-vis shirts', detail: 'The class your plan requires · logo per the maker’s instructions', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=913213443&RS=300' },
 { name: 'Foreman + supervisor polos', detail: 'Differentiated colorway · embroidered chest · for client walk-throughs', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=572084278&RS=300' },
 { name: 'Branded crew hoodies', detail: 'Heavyweight · for early-morning pours + winter mornings', img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=786780311&RS=300' },
]

const useCases = [
 'Flatwork and finisher crews in heavyweight tees',
 'Night-pour crews in the hi-vis class your plan requires, with your logo',
 'Foreman differentiation by color and polo vs tee: visibility from across the slab',
 'Masonry crews running consistent crew tees for residential blockwork and commercial veneer',
 'Pump operators and tailgate finishers in branded hi-vis with company name on the back',
 'New-hire kits built from your approved list for each role',
]

const faqs = [
 {
 q: 'Why do my polos last a week on concrete crews?',
 a: 'A polo isn’t built for flatwork. Cement and abrasion chew through lighter fabric, so try a heavier tee or work shirt for the field and save polos for walk-throughs.',
 },
 {
 q: 'What\'s the best brand for crews that destroy everything?',
 a: 'No one brand wins. Tell us the role, the conditions, any required rating, and your budget, and we’ll quote Carhartt, Gildan, ML Kishigo, Pioneer, or others to match.',
 },
 {
 q: 'Can you handle hi-vis branding for night pours and DOT-adjacent work?',
 a: 'Yes. Tell us the class your job requires. The garment maker’s rules set how big the logo can be and where it goes, and we work within them.',
 },
 {
 q: 'How do you handle reorders when shirts get destroyed mid-season?',
 a: 'We keep your approved product and logo details so a reorder starts from there. If shirts go fast, ask about a company store with allowances.',
 },
 {
 q: 'Can you get heavyweight long-sleeves for masonry crews in cooler months?',
 a: 'Yes. We can quote long-sleeve tees, quarter-zips, and hoodies, and we’ll check sizes, colors, and timing when you order.',
 },
 {
 q: 'Can a foreman or office manager order direct without going through ownership?',
 a: 'With a company store, possibly. Tell us the budget and approval rules you want, and your proposal will say what it can do.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Concrete & Masonry', item: 'https://bighornthreads.com/industries/concrete-masonry-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Concrete and Masonry Crews',
 serviceType: 'Heavy-wear branded apparel and crew uniforms',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Concrete and Masonry Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/concrete-masonry-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/industries/" class="hover:text-gold-700">Industries</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Concrete &amp; Masonry</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Branded concrete crew apparel in Las Vegas
 <span class="text-gold-700"> planned for the work.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Heavyweight tees, hi-vis, and foreman polos for crews who go through gear fast. One Las Vegas contact runs the order, and production partners make it.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Concrete and masonry work is hard on clothes: abrasion, heat, and alkaline materials. We can quote shirts, pants, and layers built for it, plus the hi-vis or protective garments your safety lead specifies.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Challenges / specs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What We Solve</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Concrete work can punish apparel. <span class="text-gold-600">Compare the right details.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Tell us what your crew does all day and how the gear gets washed, and we’ll quote heavier options that fit.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {challenges.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to order for <span class="text-gold-600">concrete and masonry crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Match them to the actual work, how the gear gets washed, your safety requirements, and your budget.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Common crew setups <span class="text-gold-600">for concrete and masonry shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Field crews and client-facing roles usually wear different gear. Tell us who does what and we’ll quote it.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear planning for Las Vegas concrete and masonry crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Cement, aggregate, heat, kneeling, and lifting all wear clothes down. We can quote heavyweight tees, double-knee pants, and hoodies for Las Vegas crews.
 </p>
 <p>
 A heavyweight cotton tee is a practical place to start. Compare the Carhartt K87, Bayside 5100, and Hanes Beefy-T. If a laundry service washes your gear, ask them about wash requirements.
 </p>
 <p>
 Pants are where concrete crews spend much of the durability budget. Double-knee pants include reinforced fabric panels at the knees. Compare Carhartt B11, Carhartt B324, and Dickies Industrial Double Knee options. Ask us about hemming and logo placement.
 </p>
 <p>
 Vegas summers call for a heat plan. Lightweight long-sleeve performance shirts can be part of it, and we can quote Carhartt Force and Bayside Performance options for your safety lead to review.
 </p>
 <p>
 On a larger crew, a company store lets people order approved gear in their own sizes. Your proposal covers fees, inventory, replacements, and approvals.
 </p>
 <p>
 For more on heat rules, see our <a href="/blog/nevada-osha-heat-rules-2026-workwear/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Nevada heat-rule planning guide</a>. Our <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">construction crew apparel guide</a> covers the broader ordering process.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions concrete and masonry shops <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">FR, hi-vis, and service uniforms for electrical crews.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which decoration method survives concrete crew abuse.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Get the right mix for your crew. <span class="text-gold-400">Get it in writing.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">Send your logo, the gear, sizes, ship-to address, and deadline for a quote.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
