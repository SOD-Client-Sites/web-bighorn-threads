---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Concrete and Masonry Crew Apparel | Las Vegas',
 description:
 'Planning options for branded shirts, employer-selected hi-vis, workwear, and crew programs for Las Vegas concrete and masonry contractors.',
 h1Pre: 'Concrete & Masonry',
 hero: '/images/generated/kit-concrete.jpg',
}

const challenges = [
 {
 code: 'Heavy-Wear Fabrics',
 title: 'Compare materials for the actual work conditions',
 body: 'Abrasion, laundering, fit, and garment care can affect wear. Bighorn can quote heavyweight cotton and blended options from <a href="https://www.carhartt.com/" rel="noopener" class="text-gold-700 hover:underline">Carhartt</a> and other brands. The manufacturer controls product claims.',
 },
 {
 code: 'Cement Resistance',
 title: 'Review garment care around concrete work',
 body: 'Concrete work can expose garments to abrasive and alkaline materials. Apparel does not control <a href="https://www.osha.gov/silica-crystalline" rel="noopener" class="text-gold-700 hover:underline">respirable silica hazards</a>. Follow the employer\'s safety program and the exact garment manufacturer\'s care instructions.',
 },
 {
 code: 'ANSI/ISEA 107 Class 2',
 title: 'Employer-selected hi-vis for the work zone',
 body: 'The employer and traffic-control plan determine the required visibility class. Review the current <a href="https://safetyequipment.org/standards/ansi-isea-107/" rel="noopener" class="text-gold-700 hover:underline">ANSI/ISEA 107</a> requirements, exact garment certificate, and manufacturer decoration rules before ordering.',
 },
]

const gear = [
 { name: 'Heavyweight branded tees', detail: 'Carhartt K87 or Gildan 2000 · 6.1oz cotton or poly-blend · screen-printed back', img: '/images/generated/kit-concrete.jpg' },
 { name: 'Employer-selected hi-vis shirts', detail: 'Confirm class, certificate, fabric, fit, striping, and decoration rules', img: '/images/generated/service-screen-printing.jpg' },
 { name: 'Foreman + supervisor polos', detail: 'Differentiated colorway · embroidered chest · for client walk-throughs', img: '/images/generated/service-embroidery.jpg' },
 { name: 'Branded crew hoodies', detail: 'Heavyweight · for early-morning pours + winter mornings', img: '/images/generated/service-company-stores.jpg' },
]

const useCases = [
 'Flatwork and finisher crews comparing heavyweight tees for their work conditions',
 'Night-pour crews using employer-selected visibility garments and approved decoration',
 'Foreman differentiation by color and polo vs tee — visibility from across the slab',
 'Masonry crews running consistent crew tees for residential blockwork and commercial veneer',
 'Pump operators and tailgate finishers in branded hi-vis with company name on the back',
 'New-hire kits built from the employer-approved product list and role requirements',
]

const faqs = [
 {
 q: 'Why do my polos last a week on concrete crews?',
 a: 'Garment life varies with product, fit, work conditions, laundering, and care. Compare manufacturer materials and care guidance. A heavier product may be one option, but no fixed lifetime applies.',
 },
 {
 q: 'What\'s the best brand for crews that destroy everything?',
 a: 'There is no universal best brand. Bighorn can quote Carhartt, Gildan, ML Kishigo, Pioneer, and other options after reviewing the role, work conditions, required rating, and budget.',
 },
 {
 q: 'Can you handle hi-vis branding for night pours and DOT-adjacent work?',
 a: 'Bighorn can coordinate approved hi-vis decoration through a production partner. The employer selects the required class. The exact garment manufacturer controls decoration size, placement, materials, and certificate requirements.',
 },
 {
 q: 'How do you handle reorders when shirts get destroyed mid-season?',
 a: 'Bighorn can retain approved product and artwork details subject to written terms. A proposed store could support allowances if the selected platform and configuration do. No platform has been selected or launched. Availability, shipping, timing, implementation, and capabilities require separate written approval.',
 },
 {
 q: 'Do you stock heavyweight long-sleeves for masonry crews working in cooler months?',
 a: 'Bighorn can request current quotes for long-sleeve tees, quarter-zips, and hoodies. Sizes, colors, availability, production, delivery, and timing depend on the selected product and partner.',
 },
 {
 q: 'Can a foreman or office manager order direct without going through ownership?',
 a: 'A proposed company store may support budgets, approvals, and purchasing fields. The exact workflow, inventory, fees, delivery, and fulfillment depend on the written setup.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://bighornthreads.com/industries/' },
 { '@type': 'ListItem', position: 3, name: 'Concrete & Masonry', item: 'https://bighornthreads.com/industries/concrete-masonry-las-vegas/' },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Workwear for Concrete and Masonry Crews',
 serviceType: 'Heavy-wear branded apparel and crew uniforms',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: { '@type': 'BusinessAudience', audienceType: 'Concrete and Masonry Contractors' },
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/industries/concrete-masonry-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/industries/" class="hover:text-gold-400">Industries</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Concrete &amp; Masonry</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Branded Concrete Crew Apparel <span class="text-gold-400">Planned for the Work.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Compare heavyweight tees, employer-selected hi-vis, and foreman polos. Bighorn manages the Las Vegas account and coordinates production through selected partners.
 </p>

 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Answer-first block (AEO citation target) — concrete -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-7 sm:p-9">
 <span class="spec mb-3 inline-block text-gold-600">Quick Answer</span>
 <p class="font-heading text-lg leading-relaxed text-charcoal sm:text-xl">
 Concrete and masonry work can expose garments to abrasion, heat, and alkaline materials. The employer selects any protective or visibility garment. Bighorn can quote approved shirts, pants, layers, and branded role identifiers through production partners.
 </p>
 </div>
 </div>
 </div>
 </section>

 <!-- Challenges / specs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What We Solve</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Concrete work can punish apparel. <span class="text-gold-600">Compare the right details.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Concrete and masonry work can create heavy abrasion. Bighorn can quote heavier-weight options based on your crew's work conditions. The manufacturer defines each garment's materials and care instructions.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {challenges.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline bg-gold-500/15 px-2.5 py-1 text-gold-700">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash" set:html={c.body}></p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Gear — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Gear</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Products to compare for <span class="text-gold-600">concrete and masonry crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Review the products against the crew's actual work conditions, laundering, approved safety requirements, and budget. Manufacturer data controls product claims.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {gear.map((g) => (
 <div class="flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={g.img} alt={g.name} class="h-full w-full object-cover" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="flex flex-1 flex-col p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{g.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{g.detail}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Use cases — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Typical Orders</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Crew configurations to review <span class="text-gold-600">for concrete and masonry shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Field and client-facing roles may use different product mixes. The employer controls all protective requirements. Bighorn can quote the documented configuration.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="divide-y divide-hairline border-y border-hairline">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 py-4">
 <span class="flex-shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Branded workwear planning for Las Vegas concrete and masonry crews.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Concrete and masonry work can expose garments to cement, aggregate, heat, kneeling, and lifting. Bighorn Threads manages apparel programs for Las Vegas crews. We can quote heavyweight tees, double-knee pants, and hoodies from selected brands. Product availability and durability claims come from the manufacturer.
 </p>
 <p>
 A heavyweight cotton tee can be a practical option for concrete work. Carhartt K87, Bayside 5100, and Hanes Beefy-T are examples to compare. Bighorn coordinates logo placement and decoration through a selected production partner. Ask the garment manufacturer and your laundry provider about durability and wash requirements.
 </p>
 <p>
 Pants are where concrete crews spend much of the durability budget. Double-knee pants include reinforced fabric panels at the knees. Compare Carhartt B11, Carhartt B324, and Dickies Industrial Double Knee options. Bighorn can request partner quotes for compatible hemming and logo placement.
 </p>
 <p>
 Vegas summer requires a documented employer heat plan. Lightweight long-sleeve performance shirts may support some plans. Bighorn can quote Carhartt Force and Bayside Performance options. Your employer must approve the fabric, coverage, and work practice.
 </p>
 <p>
 A proposed company store may present approved products and ordering rules for a larger crew. Inventory, sizing data, replacements, fees, approvals, production, delivery, and fulfillment depend on the written setup.
 </p>
 <p>
 The employer's heat plan controls work practices and apparel selection. See our <a href="/blog/nevada-osha-heat-rules-2026-workwear/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Nevada heat-rule planning guide</a>. Our <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">construction crew apparel guide</a> covers the broader ordering process.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-10 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Questions concrete and masonry shops <span class="text-gold-600">ask us.</span></h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Crew uniforms, sub branding, and onboarding kits for Vegas GCs.</p>
 </a>
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Employer-selected protective apparel with manufacturer-reviewed decoration.</p>
 </a>
 <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Print vs Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Which decoration method survives concrete crew abuse.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl">Plan the right product mix. <span class="text-gold-400">Confirm every term in writing.</span></h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-200">Send the approved products, size list, artwork, destination, and deadline for a current quote.</p>
 <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
