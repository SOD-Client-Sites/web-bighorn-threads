---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Bulwark FR Embroidery and Printing in Las Vegas',
 description:
  'Managed Bulwark FR apparel programs for Las Vegas crews. Compare eligible garments, documentation, and partner-coordinated decoration for your workplace requirements.',
 hero: '/images/generated/workwear-flatlay.jpg',
}

const products = [
  { sku: 'SLU2', name: 'Bulwark FR Excel-FR ComforTouch Work Shirt', detail: 'A work-shirt option for crews with documented FR requirements. Confirm the current rating and product specifications before ordering.', method: 'Decoration subject to current manufacturer guidance' },
  { sku: 'QT11', name: 'Bulwark FR Long-Sleeve Henley', detail: 'A long-sleeve FR option for eligible workplace programs. Confirm the current product documentation before ordering.', method: 'Decoration subject to current manufacturer guidance' },
  { sku: 'PMW2', name: 'Bulwark FR Premium Uniform Shirt', detail: 'A button-front uniform option for utility techs and field teams. Confirm the current product specifications before ordering.', method: 'Decoration subject to current manufacturer guidance' },
 { sku: 'PEW2', name: 'Bulwark FR Excel-FR ComforTouch Pant', detail: 'A work-pant option for eligible programs. Confirm the current rating, features, and intended use.', method: 'Decoration subject to current manufacturer guidance' },
 { sku: 'SMW2', name: 'Bulwark FR Midweight Excel-FR Work Shirt', detail: 'A midweight shirt option. Confirm the current rating, fabric weight, and layering guidance.', method: 'Decoration subject to current manufacturer guidance' },
 { sku: 'JLR8', name: 'Bulwark FR Hi-Vis Lined Bomber Jacket', detail: 'A lined hi-vis FR option. Confirm all current ratings and workplace requirements by SKU.', method: 'Decoration subject to current manufacturer guidance' },
]

const why = [
  { title: 'Product documentation by SKU', body: 'Ratings and certifications can vary by garment. Review the current manufacturer documents for each selected SKU.' },
 { title: 'Options for Las Vegas heat', body: 'Compare current fabric weights, fits, care instructions, and ratings. Comfort does not replace the employer\'s hazard assessment.' },
 { title: 'Products for multiple sectors', body: 'Bulwark offers garments for electrical, utility, industrial, and other eligible programs. Requirements vary by task and employer.' },
  { title: 'Decoration reviewed by garment', body: 'Bighorn coordinates approved decoration through selected partners. Your safety lead reviews the plan against current manufacturer guidance.' },
]

const faqs = [
 {
 q: 'Does embroidering a Bulwark FR shirt void the NFPA rating?',
    a: 'Decoration can affect a garment\'s protective performance. Review Bulwark\'s current written guidance and have your safety lead approve the plan before use.',
 },
 {
 q: 'What\'s the difference between Bulwark and Carhartt FR?',
    a: 'Available ratings and styles differ by garment. Compare current manufacturer documents, workplace requirements, availability, and fit before choosing.',
 },
 {
 q: 'What\'s your minimum order for custom Bulwark FR?',
    a: 'Minimums depend on the garment, decoration method, and production partner. Share your quantity so we can confirm current options.',
 },
 {
 q: 'How fast can you turn around a Bulwark FR order?',
    a: 'Lead time depends on product availability and production capacity. Share your SKU, quantity, and deadline so we can confirm a current estimate.',
 },
 {
 q: 'Can you do woven FR nameplates instead of direct embroidery?',
    a: 'A woven nameplate may be available. The garment manufacturer and your safety lead must approve the material and placement.',
 },
 {
 q: 'Do you handle Bulwark FR for full crew rollouts and uniform programs?',
    a: 'Bighorn can scope a proposed product list and portal. No platform has been selected or launched. Allowances, capabilities, availability, delivery, and implementation require separate written approval.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Brands', item: 'https://bighornthreads.com/brands/' },
 { '@type': 'ListItem', position: 3, name: 'Bulwark FR', item: 'https://bighornthreads.com/brands/bulwark-fr-custom-las-vegas/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/brands/bulwark-fr-custom-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-navy-400">Brands</span>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Bulwark FR</span>
 </nav>

 <p class="kicker mb-3">Brand</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom Bulwark FR <span class="text-gold-400">for Linemen, Roughnecks, and Utility Crews.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
          Compare Bulwark FR options by garment, rating, fit, and current documentation. We coordinate approved decoration through selected production partners.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Why Bulwark FR — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why Bulwark FR</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four reasons to compare <span class="text-gold-600">Bulwark FR options.</span></h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {why.map((w) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{w.title}</h3>
 <p class="text-base leading-relaxed text-ash">{w.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 How to compare Bulwark FR options by SKU, rating, fit, and current documentation.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
          Bulwark offers FR apparel for electrical, utility, and other eligible work. Ratings vary by garment. Review the current label and manufacturer documentation for every selected SKU. Your safety lead should approve the final product for its intended use.
 </p>
 <p>
          Fabric weight and fit matter in Las Vegas heat. Compare current fabric specifications and size options before choosing. Comfort does not replace a documented workplace hazard assessment.
 </p>
 <p>
 A shirt and pant combination does not establish protection for a task by itself. Compare the required arc rating and other workplace requirements against each current label. Layering can change protection, but only use combinations supported by current product documentation and the employer's safety plan.
 </p>
 <p>
          Decoration can affect protective apparel. Start with Bulwark's current written instructions for the selected garment. Bighorn coordinates the approved plan through a selected production partner. Your safety lead should verify the product and decoration before use.
 </p>
 <p>
          A proposed store could support an employer-approved product list and ordering rules if the selected platform and configuration do. No platform has been selected or launched. Availability, decoration, delivery, implementation, and capabilities require separate written approval.
 </p>
 <p>
          Learn more in our <a href="/blog/bulwark-fr-shirts-vegas-heat/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Bulwark FR heat guide</a>. For electrical programs, review our <a href="/blog/nfpa-70e-fr-shirts-vegas-electricians/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">FR shirts for Vegas electricians guide</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- Products — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Product Options</p>
        <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Compare Bulwark FR <span class="text-gold-600">options for your crew.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
          Product availability changes by size, color, and SKU. We confirm current options against your approved workplace requirements.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
 {products.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-center justify-between">
 <span class="spec text-gold-600">{p.sku}</span>
 </div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.name}</h3>
 <p class="mb-4 text-sm leading-relaxed text-ash">{p.detail}</p>
 <div class="mt-4 border-t border-hairline pt-3">
 <span class="spec text-gold-600">Decoration</span>
 <p class="mt-1 text-sm text-charcoal">{p.method}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- vs Other FR Suppliers — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">vs Other FR Suppliers</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Compare program support and current FR documentation.</h2>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">&nbsp;</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">Catalog FR Supplier</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Bighorn Threads</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Minimum order</td><td class="px-5 py-4 text-sm text-ash">Varies by seller</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed by garment and partner</td></tr>
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Lead time</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed before approval</td></tr>
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Delivery</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Options confirmed per order</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Decoration review</td><td class="px-5 py-4 text-sm text-ash">Check current policy</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed by garment and partner</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Repeat orders</td><td class="px-5 py-4 text-sm text-ash">Account terms vary</td><td class="px-5 py-4 text-sm text-charcoal">Use the current approved specification</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Support</td><td class="px-5 py-4 text-sm text-ash">Varies by seller</td><td class="px-5 py-4 text-sm text-charcoal">Contact Bighorn by phone or form</td></tr>
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Bulwark FR customization questions.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Electrical Contractors</h3>
 <p class="mt-2 text-sm text-ash">Compare current Bulwark FR options for employer-approved electrical work.</p>
 </a>
 <a href="/industries/oil-gas-mechanical-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Oil, Gas, and Mechanical</h3>
          <p class="mt-2 text-sm text-ash">Compare current FR options for eligible midstream and mechanical work.</p>
 </a>
 <a href="/blog/nfpa-70e-fr-shirts-vegas-electricians/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">NFPA 70E FR Shirt Guide</h3>
 <p class="mt-2 text-sm text-ash">Questions to take to your safety lead when comparing FR shirts.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Request a custom Bulwark FR <span class="text-gold-400">quote.</span></h2>
      <p class="mb-8 text-lg text-navy-200">Ask for current product documentation and order terms.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
