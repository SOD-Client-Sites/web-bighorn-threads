  "brand": "Bulwark",
  "h1": "Bulwark FR workwear with your logo",
  "intro": "Order Bulwark shirts, coveralls, and outerwear for your crew. Send your employer’s garment requirements with your logo so we can check suitable products and decoration options.",
  "garments": [
    {
      "name": "Bulwark EXCEL FR ComforTouch Dress Uniform Shirt",
      "best": "Everyday FR uniform for crews and leads",
      "watch": "Confirm the arc rating on the current spec sheet",
      "img": "50042-324603177"
    },
    {
      "name": "Bulwark Long Sleeve Tagless Henley",
      "best": "A lighter FR layer",
      "watch": "Check that it meets your required rating alone",
      "img": "52278-989020184"
    },
    {
      "name": "Bulwark Classic Industrial Coverall",
      "best": "Full coverage over clothes",
      "watch": "Sizing by chest, so measure first",
      "img": "52278-779020111"
    },
    {
      "name": "Bulwark Classic Coverall With Reflective Trim",
      "best": "FR plus low-light visibility",
