      "img": "52278-359020071"
    },
    {
      "name": "Bulwark Deluxe Parka With Reflective Trim",
      "best": "Cold-weather FR outerwear",
      "watch": "Logo placement is limited by trim and seams",
      "img": "52278-539020133"
    },
    {
      "name": "Bulwark iQ Series Lightweight FR Pant",
      "best": "Hot conditions where FR pants are required",
      "watch": "Confirm the rating and inseam",
      "img": "68414-736693241"
    }
  ],
  "choose": [
    {
      "if": "Start with your hazard assessment.",
      "then": "The required rating comes from your employer, and we quote garments that meet it."
    },
    {
      "if": "Then the job:",
      "then": "shirts for daily wear, coveralls for full coverage, parkas for winter."
    },
    {
      "if": "Before any logo:",
      "then": "the maker's instructions set the thread and placement, so tell us the logo size early."
    }
  ],
  "faqs": [
    {
      "q": "Does a logo affect FR protection?",
      "a": "It can. The wrong thread or heat transfer can compromise the garment, so we check the maker's instructions and your safety lead signs off."
    },
    {
      "q": "Can you tell us which rating we need?",
      "a": "No. That comes from your employer's hazard assessment."
    },
    {
      "q": "What's the minimum order?",
      "a": "Each garment and decoration method has its own minimum. Send the item and a rough count, and we will tell you the number."
    },
    {
      "q": "How fast can you turn it around?",
      "a": "Send the style, quantity, and delivery deadline. We check availability and production timing before you place the order."
    }
  ],
  "links": [
    {
