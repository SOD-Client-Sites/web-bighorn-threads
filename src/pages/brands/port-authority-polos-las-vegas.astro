---
import BrandPage from '@/components/BrandPage.astro'

const props = {
  "title": "Custom Port Authority Polos and Embroidery in Las Vegas",
  "description": "Managed Port Authority polo programs for Vegas teams. Compare current styles, sizes, decoration, minimums, and timelines for your order.",
  "slug": "port-authority-polos-las-vegas",
  "brand": "Port Authority",
  "h1": "Port Authority polos with your logo",
  "intro": "Order embroidered Port Authority polos for your staff. Compare styles below, then send your logo and quantity for a quote.",
  "garments": [
    {
      "name": "Port Authority Core Classic Pique Polo",
      "best": "Budget orders and casual staff",
      "watch": "Classic pique runs warmer than performance fabric",
      "img": "50042-325298568"
    },
    {
      "name": "Port Authority Silk Touch Polo",
      "best": "Office and front desk",
      "watch": "Compare with Silk Touch Performance for outdoor roles",
      "img": "50042-572084278"
    },
    {
      "name": "Port Authority Silk Touch Performance Polo",
      "best": "Mixed office and field roles",
      "watch": "Thread tension matters on slick fabric, so check the proof",
      "img": "50042-774086150"
    },
    {
      "name": "Port Authority Dry Zone UV Micro-Mesh Polo",
      "best": "Outdoor and route work in heat",
      "watch": "Fine mesh suits simple logos",
      "img": "50042-595513173"
    },
    {
      "name": "Port Authority C-FREE Performance Polo",
      "best": "Staff who want a stretchy, easy-care polo",
      "watch": "Confirm current colors and sizes",
      "img": "50042-986605075"
    },
    {
      "name": "Port Authority Dry Zone Grid Polo",
      "best": "Hot-weather staff who want a textured look",
      "watch": "Grid texture can break up tiny lettering",
      "img": "50042-964554156"
    }
  ],
  "choose": [
    {
      "if": "Inside all day:",
      "then": "Silk Touch."
    },
    {
      "if": "In and out of the truck:",
      "then": "Silk Touch Performance."
    },
    {
      "if": "Outside in heat:",
      "then": "Dry Zone micro-mesh."
    },
    {
      "if": "Mixed teams:",
      "then": "most styles have a women's cut in the catalog, so ask and we will match it."
    }
  ],
  "faqs": [
    {
      "q": "Embroidery or print on a polo?",
      "a": "Embroidery is the usual choice and looks finished up close. Very small type can blur in thread, so send your real logo file."
    },
    {
      "q": "Can we reorder the same polo later?",
      "a": "Usually, but colors and styles can be dropped. We check before you reorder and suggest a close match if needed."
    },
    {
      "q": "What's the minimum order?",
      "a": "Each garment and decoration method has its own minimum. Send the item and a rough count, and we will tell you the number."
    },
    {
      "q": "How fast can you turn it around?",
      "a": "Send the style, quantity, and delivery deadline. We check availability and production timing before you place the order."
    }
  ],
  "links": [
    {
      "href": "/custom-polo-shirts/",
      "label": "custom polo shirts"
    },
    {
      "href": "/services/embroidery-las-vegas/",
      "label": "embroidery"
    },
    {
      "href": "/company-stores/",
      "label": "company stores"
    }
  ]
}
---

<BrandPage {...props} />
