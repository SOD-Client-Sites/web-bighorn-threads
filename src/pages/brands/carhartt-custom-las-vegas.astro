---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Carhartt Embroidery and Printing in Las Vegas',
 description:
  'Managed custom Carhartt programs for Las Vegas contractors. Compare current apparel, decoration, minimums, and timelines for your team.',
 hero: '/images/generated/workwear-flatlay.jpg',
}

const products = [
  { sku: 'K87', name: 'Carhartt Workwear Pocket T-Shirt', detail: 'A heavyweight cotton option for crew programs. Sizes, colors, and availability are confirmed per order.', method: 'Decoration confirmed for the approved product' },
 { sku: 'K84', name: 'Carhartt Force Cotton Long-Sleeve T-Shirt', detail: 'A long-sleeve option to compare for outdoor crews. Confirm current fabric features and product documentation.', method: 'Decoration confirmed for the approved product' },
 { sku: 'K500', name: 'Carhartt Workwear Pique Polo', detail: 'A polo option for customer-facing roles. Durability depends on the product, use, laundering, and care.', method: 'Decoration and placement confirmed per product' },
 { sku: 'SUP01', name: 'Carhartt Sweater Knit Pullover', detail: 'Heavyweight quarter-zip. Premium look for ops, sales, project managers.', method: 'Embroidery (left chest)' },
 { sku: 'CTK122', name: 'Carhartt Loose Fit Heavyweight Hoodie', detail: 'The go-to crew hoodie for 5 AM Vegas job-site starts.', method: 'Screen print or embroidery (chest, sleeve)' },
  { sku: 'FRSH13', name: 'Carhartt FR Force Henley', detail: 'An FR option for eligible crew programs. Confirm the current rating and product documentation before ordering.', method: 'Decoration subject to current manufacturer guidance' },
]

const why = [
 { title: 'Recognized workwear brand', body: 'Carhartt offers apparel that many buyers consider for construction, service, and field roles.' },
 { title: 'Features vary by product', body: 'Review the exact fabric, seams, pockets, fit, care instructions, and intended use for each SKU.' },
  { title: 'Decoration matched to the garment', body: 'Bighorn coordinates the approved method through selected production partners. The garment, design, and quantity guide the recommendation.' },
  { title: 'Availability confirmed per order', body: 'Sizes, colors, and SKUs change by distributor. We confirm current options before you approve the order.' },
]

const faqs = [
 {
 q: 'What\'s the minimum order for custom Carhartt?',
    a: 'Minimums depend on the garment, decoration method, and production partner. Share your quantity so we can confirm current options.',
 },
 {
 q: 'How is your pricing compared to Carhartt Company Gear (their direct site)?',
    a: 'Programs differ by product, minimum, service, and current lead time. Bighorn gives you one local contact who coordinates your approved order.',
 },
 {
 q: 'Can you embroider on Carhartt FR (flame-resistant) shirts without voiding the rating?',
 a: 'Decoration may be available on eligible FR garments. Your safety lead must approve the product, materials, and placement against current manufacturer guidance.',
 },
 {
 q: 'What Carhartt items are available?',
 a: 'Availability changes by SKU, size, color, and distributor. Tell us what you need so we can confirm current options.',
 },
 {
 q: 'How fast can you turn around a Carhartt order?',
    a: 'Timing depends on product availability and production capacity. Share your SKU, quantity, and deadline so we can confirm a current estimate.',
 },
 {
 q: 'Do you set up Carhartt company stores?',
    a: 'A private-store option may be available. Catalog, access, allowances, pricing, availability, and fulfillment terms must be confirmed in writing.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Brands', item: 'https://bighornthreads.com/brands/' },
 { '@type': 'ListItem', position: 3, name: 'Carhartt', item: 'https://bighornthreads.com/brands/carhartt-custom-las-vegas/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/brands/carhartt-custom-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-navy-400">Brands</span>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Carhartt</span>
 </nav>

 <p class="kicker mb-3">Brand</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom Carhartt <span class="text-gold-400">for Vegas Crews That Actually Work.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
          Compare Carhartt options for your crew. Bighorn coordinates approved decoration and ordering through selected production partners.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Why Carhartt — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why Carhartt</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four reasons crews ask for it <span class="text-gold-600">by name.</span></h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {why.map((w) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{w.title}</h3>
 <p class="text-base leading-relaxed text-ash">{w.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 How Las Vegas contractors can compare Carhartt options by crew role.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Carhartt offers workwear options for general contractors, framers, concrete crews, MEP subcontractors, and service trades. Start with the exact role, work setting, fabric, fit, care requirements, and current product documentation. Then compare decoration compatibility, availability, and quoted price.
 </p>
 <p>
          The K87 Loose Fit Heavyweight Pocket Tee is one crew option to compare. Confirm current fabric, construction, colors, sizes, decoration, and quoted pricing for the order.
 </p>
 <p>
 For project managers, superintendents, and client-facing staff, compare the current Carhartt polo options. Confirm the exact fabric, pocket, fit, decoration, and care details. A current Force Series option may suit teams seeking a lighter fabric, subject to product documentation and availability.
 </p>
 <p>
 For cooler conditions, compare current Carhartt jackets, hoodies, and insulated vests. Decoration compatibility and placement depend on the exact product and manufacturer guidance. Current cap and beanie options can also be reviewed for qualifying programs.
 </p>
 <p>
          A strong Carhartt program starts with an approved product and decoration specification. Bighorn coordinates the program and uses the current approved details for repeat orders. A company store can give larger crews one managed ordering path.
 </p>
 <p>
          Learn how Bighorn <a href="/blog/carhartt-custom-embroidery-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">coordinates custom Carhartt programs for Las Vegas crews</a>. Compare methods in our <a href="/blog/dtf-printing-vs-screen-printing-custom-apparel/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">DTF printing vs screen printing guide</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- Products — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Product Options</p>
        <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Compare Carhartt options <span class="text-gold-600">for your crew.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
          Product availability changes by SKU, size, and color. We confirm current options before you approve the order.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
 {products.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-center justify-between">
 <span class="spec text-gold-600">{p.sku}</span>
 </div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.name}</h3>
 <p class="mb-4 text-sm leading-relaxed text-ash">{p.detail}</p>
 <div class="mt-4 border-t border-hairline pt-3">
 <span class="spec text-gold-600">Decoration</span>
 <p class="mt-1 text-sm text-charcoal">{p.method}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- vs Carhartt Direct — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Program Comparison</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Compare direct and locally managed ordering options.</h2>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">&nbsp;</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">Carhartt Direct</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Bighorn Threads</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Minimum order</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed by product and partner</td></tr>
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Lead time</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed before approval</td></tr>
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Delivery</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Options confirmed per order</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">FR decoration review</td><td class="px-5 py-4 text-sm text-ash">Check current policy</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed by garment and partner</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Repeat orders</td><td class="px-5 py-4 text-sm text-ash">Account terms vary</td><td class="px-5 py-4 text-sm text-charcoal">Use the current approved specification</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Support</td><td class="px-5 py-4 text-sm text-ash">Check current support options</td><td class="px-5 py-4 text-sm text-charcoal">Local account contact</td></tr>
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Carhartt customization questions.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Best decoration method for Carhartt polos and outerwear.</p>
 </a>
 <a href="/industries/electrical-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Carhartt FR for Electrical</h3>
          <p class="mt-2 text-sm text-ash">Compare current Carhartt FR options and product documentation.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Carhartt Company Stores</h3>
          <p class="mt-2 text-sm text-ash">Private portals with an approved Carhartt product list.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Quote on custom Carhartt <span class="text-gold-400">fast.</span></h2>
      <p class="mb-8 text-lg text-navy-200">Get current availability and a timeline for your order.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
