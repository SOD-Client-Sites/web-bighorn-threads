---
import BrandPage from '@/components/BrandPage.astro'

const props = {
  "title": "Custom ML Kishigo Hi-Vis Vests and Apparel in Las Vegas",
  "description": "Managed ML Kishigo hi-vis programs for Las Vegas crews. Compare current garment classes, product documents, and partner-coordinated decoration.",
  "slug": "ml-kishigo-hi-vis-las-vegas",
  "brand": "ML Kishigo",
  "h1": "Custom Kishigo safety vests",
  "intro": "Add your company logo to Kishigo safety vests. Tell us the garment class your site requires, your quantity, and where you want the logo.",
  "garments": [
    {
      "name": "Kishigo Premium Black Series Surveyors Vest",
      "best": "Supervisors and surveyors who carry gear",
      "watch": "Confirm the class on the current listing",
      "img": "62662-147419670"
    },
    {
      "name": "Kishigo Single Pocket Zipper Mesh Class 2 Vest",
      "best": "General crew vests on a budget",
      "watch": "One pocket only",
      "img": "62662-996493185"
    },
    {
      "name": "Kishigo Ultimate Construction Class 2 Vest",
      "best": "Crews that want more storage",
      "watch": "Warmer than plain mesh",
      "img": "52278-509019436"
    },
    {
      "name": "Kishigo Ultra-Cool Multi-Pocket Vest",
      "best": "Hot-weather work",
      "watch": "Confirm the class before you assign it to a site",
      "img": "52278-519019401"
    },
    {
      "name": "Kishigo Ultra-Cool Solid Front Vest With Mesh Back",
      "best": "A solid surface for a printed logo",
      "watch": "Confirm the class and allowed print area",
      "img": "62662-336493062"
    },
    {
      "name": "Kishigo EV Series Multi-Pocket Mesh Vest",
      "best": "Warehouse and visitor use where no class is required",
      "watch": "Listed as non-ANSI, so not for sites that require a class",
      "img": "52649-969158354"
    }
  ],
  "choose": [
    {
      "if": "Road or site work with a class rule:",
      "then": "your safety lead picks the class, then choose pockets and fabric."
    },
    {
      "if": "Hot months:",
      "then": "mesh or Ultra-Cool styles."
    },
    {
      "if": "Bold logo on the back:",
      "then": "a solid panel usually prints cleaner than open mesh."
    }
  ],
  "faqs": [
    {
      "q": "Can you print on a Class 2 vest?",
      "a": "Yes, within what the maker allows. Logos cannot cover so much reflective or background material that the vest falls out of its class, so we check before printing."
    },
    {
      "q": "Which class do we need?",
      "a": "Your safety lead or the site sets that. Tell us the class, and we quote vests that meet it."
    },
    {
      "q": "What's the minimum order?",
      "a": "Each garment and decoration method has its own minimum. Send the item and a rough count, and we will tell you the number."
    },
    {
      "q": "How fast can you turn it around?",
      "a": "Send the style, quantity, and delivery deadline. We check availability and production timing before you place the order."
    }
  ],
  "links": [
    {
      "href": "/custom-safety-vests/",
      "label": "custom safety vests"
    },
    {
      "href": "/catalog/hi-vis/",
      "label": "hi-vis catalog"
    },
    {
      "href": "/safety-compliance/",
      "label": "safety and compliance"
    }
  ]
}
---

<BrandPage {...props} />
