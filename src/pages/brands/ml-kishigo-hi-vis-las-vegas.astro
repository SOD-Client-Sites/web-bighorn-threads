---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom ML Kishigo Hi-Vis Vests and Apparel in Las Vegas',
 description:
  'Managed ML Kishigo hi-vis programs for Las Vegas crews. Compare current garment classes, product documents, and partner-coordinated decoration.',
 hero: '/images/generated/workwear-flatlay.jpg',
}

const products = [
 { sku: '1571', name: 'ML Kishigo Solid Vest (Lime)', detail: 'A lime vest option. Confirm the current class, features, sizes, and workplace fit before ordering.', method: 'Decoration subject to current manufacturer guidance' },
  { sku: '1572', name: 'ML Kishigo Solid Vest (Orange)', detail: 'An orange hi-vis vest option. Confirm the current class and workplace fit before ordering.', method: 'Decoration subject to current manufacturer guidance' },
  { sku: '1085', name: 'ML Kishigo Hi-Vis T-Shirt (Lime)', detail: 'A birdseye mesh hi-vis shirt option. Confirm the current class and workplace fit before ordering.', method: 'Decoration subject to current manufacturer guidance' },
 { sku: '1086', name: 'ML Kishigo Hi-Vis T-Shirt (Orange)', detail: 'An orange hi-vis shirt option. Confirm the current class and product documentation before ordering.', method: 'Decoration subject to current manufacturer guidance' },
 { sku: '9114', name: 'ML Kishigo Lined Bomber Jacket', detail: 'A lined hi-vis jacket option. Confirm the current class, features, and intended use before ordering.', method: 'Decoration subject to current manufacturer guidance' },
 { sku: 'B200', name: 'ML Kishigo Brilliant Series Vest', detail: 'A contrast-trim vest option. Confirm the current class, features, and product documentation.', method: 'Decoration subject to current manufacturer guidance' },
]

const why = [
 { title: 'Options across product types', body: 'Compare current Kishigo vests, shirts, jackets, and rainwear by class, fit, and product documentation.' },
 { title: 'Products for exposed work', body: 'Kishigo offers garments intended for roadway, utility, traffic-control, and other work. Employer requirements control selection.' },
 { title: 'Hot-weather options', body: 'Compare mesh and other lightweight options by fabric, fit, current rating, and employer-approved use.' },
 { title: 'Decoration reviewed by garment', body: 'Bighorn coordinates approved decoration through selected partners. Your safety lead reviews the plan against current manufacturer guidance.' },
]

const faqs = [
 {
 q: 'What\'s the difference between Class 2 and Class 3 hi-vis?',
 a: 'Class 3 has greater visibility requirements than Class 2. The employer selects the class from the hazard assessment, work-zone rules, and current product documents. Speed or shift alone is not a universal selection rule.',
 },
 {
 q: 'How does ML Kishigo compare to Pyramex or Radians?',
    a: 'Compare the current product documentation, fit, availability, and project requirements for each brand. Your safety lead should approve the final selection.',
 },
 {
 q: 'Can you screen-print or heat-press over the reflective tape?',
 a: 'Decoration can affect the garment. Review Kishigo\'s current written instructions and have your safety lead approve the proposed method and placement.',
 },
 {
 q: 'What\'s your minimum order for Kishigo hi-vis?',
    a: 'Minimums depend on the garment, decoration method, and production partner. Share your quantity so we can confirm current options.',
 },
 {
 q: 'Do you stock Kishigo or order it in for each job?',
    a: 'Availability changes by SKU, size, and color. We confirm current options before you approve an order or program.',
 },
 {
 q: 'Can you set up a hi-vis program with per-employee allowances?',
    a: 'A proposed private portal could support approved products, decoration choices, and allowances if the selected platform and configuration do. No platform has been selected or launched. Implementation and capabilities require separate written approval.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Brands', item: 'https://bighornthreads.com/brands/' },
 { '@type': 'ListItem', position: 3, name: 'ML Kishigo', item: 'https://bighornthreads.com/brands/ml-kishigo-hi-vis-las-vegas/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/brands/ml-kishigo-hi-vis-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-navy-400">Brands</span>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">ML Kishigo</span>
 </nav>

 <p class="kicker mb-3">Brand</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom ML Kishigo Hi-Vis <span class="text-gold-400">for Vegas Road and Utility Crews.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
          Compare ML Kishigo options by class, fit, and current documentation. We coordinate approved decoration through selected production partners.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Why ML Kishigo — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why ML Kishigo</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four reasons to compare <span class="text-gold-600">ML Kishigo options.</span></h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {why.map((w) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{w.title}</h3>
 <p class="text-base leading-relaxed text-ash">{w.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 How to compare ML Kishigo options for road, utility, and other exposed work.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
          ML Kishigo offers hi-vis apparel for road, utility, traffic-control, and other exposed work. Ratings vary by garment. Review the current label and manufacturer documentation for each selected SKU. Your safety lead should approve the final product for its intended use.
 </p>
 <p>
 For Las Vegas heat, compare current mesh and lightweight product options. Review fabric, fit, care, labels, and workplace requirements. Garment comfort does not replace the employer's heat safety program.
 </p>
 <p>
 For night or low-visibility work, the employer may select a higher-visibility class. Compare current Kishigo products by label and intended use. Decoration requires separate approval for the exact product and placement.
 </p>
 <p>
          Decoration can affect hi-vis apparel. Start with Kishigo's current written instructions for the selected garment. Bighorn coordinates the approved plan through a selected production partner. Your safety lead should verify the final product before use.
 </p>
 <p>
          A proposed store could support an employer-approved product list by role if the selected platform and configuration do. No platform has been selected or launched. Availability, decoration, delivery, implementation, and capabilities require separate written approval.
 </p>
 <p>
 Class 2 vs Class 3: see our <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">planning guide for Las Vegas crews</a>. The employer's hazard assessment controls selection.
 </p>
 </div>
 </div>
 </section>

 <!-- Products — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Product Options</p>
        <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Compare Kishigo options <span class="text-gold-600">for your crew.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
          Product availability changes by SKU, size, and color. We confirm current options against your approved workplace requirements.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
 {products.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-center justify-between">
 <span class="spec text-gold-600">{p.sku}</span>
 </div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.name}</h3>
 <p class="mb-4 text-sm leading-relaxed text-ash">{p.detail}</p>
 <div class="mt-4 border-t border-hairline pt-3">
 <span class="spec text-gold-600">Decoration</span>
 <p class="mt-1 text-sm text-charcoal">{p.method}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- vs Other Hi-Vis Brands — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">vs Pyramex / Generic Hi-Vis</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Compare Kishigo with other hi-vis options.</h2>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">&nbsp;</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">Other Hi-Vis Options</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Bighorn + Kishigo</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Minimum order</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed by product and partner</td></tr>
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Lead time</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed before approval</td></tr>
              <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Delivery</td><td class="px-5 py-4 text-sm text-ash">Varies</td><td class="px-5 py-4 text-sm text-charcoal">Options confirmed per order</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Product documentation</td><td class="px-5 py-4 text-sm text-ash">Check by SKU</td><td class="px-5 py-4 text-sm text-charcoal">Confirmed by SKU before approval</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Repeat orders</td><td class="px-5 py-4 text-sm text-ash">Account terms vary</td><td class="px-5 py-4 text-sm text-charcoal">Use the current approved specification</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Support</td><td class="px-5 py-4 text-sm text-ash">Varies by seller</td><td class="px-5 py-4 text-sm text-charcoal">Contact Bighorn by phone or form</td></tr>
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">ML Kishigo customization questions.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/concrete-masonry-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Concrete and Masonry Crews</h3>
 <p class="mt-2 text-sm text-ash">Compare current Kishigo vest and shirt options for exposed work.</p>
 </a>
 <a href="/industries/general-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">General Contractors</h3>
 <p class="mt-2 text-sm text-ash">Hi-vis program options for supervisors, project managers, and field staff.</p>
 </a>
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Employer-approved logo placement on eligible Kishigo garments.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Request a custom Kishigo hi-vis <span class="text-gold-400">quote.</span></h2>
      <p class="mb-8 text-lg text-navy-200">Get current availability and a timeline for your order.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
