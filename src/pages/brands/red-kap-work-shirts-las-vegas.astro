---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Red Kap Work Shirts and Industrial Uniforms in Las Vegas',
 description:
 'Compare current Red Kap work shirts, pants, coveralls, and jackets for Las Vegas uniform programs. Product availability, specifications, decoration, and pricing require a current quote.',
 hero: '/images/generated/workwear-flatlay.jpg',
}

const products = [
  { sku: 'SP14', name: 'Red Kap Industrial Work Shirt', detail: 'A mechanic-shop option with stain-release fabric, two chest pockets, and a banded collar. Availability is confirmed per order.', method: 'Decoration confirmed for the approved product' },
 { sku: 'PT20', name: 'Red Kap Industrial Work Pant', detail: 'A work-pant option to compare with the SP14. Confirm current fabric, features, fit, and care instructions.', method: 'Decoration eligibility confirmed per product' },
 { sku: 'CS10', name: 'Red Kap Specialized Cotton Coverall', detail: 'A cotton coverall option for fleet techs and mechanics. Confirm current construction and product specifications.', method: 'Decoration and placement confirmed per product' },
 { sku: 'SC30', name: 'Red Kap Industrial Short-Sleeve Work Shirt', detail: 'A short-sleeve work-shirt option. Confirm the current fabric, finish, and availability before ordering.', method: 'Decoration and placement confirmed per product' },
 { sku: 'JT22', name: 'Red Kap Perma-Lined Panel Jacket', detail: 'A lined jacket option for cool shop starts. Confirm current features, care, and decoration compatibility.', method: 'Decoration and placement confirmed per product' },
  { sku: 'SY24', name: 'Red Kap Hi-Vis Work Shirt', detail: 'A hi-vis work-shirt option. Confirm the current classification and workplace fit before ordering.', method: 'Decoration subject to current manufacturer guidance' },
]

const why = [
 { title: 'Options for mechanic-shop roles', body: 'Compare Red Kap work shirts, pants, coveralls, and jackets for the roles in your shop.' },
 { title: 'Current construction details', body: 'Review the exact product specifications, fit, finish, care instructions, and workplace use before approval.' },
  { title: 'Managed name patch and logo plan', body: 'Bighorn coordinates the approved placement through selected production partners. Reorders use the current approved specification.' },
 { title: 'Care and durability are product-specific', body: 'Fabric performance and service life depend on the exact SKU, use, laundering, care, and manufacturer guidance.' },
]

const faqs = [
 {
 q: 'What\'s the minimum order for custom Red Kap?',
    a: 'Minimums depend on the garment, decoration method, and production partner. Share your quantity so we can confirm current options.',
 },
 {
 q: 'How does Red Kap compare to Dickies?',
 a: 'Compare current fabrics, fits, care instructions, available sizes, and pricing. The best brand depends on the role and approved uniform program.',
 },
 {
 q: 'Can you do name patches with Red Kap orders?',
    a: 'Name patches may be available. Bighorn coordinates the approved method and placement through a selected production partner.',
 },
 {
 q: 'What\'s your turnaround on Red Kap orders?',
    a: 'Timing depends on product availability and production capacity. Share your deadline so we can confirm a current estimate.',
 },
 {
 q: 'Do you set up uniform rental-style programs?',
    a: 'A private-store option may be available. Catalog, access, ordering, shipping, pricing, and timing terms must be confirmed in writing for the program.',
 },
 {
 q: 'Can you do FR or specialty Red Kap items?',
    a: 'Ask us to check current Red Kap FR options. Your safety lead should approve the product and any decoration against current manufacturer guidance.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Brands', item: 'https://bighornthreads.com/brands/' },
 { '@type': 'ListItem', position: 3, name: 'Red Kap', item: 'https://bighornthreads.com/brands/red-kap-work-shirts-las-vegas/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/brands/red-kap-work-shirts-las-vegas/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-navy-400">Brands</span>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Red Kap</span>
 </nav>

 <p class="kicker mb-3">Brand</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Custom Red Kap <span class="text-gold-400">for Vegas Fleets, Shops, and Trades.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Compare SP14 work shirts, PT20 industrial pants, and CS10 coveralls for fleet and trade roles. Your quote confirms the products, decoration, pricing, and program terms.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Why Red Kap — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why Red Kap</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four details to review <span class="text-gold-600">for your fleet.</span></h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {why.map((w) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{w.title}</h3>
 <p class="text-base leading-relaxed text-ash">{w.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Guide</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 How to compare Red Kap for Las Vegas mechanical, HVAC, and fleet uniform programs.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Red Kap offers workwear for mechanical contractors, HVAC technicians, plumbers, fleet drivers, automotive service teams, and industrial maintenance crews. Compare the exact SKU, fit, fabric, care instructions, and available sizes for each role. If you use an industrial laundry, confirm compatibility with that provider and the current manufacturer documentation.
 </p>
 <p>
          The SP14 Industrial Work Shirt is a 65/35 polyester-cotton button-front shirt with two chest pockets. Short-sleeve and long-sleeve options may be available. Bighorn coordinates approved logos and name patches through selected production partners.
 </p>
 <p>
          Compare the SC30, CS70, SY24, and PT20 for different uniform roles. Review current fabrics, product documents, sizes, and availability. Alteration options depend on the garment and production partner.
 </p>
 <p>
          The SK24 offers a snap-front work-shirt option. The JT22 and JT38 add jacket choices for eligible programs. We confirm current specifications, decoration options, and availability before approval.
 </p>
 <p>
          Red Kap offers products designed for industrial uniform programs. If you use a laundry partner, confirm garment compatibility and tagging requirements first. Bighorn can coordinate the approved product and decoration plan.
 </p>
 <p>
 Our <a href="/blog/red-kap-industrial-work-shirts-buyer-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Red Kap industrial work shirts buyer guide</a> walks through fits, fabrics, and which Red Kap line to pick.
 </p>
 </div>
 </div>
 </section>

 <!-- Products — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Product Options</p>
        <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Compare Red Kap options <span class="text-gold-600">for your crew.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
          Product availability changes by SKU, size, and color. We confirm current options before you approve the order.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
 {products.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <div class="mb-3 flex items-center justify-between">
 <span class="spec text-gold-600">{p.sku}</span>
 </div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{p.name}</h3>
 <p class="mb-4 text-sm leading-relaxed text-ash">{p.detail}</p>
 <div class="mt-4 border-t border-hairline pt-3">
 <span class="spec text-gold-600">Decoration</span>
 <p class="mt-1 text-sm text-charcoal">{p.method}</p>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- vs Dickies — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Product Comparison</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Compare Red Kap, Dickies, and other industrial options.</h2>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">&nbsp;</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-ash">What to confirm</th>
 <th class="px-5 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Bighorn's role</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Product fit</td><td class="px-5 py-4 text-sm text-ash">Role and work setting</td><td class="px-5 py-4 text-sm text-charcoal">Compare approved options</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Fabric features</td><td class="px-5 py-4 text-sm text-ash">Current SKU specifications</td><td class="px-5 py-4 text-sm text-charcoal">Confirm before approval</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Care and service life</td><td class="px-5 py-4 text-sm text-ash">Use and care conditions</td><td class="px-5 py-4 text-sm text-charcoal">Provide current product guidance</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Name patches</td><td class="px-5 py-4 text-sm text-ash">Garment and placement</td><td class="px-5 py-4 text-sm text-charcoal">Coordinate approved production</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Product range</td><td class="px-5 py-4 text-sm text-ash">Current SKUs and availability</td><td class="px-5 py-4 text-sm text-charcoal">Build the approved product list</td></tr>
 <tr><td class="px-5 py-4 font-mono text-xs uppercase tracking-wider text-ash">Lead time</td><td class="px-5 py-4 text-sm text-ash">Availability and capacity</td><td class="px-5 py-4 text-sm text-charcoal">Confirm before approval</td></tr>
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Red Kap customization questions.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/plumbing-hvac-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Plumbing &amp; HVAC Fleets</h3>
 <p class="mt-2 text-sm text-ash">Red Kap SP14 + name patches for service techs in customer homes.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Fleet Uniform Stores</h3>
          <p class="mt-2 text-sm text-ash">Build an owned uniform program with approved decoration choices.</p>
 </a>
 <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Outfitting a Vegas Crew</h3>
 <p class="mt-2 text-sm text-ash">How many shirts, pants, and coveralls per tech — the real math.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Quote on custom Red Kap <span class="text-gold-400">fast.</span></h2>
      <p class="mb-8 text-lg text-navy-200">Get current availability and a timeline for your order.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
