---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import NationalLinks from '@/components/NationalLinks.astro'

const page = {
 title: 'Custom Safety Vests in Las Vegas | Bighorn Threads',
 description:
  'Plan custom hi-vis safety vests for Las Vegas crews. Compare current options, then confirm each garment and decoration with the employer and manufacturer.',
 url: 'https://bighornthreads.com/custom-safety-vests-las-vegas/',
}

const stack = [
  { label: 'The vest', body: 'Compare hi-vis vests by brand, class, and size. Your company picks the vest based on its hazard assessment, project rules, and the manufacturer\'s documents.' },
  { label: 'The branding', body: 'We draft a logo plan and a production partner makes it. Your company approves the plan, and it has to follow that vest maker\'s written instructions.' },
 { label: 'Color options', body: 'Colors depend on the vest, class, size, and distributor stock.' },
 { label: 'Sizing', body: 'Sizes and fabrics vary by vest.' },
]

const classes = [
 { row: 'Class 2', meaning: 'More reflective and background material than Class 1', use: 'Often specified for work near traffic' },
 { row: 'Class 3', meaning: 'The most visible class, with more coverage than Class 2', use: 'Often specified for work near traffic' },
 { row: 'Class E', meaning: 'Pants or shorts, not a vest', use: 'Worn with a Class 2 or 3 top to reach Class 3 as a set' },
]

const placements = [
 { name: 'Left chest logo', detail: 'The usual spot, if the vest maker allows it.' },
 { name: 'Right chest name or title', detail: 'A worker name or role, if the vest allows it.' },
 { name: 'Back yoke logo', detail: 'Room for a larger logo, kept clear of the tape.' },
 { name: 'Back lower panel', detail: 'A project ID or role, if the vest allows it.' },
]

const faqs = [
  { q: 'Can you put a logo on an ANSI 107 safety vest?', a: 'Usually, yes, if that vest maker’s instructions allow it. Keep the logo off the reflective tape and within the size they permit.' },
  { q: 'What\'s the size limit for a logo on a hi-vis vest?', a: 'There’s no universal number. Each vest maker sets its own limit, so send us the vest and logo and we’ll check it.' },
  { q: 'Can decoration affect ANSI compliance on a safety vest?', a: 'Yes. A logo that covers too much background or tape can take a vest out of its class, which is why placement matters.' },
 { q: 'Class 2 vs Class 3. Which one does my crew need?', a: 'Your safety lead makes that call based on the job and site rules. Class 3 gives more coverage, and it’s often specified for higher-speed traffic or night work.' },
  { q: 'Embroidery or screen print on a hi-vis vest?', a: 'It depends on what the vest maker allows. Many mesh vests take printing or heat transfers better than thread, so we start from its instructions.' },
  { q: 'Can you supply hi-vis vests with company logo and worker name?', a: 'Yes, if the vest maker allows both. Send the roster and we’ll lay it out for your approval.' },
  { q: 'Where can I get custom safety vests in Las Vegas?', a: 'Bighorn Threads handles custom vest orders for Las Vegas teams. Send your class, roster size, and logo for a quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Safety Vests Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Safety Vests in Las Vegas',
  serviceType: 'Managed custom hi-vis safety vest programs',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Custom Safety Vests</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  ANSI 107 Hi-Vis
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
          Custom Safety Vests in Las Vegas with your logo.
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Hi-vis vests with your logo, quoted for your crew. You choose the class your safety program requires. We check the manufacturer's decoration rules and run the job through a production partner.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A branded hi-vis vest program built around documented requirements.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Class table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">ANSI/ISEA 107</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Class 2, Class 3, Class E: what to spec.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Your company picks the class using its hazard assessment, project rules, and the official requirements. Check the vest's label and the manufacturer's documents before you order.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Class</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Requires</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Typical Use</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {classes.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Placements -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Decoration Placements</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Where a logo or name may fit on the selected garment.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {placements.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{p.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom safety vests for Vegas crews with an employer-reviewed decoration plan.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Hi-vis garments use fluorescent and reflective material as part of their design, and a logo can change that. Don't go by a general rule. Use that vest maker's written instructions for method, material, size, and placement.
 </p>
 <p>
          Review the current <a href="https://safetyequipment.org/standards/ansi-isea-107/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener" target="_blank">ANSI/ISEA 107 resources</a> and applicable <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1926/1926.96" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener" target="_blank">OSHA rules</a>. Projects and employers can add their own rules. Your safety lead has the final say on the garment and the logo.
 </p>
 <p>
          A plan can include a chest logo, worker name, or back identifier if the vest's documents allow it. A production partner makes what your company approves. Bighorn does not certify garments or set workplace safety requirements.
 </p>
 <p>
 For deeper compliance reads, see our <a href="/safety-compliance/ansi-107-hi-vis-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 hi-vis compliance guide</a>, the <a href="/blog/custom-safety-vests-ansi-compliance/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">decoration-rules deep-dive</a>, the <a href="/blog/hi-vis-class-3-when-you-need-it-over-class-2/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Class 3 vs Class 2 decision guide</a>, and the <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 Class 2 vs 3 comparison</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Hi-vis vest questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/roofing-solar-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Roofing & Solar</h3>
 <p class="mt-2 text-sm text-ash">Hi-vis and sun-protective gear for roofing and solar crews.</p>
 </a>
 <a href="/brands/ml-kishigo-hi-vis-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">ML Kishigo Hi-Vis</h3>
          <p class="mt-2 text-sm text-ash">Compare ML Kishigo hi-vis options for your crew.</p>
 </a>
 <a href="/catalog/hi-vis/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Hi-Vis Catalog</h3>
 <p class="mt-2 text-sm text-ash">Compare vests, shirts, jackets, and rain gear, then check the product documents.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to brand your crew's hi-vis vests?</h2>
 <p class="mb-8 text-lg text-white/80">Send your roster size, class, and decoration spec.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
 <NationalLinks heading='Related product guides' links={[{ href: '/custom-safety-vests/', label: 'Custom safety vests' }]} />
</BaseLayout>
