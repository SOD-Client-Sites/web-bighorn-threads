---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Safety Vests in Las Vegas | Bighorn Threads',
 description:
  'Plan custom hi-vis safety vests for Las Vegas crews. Compare current options, then confirm each garment and decoration with the employer and manufacturer.',
 hero: '/images/generated/service-screen-printing.jpg',
 url: 'https://bighornthreads.com/custom-safety-vests-las-vegas/',
}

const stack = [
  { label: 'The vest', body: 'Compare candidate hi-vis vests by brand, class, size, and workplace requirement. The employer selects the garment from its current hazard assessment, project rules, and manufacturer documentation.' },
  { label: 'The branding', body: 'Bighorn coordinates a proposed decoration plan through selected production partners. The employer must approve it, and every detail must follow the exact garment manufacturer\'s current written instructions.' },
 { label: 'Color options', body: 'Available colors depend on the selected garment, class, size, and current distributor inventory.' },
 { label: 'Sizing', body: 'Size ranges and fabric options vary by garment. We confirm current products before approval.' },
]

const classes = [
 { row: 'Class 2', meaning: 'Hi-vis garment classification', use: 'Confirm against the current hazard assessment and project rules' },
 { row: 'Class 3', meaning: 'Higher-visibility garment classification', use: 'Confirm against the current hazard assessment and project rules' },
 { row: 'Class E', meaning: 'Supplemental garment classification', use: 'Confirm how it applies to the complete approved outfit' },
]

const placements = [
 { name: 'Left chest logo', detail: 'Availability and size depend on the exact garment manufacturer\'s current written instructions.' },
 { name: 'Right chest name or title', detail: 'May support a worker name or role when the garment permits the placement.' },
 { name: 'Back yoke logo', detail: 'Availability and size depend on the exact garment manufacturer\'s current written instructions.' },
 { name: 'Back lower panel', detail: 'May support a project ID or role callout when the garment permits the placement.' },
]

const faqs = [
  { q: 'Can you put a logo on an ANSI 107 safety vest?', a: 'Decoration may be possible only when the exact garment manufacturer\'s current written instructions permit the proposed method, material, size, and placement. The employer must also approve the result against its hazard assessment and project requirements before use.' },
  { q: 'What\'s the size limit for a logo on a hi-vis vest?', a: 'There is no universal limit. The employer must compare the proposed decoration with the exact garment manufacturer\'s current written instructions and its own hazard assessment before approval.' },
  { q: 'Can decoration affect ANSI compliance on a safety vest?', a: 'Yes. Decoration can affect a garment\'s performance or classification. The employer must review the exact garment manufacturer\'s current written instructions, its hazard assessment, and project requirements before approval.' },
 { q: 'Class 2 vs Class 3. Which one does my crew need?', a: 'The right class depends on the hazard assessment, job, and governing rules. Your safety lead should approve the final garment.' },
  { q: 'Embroidery or screen print on a hi-vis vest?', a: 'The permitted method depends on the exact garment manufacturer\'s current written instructions. Bighorn coordinates the employer-approved plan through a selected production partner but does not determine safety compliance.' },
  { q: 'Can you supply hi-vis vests with company logo and worker name?', a: 'Logo and worker-name options depend on the exact garment manufacturer\'s current written instructions. Bighorn can coordinate a proposed layout after the employer approves it against its hazard assessment and project requirements.' },
  { q: 'Where can I get custom safety vests in Las Vegas?', a: 'Bighorn Threads manages custom vest programs for Las Vegas teams. Send your roster and employer-selected requirements so we can identify candidate products and decoration options for employer review.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Safety Vests Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Safety Vests in Las Vegas',
  serviceType: 'Managed custom hi-vis safety vest programs',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Custom Safety Vests</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  ANSI 107 Hi-Vis
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Custom Safety Vests in Las Vegas <span class="text-gold-400">with a managed product and decoration plan.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
          Compare hi-vis vest options for your crew. We coordinate employer-approved decoration through selected production partners after the exact garment documentation is reviewed.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A branded hi-vis vest program built around documented requirements.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Class table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">ANSI/ISEA 107</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Class 2, Class 3, Class E — what to spec.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 The employer must use its current hazard assessment, project rules, and applicable official requirements to select the required class. Confirm the exact product against its current label and manufacturer documentation before ordering.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Class</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Requires</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Typical Use</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {classes.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Placements -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Decoration Placements</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Where a logo or name may fit on the selected garment.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {placements.map((p) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{p.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{p.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom safety vests for Vegas crews with an employer-reviewed decoration plan.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 High-visibility garments use fluorescent background material and retroreflective material as part of a documented product design. Decoration can alter that design. Do not infer an acceptable method, material, size, or placement from a generic rule. Use the exact garment manufacturer's current written instructions.
 </p>
 <p>
          Review the current <a href="https://safetyequipment.org/standards/ansi-isea-107/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener" target="_blank">ANSI/ISEA 107 resources</a> and applicable <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1926/1926.96" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener" target="_blank">OSHA rules</a>. Project and employer requirements can add their own conditions. Your safety lead remains responsible for the final garment and decoration approval.
 </p>
 <p>
          A proposed decoration plan can include a chest logo, worker name, or back identifier when the exact garment documentation permits it. Bighorn coordinates the employer-approved plan through a selected production partner but does not certify the garment or determine workplace safety requirements.
 </p>
 <p>
          Decoration method, material, size, and placement all matter. The employer must approve the final plan against its current hazard assessment and project requirements, using the exact garment manufacturer's current written instructions, before use.
 </p>
 <p>
 For deeper compliance reads, see our <a href="/safety-compliance/ansi-107-hi-vis-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 hi-vis compliance guide</a>, the <a href="/blog/custom-safety-vests-ansi-compliance/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">decoration-rules deep-dive</a>, the <a href="/blog/hi-vis-class-3-when-you-need-it-over-class-2/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Class 3 vs Class 2 decision guide</a>, and the <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 Class 2 vs 3 comparison</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Hi-vis vest questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/roofing-solar-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Roofing & Solar</h3>
 <p class="mt-2 text-sm text-ash">Compare candidate hi-vis and sun-protective garments against the employer's current requirements.</p>
 </a>
 <a href="/brands/ml-kishigo-hi-vis-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">ML Kishigo Hi-Vis</h3>
          <p class="mt-2 text-sm text-ash">Compare ML Kishigo hi-vis options for your crew.</p>
 </a>
 <a href="/catalog/hi-vis/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Hi-Vis Catalog</h3>
 <p class="mt-2 text-sm text-ash">Compare current vests, shirts, jackets, and rain gear, then verify the exact product documentation.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to brand your crew's hi-vis vests?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your roster size, class, and decoration spec.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
