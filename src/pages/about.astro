---
import { Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import stevePhoto from '@/assets/steve-dodson-ref.jpg'

const jsonLd = {
 '@context': 'https://schema.org',
 '@graph': [
 {
 '@type': 'AboutPage',
 '@id': 'https://bighornthreads.com/about#aboutpage',
 url: 'https://bighornthreads.com/about',
 name: 'About Bighorn Threads | Las Vegas Branded Apparel',
 description: 'Bighorn Threads is a DBA of VP Promos. The Las Vegas based business coordinates branded apparel and promotional-product orders through production partners.',
 isPartOf: { '@id': 'https://bighornthreads.com/#website' },
 about: { '@id': 'https://bighornthreads.com/#organization' },
 },
 {
 '@type': 'Organization',
 '@id': 'https://bighornthreads.com/#organization',
 name: 'Bighorn Threads',
 alternateName: 'VP Promos',
 founder: { '@id': 'https://bighornthreads.com/#founder' },
 url: 'https://bighornthreads.com',
 logo: 'https://bighornthreads.com/images/logo.png',
 description: 'Las Vegas based branded apparel and promotional products. Production is coordinated through partners.',
 address: {
 '@type': 'PostalAddress',
 streetAddress: '9205 W. Russell Rd Ste 305',
 addressLocality: 'Las Vegas',
 addressRegion: 'NV',
 postalCode: '89148',
 addressCountry: 'US',
 },
 },
 {
 '@type': 'Person',
 '@id': 'https://bighornthreads.com/#founder',
 name: 'Steven Dodson',
 jobTitle: 'Founder',
 worksFor: { '@id': 'https://bighornthreads.com/#organization' },
 description: 'Founder of Bighorn Threads and its parent VP Promos. Steve coordinates branded apparel and promotional-product programs through production partners.',
 telephone: '+17029048923',
 },
 ],
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/about/',
 name: 'The people behind Bighorn Threads',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title="About Bighorn Threads | Las Vegas Based, Ships Nationwide"
 description="Bighorn Threads is a Las Vegas branded apparel company founded by Steve Dodson. We manage your order and work with production partners, with one contact from quote to delivery."
>
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <section class="bg-concrete">
 <div class="mx-auto grid max-w-5xl items-center gap-10 px-4 pb-14 pt-12 sm:px-6 md:grid-cols-[1fr_260px] lg:px-8 lg:pt-16">
 <div>
 <p class="kicker mb-4">About us</p>
 <h1 class="font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-6xl">The people behind Bighorn Threads</h1>
 <p class="speakable-answer mt-6 max-w-2xl text-lg leading-relaxed text-charcoal">
 Bighorn Threads is the branded apparel side of VP Promos, based in Las Vegas and founded by Steve Dodson. We get your logo onto the gear your team needs and ship it nationwide.
 </p>
 </div>
 <figure class="max-w-44 border border-hairline bg-panel p-2 lg:max-w-none">
 <Picture src={stevePhoto} alt="Steve Dodson, founder of Bighorn Threads" widths={[260, 418]} sizes="260px" formats={['avif', 'webp']} fallbackFormat="jpg" loading="eager" decoding="async" class="h-auto w-full" />
 <figcaption class="spec p-2 text-ash">Steve Dodson, founder</figcaption>
 </figure>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto grid max-w-5xl gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
 <div>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">What we do, and what we don't</h2>
 <div class="mt-5 space-y-4 text-lg leading-relaxed text-charcoal">
 <p>We do not run printing presses or embroidery machines ourselves. We work with production partners and pick the one that suits your job.</p>
 <p>What we do is run the order. We help you choose the garment, work out the decoration, get you a proof, and stay on it through delivery. When something changes, you have one person to call. That includes the small stuff, like a new hire who needs gear next week or a logo that only exists as a blurry JPEG.</p>
 </div>
 </div>
 <div>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Why people stay</h2>
 <blockquote class="mt-5 border-l-2 border-charcoal pl-5 text-lg leading-relaxed text-charcoal">
 "I've worked with them for over 14 years for all my event promotional needs."
 <footer class="mt-2 font-mono text-xs not-italic text-ash">Nadia G., client review</footer>
 </blockquote>
 <blockquote class="mt-6 border-l-2 border-charcoal pl-5 text-lg leading-relaxed text-charcoal">
 "One of the most reliable and honest vendors we've worked with."
 <footer class="mt-2 font-mono text-xs not-italic text-ash">Desha B., client review</footer>
 </blockquote>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">What you can expect</h2>
 <ul class="mt-8 grid gap-8 md:grid-cols-3">
 <li class="border-t-2 border-charcoal pt-4"><h3 class="font-heading text-xl font-bold uppercase tracking-tight">A real answer on your date</h3><p class="mt-2 leading-relaxed text-ash">We check stock and partner capacity before telling you a date works.</p></li>
 <li class="border-t-2 border-charcoal pt-4"><h3 class="font-heading text-xl font-bold uppercase tracking-tight">A proof first</h3><p class="mt-2 leading-relaxed text-ash">You see the garment, colors, and logo placement before you approve anything.</p></li>
 <li class="border-t-2 border-charcoal pt-4"><h3 class="font-heading text-xl font-bold uppercase tracking-tight">The price up front</h3><p class="mt-2 leading-relaxed text-ash">Your quote lists what you are getting and what it costs before the order goes ahead.</p></li>
 </ul>
 <p class="mt-10 text-lg text-ash">Work in the trades? Start with our pages for <a href="/industries/electrical-contractors-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">electrical work</a>, <a href="/industries/plumbing-hvac-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">plumbing and HVAC</a>, or <a href="/industries/data-center-contractors-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">data center projects</a>.</p>
 </div>
 </section>

 <section class="border-t border-hairline bg-paper">
 <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
 <div>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight">Tell us what you need</h2>
 <p class="mt-3 text-lg text-ash">9205 W. Russell Rd, Ste 305, Las Vegas, NV</p>
 </div>
 <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal hover:text-gold-700">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
