---
import { Image, Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import foremanCloseup from '@/assets/generated/foreman-closeup.jpg'
import productStack from '@/assets/generated/product-stack.jpg'
import workwearFlatlay from '@/assets/generated/workwear-flatlay.jpg'
import founderSteve from '@/assets/generated/founder-steve.jpg'

const values = [
 {
 title: 'Products chosen for the way your team works',
 body: 'Tell us where, when, and how your team will wear the gear. Bighorn uses those requirements to recommend products and coordinate the approved order through production partners.',
 icon: 'shield',
 },
 {
 title: 'A phone call beats a contact form',
 body: 'Call the Las Vegas account team to review products, artwork, proofs, and current order terms. Response timing depends on staff availability.',
 icon: 'phone',
 },
 {
 title: 'Timing is confirmed before approval',
 body: "Share your required date with the complete order details. We'll review partner capacity and confirm current timing before you approve the order.",
 icon: 'clock',
 },
 {
 title: "We'd rather be the Vegas local than the cheapest online option",
 body: 'A Las Vegas based contact gives you one place for questions, proofs, order updates, and reorders. Current order terms are documented before approval.',
 icon: 'pin',
 },
]

const comparison = [
 { category: 'Who you talk to', online: 'A chatbot and a ticket queue', bighorn: 'A local rep who knows your account by name' },
 { category: 'Customization', online: 'Pre-built templates you drop a logo into', bighorn: 'Artwork and proofing coordinated with production partners' },
 { category: 'Proofing', online: 'Proofing process varies by provider', bighorn: 'Artwork approval is documented before production' },
 { category: 'Timing', online: 'Confirm timing for the complete order', bighorn: 'Current timing documented before approval' },
 { category: 'Order terms', online: 'Confirm the complete scope before ordering', bighorn: 'Current products, production, timing, and pricing documented in the quote' },
 { category: 'Requirements', online: 'Confirm the review process', bighorn: 'Garment, artwork, use, and jobsite needs reviewed' },
 { category: 'Pricing', online: 'Compare itemized quotes', bighorn: 'Current commercial terms documented before approval' },
 { category: 'Long-term fit', online: 'Confirm reorder support', bighorn: 'Current artwork and order details documented for reorder review' },
]

const founder = {
 initials: 'SD',
 name: 'Steven Dodson',
 role: 'Founder',
 bio: 'Steve coordinates branded-apparel and promotional-product programs for teams through production partners.',
 phone: '702.904.8923',
}

const jsonLd = {
 '@context': 'https://schema.org',
 '@graph': [
 {
 '@type': 'AboutPage',
 '@id': 'https://bighornthreads.com/about#aboutpage',
 url: 'https://bighornthreads.com/about',
 name: 'About Bighorn Threads | Las Vegas Branded Apparel',
 description: 'Bighorn Threads is a DBA of VP Promos. The Las Vegas based business coordinates branded apparel and promotional-product orders through production partners.',
 isPartOf: { '@id': 'https://bighornthreads.com/#website' },
 about: { '@id': 'https://bighornthreads.com/#organization' },
 },
 {
 '@type': 'Organization',
 '@id': 'https://bighornthreads.com/#organization',
 name: 'Bighorn Threads',
 alternateName: 'VP Promos',
 founder: { '@id': 'https://bighornthreads.com/#founder' },
 url: 'https://bighornthreads.com',
 logo: 'https://bighornthreads.com/images/logo.png',
 description: 'Las Vegas based branded apparel and promotional products. Production is coordinated through partners.',
 address: {
 '@type': 'PostalAddress',
 streetAddress: '9205 W. Russell Rd Ste 305',
 addressLocality: 'Las Vegas',
 addressRegion: 'NV',
 postalCode: '89148',
 addressCountry: 'US',
 },
 },
 {
 '@type': 'Person',
 '@id': 'https://bighornthreads.com/#founder',
 name: 'Steven Dodson',
 jobTitle: 'Founder',
 worksFor: { '@id': 'https://bighornthreads.com/#organization' },
 description: 'Founder of Bighorn Threads and its parent VP Promos. Steve coordinates branded apparel and promotional-product programs through production partners.',
 telephone: '+17029048923',
 },
 ],
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/about/',
 name: 'We Build Branded Programs for Teams of Every Kind',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title="About Bighorn Threads | Las Vegas Branded Apparel"
 description="Meet the Las Vegas team coordinating branded apparel and promotional-product orders through production partners."
>
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <Picture
 src={foremanCloseup}
 alt=""
 aria-hidden="true"
 widths={[768, 1280, 1920]}
 sizes="100vw"
 formats={['avif', 'webp']}
 fallbackFormat="jpg"
 quality={72}
 class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
 loading="eager"
 fetchpriority="high"
 decoding="async"
 />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/88 to-navy-950/45"></div>
 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28">
 <p class="kicker mb-5 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Our Story
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 We Build Branded Programs for <span class="text-gold-400">Teams of Every Kind</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn Threads is the branded-apparel arm of VP Promos. We are based in Las Vegas and coordinate apparel and promotional-product orders through production partners.
 </p>
 <div class="mt-8 flex flex-wrap items-center gap-2">
 {['Las Vegas based', 'Partner-coordinated production', 'A DBA of VP Promos'].map((tag) => (
 <span class="spec inline-flex items-center gap-2 border border-navy-700 px-2.5 py-1.5 text-navy-200">
 <span class="h-1.5 w-1.5 bg-gold-500"></span>
 {tag}
 </span>
 ))}
 </div>
 </div>
 </section>

 <!-- Operating model — concrete -->
 <section class="bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
 <div class="lg:col-span-7">
 <p class="kicker mb-3">How we work</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
 From request to <span class="text-gold-600">approved order</span>
 </h2>
 <div class="space-y-6 text-lg leading-relaxed text-charcoal">
 <p>
 Bighorn provides Las Vegas account management for branded apparel and promotional products. Production is coordinated through selected partners.
 </p>
 <p>
 Planning starts with the job, team, product requirements, artwork, quantities, and required date. Bighorn then checks supplier availability and partner capacity.
 </p>
 <p>
 Artwork and proofs are coordinated with the selected production partner. The client reviews the proposed garment, decoration, placement, and colors before authorizing production.
 </p>
 <p>
 Each quote documents current products, production, timing, pricing, and reorder terms before approval.
 </p>
 <p>
 Teams can start with the planning pages for <a href="/industries/electrical-contractors-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">electrical work</a>, <a href="/industries/plumbing-hvac-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">plumbing and HVAC</a>, or <a href="/industries/data-center-contractors-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">data center projects</a>. Every product request still requires a current review and written quote.
 </p>
 </div>
 </div>
 <div class="lg:col-span-5">
 <div class="sticky top-24 space-y-6">
 <div class="border border-hairline bg-panel p-2">
 <Picture
 src={workwearFlatlay}
 alt="Branded apparel including embroidered polos, tees, and caps"
 loading="lazy"
 class="h-auto w-full"
 />
 </div>
 <div class="border-l-4 border-gold-500 bg-panel p-6 pl-8">
 <p class="font-heading text-lg leading-relaxed text-charcoal">
 Product recommendations start with how and where your team will use the apparel.
 </p>
 </div>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- Values — paper -->
 <section class="border-y border-hairline bg-paper py-16 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-14 max-w-3xl">
 <p class="kicker mb-3">What we believe</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
 Four planning principles
 </h2>
 <p class="mt-4 text-lg text-ash">
 These values guide product recommendations, quotes, communication, and partner coordination. They help clients understand what to expect before approving an order.
 </p>
 </div>

 <div class="grid gap-6 sm:grid-cols-2">
 {values.map((v) => (
 <article class="border border-hairline bg-panel p-8 transition-colors hover:border-gold-500">
 <div class="mb-5 flex h-14 w-14 items-center justify-center bg-gold-500/15 text-gold-700">
 {v.icon === 'shield' && (
 <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
 </svg>
 )}
 {v.icon === 'phone' && (
 <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
 </svg>
 )}
 {v.icon === 'clock' && (
 <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 )}
 {v.icon === 'pin' && (
 <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
 <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
 </svg>
 )}
 </div>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">{v.title}</h3>
 <p class="leading-relaxed text-ash">{v.body}</p>
 </article>
 ))}
 </div>
 </div>
 </section>

 <!-- Comparison — concrete -->
 <section class="bg-concrete py-24 sm:py-32">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-14 max-w-3xl">
 <p class="kicker mb-3">How we're different</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
 Online promo catalogs vs. <span class="text-gold-600">Bighorn Threads</span>
 </h2>
 <p class="mt-4 text-lg text-ash">
 Compare the complete written scope, including products, artwork, proofing, production, timing, and current commercial terms.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline">
 <!-- Header row -->
 <div class="grid grid-cols-1 gap-px bg-hairline md:grid-cols-3">
 <div class="bg-paper p-5 md:p-6">
 <div class="spec text-ash">Category</div>
 </div>
 <div class="bg-paper p-5 md:p-6">
 <div class="flex items-center gap-2">
 <svg class="h-5 w-5 text-ash" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
 </svg>
 <div class="spec text-ash">Online promo catalogs</div>
 </div>
 </div>
 <div class="bg-gold-500/15 p-5 md:p-6">
 <div class="flex items-center gap-2">
 <svg class="h-5 w-5 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
 </svg>
 <div class="spec text-gold-700">Bighorn Threads</div>
 </div>
 </div>
 </div>
 <!-- Body rows -->
 {comparison.map((row) => (
 <div class="grid grid-cols-1 gap-px bg-hairline md:grid-cols-3">
 <div class="bg-paper p-5 md:p-6">
 <div class="font-heading text-sm font-bold uppercase tracking-tight text-charcoal">{row.category}</div>
 </div>
 <div class="bg-panel p-5 md:p-6">
 <div class="flex items-start gap-2">
 <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-ash" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
 </svg>
 <div class="text-sm text-ash">{row.online}</div>
 </div>
 </div>
 <div class="bg-panel p-5 md:p-6">
 <div class="flex items-start gap-2">
 <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
 </svg>
 <div class="text-sm text-charcoal">{row.bighorn}</div>
 </div>
 </div>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Founder — paper -->
 <section class="border-y border-hairline bg-paper py-24 sm:py-32">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-14 max-w-3xl">
 <p class="kicker mb-3">Meet the founder</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
 Meet <span class="text-gold-600">Steven Dodson</span>
 </h2>
 <p class="mt-4 text-lg text-ash">
 Steve founded Bighorn Threads and its parent, VP Promos.
 </p>
 </div>

 <article class="border border-hairline bg-panel">
 <div class="grid gap-0 lg:grid-cols-[minmax(280px,_380px)_1fr]">
 <!-- Avatar column -->
 <div class="flex flex-col items-center justify-center gap-5 border-b border-hairline bg-concrete p-10 lg:border-b-0 lg:border-r lg:p-14">
 <div class="h-48 w-48 overflow-hidden border border-hairline sm:h-56 sm:w-56">
 <Picture
 src={founderSteve}
 alt="Representative branded-apparel account management portrait"
 widths={[224, 448]}
 sizes="224px"
 formats={['avif', 'webp']}
 fallbackFormat="jpg"
 quality={75}
 loading="lazy"
 decoding="async"
 class="h-full w-full object-cover"
 />
 </div>
 <div class="text-center">
 <div class="kicker">{founder.role}</div>
 <h3 class="mt-1 font-heading text-2xl font-bold uppercase tracking-tight text-charcoal">{founder.name}</h3>
 <div class="mt-2 font-mono text-xs text-ash">Las Vegas, NV</div>
 </div>
 </div>

 <!-- Bio column -->
 <div class="flex flex-col justify-center gap-6 p-10 lg:p-14">
 <p class="leading-relaxed text-ash">{founder.bio}</p>
 <div class="flex flex-wrap items-center gap-4 pt-2">
 <a href="tel:+17029048923" class="inline-flex min-h-[44px] items-center gap-2 border border-charcoal px-5 py-2.5 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:border-gold-500 hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
 <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
 </svg>
 <span>{founder.phone}</span>
 </a>
 <span class="text-sm text-ash">Call Bighorn Threads.</span>
 </div>
 </div>
 </div>
 </article>

 <!-- Production partners photo strip -->
 <div class="mt-16 border border-hairline bg-panel p-2">
 <Image
 src={workwearFlatlay}
 alt="Branded workwear and apparel coordinated by Bighorn Threads"
 loading="lazy"
 class="h-[280px] w-full object-cover sm:h-[320px]"
 />
 </div>
 </div>
 </section>

 <!-- Location — concrete -->
 <section class="bg-concrete py-24 sm:py-32">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 lg:items-center">
 <div>
 <p class="kicker mb-3">Based in Las Vegas</p>
 <h2 class="mb-6 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
 Vegas roots. <span class="text-gold-600">Confirmed order terms.</span>
 </h2>
 <p class="mb-6 text-lg leading-relaxed text-ash">
 Bighorn is based in Las Vegas and coordinates production through partners. Product availability, production method, and timing are confirmed for each order.
 </p>
 <p class="mb-8 text-lg leading-relaxed text-ash">
 Share your product, artwork, quantity, and required date. Bighorn will document the current order terms in the quote.
 </p>

 <div class="mb-8 flex items-start gap-4 border border-hairline bg-panel p-6">
 <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center bg-gold-500/15 text-gold-700">
 <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
 <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
 </svg>
 </div>
 <div>
 <div class="kicker mb-1">Shop location</div>
 <div class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">Las Vegas, Nevada</div>
 <div class="mt-1 text-sm text-ash">Las Vegas based account service with partner-coordinated production.</div>
 </div>
 </div>
 </div>

 <div>
 <div class="kicker mb-6">Before you approve</div>
 <div class="border border-hairline bg-panel p-8">
 <h3 class="font-heading text-2xl font-bold uppercase tracking-tight text-charcoal">Get the complete order in writing</h3>
 <p class="mt-4 leading-relaxed text-ash">
 Your quote should identify the products, artwork, quantities, production method, timing, pricing, and reorder terms.
 </p>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <Image
 src={productStack}
 alt=""
 aria-hidden="true"
 class="absolute inset-0 -z-10 h-full w-full object-cover"
 loading="lazy"
 />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>
 <div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:px-8">
 <p class="kicker mb-3 justify-center">Let's work</p>
 <h2 class="mb-6 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl lg:text-5xl">
 Ready to work with a team that <span class="text-gold-400">actually gets it?</span>
 </h2>
 <p class="mx-auto mb-10 max-w-2xl text-lg text-navy-200">
 Send your logo, quantities, garment needs, and deadline. We'll review the complete order and document the available products, proof, timing, and commercial terms.
 </p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
 <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
 </svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
 </svg>
 Call the shop
 </a>
 </div>
 <p class="mt-8 text-sm text-navy-300">
 Call the Las Vegas account team. Response timing depends on staff availability.
 </p>
 </div>
 </section>
</BaseLayout>
