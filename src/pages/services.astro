---
import { photo } from '@/data/pagePhotos'
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Picture } from 'astro:assets'

const services = [
 {
 name: 'Screen Printing',
 serviceType: 'Screen printing for construction branded apparel',
 description: 'Multi-color screen printing on tees, hoodies, and workwear, with bold logos and large back prints.',
 },
 {
 name: 'Embroidery',
 serviceType: 'Embroidery for construction uniforms, polos, headwear',
 description: 'Stitched logos on polos, softshells, hats, beanies, and bags.',
 },
 {
 name: 'Branded Apparel',
 serviceType: 'Branded workwear and uniforms for trades',
 description: 'Tees, polos, jackets, work pants, and safety-rated garments for construction and trade teams, sorted by role.',
 },
 {
 name: 'Company Stores',
 serviceType: 'Private branded apparel store for contractors',
 description: 'A private online store with your approved gear, where employees order their own sizes.',
 },
 {
 name: 'Promotional Products',
 serviceType: 'Branded promotional products & corporate gifts',
 description: 'Drinkware, bags, tech accessories, awards, and event items with your logo.',
 },
]

const faqs = [
 {
 q: 'What services does Bighorn Threads offer?',
 a: 'Screen printing, embroidery, branded workwear, promotional products, and private company stores for teams that reorder.',
 },
 {
 q: 'What’s the minimum order?',
 a: 'Each garment and decoration method has its own minimum. Send the item and a rough count, and we will tell you the minimum and any setup charge.',
 },
 {
 q: 'How fast can you turn around a rush job?',
 a: 'Give us your date before you order. We check that the garment is in stock and a shop has room, then tell you if the date works.',
 },
 {
 q: 'Do you handle FR-rated and ANSI hi-vis decoration?',
 a: 'Yes. You tell us the protection level, and we find garments rated for it. Some of this gear limits how and where a logo can go, so we check the maker’s instructions before anything is made.',
 },
 {
 q: 'Should I pick screen printing, embroidery, or DTF?',
 a: 'Embroidery suits polos, jackets, and hats. Screen printing suits larger runs of tees and hoodies. DTF suits detailed artwork in smaller quantities. Send your logo and count and we will recommend one.',
 },
 {
 q: 'How does a company store work?',
 a: 'Your approved gear sits in one private store, and your staff order their own sizes without going through you.',
 },
]

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@graph': services.map((s, idx) => ({
 '@type': 'Service',
 '@id': `https://bighornthreads.com/services#${s.name.toLowerCase().replace(/\s+/g, '-')}`,
 name: s.name,
 serviceType: s.serviceType,
 description: s.description,
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: {
 '@type': 'BusinessAudience',
 name: 'General contractors, electrical contractors, plumbing companies, HVAC service companies, roofing contractors, and trade businesses',
 },
 })),
}

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/services/',
 datePublished: '2026-07-08',
 dateModified: '2026-11-01',
 name: 'Screen Printing, Embroidery & Branded Gear',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title="Screen Printing, Embroidery & Branded Apparel Services | Bighorn Threads"
 description="Screen printing, embroidery, branded workwear, company stores, and promotional products for teams across the US, with one contact on every order."
>
 <!-- ════ HERO — full-bleed photographic dark band ════ -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-28 lg:pt-24">
 <div class="max-w-2xl">
 <p class="kicker mb-5 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Our Services
 </p>
 <h1 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Screen Printing, Embroidery &amp; <span class="text-gold-700">Branded Gear</span> for Your Team
 </h1>
 <p class="speakable-answer mt-7 max-w-xl text-lg leading-relaxed text-ash sm:text-xl">
 Printed tees, stitched polos, workwear, promo items, or a private store your people order from. One contact runs the order, and it ships anywhere in the US.
 </p>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- ════ ANSWER-FIRST SUMMARY + JUMP LINKS — paper ════ -->
 <section class="border-y border-hairline bg-paper py-14 sm:py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="mb-7 max-w-3xl text-base leading-relaxed text-ash sm:text-lg">
 Need shirts for a new crew, polos for the front desk, or a store so people can order their own sizes? Start here. We run the order and production partners do the decoration.
 </p>
 <ul class="grid grid-cols-2 gap-2 sm:gap-3 lg:grid-cols-5">
 {[
 { href: '#screen-printing', name: 'Screen Printing', detail: 'Tees, hoodies, and workwear.' },
 { href: '#embroidery', name: 'Embroidery', detail: 'Polos, jackets, hats, and bags.' },
 { href: '#branded-apparel', name: 'Branded Apparel', detail: 'Gear for each role on the crew.' },
 { href: '/company-stores/', name: 'Company Stores', detail: 'Your people order their own sizes.' },
 { href: '#promotional-products', name: 'Promotional Products', detail: 'Drinkware, swag, client gifts.' },
 { href: '/custom-uniforms-las-vegas/', name: 'Custom Uniforms', detail: 'Uniforms you buy and keep.' },
 { href: '/custom-t-shirts-las-vegas/', name: 'Custom T-Shirts', detail: 'Printed tees for crews and events.' },
 { href: '/custom-work-shirts-las-vegas/', name: 'Custom Work Shirts', detail: 'Red Kap, Carhartt, FR with your logo.' },
 { href: '/custom-hats-las-vegas/', name: 'Custom Hats', detail: 'Embroidered caps and beanies.' },
 { href: '/custom-hard-hat-stickers-las-vegas/', name: 'Hard Hat Decals', detail: 'Logo, name, and cert stickers.' },
 ].map((j) => (
 <li>
 <a href={j.href} class="block h-full border border-hairline bg-panel px-4 py-3 transition-colors hover:border-gold-500">
 <span class="block font-heading text-sm font-bold uppercase tracking-tight text-charcoal">{j.name}</span>
 <span class="mt-0.5 hidden text-xs text-ash sm:block">{j.detail}</span>
 </a>
 </li>
 ))}
 </ul>
 <p class="mt-6 max-w-3xl text-sm leading-relaxed text-ash">
 Need help deciding? Read about <a href="/services/screen-printing-las-vegas/" class="text-gold-600 hover:underline">screen printing</a>, <a href="/services/embroidery-las-vegas/" class="text-gold-600 hover:underline">embroidery</a>, and <a href="/services/rush-orders-las-vegas/" class="text-gold-600 hover:underline">rush orders</a>, or compare <a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="text-gold-600 hover:underline">screen print vs. embroidery</a> and <a href="/blog/dtf-printing-vs-screen-printing-custom-apparel/" class="text-gold-600 hover:underline">DTF vs. screen print</a>. Weighing the spend first? Read <a href="/is-branded-apparel-worth-it/" class="text-gold-600 hover:underline">is branded apparel worth it for a service business</a>.
 </p>
 </div>
 </section>

 <!-- ════ FLAGSHIP: COMPANY STORES — concrete ════ -->
 <section class="bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="grid gap-0 border border-l-0 border-hairline lg:grid-cols-[1.4fr_1fr]">
 <div class="p-9 sm:p-12">
 <span class="spec mb-4 inline-block bg-gold-500 px-2 py-1 text-charcoal">Flagship Service</span>
 <h2 class="mb-5 font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-4xl lg:text-5xl">
 Company Stores: <span class="text-gold-600">Private Online Storefronts for Your Crew</span>
 </h2>
 <p class="mb-5 text-lg leading-relaxed text-ash">
 A company store is a private online store with the gear you approved, so a new hire can pick a size and order without going through you. Tell us if you also need budgets, payment options, or reports, and we will show you what the store can do.
 </p>
 <p class="mb-8 text-base leading-relaxed text-ash">
 Our team in Las Vegas runs the account. Your written proposal lists every cost, who handles what, and how orders ship.
 </p>
 <div class="mb-8 flex flex-wrap gap-2">
 {['Your logo', 'Approved catalog', 'Employee sizes', 'Shipping options', 'Written proposal'].map((tag) => (
 <span class="spec border border-hairline px-2.5 py-1 text-ash">{tag}</span>
 ))}
 </div>
 <div class="flex flex-wrap gap-3">
 <a href="/company-stores/" class="btn-primary text-base">
 How company stores work
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow}/></svg>
 </a>
 <a href="/get-a-quote/" class="btn-secondary text-base">
 Ask about a store
 </a>
 </div>
 </div>
 <div class="border-t border-hairline bg-paper p-9 sm:p-12 lg:border-l lg:border-t-0">
 <div class="kicker mb-2">Who it's for</div>
 <h3 class="mb-5 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">Multi-crew contractors &amp; service trades</h3>
 <ul class="space-y-4 text-ash">
 {[
 'Crews spread across several job sites',
 'Steady hiring, where each new hire needs a starter kit',
 'Several offices or yards that should match',
 'Apparel budgets you want to keep an eye on',
 ].map((item) => (
 <li class="flex gap-3">
 <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
 <span>{item}</span>
 </li>
 ))}
 </ul>

 <div class="mt-8 border-t border-hairline pt-6">
 <div class="kicker mb-3">Setup steps</div>
 <ul class="space-y-2.5 text-sm text-ash">
 <li class="flex gap-3">
 <span class="w-20 flex-shrink-0 font-mono text-xs font-bold text-gold-600">Kickoff</span>
 <span>Kickoff call and your logo files</span>
 </li>
 <li class="flex gap-3">
 <span class="w-20 flex-shrink-0 font-mono text-xs font-bold text-gold-600">Catalog</span>
 <span>Pick the products and get pricing</span>
 </li>
 <li class="flex gap-3">
 <span class="w-20 flex-shrink-0 font-mono text-xs font-bold text-gold-600">Test</span>
 <span>You test the store and sign off</span>
 </li>
 <li class="flex gap-3">
 <span class="w-20 flex-shrink-0 font-mono text-xs font-bold text-gold-600">Launch</span>
 <span>Send your team the link</span>
 </li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ SCREEN PRINTING — paper ════ -->
 <section id="screen-printing" class="scroll-mt-20 border-y border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-12 lg:grid-cols-2">
 <div>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Screen Printing</h2>
 <p class="mb-4 text-lg leading-relaxed text-ash">
 Use screen printing for tees, hoodies, and workwear in bigger runs, especially with a bold logo or a big back print.
 </p>
 <p class="mb-6 text-base leading-relaxed text-ash">
 Send your logo and we will tell you how many ink colors it takes and where it can go. You see it on a proof before it goes to press.
 </p>
 <a href="/get-a-quote/" class="btn-primary text-sm">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 <div class="">
 <img src="/images/photos/screen-printing-closeup.webp" alt={photo('screen-printing-closeup').alt} width="1376" height="768" loading="lazy" decoding="async" class="mb-6 aspect-[3/2] w-full object-cover" />
 <h3 class="kicker mb-5">What's Included</h3>
 <ul class="space-y-3">
 {['Multi-color print options', 'Plastisol & water-based ink options', 'Specialty ink options', 'Large format back prints', 'Left chest & pocket prints'].map((item) => (
 <li class="flex items-center gap-3 text-ash">
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
 {item}
 </li>
 ))}
 </ul>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ EMBROIDERY — concrete ════ -->
 <section id="embroidery" class="scroll-mt-20 bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-12 lg:grid-cols-2">
 <div class="order-2  lg:order-1">
 <img src="/images/photos/embroidered-caps.webp" alt={photo('embroidered-caps').alt} width="1376" height="768" loading="lazy" decoding="async" class="mb-6 aspect-[3/2] w-full object-cover" />
 <h3 class="kicker mb-5">What's Included</h3>
 <ul class="space-y-3">
 {['Logo digitizing options', 'Multi-color thread options', 'Left chest, sleeves, back placement', 'Hats, beanies & headwear', 'Bags & backpacks'].map((item) => (
 <li class="flex items-center gap-3 text-ash">
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
 {item}
 </li>
 ))}
 </ul>
 </div>
 <div class="order-1 lg:order-2">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Embroidery</h2>
 <p class="mb-4 text-lg leading-relaxed text-ash">
 Use embroidery on polos, softshells, caps, jackets, and bags when the logo has to look sharp up close. Small type can blur in thread, so send the real logo file and we will tell you if it holds up.
 </p>
 <p class="mb-6 text-base leading-relaxed text-ash">
 Your logo gets digitized for stitching and the thread colors get matched as closely as thread allows. Any digitizing or setup charge shows on your quote, and you approve the proof first.
 </p>
 <a href="/get-a-quote/" class="btn-primary text-sm">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ BRANDED APPAREL — paper ════ -->
 <section id="branded-apparel" class="scroll-mt-20 border-y border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-12 lg:grid-cols-2">
 <div>
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Branded Apparel</h2>
 <p class="mb-4 text-lg leading-relaxed text-ash">
 Tees, polos, jackets, headwear, work pants, coveralls, and safety-rated garments. Tell us who wears what and we look up which brands and sizes are available.
 </p>
 <p class="mb-6 text-base leading-relaxed text-ash">
 We help you sort gear by role, weather, fit, and how it gets washed. Tell us the protection level the job calls for and we will find garments rated for it.
 </p>
 <a href="/get-a-quote/" class="btn-primary text-sm">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 <div class="">
 <img src="/images/photos/crew-hoodies.webp" alt="Four crew members in matching charcoal hoodies talking over coffee in a pipe yard" width="1376" height="610" loading="lazy" decoding="async" class="mb-6 aspect-[3/2] w-full object-cover" />
 <h3 class="kicker mb-5">What's Included</h3>
 <ul class="space-y-3">
 {['T-shirts & tank tops', 'Polos & dress shirts', 'Hoodies & jackets', 'Hi-vis safety wear', 'Hard hats & beanies', 'Work pants & coveralls'].map((item) => (
 <li class="flex items-center gap-3 text-ash">
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
 {item}
 </li>
 ))}
 </ul>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ PROMOTIONAL PRODUCTS — concrete ════ -->
 <section id="promotional-products" class="scroll-mt-20 bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-12 lg:grid-cols-2">
 <div class="order-2  lg:order-1">
 <img src="/images/photos/new-hire-kit.webp" alt={photo('new-hire-kit').alt} width="1376" height="768" loading="lazy" decoding="async" class="mb-6 aspect-[3/2] w-full object-cover" />
 <h3 class="kicker mb-5">What's Included</h3>
 <ul class="space-y-3">
 {['Drinkware & tumblers', 'Tote bags & coolers', 'Pens & office supplies', 'Safety gear & first aid kits', 'Tech accessories', 'Awards & recognition'].map((item) => (
 <li class="flex items-center gap-3 text-ash">
 <svg class="h-5 w-5 flex-shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
 {item}
 </li>
 ))}
 </ul>
 </div>
 <div class="order-1 lg:order-2">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Promotional Products</h2>
 <p class="mb-4 text-lg leading-relaxed text-ash">
 Tumblers, stickers, power banks, caps, tote bags, event signage, and more. Tell us who it is for, your budget, how many, and your date, and we narrow down the catalog.
 </p>
 <p class="mb-6 text-base leading-relaxed text-ash">
 Good for client gifts, crew appreciation, meetings, tournaments, open houses, and events. Need a sample, or an item made in a certain country? Ask and we will check that product.
 </p>
 <a href="/get-a-quote/" class="btn-primary text-sm">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ RECENTLY PUBLISHED — paper ════ -->
 <section class="border-y border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Guides</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Compare methods before you order.</h2>
 <ul class="grid gap-3 sm:grid-cols-2">
 <li><a href="/screen-printing-vs-embroidery-construction-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Screen printing vs embroidery for construction crews</a></li>
 <li><a href="/blog/dtf-printing-vs-screen-printing-custom-apparel/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">DTF printing vs screen printing</a></li>
 <li><a href="/blog/plastisol-vs-water-based-ink-workwear/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Plastisol vs water-based ink for workwear</a></li>
 <li><a href="/blog/sublimation-printing-custom-apparel-guide/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Sublimation printing custom apparel guide</a></li>
 <li><a href="/embroidery-vs-patches-uniforms/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Embroidery vs patches on uniforms</a></li>
 <li><a href="/screen-printing-vs-dtg-vs-embroidery/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">Screen printing vs DTG vs embroidery</a></li>
 </ul>
 <p class="mt-6 text-base leading-relaxed text-ash">On pricing and order size: <a href="/blog/how-much-to-embroider-a-shirt/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">how much to embroider a shirt</a> and our <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">MOQ guide</a>.</p>
 </div>
 </section>

 <!-- FAQ: visible, so the FAQPage schema matches the page -->
 <section class="bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Questions we get</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((item) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <span class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.q}</span>
 <svg class="h-5 w-5 shrink-0 text-gold-700 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 <p class="pb-5 leading-relaxed text-ash">{item.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- ════ CTA — full-bleed photographic dark band ════ -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:px-8">
 <p class="kicker mb-3 justify-center">Not sure what you need?</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl">
 Tell us who's wearing it. <span class="text-gold-400">We'll suggest the gear.</span>
 </h2>
 <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/80">
 You get a price, the minimum, and timing for your order in writing.
 </p>
 <div class="mt-9 flex justify-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
