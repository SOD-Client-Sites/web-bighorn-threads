---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Picture } from 'astro:assets'
import productStack from '@/assets/generated/product-stack.jpg'

const services = [
 {
 name: 'Screen Printing',
 serviceType: 'Screen printing for construction branded apparel',
 description: 'Multi-color screen printing on tees, hoodies, and qualifying workwear. Ink, color, minimum, and timing requirements are confirmed for each order.',
 },
 {
 name: 'Embroidery',
 serviceType: 'Embroidery for construction uniforms, polos, headwear',
 description: 'Commercial embroidery on qualifying polos, softshells, hats, beanies, and bags. Thread, artwork, minimum, and timing requirements are confirmed for each order.',
 },
 {
 name: 'Branded Apparel',
 serviceType: 'Branded workwear & uniforms for Las Vegas trades',
 description: 'Branded apparel planning for construction and trade teams. Product ratings, brand availability, decoration, minimums, and timing are confirmed by quote.',
 },
 {
 name: 'Company Stores',
 serviceType: 'Private branded apparel store for contractors',
 description: 'Planning for private branded apparel portals. Platform features, costs, inventory, ordering, and fulfillment terms are confirmed before setup.',
 },
 {
 name: 'Promotional Products',
 serviceType: 'Branded promotional products & corporate gifts',
 description: 'Promotional product sourcing for drinkware, bags, tech accessories, awards, and event items. Availability, samples, decoration, minimums, and timing vary by product.',
 },
]

const faqs = [
 {
 q: 'What services does Bighorn Threads offer?',
 a: 'Bighorn coordinates screen printing, embroidery, branded workwear, and promotional-product quotes through production partners. Company-store work is planning only: no platform has been selected or launched, and implementation requires a separately approved configuration.',
 },
 {
 q: 'What’s the minimum order?',
 a: 'Minimums vary by garment, decoration method, supplier, and order specification. We confirm the current minimum and any setup charges in the quote.',
 },
 {
 q: 'How fast can you turn around a rush job?',
 a: 'Rush capacity depends on the product, artwork, quantity, approvals, production partner, and delivery requirements. Share your needed date so we can confirm the current schedule before you commit.',
 },
 {
 q: 'Do you handle FR-rated and ANSI hi-vis decoration?',
 a: 'Bighorn coordinates decoration through production partners. Safety-rated garments require written review of the product, decoration method, placement, thread, and current supporting documents before approval.',
 },
 {
 q: 'Should I pick screen printing, embroidery, or DTF?',
 a: 'Embroidery is common for polos, jackets, and headwear. Screen printing can fit larger runs, while DTF can fit detailed artwork and smaller quantities. The product, artwork, quantity, care needs, and quote determine the final method.',
 },
 {
 q: 'How does a company store work?',
 a: 'A proposed company store could organize approved products and ordering rules if the selected platform and approved configuration support them. Bighorn has not selected or launched that platform. Implementation, capabilities, costs, and terms require separate written approval.',
 },
]

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@graph': services.map((s, idx) => ({
 '@type': 'Service',
 '@id': `https://bighornthreads.com/services#${s.name.toLowerCase().replace(/\s+/g, '-')}`,
 name: s.name,
 serviceType: s.serviceType,
 description: s.description,
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 audience: {
 '@type': 'BusinessAudience',
 name: 'General contractors, electrical contractors, plumbing companies, HVAC service companies, roofing contractors, and trade businesses',
 },
 })),
}

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/services/',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Screen Printing, Embroidery & Branded Gear in Las Vegas',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
