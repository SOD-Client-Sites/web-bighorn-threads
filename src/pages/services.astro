 src={productStack}
 alt=""
 aria-hidden="true"
 widths={[768, 1280, 1920]}
 sizes="100vw"
 formats={['avif', 'webp']}
 fallbackFormat="jpg"
 loading="eager"
 fetchpriority="high"
 decoding="async"
 class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
 />
