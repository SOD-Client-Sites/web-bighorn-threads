---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Trade Show Apparel in Las Vegas | Booth Crew Polos & Tees — Bighorn Threads',
 description:
 'Trade show apparel for Vegas booth crews — World of Concrete, IBS, ConExpo, AHR Expo, AGC, SEMA. Embroidered polos with logo + name, branded tees for setup, exec layer for the lead. Get a quote.',
 hero: '/images/generated/service-branded-apparel.jpg',
 url: 'https://bighornthreads.com/trade-show-apparel-las-vegas/',
}

const stack = [
 { label: 'Booth-rep polos', body: 'Matching embroidered polos can be quoted for floor reps. Logo, name treatment, placement, product, and quantity are confirmed after artwork review.' },
 { label: 'Executive layer', body: 'A quarter-zip, button-down, or vest can distinguish an executive role while using the approved color and decoration system.' },
 { label: 'Setup crew tees', body: 'A separate tee can be considered for setup and breakdown work. Product performance depends on the exact garment, use, care, and manufacturer instructions.' },
 { label: 'Order timeline', body: 'Production timing depends on the selected product, artwork approval, quantity, supplier availability, and production partner capacity. Confirm the schedule before ordering.' },
]

const shows = [
 { row: 'World of Concrete', meaning: 'Confirm current Las Vegas dates', use: 'Concrete, masonry, decorative, equipment trades' },
 { row: 'International Builders\' Show (IBS)', meaning: 'Confirm current host city and dates', use: 'Residential construction, building products, NAHB' },
 { row: 'ConExpo-Con/Agg', meaning: 'Confirm current Las Vegas dates', use: 'Construction equipment and aggregates' },
 { row: 'AHR Expo', meaning: 'Confirm current host city and dates', use: 'HVAC, refrigeration, building automation' },
 { row: 'AGC Annual Convention', meaning: 'Confirm current host city and dates', use: 'Associated General Contractors leadership and members' },
 { row: 'SEMA Show', meaning: 'Confirm current Las Vegas dates', use: 'Auto aftermarket, fabrication, performance' },
]

const layout = [
 { name: 'Floor reps', detail: 'A matching embroidered polo can use an approved company logo and optional name treatment. Quantity is based on the roster, schedule, care plan, and quote.' },
 { name: 'Executive lead', detail: 'A quarter-zip, vest, or button-down can use the same approved color and decoration system as the floor team.' },
 { name: 'Setup / breakdown', detail: 'A separate tee and workwear combination can be considered for setup tasks. The employer approves the exact product for the work.' },
 { name: 'Tech / AV crew', detail: 'A distinct tee or hoodie can be requested for technical staff. Product, color, and decoration are confirmed in the proof and quote.' },
]

const faqs = [
 { q: 'What should trade show booth crews wear?', a: 'Branded polos for senior reps and customer-facing roles, branded long-sleeve button-downs or quarter-zips for executives, branded tees for booth setup and breakdown crews. All three should share the same logo placement, color palette, and embroidery style. Match the booth visual identity — if your booth is navy and gold, the apparel is navy with gold-stitched logos.' },
 { q: 'How many shirts should each booth person have?', a: 'Set the quantity from the event schedule, role, travel plan, expected changes, and garment care requirements. Share the roster and dates so Bighorn can quote the requested quantity and current production terms.' },
 { q: 'Should the booth crew all wear identical shirts?', a: 'A shared color and decoration system can create consistency, while different garments can identify floor, executive, setup, or technical roles. The final approach depends on your brand standards, work requirements, and approved proof.' },
 { q: 'What\'s the best polo for trade show wear?', a: 'The right polo depends on budget, fit, fabric, care, brand requirements, logo complexity, and current availability. Bighorn can quote requested Port Authority, Cutter & Buck, Nike, or comparable products after reviewing the exact garment and decoration method.' },
 { q: 'Should we put names on trade show shirts?', a: 'Name embroidery is optional. Placement, letter size, privacy preferences, garment compatibility, and production timing are confirmed in the proof and quote.' },
 { q: 'Do we need different apparel for setup and show floor?', a: 'Some teams request separate products for setup and show-floor roles while keeping an approved color and logo system. The employer selects products for the exact work, use, care, and manufacturer instructions.' },
 { q: 'When should I order trade show apparel?', a: 'Allow time for product selection, artwork review, proof approval, supplier availability, and partner production. File retention and reorder timing depend on the approved program, and the current production schedule is confirmed in the quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Trade Show Apparel Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Trade Show Apparel in Las Vegas',
 serviceType: 'Branded booth crew apparel — embroidered polos, executive layer, setup-crew tees',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Trade Show Apparel</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Booth Crew Apparel
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Trade Show Apparel in Las Vegas <span class="text-gold-400">— booth crews, exec layer, setup tees.</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn Threads outfits Las Vegas trade show booth crews with matching embroidered polos for floor reps. Add a distinct executive layer for the lead and branded heavyweight tees for setup. We coordinate one logo and name treatment through production partners.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A trade show apparel program, tiered by role.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Vegas shows -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Major Shows in Vegas</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Plan apparel for major Las Vegas trade shows.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Las Vegas hosts construction, building-products, HVAC, equipment, and automotive events. Confirm each event's current organizer schedule. Artwork retention and reorder timing depend on the approved program, exact product availability, and current partner capacity.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Show</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">When</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Audience</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {shows.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Layout by role -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">By Role</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Different garments, same brand language.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {layout.map((l) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{l.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{l.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Trade show apparel is a brand asset, not a uniform.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Trade show apparel may appear in event photos, videos, and booth conversations. Fabric, decoration placement, optional name treatment, and color can be reviewed against the approved booth and brand standards.
 </p>
 <p>
 One planning option is to organize apparel by role. Floor representatives may use a matching polo, while optional name decoration and its placement are confirmed during artwork review. The client decides whether names fit its brand and privacy preferences.
 </p>
 <p>
 An executive lead may use a quarter-zip, vest, or button-down with the same approved decoration system. Setup and breakdown staff may need a separate product selected by the employer for the exact tasks, use, care, and manufacturer instructions. Products and quantities are confirmed in the quote.
 </p>
 <p>
 Las Vegas event planning may involve World of Concrete, the International Builders' Show, ConExpo-Con/Agg, AHR Expo, AGC events, or SEMA. Organizer schedules and host cities can change, so confirm current dates before setting the apparel deadline. File retention, product availability, and reorder timing remain program-specific.
 </p>
 <p>
 For deeper reads, see our <a href="/blog/trade-show-apparel-booth-crew/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">trade show apparel playbook</a>, the <a href="/blog/custom-polo-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom polo shirts buyer's guide</a>, and the <a href="/blog/port-authority-polos-vs-alternatives/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Port Authority polos comparison</a> for blank picks.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Trade show apparel questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-polo-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Polo Shirts</h3>
 <p class="mt-2 text-sm text-ash">The blanks and embroidery options behind every floor-rep polo.</p>
 </a>
 <a href="/services/embroidery-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Embroidery</h3>
 <p class="mt-2 text-sm text-ash">Logo, optional name treatment, thread color, retention, and partner proofing confirmed per quote.</p>
 </a>
 <a href="/services/rush-orders-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Rush Orders</h3>
 <p class="mt-2 text-sm text-ash">For shows where the date crept up faster than the order did.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to outfit your booth?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your show date and roster size.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
