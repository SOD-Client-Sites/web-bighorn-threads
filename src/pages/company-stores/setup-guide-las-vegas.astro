---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Company Store Planning for Las Vegas Trades | Bighorn Threads',
 description:
 'Company store planning for Las Vegas contractors and trades. Bighorn provides local account management and coordinates approved products and decoration through production partners. Get a quote.',
 hero: '/images/generated/service-company-stores.jpg',
 url: 'https://bighornthreads.com/company-stores/setup-guide-las-vegas/',
}

const steps = [
 { n: '01', label: 'Discovery call', body: 'We review your trades, roles, apparel standards, and ordering process. Safety-rated items require a separate written product and decoration review.' },
 { n: '02', label: 'Program scope', body: 'We outline the proposed catalog, artwork requirements, ordering flow, and available storefront options.' },
 { n: '03', label: 'Terms and controls', body: 'Your written proposal confirms available spending controls, user roles, minimums, fees, timing, and fulfillment terms.' },
 { n: '04', label: 'Approval and launch', body: 'You approve the products, artwork treatment, program terms, and launch plan before production or ordering begins.' },
]

const included = [
 { label: 'Storefront options', body: 'A proposal can include a branded ordering page if the selected platform supports your requirements.' },
 { label: 'Approved catalog', body: 'You review the proposed products and decoration specifications before they become part of the program.' },
 { label: 'Ordering controls', body: 'Available budgets, permissions, and approval rules are documented before setup.' },
 { label: 'Fulfillment plan', body: 'Shipping destinations, inventory handling, minimums, and delivery terms are confirmed in the written quote.' },
]

const timeline = [
 { row: 'Planning', meaning: 'Discovery and program scope', use: 'Roles, products, artwork, ordering needs, and safety requirements' },
 { row: 'Configuration', meaning: 'Catalog and program proposal', use: 'Available storefront features, controls, pricing, minimums, and fulfillment terms' },
 { row: 'Approval', meaning: 'Written sign-off and launch plan', use: 'Product approvals, artwork treatment, schedule, testing, and launch responsibilities' },
]

const whoFor = [
 { name: 'General contractors', detail: 'A proposed store can be evaluated for role-based ordering, subject to confirmed platform and operating terms.' },
 { name: 'MEP subcontractors', detail: 'Mechanical, electrical, and plumbing teams can compare role-based apparel and ordering options.' },
 { name: 'Data center contractors', detail: 'Large rosters can benefit from one approved product and branding specification. PPE decisions still require qualified safety review.' },
 { name: 'Multi-location trades', detail: 'A shared program can help teams evaluate consistent products and branding across locations.' },
 { name: 'Fleet and field service', detail: 'HVAC, low-voltage, solar, and utility teams can plan apparel by role and replacement need.' },
 { name: 'Growing crews', detail: 'Businesses hiring year-round can document a repeatable new-hire apparel process.' },
]

const faqs = [
 { q: 'How long does it take to set up a company store?', a: 'Timing depends on the approved products, artwork, selected platform, configuration, testing, and production-partner capacity. Bighorn confirms the proposed schedule in writing before launch.' },
 { q: 'Is there a minimum order to set up a company store?', a: 'Minimums and inventory requirements depend on the products, decoration methods, suppliers, platform, and fulfillment model. Your quote confirms the current terms.' },
 { q: 'What does it cost to run a company store?', a: 'Setup, platform, transaction, product, decoration, and shipping costs vary by program. Bighorn provides the available terms in a written proposal before you approve setup.' },
 { q: 'Who manages sizes, reorders, and new hires?', a: 'That depends on the selected ordering platform and program design. Bighorn documents the available user, reorder, import, and allowance features before configuration.' },
 { q: 'Can we control what employees order and how much they spend?', a: 'Catalog, role, budget, and approval controls depend on the selected platform. The proposal identifies which controls are available for your program.' },
 { q: 'Do we have to do any IT work to set up the store?', a: 'Technical requirements depend on the selected platform and any integrations. Bighorn coordinates the approved program and explains each party\'s setup responsibilities in writing.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Company Stores', item: 'https://bighornthreads.com/company-stores/' },
 { '@type': 'ListItem', position: 3, name: 'Setup Guide for Las Vegas Trades', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Company Store Setup for Las Vegas Trades',
 serviceType: 'Company Stores',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/company-stores/setup-guide-las-vegas/',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <a href="/company-stores/" class="hover:text-gold-400">Company Stores</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Setup Guide</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Setup Guide
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Company Store Planning for Trades in Las Vegas. <span class="text-gold-400">Scoped around your crew.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn provides Las Vegas account management and coordinates approved products and decoration through production partners. Platform, fulfillment, timing, minimums, and fees are confirmed in writing.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Liftable answer — AEO definition block, speakable -->
 <section class="border-b border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-4">The Short Answer</p>
 <p class="speakable-answer text-lg leading-relaxed text-ash">
 Bighorn Threads helps Las Vegas trades plan branded apparel ordering programs. We provide local account management and coordinate approved products and decoration through production partners. Your proposal confirms platform capabilities, fulfillment, timing, minimums, fees, and responsibilities.
 </p>
 </div>
 </section>

 <!-- Setup steps — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How Setup Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Company store setup for Las Vegas trades, step by step.</h2>
 </div>

 <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {steps.map((s) => (
 <li class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="mb-4 block font-heading text-5xl font-extrabold leading-none text-gold-500">{s.n}</span>
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </li>
 ))}
 </ol>
 </div>
 </section>

 <!-- Timeline table — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Timeline</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From kickoff to <span class="text-gold-600">crew ordering.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Each program follows a planning, configuration, and approval process. The written proposal confirms the schedule.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Stage</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What Happens</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">The Work</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {timeline.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- What's included — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What's Included</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Options to review for your program.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {included.map((i) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{i.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{i.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Who it's for — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Who It's For</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Built for Las Vegas trades that hire and reorder all year.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {whoFor.map((w) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{w.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{w.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 What company store setup actually takes for a Vegas trade.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A company store is a branded ordering portal that can present approved products to a defined team. Available ordering, payment, approval, inventory, and fulfillment features depend on the selected platform and program.
 </p>
 <p>
 The discovery call defines your roles, apparel standards, ordering needs, and artwork. Bighorn then coordinates a proposed product and decoration specification through production partners. Safety-rated garments require separate written review before approval.
 </p>
 <p>
 Budget controls can help owners manage employee apparel spending. The selected platform determines whether credits, role-based catalogs, approval rules, and reporting are available. Those capabilities should be confirmed before the program is configured.
 </p>
 <p>
 Inventory, shipping, hosting, support, and technical responsibilities vary by program. Bighorn documents the approved model before setup begins. For a broader comparison, see our <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company stores overview</a> and our guide on <a href="/blog/company-store-vs-bulk-ordering/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company stores versus bulk ordering</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Setup questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores Overview</h3>
 <p class="mt-2 text-sm text-ash">How the model works, who it may fit, and what to confirm.</p>
 </a>
 <a href="/industries/data-center-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Data Center Contractors</h3>
 <p class="mt-2 text-sm text-ash">Planning considerations for large rosters and fast hiring.</p>
 </a>
 <a href="/catalog/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Catalog</h3>
 <p class="mt-2 text-sm text-ash">Browse apparel categories and request a product-specific quote.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to set up your company store?</h2>
 <p class="mb-8 text-lg text-navy-200">Tell us your crew size, trades, and ordering needs. We'll prepare a program recommendation.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
