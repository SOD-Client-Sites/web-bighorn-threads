---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Company Store Setup Guide for Trades | Bighorn Threads',
 description:
 'How a company store gets set up for contractors and trades: the steps, the decisions, and what to get in writing. Based in Las Vegas, shipping nationwide.',
 url: 'https://bighornthreads.com/company-stores/setup-guide-las-vegas/',
}

const steps = [
 { n: '01', label: 'Discovery call', body: 'We go over your trades, roles, and how you order today. Any safety-rated gear gets its own review of the garment and the logo work.' },
 { n: '02', label: 'Program scope', body: 'We suggest the gear, what we need for your logo, and how ordering would work.' },
 { n: '03', label: 'Terms and controls', body: 'Your written proposal lists spending controls, user roles, minimums, fees, timing, and shipping.' },
 { n: '04', label: 'Approval and launch', body: 'You approve the products, the logo work, the terms, and the launch date before anything is made or ordered.' },
]

const included = [
 { label: 'Storefront options', body: 'A branded ordering page with your approved products and logo.' },
 { label: 'Approved catalog', body: 'You see each product and how the logo goes on before it goes in the store.' },
 { label: 'Ordering controls', body: 'We tell you in writing which budgets, permissions, and approvals you get before setup.' },
 { label: 'Fulfillment plan', body: 'Your written quote covers where gear ships, who holds inventory, and any minimums.' },
]

const timeline = [
 { row: 'Planning', meaning: 'We learn how you order', use: 'Roles, products, logo files, ordering, and safety requirements' },
 { row: 'Configuration', meaning: 'Catalog and written proposal', use: 'Store features, controls, pricing, minimums, and shipping' },
 { row: 'Approval', meaning: 'You sign off and pick a launch date', use: 'Product and logo approvals, schedule, testing, and who does what at launch' },
]

const whoFor = [
 { name: 'General contractors', detail: 'Role-based ordering so field, shop, and office crews each see the gear approved for them.' },
 { name: 'MEP subcontractors', detail: 'Mechanical, electrical, and plumbing teams each see the gear approved for their role.' },
 { name: 'Data center contractors', detail: 'One approved list keeps a large roster looking the same. Your safety lead still makes the PPE calls.' },
 { name: 'Multi-location trades', detail: 'The same products and the same logo at every location.' },
 { name: 'Fleet and field service', detail: 'HVAC, low-voltage, solar, and utility teams set gear by role and how fast it wears out.' },
 { name: 'Growing crews', detail: 'If you hire year-round, new hires order from the same approved list every time.' },
]

const faqs = [
 { q: 'How long does it take to set up a company store?', a: 'The number of products and how fast your logo files and approvals come back move the date most. Give us a target and we’ll put a schedule in writing.' },
 { q: 'Is there a minimum order to set up a company store?', a: 'The products and decoration methods set the minimums, and how the store ships determines whether anything sits in inventory. Your quote lists both.' },
 { q: 'What does it cost to run a company store?', a: 'You pay for the products, decoration, and shipping, plus any setup, platform, or transaction fees. They vary by program, so you get them in writing before you approve setup.' },
 { q: 'Who manages sizes, reorders, and new hires?', a: 'Tell us who you want managing it. We’ll put in writing what your store can do for new users, reorders, and allowances before setup.' },
 { q: 'Can we control what employees order and how much they spend?', a: 'They only see what you approve. For role, budget, and approval limits, your proposal says which ones your store supports.' },
 { q: 'Do we have to do any IT work to set up the store?', a: 'Tell us if you want it connected to another system. We’ll tell you in writing what we need from your side.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Company Stores', item: 'https://bighornthreads.com/company-stores/' },
 { '@type': 'ListItem', position: 3, name: 'Setup Guide for Las Vegas Trades', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Company Store Setup for Las Vegas Trades',
 serviceType: 'Company Stores',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/company-stores/setup-guide-las-vegas/',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/company-stores/" class="hover:text-gold-700">Company Stores</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Setup Guide</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Setup Guide
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Company Store Planning for Trades in Las Vegas. <span class="text-gold-700">Scoped around your crew.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 You get one contact in Las Vegas, and production partners make the gear. Timing, minimums, and fees all come to you in writing.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Liftable answer — AEO definition block, speakable -->
 <section class="border-b border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-4">The Short Answer</p>
 <p class="speakable-answer text-lg leading-relaxed text-ash">
 Setting up a company store takes four steps: a call about your crew, a proposed list of gear, a written proposal with fees and timing, and your sign-off. Bighorn Threads runs all of it for trades in Las Vegas and across the US.
 </p>
 </div>
 </section>

 <!-- Setup steps — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How Setup Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Company store setup for Las Vegas trades, step by step.</h2>
 </div>

 <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {steps.map((s) => (
 <li class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="mb-4 block font-heading text-5xl font-extrabold leading-none text-gold-500">{s.n}</span>
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </li>
 ))}
 </ol>
 </div>
 </section>

 <!-- Timeline table — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Timeline</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From kickoff to <span class="text-gold-600">crew ordering.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Every store goes through these three stages. Your proposal has the dates.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Stage</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What Happens</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">The Work</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {timeline.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- What's included — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What's Included</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What goes into your store.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {included.map((i) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{i.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{i.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Who it's for — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Who It's For</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Built for Las Vegas trades that hire and reorder all year.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {whoFor.map((w) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{w.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{w.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 What company store setup actually takes for a Vegas trade.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A company store is a private branded site where your team orders the products you approved. Payment, approvals, and inventory come down to the setup we agree on.
 </p>
 <p>
 The first call covers your roles, what each one wears, how you order, and your logo. Then we propose the products and how the logo goes on each one. Safety-rated garments get a separate written review.
 </p>
 <p>
 If you want to cap what each person spends, ask about credits, role-based catalogs, approval rules, and reports early. We’ll confirm which ones you get before the store is built.
 </p>
 <p>
 Who holds inventory, ships orders, and answers employee questions varies by store, so we write it down before setup begins. For a broader comparison, see our <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company stores overview</a> and our guide on <a href="/blog/company-store-vs-bulk-ordering/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company stores versus bulk ordering</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Setup questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — concrete -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores Overview</h3>
 <p class="mt-2 text-sm text-ash">How a store works, who needs one, and what to ask.</p>
 </a>
 <a href="/industries/data-center-contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Data Center Contractors</h3>
 <p class="mt-2 text-sm text-ash">Planning considerations for large rosters and fast hiring.</p>
 </a>
 <a href="/catalog/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Catalog</h3>
 <p class="mt-2 text-sm text-ash">Browse apparel categories and request a product-specific quote.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to set up your company store?</h2>
 <p class="mb-8 text-lg text-white/80">Tell us your crew size, trades, and ordering needs. We’ll tell you what we’d set up.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
