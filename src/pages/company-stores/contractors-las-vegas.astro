---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Company Store for Contractors in Las Vegas | Bighorn Threads',
 description:
 'A private online store for your Las Vegas construction or trades crews. Your people pick their own sizes, and you know the cost and who does what before launch.',
 url: 'https://bighornthreads.com/company-stores/contractors-las-vegas/',
}

const stack = [
 { label: 'Proposed catalog', body: 'List the garments and logo options you want. We tell you in writing what’s available and suggest swaps for anything that isn’t.' },
 { label: 'Ordering requirements', body: 'Tell us who orders, who approves, and who pays. Your proposal says what the store can do.' },
 { label: 'Budget requirements', body: 'Ask for the allowances, role limits, and reports you want. We check the store can do them before we promise anything.' },
 { label: 'Operating responsibilities', body: 'The written terms say who handles inventory, production, shipping, support, and admin.' },
]

const steps = [
 { num: '01', title: 'Tell us about your crew', body: 'Send your logo, the gear you want, who will order, and your locations.' },
 { num: '02', title: 'Check the store', body: 'We check access, budgets, payment, and reports before you approve anything.' },
 { num: '03', title: 'Decide who does what', body: 'We write down who handles inventory, production, shipping, user support, and changes.' },
 { num: '04', title: 'Approve the proposal', body: 'You review pricing, responsibilities, testing, and launch conditions before any store is built.' },
]

const faqs = [
 { q: 'What is a company store for a construction company?', a: 'A private online store with your approved gear, where crew members order their own sizes. You stop collecting sizes from every foreman.' },
 { q: 'How do I plan a company store for my Las Vegas crew?', a: 'Send us your logo, the gear you want, who will order, and your locations. We’ll write a proposal that says what it costs and who does what.' },
 { q: 'Is a company store better than bulk ordering?', a: 'If you know the quantity and it’s a one-time order, buy in bulk. If you hire often or reorder by role, a store usually saves more work. Compare fees and who holds inventory before you choose.' },
 { q: 'Can the store carry ANSI hi-vis and FR-rated gear?', a: 'Yes, once your safety lead sets the requirements. You approve each exact garment, and the logo goes on only the way the manufacturer’s instructions allow.' },
 { q: 'How is this different from a uniform rental program?', a: 'With a store, you generally own what you buy. A rental program usually bundles laundry and replacement into a recurring bill. Compare the written terms and the total cost for your crew.' },
 { q: 'Can you scope a store concept for other trades?', a: 'Yes. Electrical, plumbing, HVAC, and other field teams can all use one. Tell us your roles and we’ll suggest the gear.' },
 { q: 'Where does Bighorn offer company stores?', a: 'We’re based in Las Vegas and ship anywhere in the US. Your proposal covers pickup and shipping.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Company Stores', item: 'https://bighornthreads.com/company-stores/' },
 { '@type': 'ListItem', position: 3, name: 'For Contractors in Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Company Stores for Las Vegas Contractors',
 serviceType: 'Online company stores for contractor apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/company-stores/" class="hover:text-gold-700">Company Stores</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">For Contractors</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Company Stores for Contractors
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Plan a company store for your Las Vegas crew.
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 A private online store for your crew's approved gear. Before it goes live, you know who handles ordering, inventory, and shipping.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/demo/" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 See a demo store
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Liftable answer -->
 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="speakable-answer text-xl leading-relaxed text-charcoal sm:text-2xl">
 A company store lets crew members order their own approved gear. Our proposal lists the catalog, the fees, and who does what.
 </p>
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What to Scope</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Settle these before the store opens.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- How it works -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From your crew list to a written proposal.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {steps.map((s) => (
 <div class="border border-hairline bg-panel p-6">
 <div class="mb-3 font-mono text-sm font-bold text-gold-600">{s.num}</div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 When a contractor should compare a store with bulk ordering.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Ordering by hand means extra work on sizes, approvals, storage, and reorders. If those are eating your office’s time, a store is worth pricing.
 </p>
 <p>
 With a store, crews order approved gear directly. Your safety lead still decides which protective garments go in and who wears them.
 </p>
 <p>
 A store and a uniform rental handle ownership, replacement, and billing differently, so compare the written terms side by side.
 </p>
 <p>
 You get a Las Vegas contact, and production partners do the decoration. Your proposal names who handles the store, inventory, shipping, and support.
 </p>
 <p>
 For the strategic side of bulk versus store, read our <a href="/blog/company-store-vs-bulk-ordering/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store vs bulk ordering</a> breakdown. To plan what each role needs, see <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how to outfit a construction crew in Las Vegas</a> and <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how many shirts per crew member</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Company store questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">How Company Stores Work</h3>
 <p class="mt-2 text-sm text-ash">What it is, what it costs, and when you need one.</p>
 </a>
 <a href="/industries/construction-trades/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Construction & Trades</h3>
 <p class="mt-2 text-sm text-ash">Branded workwear and crew programs for Vegas trades.</p>
 </a>
 <a href="/custom-safety-vests-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Safety Vests</h3>
 <p class="mt-2 text-sm text-ash">Hi-vis vests with your logo, in the class your job calls for.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Want a store plan for your crew?</h2>
 <p class="mb-8 text-lg text-white/80">Send your logo, the gear you want, who will order, and your locations.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
