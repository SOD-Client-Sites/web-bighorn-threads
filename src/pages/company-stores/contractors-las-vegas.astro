---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Company Store for Contractors in Las Vegas | Bighorn Threads',
 description:
 'Scope a proposed company store for your Las Vegas construction or trades company. Confirm platform, catalog, ordering, inventory, fulfillment, and administration before launch.',
 hero: '/images/generated/service-branded-apparel.jpg',
 url: 'https://bighornthreads.com/company-stores/contractors-las-vegas/',
}

const stack = [
 { label: 'Proposed catalog', body: 'Scope the garments and decoration options you want reviewed. Product availability and substitutions need written confirmation.' },
 { label: 'Ordering requirements', body: 'Define users, size selection, approvals, and payment. The proposal confirms what the selected platform supports.' },
 { label: 'Budget requirements', body: 'Request allowances, roles, limits, and reporting. These features remain conditional until the platform configuration is verified.' },
 { label: 'Operating responsibilities', body: 'Assign inventory, production, shipping, support, and administration in the written program terms.' },
]

const steps = [
 { num: '01', title: 'Define the request', body: 'Send your logo, proposed products, users, locations, and ordering requirements.' },
 { num: '02', title: 'Verify the platform', body: 'Confirm supported access, budget, payment, reporting, and administrative features before approval.' },
 { num: '03', title: 'Assign operations', body: 'Document who handles inventory, production, shipping, user support, changes, and account administration.' },
 { num: '04', title: 'Approve the proposal', body: 'Review pricing, responsibilities, acceptance tests, and launch conditions before any store is built.' },
]

const faqs = [
 { q: 'What is a company store for a construction company?', a: 'A company store is a possible online ordering model for an approved apparel program. Verify the platform, catalog, users, payment, inventory, production, shipping, reporting, and administration before launch.' },
 { q: 'How do I plan a company store for my Las Vegas crew?', a: 'Send Bighorn Threads your logo, proposed gear, users, locations, and ordering requirements. We can scope a proposal after the platform and operating responsibilities are verified.' },
 { q: 'Is a company store better than bulk ordering?', a: 'Bulk ordering can fit a known one-time quantity. A store may fit recurring or role-based orders. Compare setup, inventory, payment, fulfillment, fees, and administration before choosing.' },
 { q: 'Can the store carry ANSI hi-vis and FR-rated gear?', a: 'A proposed catalog can include protective garments after the employer identifies its requirements through a current hazard assessment and project rules. The employer must review each exact product and decoration against the manufacturer’s current written instructions and documentation before approval.' },
 { q: 'How is this different from a uniform rental program?', a: 'A managed company store and a rental program can use different ownership, replacement, service, and billing models. Compare the written terms and total program cost for your specific crew.' },
 { q: 'Can you scope a store concept for other trades?', a: 'Bighorn can discuss proposed catalogs for electrical, plumbing, HVAC, and other field teams. The platform, service area, products, and operating terms must be verified in the proposal.' },
 { q: 'Where does Bighorn offer company stores?', a: 'Bighorn Threads is based in Las Vegas. Service area, pickup, production, shipping, and fulfillment terms are confirmed in each proposal.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Company Stores', item: 'https://bighornthreads.com/company-stores/' },
 { '@type': 'ListItem', position: 3, name: 'For Contractors in Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Company Stores for Las Vegas Contractors',
 serviceType: 'Planning for a proposed online company store for contractor apparel',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <a href="/company-stores/" class="hover:text-gold-400">Company Stores</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">For Contractors</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Company Stores for Contractors
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Plan a company store for your Las Vegas crew <span class="text-gold-400">with responsibilities defined first.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn can scope a proposed storefront. Platform features, ordering, inventory, fulfillment, and administration require written verification before launch.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="/demo/" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 Request a demo concept
 </a>
 </div>
 </div>
 </section>

 <!-- Liftable answer -->
 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="speakable-answer text-xl leading-relaxed text-charcoal sm:text-2xl">
 A company store is one possible ordering model for contractor apparel. Bighorn can scope a proposal after the platform, catalog, operations, fees, and responsibilities are verified.
 </p>
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What to Scope</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Define the program before any store launch.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- How it works -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From requirements to a written proposal.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {steps.map((s) => (
 <div class="border border-hairline bg-panel p-6">
 <div class="mb-3 font-mono text-sm font-bold text-gold-600">{s.num}</div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 When a contractor should compare a store with bulk ordering.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Manual ordering can create extra work around sizes, approvals, storage, and reorders. Document those problems before choosing a bulk or store model.
 </p>
 <p>
 A company store may change the ordering path if the selected platform supports the required workflow. Inclusion does not establish that a garment is appropriate for a worker or task. Inventory, production, shipping, support, and reorder review depend on written terms.
 </p>
 <p>
 A store and a uniform rental program can assign ownership, replacement, service, and billing differently. Compare the complete written terms. Employers remain responsible for protective-apparel selection and approval.
 </p>
 <p>
 Bighorn provides a Las Vegas account contact and can coordinate quoted decoration through production partners. The proposal must identify who manages the platform, catalog, users, inventory, fulfillment, and support.
 </p>
 <p>
 For the strategic side of bulk versus store, read our <a href="/blog/company-store-vs-bulk-ordering/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store vs bulk ordering</a> breakdown. To plan what each role needs, see <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how to outfit a construction crew in Las Vegas</a> and <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how many shirts per crew member</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Company store questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">How Company Stores Work</h3>
 <p class="mt-2 text-sm text-ash">Questions to settle for the platform, ordering, fulfillment, and administration.</p>
 </a>
 <a href="/industries/construction-trades/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Construction & Trades</h3>
 <p class="mt-2 text-sm text-ash">Branded workwear and crew programs for Vegas trades.</p>
 </a>
 <a href="/custom-safety-vests-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Safety Vests</h3>
 <p class="mt-2 text-sm text-ash">Plan a hi-vis selection using the employer's hazard assessment and the exact product's current manufacturer documentation.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to scope a company-store concept?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo, proposed products, users, locations, and ordering requirements.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
