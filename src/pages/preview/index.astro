---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { demoProducts } from '@/data/demoCatalog'
---

<BaseLayout
 title="Your Branded Apparel Store — Bighorn Threads"
 description="Private preview of what your company's branded apparel store would look like. Powered by Bighorn Threads."
 canonical="https://bighornthreads.com/preview/"
 noindex={true}
>
 <script id="demo-products" type="application/json" set:html={JSON.stringify(demoProducts)} />

 <!-- Loading -->
 <section id="preview-loading" class="flex min-h-[70vh] items-center justify-center bg-concrete px-4 py-24">
 <div class="text-center">
 <div class="mx-auto mb-4 h-8 w-8 animate-pulse rounded-full bg-gold-500/60"></div>
 <p class="font-mono text-xs font-bold uppercase tracking-[0.3em] text-gold-600">Building your store…</p>
 </div>
 </section>

 <!-- Not found -->
 <section id="preview-notfound" class="hidden min-h-[70vh] items-center justify-center bg-concrete px-4 py-24">
 <div class="max-w-xl text-center">
 <p class="mb-3 font-mono text-xs font-bold uppercase tracking-[0.3em] text-gold-600">Preview Not Found</p>
 <h1 class="mb-5 font-heading text-4xl font-extrabold uppercase tracking-tight text-charcoal sm:text-5xl">This link's expired or invalid.</h1>
 <a href="/demo/" class="btn-primary text-base">Build a New Preview</a>
 </div>
 </section>

 <!-- Store -->
 <div id="preview-content" class="hidden bg-white text-charcoal">

 <!-- Store header -->
 <header class="border-b border-hairline bg-white">
 <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
 <div class="flex items-center gap-3">
 <div id="store-logo" class="flex h-11 w-11 shrink-0 items-center justify-center rounded border border-hairline bg-white font-heading text-base font-bold text-charcoal">
 <span id="store-logo-initials">—</span>
 </div>
 <div>
 <h1 id="store-title" class="font-heading text-base font-bold uppercase leading-tight tracking-tight text-charcoal sm:text-lg"></h1>
 <p class="font-mono text-[9px] uppercase tracking-[0.25em] text-ash">Powered by <a href="/" class="text-gold-600 hover:text-gold-700">Bighorn Threads</a></p>
 </div>
 </div>
 <button id="cart-btn" type="button" class="relative flex items-center gap-2 rounded border border-hairline px-3 py-2 font-mono text-[11px] font-bold uppercase tracking-wider text-charcoal transition-colors hover:border-gold-500">
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
 Cart <span id="cart-count">0</span>
 </button>
 </div>
 </header>

 <!-- Store name band -->
 <div class="border-b border-hairline bg-concrete">
 <div class="mx-auto max-w-5xl px-4 py-4 sm:px-6">
 <p class="font-mono text-[10px] font-bold uppercase tracking-[0.25em] text-gold-600">Company Store · 2026</p>
 <p id="store-band-name" class="font-heading text-xl font-bold uppercase tracking-tight text-charcoal sm:text-2xl"></p>
 </div>
 </div>

 <!-- ===================== STORE (grid) view ===================== -->
 <main id="view-store" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
 <h2 class="mb-5 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">Featured Gear</h2>
 <div class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
 {demoProducts.map((p) => (
 <button type="button" data-open-product={p.id} class="group flex flex-col overflow-hidden rounded border border-hairline bg-white text-left transition-shadow hover:shadow-lg hover:shadow-charcoal/5">
 <div class="aspect-square overflow-hidden bg-white">
 <img src={p.image} alt={p.name} loading="lazy" decoding="async" width="512" height="512" class="h-full w-full object-contain p-2 transition-transform duration-500 group-hover:scale-105" />
 </div>
 <div class="flex flex-1 flex-col gap-1 border-t border-hairline p-3">
 <h3 class="line-clamp-2 font-heading text-sm font-semibold leading-snug tracking-tight text-charcoal">{p.name}</h3>
 <div class="mt-auto flex items-center justify-between pt-1">
 <span class="font-mono text-base font-bold text-charcoal">${p.price.toFixed(2)}</span>
 <span class="font-mono text-[10px] uppercase tracking-wider text-ash">{p.colors.length} colors</span>
 </div>
 </div>
 </button>
 ))}
 </div>
 <p class="mt-8 text-center font-mono text-[11px] uppercase tracking-[0.15em] text-ash">Sample store · your real gear & pricing are curated for your crew</p>
 </main>

 <!-- ===================== PRODUCT (PDP) view ===================== -->
 <main id="view-product" class="mx-auto hidden max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
 <button id="pdp-back" type="button" class="mb-5 inline-flex items-center gap-2 font-mono text-[11px] font-bold uppercase tracking-wider text-ash transition-colors hover:text-gold-600">
 <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
 Back to store
 </button>
 <div class="grid gap-8 lg:grid-cols-2">
 <div class="overflow-hidden rounded border border-hairline bg-white">
 <img id="pdp-image" src="" alt="" width="800" height="800" class="aspect-square w-full object-contain p-4" />
 </div>
 <div>
 <h2 id="pdp-name" class="font-heading text-2xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-3xl"></h2>
 <p id="pdp-price" class="mt-3 font-mono text-2xl font-bold text-charcoal"></p>

 <div class="mt-6 space-y-4">
 <div>
 <label for="pdp-color" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Color</label>
 <select id="pdp-color" class="w-full rounded border border-hairline bg-white px-4 py-2.5 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"></select>
 </div>
 <div>
 <label for="pdp-size" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Size</label>
 <select id="pdp-size" class="w-full rounded border border-hairline bg-white px-4 py-2.5 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"></select>
 </div>
 <div>
 <label for="pdp-qty" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Quantity</label>
 <div class="flex items-center gap-2">
 <button id="pdp-minus" type="button" aria-label="Decrease quantity" class="flex h-11 w-11 items-center justify-center rounded border border-hairline text-lg font-bold text-charcoal hover:border-gold-500">−</button>
 <input id="pdp-qty" type="number" min="1" max="999" value="1" inputmode="numeric" class="h-11 w-20 rounded border border-hairline bg-white text-center text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25" />
 <button id="pdp-plus" type="button" aria-label="Increase quantity" class="flex h-11 w-11 items-center justify-center rounded border border-hairline text-lg font-bold text-charcoal hover:border-gold-500">+</button>
 </div>
 </div>
 </div>

 <button id="pdp-add" type="button" class="btn-primary mt-6 w-full justify-center text-base">Add to Cart</button>
 <p id="pdp-added" class="mt-3 hidden text-center font-mono text-[11px] font-bold uppercase tracking-wider text-gold-700"></p>

 <div class="mt-8 border-t border-hairline pt-5">
 <h3 class="mb-3 font-heading text-sm font-bold uppercase tracking-tight text-charcoal">Details</h3>
 <ul id="pdp-desc" class="space-y-2 text-sm text-ash"></ul>
 </div>
 </div>
 </div>
 </main>

 <!-- Convert CTA -->
 <section class="border-t border-hairline bg-navy-950 py-14 text-white sm:py-16">
 <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
 <p class="kicker mb-3 justify-center">Make This Real</p>
 <h2 class="mb-4 font-heading text-2xl font-extrabold uppercase tracking-tight text-white sm:text-3xl">Want <span id="cta-company"></span>'s real ordering store?</h2>
 <p class="mb-8 text-base leading-relaxed text-navy-200">Your info's already in. One click and Steve sets up your live store — your logo, your gear, your team ordering direct. About a week to go live.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
 <button id="convert-btn" type="button" class="btn-primary text-base">Make my store real</button>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">Or call 702.904.8923</a>
 </div>
 <p id="convert-done" class="mt-6 hidden font-mono text-[12px] font-bold uppercase tracking-wider text-gold-400"></p>
 </div>
 </section>

 <!-- Convert modal -->
 <div id="convert-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-charcoal/70 p-4" role="dialog" aria-modal="true" aria-labelledby="convert-modal-title">
 <div class="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-lg border border-hairline bg-white p-6 shadow-2xl sm:p-8">
 <div class="mb-1 flex items-start justify-between gap-4">
 <h3 id="convert-modal-title" class="font-heading text-xl font-extrabold uppercase tracking-tight text-charcoal">Make my store real</h3>
 <button id="convert-close" type="button" aria-label="Close" class="text-ash hover:text-charcoal"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
 </div>
 <p class="mb-5 text-sm text-ash">Confirm your details and tell us anything specific. Steve builds your live ordering store — usually within a week.</p>

 <form id="convert-form" class="space-y-4" novalidate>
 <div class="grid gap-4 sm:grid-cols-2">
 <div>
 <label for="cf-company" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Company *</label>
 <input id="cf-company" name="company" type="text" required maxlength="80" class="w-full rounded border border-hairline bg-white px-3 py-2 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25" />
 </div>
 <div>
 <label for="cf-contact" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Your name *</label>
 <input id="cf-contact" name="contact" type="text" required maxlength="80" class="w-full rounded border border-hairline bg-white px-3 py-2 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25" />
 </div>
 <div>
 <label for="cf-email" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Email *</label>
 <input id="cf-email" name="email" type="email" required maxlength="120" class="w-full rounded border border-hairline bg-white px-3 py-2 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25" />
 </div>
 <div>
 <label for="cf-phone" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Phone</label>
 <input id="cf-phone" name="phone" type="tel" maxlength="20" class="w-full rounded border border-hairline bg-white px-3 py-2 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25" />
 </div>
 </div>
 <div>
 <label for="cf-notes" class="mb-1 block font-mono text-[11px] font-bold uppercase tracking-[0.15em] text-gold-700">Notes <span class="text-ash">(optional)</span></label>
 <textarea id="cf-notes" name="notes" rows="4" maxlength="2000" placeholder="Logo placement, colors, which gear, timeline, budget per employee, anything else…" class="w-full rounded border border-hairline bg-white px-3 py-2 text-base text-charcoal focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-500/25"></textarea>
 </div>

 <!-- Honeypot -->
 <div class="absolute -left-[9999px]" aria-hidden="true">
 <label for="cf-hp">Leave blank</label>
 <input id="cf-hp" type="text" name="bh_hp_field" tabindex="-1" autocomplete="off" />
 </div>

 <div class="cf-turnstile" data-sitekey="0x4AAAAAADW_K97ZyhlAHC4I" data-theme="light"></div>

 <button id="convert-submit" type="submit" class="btn-primary w-full justify-center text-base disabled:cursor-not-allowed disabled:opacity-60">
 <span id="convert-submit-label">Send my request</span>
 </button>
 <p id="convert-error" class="hidden text-center text-sm font-medium text-red-600"></p>
 </form>

 <div id="convert-success" class="hidden py-4 text-center">
 <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gold-500/20"><svg class="h-6 w-6 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
 <h3 class="mb-1 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">Request sent</h3>
 <p id="convert-success-msg" class="text-sm text-ash"></p>
 <button id="convert-done-btn" type="button" class="mt-5 inline-flex items-center gap-2 border border-hairline px-5 py-2 font-mono text-[11px] font-bold uppercase tracking-wider text-charcoal hover:border-gold-500">Close</button>
 </div>
 </div>
 </div>
 </div>
</BaseLayout>

<script>
 type Lead = { company: string; contact: string; email: string; phone: string | null; trade: string; crewSize: number | null; logoDataUrl?: string | null }
 type Payload = { v: number; createdAt: string; lead: Lead }
 type Product = { id: string; name: string; price: number; image: string; colors: string[]; sizes: string[]; description: string[] }

 const $ = (id: string) => document.getElementById(id)
 const products: Product[] = JSON.parse($('demo-products')?.textContent || '[]')

 function decodeSlug(s: string): Payload | null {
 try {
 const b64 = s.replace(/-/g, '+').replace(/_/g, '/')
 const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4)
 const data = JSON.parse(decodeURIComponent(escape(atob(padded))))
 return data?.lead?.company ? (data as Payload) : null
 } catch { return null }
 }
 const initials = (n: string) => n.trim().split(/\s+/).slice(0, 2).map((w) => w[0] || '').join('').toUpperCase() || '—'
 const setText = (id: string, t: string) => { const el = $(id); if (el) el.textContent = t }

 function putLogo(slot: HTMLElement, dataUrl: string, company: string, className: string) {
 while (slot.firstChild) slot.removeChild(slot.firstChild)
 const img = document.createElement('img')
 img.src = dataUrl; img.alt = `${company} logo`; img.className = className
 slot.appendChild(img)
 }

 const slug = new URLSearchParams(location.search).get('s')
 const data = slug ? decodeSlug(slug) : null

 if (!data) {
 $('preview-loading')?.classList.add('hidden')
 $('preview-notfound')?.classList.remove('hidden')
 $('preview-notfound')?.classList.add('flex')
 } else {
 const { lead } = data
 document.title = `${lead.company} — Branded Apparel Store · Bighorn Threads`
 setText('store-title', `${lead.company} Store`)
 setText('store-band-name', `${lead.company} Company Store`)
 setText('cta-company', lead.company)
 const logoBox = $('store-logo')
 if (lead.logoDataUrl && logoBox) putLogo(logoBox, lead.logoDataUrl, lead.company, 'h-full w-full rounded object-contain p-1')
 else setText('store-logo-initials', initials(lead.company))

 $('preview-loading')?.classList.add('hidden')
 $('preview-content')?.classList.remove('hidden')

 // ---- cart (fake) ----
 let cart = 0
 const bumpCart = (n: number) => { cart += n; setText('cart-count', String(cart)) }
 $('cart-btn')?.addEventListener('click', () => {
 flash($('convert-done'), cart ? `${cart} item${cart === 1 ? '' : 's'} in cart — checkout goes live when your real store is set up.` : 'Your cart is empty — this is a sample store.')
 $('convert-done')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
 })

 // ---- product detail ----
 const storeView = $('view-store'), productView = $('view-product')
 const option = (v: string) => { const o = document.createElement('option'); o.value = v; o.textContent = v; return o }

 function openProduct(id: string) {
 const p = products.find((x) => x.id === id); if (!p) return
 ;($('pdp-image') as HTMLImageElement).src = p.image
 ;($('pdp-image') as HTMLImageElement).alt = p.name
 setText('pdp-name', p.name)
 setText('pdp-price', `$${p.price.toFixed(2)}`)
 const color = $('pdp-color') as HTMLSelectElement, size = $('pdp-size') as HTMLSelectElement
 color.replaceChildren(...p.colors.map(option))
 size.replaceChildren(...p.sizes.map(option))
 ;($('pdp-qty') as HTMLInputElement).value = '1'
 $('pdp-added')?.classList.add('hidden')
 const desc = $('pdp-desc'); if (desc) desc.replaceChildren(...p.description.map((d) => { const li = document.createElement('li'); li.className = 'flex gap-2'; li.innerHTML = '<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500"></span>'; li.appendChild(document.createTextNode(d)); return li }))
 storeView?.classList.add('hidden'); productView?.classList.remove('hidden')
 window.scrollTo({ top: 0, behavior: 'smooth' })
 }
 function closeProduct() { productView?.classList.add('hidden'); storeView?.classList.remove('hidden') }

 document.querySelectorAll<HTMLElement>('[data-open-product]').forEach((el) => el.addEventListener('click', () => openProduct(el.dataset.openProduct!)))
 $('pdp-back')?.addEventListener('click', closeProduct)

 const qtyEl = () => $('pdp-qty') as HTMLInputElement
 const clampQty = () => { const q = Math.max(1, Math.min(999, parseInt(qtyEl().value || '1', 10) || 1)); qtyEl().value = String(q); return q }
 $('pdp-minus')?.addEventListener('click', () => { qtyEl().value = String(Math.max(1, clampQty() - 1)) })
 $('pdp-plus')?.addEventListener('click', () => { qtyEl().value = String(Math.min(999, clampQty() + 1)) })
 qtyEl()?.addEventListener('change', clampQty)

 $('pdp-add')?.addEventListener('click', () => {
 const q = clampQty()
 bumpCart(q)
 const added = $('pdp-added')
 if (added) { added.textContent = `Added ${q} to cart ✓`; added.classList.remove('hidden') }
 })

 // ---- convert modal (info prefilled; they can add notes) ----
 const modal = $('convert-modal')
 const setVal = (id: string, v: string) => { const el = $(id) as HTMLInputElement | null; if (el) el.value = v }
 const openModal = () => {
 setVal('cf-company', lead.company || ''); setVal('cf-contact', lead.contact || '')
 setVal('cf-email', lead.email || ''); setVal('cf-phone', lead.phone || '')
 $('convert-form')?.classList.remove('hidden'); $('convert-success')?.classList.add('hidden')
 modal?.classList.remove('hidden'); modal?.classList.add('flex'); document.body.style.overflow = 'hidden'
 }
 const closeModal = () => { modal?.classList.add('hidden'); modal?.classList.remove('flex'); document.body.style.overflow = '' }
 $('convert-btn')?.addEventListener('click', openModal)
 $('convert-close')?.addEventListener('click', closeModal)
 $('convert-done-btn')?.addEventListener('click', closeModal)
 modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal() })

 $('convert-form')?.addEventListener('submit', async (e) => {
 e.preventDefault()
 const form = e.target as HTMLFormElement
 const btn = $('convert-submit') as HTMLButtonElement
 const errEl = $('convert-error')
 errEl?.classList.add('hidden')
 if (!form.checkValidity()) { form.reportValidity(); return }
 btn.disabled = true; setText('convert-submit-label', 'Sending…')
 const fd = new FormData(form)
 const payload = {
 company: String(fd.get('company') || ''), contact: String(fd.get('contact') || ''),
 email: String(fd.get('email') || ''), phone: String(fd.get('phone') || ''),
 trade: lead.trade || '', crewSize: lead.crewSize || null,
 notes: String(fd.get('notes') || ''), bh_hp_field: String(fd.get('bh_hp_field') || ''),
 previewUrl: location.href,
 'cf-turnstile-response': (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value || '',
 }
 try {
 const res = await fetch('/api/convert-request', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
 const data = await res.json().catch(() => ({}))
 if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`)
 setText('convert-success-msg', `Thanks, ${lead.contact.split(' ')[0] || 'we got it'} — Steve will reach out to build ${lead.company}'s store.`)
 form.classList.add('hidden'); $('convert-success')?.classList.remove('hidden')
 } catch (_) {
 if (errEl) { errEl.textContent = 'Something went wrong. Please try again or call 702.904.8923.'; errEl.classList.remove('hidden') }
 btn.disabled = false; setText('convert-submit-label', 'Send my request')
 }
 })

 function flash(el: HTMLElement | null, msg: string) { if (!el) return; el.textContent = msg; el.classList.remove('hidden') }
 }
</script>
