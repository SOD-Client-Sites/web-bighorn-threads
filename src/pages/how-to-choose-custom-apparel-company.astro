---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'How to Choose a Custom Apparel Company | 6-Point Checklist | Bighorn Threads',
 description:
 'Six criteria to evaluate any custom apparel company: production accountability, artwork quality, minimums, written timing, garment suitability, and reorders.',
 hero: '/images/generated/hero-foreman.jpg',
 url: 'https://bighornthreads.com/how-to-choose-custom-apparel-company/',
}

const criteria = [
 { num: '01', title: 'Production accountability', body: 'Ask who manages your order and who performs each production step. A good provider explains its model, names your accountable contact, and documents the approved specification.' },
 { num: '02', title: 'Digitizing review', body: 'Embroidery requires a stitch file prepared for the exact artwork, garment, size, backing, hooping, machine, and placement. Ask for a proof or sample and approve the production-specific treatment.' },
 { num: '03', title: 'Minimum-order flexibility', body: 'Ask for the minimum by garment and decoration method. Also ask whether a small reorder can use a different method or pricing structure instead of waiting for a larger batch.' },
 { num: '04', title: 'Written timing', body: 'Get the current production timing in writing for your exact garment, artwork, quantity, and delivery requirements.' },
 { num: '05', title: 'Protective-apparel process', body: 'The employer selects protective apparel. Require current manufacturer approval for the exact decoration method and placement before production; a shop cannot certify the complete workplace PPE system.' },
 { num: '06', title: 'Reorder process', body: 'Ask which artwork and production specifications remain available. Also ask what must be reviewed again when products or requirements change.' },
]

const faqs = [
 { q: 'How do I choose the right custom apparel company?', a: 'Evaluate each company on production accountability, artwork quality, minimums, written timing, garment suitability, and reorders. Ask every provider to quote the same order specification.' },
 { q: "What's the biggest red flag when picking a custom apparel vendor?", a: 'A vendor that cannot explain who manages the order, who performs production, and who owns problems. Transparent providers document the process before you approve it.' },
 { q: 'Should I ask for a physical sample before placing a full order?', a: 'Ask what proof or sample options are available for your order. Confirm any related cost, timing, and approval terms in writing.' },
 { q: 'Does a lower price always mean lower quality?', a: 'No. Compare itemized quotes against the same garment, artwork, decoration, quantity, timing, and reorder terms. Price alone does not explain the complete order.' },
 { q: 'How important is a local account contact?', a: 'A local contact can make requirement reviews and communication easier. Production location alone does not guarantee timing or quality. Compare the complete process in writing.' },
 { q: 'What questions should I ask before signing a contract with an apparel vendor?', a: 'Ask who manages the order, who performs production, what the current minimum and timing are, how artwork approval works, and how reorders are reviewed.' },
]

const leadAnswer = 'Choose a custom apparel company on six criteria: production accountability, artwork quality, minimums, written timing, garment suitability, and the reorder process. Use the same order specification for every provider.'

const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'How to Choose a Custom Apparel Company', item: page.url },
] }
const howToSchema = {
 '@context': 'https://schema.org',
 '@type': 'HowTo',
 name: 'How to Choose a Custom Apparel Company',
 description: 'Six criteria to evaluate any custom apparel vendor before placing an order.',
 step: criteria.map((c) => ({ '@type': 'HowToStep', name: c.title, text: c.body })),
}
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
---

<BaseLayout title={page.title} description={page.description} canonical={page.url} heroImage={page.hero}>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>
 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">How to Choose a Custom Apparel Company</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5"><span class="h-px w-8 bg-gold-500"></span>Buyer's Checklist</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Six questions <span class="text-gold-400">before you sign with any apparel vendor.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Production accountability, artwork, minimums, written timing, garment suitability, and reorders. Ask every provider the same six questions.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>

 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="speakable-answer text-xl leading-relaxed text-charcoal sm:text-2xl">
 {leadAnswer}
 </p>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Checklist</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six criteria, in order of impact.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
 {criteria.map((c) => (
 <div class="border border-hairline bg-panel p-6">
 <div class="mb-3 font-mono text-sm font-bold text-gold-600">{c.num}</div>
 <h3 class="mb-2 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">Why most apparel vendor comparisons miss the real risk.</h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Most buyers start with price per shirt. That number does not explain who owns the order, how artwork gets approved, or what happens when you reorder later.
 </p>
 <p>
 The six criteria above expose the details that price hides. Partner production can work well when the provider documents responsibilities, specifications, approvals, and timing. Poor artwork or unclear ownership creates avoidable risk in any production model.
 </p>
 <p>
 Bighorn Threads provides Las Vegas account management and coordinates <a href="/blog/embroidery-shop-las-vegas-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidery</a> and screen printing through production partners. See the <a href="/blog/logo-digitizing-101-embroidery/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">logo digitizing breakdown</a> for questions to ask about artwork. Minimums, timing, and garment requirements are confirmed for the specific order.
 </p>
 <p>
 On reorders, ask which artwork and production specifications remain available, whether the original garment is still available, and what must be reviewed again. Consistency depends on both the saved production information and the current materials.
 </p>
 <p>
 If you're vetting vendors right now, run this checklist against each one before you commit. <a href="/about/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">See how Bighorn Threads answers all six</a>, then compare.
 </p>
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Vendor selection questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/blog/logo-digitizing-101-embroidery/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Logo Digitizing 101</h3>
 <p class="mt-2 text-sm text-ash">What good digitizing looks like, and what bad looks like.</p>
 </a>
 <a href="/blog/embroidery-shop-las-vegas-guide/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidery Shop Guide</h3>
 <p class="mt-2 text-sm text-ash">What to look for in a Las Vegas embroidery shop.</p>
 </a>
 <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Minimum Order Quantities</h3>
 <p class="mt-2 text-sm text-ash">How MOQ flexibility actually plays out.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Run the checklist against us.</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo and garment list. We'll answer all six in writing.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
