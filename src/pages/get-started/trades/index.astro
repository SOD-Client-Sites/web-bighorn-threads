---
import LandingLayout from '@/layouts/LandingLayout.astro'
import LeadCaptureForm from '@/components/LeadCaptureForm.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
    { '@type': 'ListItem', position: 2, name: 'Get Started — Construction & Trades', item: 'https://bighornthreads.com/get-started/trades/' },
  ],
}

const problems = [
  {
    title: 'Chasing Sizes Across Crews.',
    desc: 'A foreman collects sizes on a notepad, a new hand starts, and the list starts over. Your supers turn into the size-collection department instead of running the job.',
  },
  {
    title: 'Hi-Vis Nobody Keeps.',
    desc: 'Cheap vests bought in bulk, wrong sizes, wrong class. They end up balled up in a truck bed instead of on your crew.',
  },
  {
    title: 'Brand Drift Across Suppliers.',
    desc: 'One crew’s shirts come from one shop, another’s from somewhere else. Logos drift, colors drift, and your company looks different on every site.',
  },
  {
    title: 'New-Hire Gear Done by Hand.',
    desc: 'Every new hand means a scramble for a shirt, a vest, and the right size before they’re cleared to be on site. It doesn’t scale with your headcount.',
  },
]

const storeSteps = [
  {
    n: '01',
    meta: 'Setup',
    title: 'We Build Your Store — Free',
    desc: 'Your logo, your colors, your approved workwear and hi-vis, your budget rules. We set up your branded crew store free and keep your logo on file so every reorder matches.',
  },
  {
    n: '02',
    meta: 'Ongoing',
    title: 'Your Crews Order Their Own Sizes',
    desc: 'Each person logs in, picks their own size, and submits. No notepads, no size-guessing, no group texts for your foremen to chase.',
  },
  {
    n: '03',
    meta: 'Ongoing',
    title: 'Ships Direct — You Control Budget',
    desc: 'Gear ships to the jobsite, the shop, or each person’s home. You cap spend per person, see every order in one place, and reorder in a click.',
  },
]

const offerings = [
  {
    title: 'Embroidered Hi-Vis & ANSI Safety',
    desc: 'Class 2 and Class 3 vests, hi-vis tees and hoodies, decorated with your logo and held on file for consistent reorders.',
    tag: 'Safety',
  },
  {
    title: 'Workwear That Holds Up',
    desc: 'Heavyweight tees, hoodies, work shirts, and jackets meant for the jobsite — branded, not bargain-bin.',
    tag: 'Workwear',
  },
  {
    title: 'Branded Outerwear',
    desc: 'Softshells, work jackets, and quarter-zips for crews and management. Your logo digitized once and kept on file.',
    tag: 'Outerwear',
  },
  {
    title: 'New-Hire Crew Kits',
    desc: 'A branded kit ready to ship the day a new hand starts. Shirt, hi-vis, the essentials — sized by them, not guessed by you.',
    tag: 'Onboarding',
  },
  {
    title: 'Headwear & Accessories',
    desc: 'Caps, beanies, hard-hat decals, and drinkware that keep your brand on every crew and every truck.',
    tag: 'Extras',
  },
]

const objections = [
  {
    q: 'What does "free" actually cover?',
    a: 'Free store setup and your first logo digitizing are on us. You only pay for the gear your crews order — nothing to set up, no monthly fee, no per-user fee.',
  },
  {
    q: 'Is there a minimum to start?',
    a: 'No. We build your store for outfits of every size. Small crew or large operation, your people order what they need, when they need it.',
  },
  {
    q: 'What about multiple crews or jobsites?',
    a: 'Each person picks their own size and ships to their own address. Multiple crews, multiple sites, and field hands all order the same way.',
  },
  {
    q: 'Can we cap how much each person spends?',
    a: 'Yes. You set a budget per person — a balance or a spend limit. People order within it, and you see every order in one place.',
  },
  {
    q: 'Who actually follows up?',
    a: 'A real person — Bighorn Threads, based in Las Vegas. Founder Steven Dodson answers the phone himself. No call center, no phone tree.',
  },
]
---

<LandingLayout
  title="Branded Crew Gear & Workwear — Free Store Setup | Bighorn Threads"
  description="Stop chasing sizes on the jobsite. We build your branded crew store free — your guys order their own sizes, hi-vis and workwear ship direct, you control the budget. Tell us about your crew."
  canonical="https://bighornthreads.com/get-started/trades/"
  noindex={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <!-- ════ HERO + FORM — concrete ════ -->
  <section class="min-h-[100svh] bg-concrete pt-16 pb-20 sm:pt-20 sm:pb-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">

        <!-- Left: pitch -->
        <div>
          <p class="kicker mb-3">Construction & Trades</p>
          <h1 class="mb-6 font-heading text-4xl font-extrabold uppercase leading-[1.05] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
            Outfit Every Crew — <span class="text-gold-600">Without Chasing a Single Size</span> on the Jobsite.
          </h1>
          <p class="mb-8 text-lg leading-relaxed text-ash sm:text-xl">
            We build your branded crew store free. Your guys order their own sizes, hi-vis and workwear
            ship direct, and you control the budget. No notepads, no truck-bed inventory.
          </p>

          <ul class="mb-8 space-y-3 text-base text-ash">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>
              <span><strong class="text-charcoal">Your crews order their own sizes</strong> — shipped to the jobsite or their home, so your foremen stop running the size list</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>
              <span><strong class="text-charcoal">Your logo stays on file</strong> — same hi-vis, same placement, every reorder, so your brand holds across every crew</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>
              <span><strong class="text-charcoal">You control the budget</strong> — cap spend per person and see every order in one place, so gear stops being a guessing game</span>
            </li>
          </ul>

          <p class="font-mono text-xs uppercase tracking-[0.15em] text-ash">No commitment · Free store setup · A real person follows up</p>
        </div>

        <!-- Right: form (sticky on desktop) -->
        <div class="lg:sticky lg:top-24">
          <LeadCaptureForm
            vertical="trades"
            heading="Get your crew gear plan"
            submitLabel="Build my crew gear plan →"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ════ THE PROBLEM — paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">The Problem</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Crew gear shouldn’t run <span class="text-gold-600">off a notepad.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          If you run the crews, you know the drill. Branded apparel and hi-vis turn into a list someone
          maintains by hand — and your brand pays for it.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {problems.map((item) => (
          <div class="border border-hairline bg-panel p-7">
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ HOW IT WORKS — concrete ════ -->
  <section class="bg-concrete py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl">
        <p class="kicker mb-3">How It Works</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          How a crew store works <span class="text-gold-600">for your outfit.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          Your logo on file, consistent reorders, and a store your crews run themselves. You set the
          budget. We handle the rest.
        </p>
      </div>

      <ol class="grid gap-5 md:grid-cols-3">
        {storeSteps.map((step) => (
          <li class="border border-hairline bg-panel p-7">
            <div class="mb-5 flex items-baseline justify-between">
              <span class="font-heading text-5xl font-extrabold leading-none text-gold-600">{step.n}</span>
              <span class="spec border border-hairline px-2 py-1 text-ash">{step.meta}</span>
            </div>
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{step.desc}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8">
        <a href="#lp-form-card" class="btn-secondary text-sm">
          Build my crew gear plan
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7-7 7 7M12 4v16" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════ WHAT YOU STOCK — paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">What You Stock</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          What you can put in <span class="text-gold-600">your store.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          Pick the gear that fits your crews and your brand. Stock as much or as little as you want —
          add and swap products any time.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {offerings.map((item) => (
          <div class="flex flex-col border border-hairline bg-panel p-6">
            <span class="spec mb-3 inline-block self-start border border-hairline px-2 py-1 text-ash">{item.tag}</span>
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ OBJECTIONS / TRUST — concrete ════ -->
  <section class="bg-concrete py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <p class="kicker mb-3">Straight Answers</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Your questions, <span class="text-gold-600">answered.</span>
        </h2>
      </div>

      <div class="divide-y divide-hairline border-y border-hairline">
        {objections.map((item) => (
          <details class="group">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
              <span class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.q}</span>
              <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </summary>
            <p class="pb-5 leading-relaxed text-ash">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ CLOSING CTA — charcoal band ════ -->
  <section class="border-y border-hairline bg-charcoal py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <p class="kicker mb-3">Get Started</p>
          <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-concrete sm:text-4xl">
            Ready to give your crews <span class="text-gold-400">a real company store?</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-navy-200">
            Free store setup. Your crews order their own sizes. A real Las Vegas person follows up. Tell
            us about your outfit and we’ll build your plan.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:items-end">
          <a href="#lp-form-card" class="btn-primary text-base">
            Build my crew gear plan
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7-7 7 7M12 4v16" /></svg>
          </a>
          <a href="tel:+17029048923" class="inline-flex items-center gap-2 font-mono text-sm font-medium tracking-wide text-concrete transition-colors hover:text-gold-400">
            <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            702.904.8923
          </a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
