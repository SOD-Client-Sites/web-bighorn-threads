---
import LandingLayout from '@/layouts/LandingLayout.astro'
import LeadCaptureForm from '@/components/LeadCaptureForm.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
    { '@type': 'ListItem', position: 2, name: 'Get Started — Construction & Trades', item: 'https://bighornthreads.com/get-started/trades/' },
  ],
}

const problems = [
  {
    title: 'Chasing Sizes Across Crews.',
    desc: 'A foreman collects sizes on a notepad, a new hand starts, and the list starts over. Your supers turn into the size-collection department instead of running the job.',
  },
  {
    title: 'Hi-Vis Nobody Keeps.',
    desc: 'A poor size plan can leave approved garments unused. Start with employer-selected products and current size information.',
  },
  {
    title: 'Brand Drift Across Suppliers.',
    desc: 'One crew’s shirts come from one shop, another’s from somewhere else. Logos drift, colors drift, and your company looks different on every site.',
  },
  {
    title: 'New-Hire Gear Done by Hand.',
    desc: 'Every new hire can create another manual size and apparel request. Document the process before selecting an ordering model.',
  },
]

const storeSteps = [
  {
    n: '01',
    meta: 'Setup',
    title: 'We Scope a Store Concept',
    desc: 'Bring your logo, proposed products, users, locations, and ordering rules. We’ll document the requirements for review.',
  },
  {
    n: '02',
    meta: 'Verify',
    title: 'Confirm the Ordering Flow',
    desc: 'Test user access, size selection, approvals, payment, notifications, and administration on the selected platform.',
  },
  {
    n: '03',
    meta: 'Terms',
    title: 'Assign Operating Responsibilities',
    desc: 'Confirm inventory, production, shipping, returns, support, reporting, costs, and administrators before launch.',
  },
]

const offerings = [
  {
    title: 'Employer-Selected Workwear',
    desc: 'Request quotes for products selected by the employer. Protective-apparel approval stays with the employer and manufacturer.',
    tag: 'Workwear',
  },
  {
    title: 'Workwear That Holds Up',
    desc: 'Compare current tees, hoodies, work shirts, and jackets by role, product specifications, availability, and quoted terms.',
    tag: 'Workwear',
  },
  {
    title: 'Branded Outerwear',
    desc: 'Compare softshells, work jackets, and quarter-zips. Bighorn coordinates approved decoration through selected production partners.',
    tag: 'Outerwear',
  },
  {
    title: 'New-Hire Crew Kits',
    desc: 'Scope a proposed kit around each new hire’s size and start date. Confirm availability, production, and delivery per order.',
    tag: 'Onboarding',
  },
  {
    title: 'Headwear & Accessories',
    desc: 'Compare caps, beanies, drinkware, and manufacturer-reviewed hard-hat decal proposals under current quoted terms.',
    tag: 'Extras',
  },
]

const objections = [
  {
    q: 'What does store setup cover?',
    a: 'The proposal must define the platform, artwork, products, users, inventory, fulfillment, administration, fees, and acceptance tests before any build.',
  },
  {
    q: 'Is there a minimum to start?',
    a: 'Store eligibility and product minimums depend on the approved program. Tell us your crew size so we can confirm the right setup.',
  },
  {
    q: 'What about multiple crews or jobsites?',
    a: 'A proposal can evaluate multiple users and locations. Access, ordering, service area, shipping, and related costs require verification.',
  },
  {
    q: 'Can we cap how much each person spends?',
    a: 'Per-person budgets or spend limits can be requested. Bighorn confirms supported controls and reporting in the proposal.',
  },
  {
    q: 'Who actually follows up?',
    a: 'The Las Vegas based Bighorn team follows up on your request. Call 702.904.8923 to reach the business directly.',
  },
]
---

<LandingLayout
  title="Branded Crew Gear and Workwear | Bighorn Threads"
  description="Scope a proposed crew-store program. Confirm the platform, products, users, ordering, inventory, fulfillment, and administration before launch."
  canonical="https://bighornthreads.com/get-started/trades/"
  noindex={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

  <!-- ════ HERO + FORM — concrete ════ -->
  <section class="min-h-[100svh] bg-concrete pt-16 pb-20 sm:pt-20 sm:pb-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">

        <!-- Left: pitch -->
        <div>
          <p class="kicker mb-3">Construction & Trades</p>
          <h1 class="mb-6 font-heading text-4xl font-extrabold uppercase leading-[1.05] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
            Plan Crew Apparel <span class="text-gold-600">With the Ordering Rules Defined First.</span>
          </h1>
          <p class="mb-8 text-lg leading-relaxed text-ash sm:text-xl">
            Scope a proposed crew store around your approved apparel. Verify the platform, ordering,
            fulfillment, fees, and administrators before launch.
          </p>

          <ul class="mb-8 space-y-3 text-base text-ash">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>
              <span><strong class="text-charcoal">Define how users submit sizes</strong> and verify the workflow on the selected platform</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>
              <span><strong class="text-charcoal">Document approved artwork</strong> with current products and production terms for each order</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500"></span>
              <span><strong class="text-charcoal">Request budget controls and reports</strong> with support confirmed before launch</span>
            </li>
          </ul>

          <p class="font-mono text-xs uppercase tracking-[0.15em] text-ash">A tailored store plan · Clear terms · A real person follows up</p>
        </div>

        <!-- Right: form (sticky on desktop) -->
        <div class="lg:sticky lg:top-24">
          <LeadCaptureForm
            vertical="trades"
            heading="Get your crew gear plan"
            submitLabel="Build my crew gear plan →"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ════ THE PROBLEM — paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">The Problem</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Crew gear shouldn’t run <span class="text-gold-600">off a notepad.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          Manual apparel requests can create extra work around sizes, approvals, orders, and storage.
          Document the problem before choosing a bulk or store model.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {problems.map((item) => (
          <div class="border border-hairline bg-panel p-7">
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ HOW IT WORKS — concrete ════ -->
  <section class="bg-concrete py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-3xl">
        <p class="kicker mb-3">How It Works</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          How a crew store works <span class="text-gold-600">for your outfit.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          Start with requirements, then verify the platform and operating model. The final proposal
          should define every feature, responsibility, and fee.
        </p>
      </div>

      <ol class="grid gap-5 md:grid-cols-3">
        {storeSteps.map((step) => (
          <li class="border border-hairline bg-panel p-7">
            <div class="mb-5 flex items-baseline justify-between">
              <span class="font-heading text-5xl font-extrabold leading-none text-gold-600">{step.n}</span>
              <span class="spec border border-hairline px-2 py-1 text-ash">{step.meta}</span>
            </div>
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{step.desc}</p>
          </li>
        ))}
      </ol>

      <div class="mt-8">
        <a href="#lp-form-card" class="btn-secondary text-sm">
          Build my crew gear plan
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7-7 7 7M12 4v16" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════ APPROVED PRODUCTS: paper ════ -->
  <section class="border-y border-hairline bg-paper py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">Proposed Products</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          What to review for <span class="text-gold-600">a proposed catalog.</span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ash">
          Your employer approves the products. The proposal confirms availability, decoration, substitutions, and change responsibilities.
        </p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {offerings.map((item) => (
          <div class="flex flex-col border border-hairline bg-panel p-6">
            <span class="spec mb-3 inline-block self-start border border-hairline px-2 py-1 text-ash">{item.tag}</span>
            <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ OBJECTIONS / TRUST — concrete ════ -->
  <section class="bg-concrete py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <p class="kicker mb-3">Straight Answers</p>
        <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
          Your questions, <span class="text-gold-600">answered.</span>
        </h2>
      </div>

      <div class="divide-y divide-hairline border-y border-hairline">
        {objections.map((item) => (
          <details class="group">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
              <span class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.q}</span>
              <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </summary>
            <p class="pb-5 leading-relaxed text-ash">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ════ CLOSING CTA — charcoal band ════ -->
  <section class="border-y border-hairline bg-charcoal py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <p class="kicker mb-3">Get Started</p>
          <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-concrete sm:text-4xl">
            Ready to scope a <span class="text-gold-400">crew-store concept?</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-navy-200">
            A Las Vegas account contact will review your request. Tell us about your team so we can scope
            a proposal with the platform, operations, costs, and responsibilities defined.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:items-end">
          <a href="#lp-form-card" class="btn-primary text-base">
            Build my crew gear plan
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 11l7-7 7 7M12 4v16" /></svg>
          </a>
          <a href="tel:+17029048923" class="inline-flex items-center gap-2 font-mono text-sm font-medium tracking-wide text-concrete transition-colors hover:text-gold-400">
            <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            702.904.8923
          </a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
