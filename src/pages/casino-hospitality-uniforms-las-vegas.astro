---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import ProofStrip from '@/components/ProofStrip.astro'

const page = {
 title: 'Casino Uniforms & Hospitality Apparel | Las Vegas, Ships Nationwide',
 description:
 'Branded staff apparel for Las Vegas casinos, resorts, hotels, and restaurants. Dealer shirts, server polos, and guest-services uniforms coordinated through production partners. Get a quote.',
 url: 'https://bighornthreads.com/casino-hospitality-uniforms-las-vegas/',
}

const departments = [
 { label: 'Gaming floor', body: 'Dealer shirts, floor-supervisor vests, and pit apparel that holds a crisp look through a full shift under the lights.' },
 { label: 'Food & beverage', body: 'Server polos and dress shirts, bartender vests, cocktail-server uniforms, kitchen and prep wear, and embroidered aprons for every outlet on property.' },
 { label: 'Guest services', body: 'Front desk, concierge, bell, and valet apparel that matches from the curb to the check-in counter.' },
 { label: 'Housekeeping & facilities', body: 'Durable branded polos and tees that take heavy laundering and keep back-of-house teams looking like one crew.' },
 { label: 'Security & surveillance', body: 'Branded polos and outerwear that keep security and surveillance staff easy to identify across long shifts on the floor.' },
]

const faqs = [
 { q: 'Who coordinates custom uniforms for casinos and hospitality staff in Las Vegas?', a: 'Bighorn Threads handles it from Las Vegas. We help you pick the garments, put your logo on a proof, and work with production partners to get the uniforms made.' },
 { q: 'Can you keep uniforms consistent across multiple outlets and departments?', a: 'Yes. A production partner digitizes your logo to the standard you approve, and every department orders from that same version. A company store can give them all one approved catalog.' },
 { q: 'What garments work best for food and beverage staff?', a: 'Polos, dress shirts, vests, and aprons are the usual place to start. Tell us the role and how the gear gets washed, and we will narrow it down.' },
 { q: 'Do you set up company stores for resorts and large properties?', a: 'Yes. Tell us what each department needs, and your proposal lists what the store can do on budgets, inventory, and shipping.' },
 { q: 'Can you add employee names and titles to hospitality uniforms?', a: 'Yes, where the garment allows it. Your quote lists the placement, the lettering, and any added cost.' },
 { q: 'Do you work with restaurants and bars, not just casinos?', a: 'Yes. We work with casinos, resorts, restaurants, bars, nightlife venues, and event teams.' },
 { q: 'What areas do you serve?', a: 'We are based in Las Vegas and ship anywhere in the US. If you would rather pick up, ask us.' },
 { q: 'Is there a minimum order for a casino or hospitality uniform program?', a: 'It depends on the garment and how it is decorated. Embroidery allows small runs, so one outlet or department can start small, and your quote lists the minimum per style and color.' },
 { q: 'Do you provide uniforms for casino security and surveillance staff?', a: 'Yes. We can do branded polos and outerwear for security and surveillance teams, using the same logo standard as your other departments. If the role has ID or visibility requirements, tell us before we quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Casino & Hospitality Uniforms Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Casino & Hospitality Uniforms in Las Vegas',
 serviceType: 'Custom branded staff uniforms for casinos, resorts, hotels, and restaurants',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Casino & Hospitality Uniforms</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Gaming & Hospitality
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Casino & hospitality uniforms in Las Vegas: <span class="text-gold-700">one brand, every department.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Dealer shirts, server polos, bartender vests, aprons, and guest-services apparel, matched to your brand standard and each department's role.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Liftable answer -->
 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="text-xl leading-relaxed text-charcoal sm:text-2xl">
 Bighorn Threads runs branded uniform orders for hospitality teams from Las Vegas and ships anywhere in the US. You approve the garments and logo placement, and production partners make them.
 </p>
 </div>
 </section>

 <!-- Departments -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Every Role On Property</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">From the gaming floor to the front door.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
 {departments.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <ProofStrip tone="paper" />

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 In hospitality, the uniform is the first impression.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A guest reads your staff before they read your sign. A sharp, consistent uniform says the property is run well; a mismatched one says the opposite. On a big Las Vegas property that is hard to keep up, with dozens of departments, several outlets, and constant turnover.
 </p>
 <p>
 A production partner digitizes your logo to the standard you approve, so each department works from the same version. That is how the aprons at the bar end up matching the polos at the front desk.
 </p>
 <p>
 Food and beverage roles have their own needs on fabric, fit, and washing, and your operations and safety leads set those rules. The <a href="https://www.southernnevadahealthdistrict.org/permits-and-regulations/food-establishments/" rel="noopener" target="_blank" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Southern Nevada Health District</a> has food-establishment guidance for local venues.
 </p>
 <p>
 On a large property, a <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store</a> can let each department order from its own approved list. Budgets and approvals depend on how we set it up.
 </p>
 <p>
 See our <a href="/industries/gaming-hospitality/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">gaming and hospitality</a> guide or read <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how company stores work</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Beyond the Casino Floor</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-uniforms-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Uniforms Las Vegas</h3>
 <p class="mt-2 text-sm text-ash">Every department, one logo standard, uniforms you own.</p>
 </a>
 <a href="/cintas-unifirst-aramark-alternatives-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Rental Alternatives</h3>
 <p class="mt-2 text-sm text-ash">Compare a rental contract to an owned program line by line.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">Reorders, sizes, and budgets for a 24-hour property.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Hospitality uniform questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/gaming-hospitality/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Gaming & Hospitality</h3>
 <p class="mt-2 text-sm text-ash">Hotels, restaurants, and casinos, shipped anywhere in the US.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">Let big teams order their own sizes.</p>
 </a>
 <a href="/custom-polo-shirts-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Polos</h3>
 <p class="mt-2 text-sm text-ash">The workhorse garment for guest-facing staff.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Outfitting a property or a single venue?</h2>
 <p class="mb-8 text-lg text-white/80">Send your logo and the roles you're outfitting. We'll build the program with you.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
 <NationalLinks heading='Related product guides' links={[{ href: '/hotel-uniforms/', label: 'Hotel uniforms' }, { href: '/restaurant-uniforms/', label: 'Restaurant uniforms' }]} />
</BaseLayout>
