---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProofStrip from '@/components/ProofStrip.astro'

const page = {
 title: 'Construction Branded Apparel in Las Vegas | Bighorn Threads',
 description:
 'Plan branded construction apparel for Las Vegas GCs, subcontractors, and data center teams. Bighorn coordinates garments, proofs, orders, and reorders.',
 url: 'https://bighornthreads.com/branded-apparel-construction-las-vegas/',
}

const stack = [
 { label: 'Built for the trade', body: 'Compare heavyweight tees, polos, and protective garments by crew role. Your company sets any hi-vis, FR, or other safety requirement from its hazard assessment and project rules.' },
 { label: 'Order-specific documentation', body: 'Tell us how the garment will be used and what your company requires. We write up the product and logo plan for your approval.' },
 { label: 'Managed artwork', body: 'We handle artwork and proofs with production partners. You get one Las Vegas contact from quote through reorder.' },
 { label: 'Local and reachable', body: 'Your account is run from Las Vegas. When the foreman needs gear before a Monday start, your request goes to the team handling your account.' },
]

const considers = [
 { row: 'Local presence', meaning: 'A Las Vegas account team', use: 'You need gear fast, or want to talk specs with someone who knows Vegas jobsites' },
 { row: 'Requirement review', meaning: 'We write down the garment, artwork, use, and jobsite rules', use: 'Your crew uses hi-vis, FR, or role-specific apparel' },
 { row: 'Company store', meaning: 'An approved catalog and ordering program', use: 'Sizes vary and your team needs a clear way to reorder' },
 { row: 'One account contact', meaning: 'One person handles products, proofs, production, and reorders', use: 'You want one person accountable for communication' },
]

const moat = [
 { label: 'Requirement review', body: 'Share the garment spec and jobsite rules before you order. Your quote lists the product and decoration method.' },
 { label: 'A local account contact', body: 'A Las Vegas contact looks at your deadline and order, then gives you a date.' },
 { label: 'Written proofs', body: 'Check the product, artwork, and placement before you approve the order.' },
 { label: 'Coordinated production', body: 'We handle the approved logo plan, proofs, and reorders, and production partners do the work.' },
]

const faqs = [
 { q: 'Who provides branded construction apparel in Las Vegas?', a: 'Bighorn Threads is a Las Vegas based apparel program manager for construction and trade crews. We coordinate product selection, artwork, proofs, decoration, orders, and reorders through production partners.' },
 { q: 'What makes a construction apparel vendor different from a general promo provider?', a: 'A construction apparel vendor should ask how each garment will be used. It should also document jobsite requirements, decoration placement, product choices, timing, and reorder needs before approval.' },
 { q: 'Can you coordinate decoration for ANSI rated hi-vis apparel?', a: 'Send the requirement selected by the employer from its current hazard assessment and project rules. Bighorn can document a proposed product and decoration plan, but the employer must approve it against the exact garment manufacturer\'s current written instructions and documentation.' },
 { q: 'How fast can you turn around an order?', a: 'Timing depends on the garment, artwork, decoration, quantity, and current availability. Send your complete order and deadline so Bighorn can confirm timing in writing.' },
 { q: 'What should I look for in a branded apparel company for a construction crew in Las Vegas?', a: 'Look for a clear production model, one accountable contact, written proofs, order-specific timing, and a documented reorder process. Compare every provider against the same garment and decoration specification.' },
 { q: 'Who does branded construction apparel in Las Vegas?', a: 'Bighorn Threads coordinates branded apparel programs for Las Vegas construction and trade crews. Production partners perform the employer-approved decoration while Bighorn manages the order and communication.' },
 { q: 'Why choose a local account contact?', a: 'A Las Vegas based contact can review your order details and keep communication in one place. Compare providers on accountability, specifications, timing, and reorder terms.' },
 { q: 'Can you coordinate decoration for hi-vis and FR gear?', a: 'Bighorn can coordinate a proposed decoration plan after the employer identifies the required garment through its current hazard assessment and project rules. The employer must approve the exact product and decoration against current manufacturer instructions and documentation. Bighorn does not verify safety compliance.' },
 { q: 'Do you coordinate both embroidery and screen printing?', a: 'Yes. Production partners perform the employer-approved decoration. For protective garments, the employer must select the method from the exact manufacturer\'s current written instructions and documentation before Bighorn coordinates production.' },
 { q: 'Can you set up a company store for our crew?', a: 'Bighorn can scope a company store around an approved product program. Ordering, budget, production, and fulfillment terms are confirmed before setup.' },
 { q: 'What should you look for in the workwear itself before adding branding?', a: 'Start with the safety requirement the employer selected from its hazard assessment, such as hi-vis or FR. Then weigh durability (fabric weight, reinforced seams, stain-release finishes), fit for the role, and Las Vegas heat, where moisture-wicking performance fabrics help from May through September. Branding comes last and must not compromise a rated garment.' },
 { q: 'Is Bighorn Threads a clothing or apparel manufacturer?', a: 'No. Bighorn Threads does not manufacture clothing or garments in-house. We are a Las Vegas based apparel program manager that coordinates product selection, artwork, proofs, decoration, orders, and reorders through production partners.' },
 { q: 'What areas do you serve?', a: 'Bighorn Threads is based in Las Vegas. Send the locations, roster, and gear you need so Bighorn can confirm current service and fulfillment options. See the communities we serve near Las Vegas, including Henderson, Summerlin, and North Las Vegas.', html: 'Bighorn Threads is based in Las Vegas. Send the locations, roster, and gear you need so Bighorn can confirm current service and fulfillment options. See the <a href="/service-areas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">communities we serve</a> near Las Vegas, including <a href="/service-areas/henderson-nv/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Henderson</a>, <a href="/service-areas/summerlin/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Summerlin</a>, and <a href="/service-areas/north-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">North Las Vegas</a>.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Branded Apparel for Construction Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 name: 'Branded Apparel for Construction Crews in Las Vegas',
 serviceType: 'Custom branded workwear and crew apparel for construction and trades',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-07-08',
 dateModified: '2026-08-21',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Branded Apparel for Construction</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Construction & Trades
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Branded apparel for construction in Las Vegas. <span class="text-gold-700">Built for the trade. Planned around documented requirements.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Branded workwear and apparel for construction crews. We handle garments, proofs, orders, and reorders, and production partners do the decoration.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Liftable answer -->
 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="speakable-answer text-xl leading-relaxed text-charcoal sm:text-2xl">
 A good construction apparel partner gives you clear product choices, written proofs, one contact, and an easy way to reorder. We handle each step for Las Vegas crews, and production partners do the decoration.
 </p>
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why We're The Right Choice</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What Bighorn does for construction companies.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- What to weigh -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">How To Choose</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What to weigh when you pick a shop.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 People search for the "best branded apparel company for construction." The best one depends on what your crews need. Here's what to weigh.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Factor</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What It Means</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">It Matters When</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {considers.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Promo shop vs construction vendor: the moat -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Vendor vs Promo Catalog
 </p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">What a national promo catalog can't do for a jobsite.</h2>
 <p class="mt-4 text-lg leading-relaxed text-navy-200">
 A general catalog may not answer your jobsite questions. Compare providers on written proofs, who does the production, timing, and reorders.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-2">
 {moat.map((m) => (
 <div class="border border-white/10 bg-white/[0.03] p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-gold-400">{m.label}</h3>
 <p class="text-sm leading-relaxed text-navy-200">{m.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <ProofStrip tone="paper" />

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Most apparel vendors aren't built for a jobsite. The good ones are.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A promo catalog can print a logo on a shirt. Outfitting a construction crew takes more. Your company sets any ANSI, NFPA, or other protective requirement from its hazard assessment and project rules. Any logo on a protective garment has to follow the manufacturer's instructions and get your company's approval.
 </p>
 <p>
 It starts with questions. We write down the garment, its use, the artwork, and your company's requirements before planning any logo. Production partners do the approved work. Bighorn does not set protective requirements or certify compliance. Read the <a href="/safety-compliance/ansi-107-hi-vis-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">ANSI 107 guide</a> and the <a href="/safety-compliance/nfpa-70e-embroidery-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">NFPA 70E guide</a>, then send us your spec and the product documents. For non-protective crew tees and hoodies, see <a href="/services/screen-printing-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-600">screen printing for crews and contractors</a>.
 </p>
 <p>
 Crews turn over, sizes vary, and reorders happen all year. A <a href="/company-stores/contractors-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store</a> can keep your approved catalog and ordering in one place.
 </p>
 <p>
 A national uniform company runs you through a service queue. Your Las Vegas contact answers the phone and knows your account. To plan what each role needs, see <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how to outfit a construction crew in Las Vegas</a>, and see the trades we outfit on the <a href="/industries/construction-trades/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">construction & trades</a> page.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Branded construction apparel, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 {f.html ? <p class="pb-5 text-base leading-relaxed text-ash" set:html={f.html} /> : <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>}
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/company-stores/contractors-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Store for Contractors</h3>
 <p class="mt-2 text-sm text-ash">See how an approved catalog and ordering program works for a crew.</p>
 </a>
 <a href="/industries/construction-trades/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Construction & Trades</h3>
 <p class="mt-2 text-sm text-ash">Every trade we outfit, from GCs to data-center crews.</p>
 </a>
 <a href="/custom-safety-vests-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Safety Vests</h3>
 <p class="mt-2 text-sm text-ash">Hi-vis options and logo rules.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Outfitting a Vegas crew?</h2>
 <p class="mb-8 text-lg text-white/80">Send your roster and the gear you need. We'll spec it with you.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
