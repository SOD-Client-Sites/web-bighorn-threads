---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Welder Uniform Planning in Las Vegas | Bighorn Threads',
 description:
 'Welder uniform planning for Las Vegas shops and contractors. Bighorn coordinates qualifying garments and decoration through production partners. Safety requirements need employer review. Get a quote.',
 hero: '/images/generated/kit-steel.jpg',
 url: 'https://bighornthreads.com/welder-uniforms-las-vegas/',
}

const stack = [
 { label: 'Base garments', body: 'Start with the employer hazard assessment and required garment ratings. Verify each product using current manufacturer documents.' },
 { label: 'Protective layers', body: 'Jackets, sleeves, and other layers depend on the process, exposure, site rules, and employer PPE program.' },
 { label: 'Hands and head', body: 'Gloves, helmets, hoods, and related PPE require selection by a qualified safety lead for the specific work.' },
 { label: 'Branding', body: 'Any decoration on safety-rated garments requires written review of the product, method, placement, materials, and manufacturer guidance.' },
]

const standards = [
 { row: 'NFPA 2112', meaning: 'Flash-fire garment standard', use: 'Only when the employer identifies a flash-fire hazard and selects the exact product' },
 { row: 'NFPA 70E', meaning: 'Electrical-safety framework', use: 'Only when the employer identifies an electrical hazard and selects the complete PPE system' },
 { row: 'AWS Z49.1', meaning: 'Welding industry safety standard', use: 'Standard guidance for general stick / MIG / TIG welding' },
 { row: 'OSHA 1910.252', meaning: 'Federal welding, cutting, and brazing rule', use: 'Review with the employer safety lead for the specific operation' },
]

const layers = [
 { name: 'FR shirt', detail: 'Compare qualifying shirts only after the employer defines the required hazard rating, fabric, fit, and care process.' },
 { name: 'FR pants', detail: 'Pants should be reviewed as part of the complete protective clothing system, not selected from a general brand list.' },
 { name: 'Welding jacket', detail: 'Jacket material and coverage depend on the welding process, heat, spatter, position, and worksite requirements.' },
 { name: 'Sleeves', detail: 'Sleeves may be one component of a PPE system. A qualified safety lead should determine where they are appropriate.' },
 { name: 'Gloves', detail: 'Glove material and construction should match the welding process and exposure defined by the employer.' },
 { name: 'Helmet and hood', detail: 'Helmet, lens, hood, and any decoration must follow current employer, product, and manufacturer requirements.' },
]

const faqs = [
 { q: 'Do welders need flame-resistant clothing?', a: 'The employer must evaluate the welding process, hazards, regulations, standards, and site requirements. A qualified safety professional should define the complete PPE and clothing system for each task.' },
 { q: 'NFPA 2112 vs FR cotton: what should a welder wear?', a: 'These terms are not interchangeable. The required garment and rating depend on the documented hazard and worksite. Review current standards, product certificates, and employer requirements with a qualified safety professional.' },
 { q: 'What FR shirt brands hold up for Vegas welders?', a: 'Do not select a protective garment by brand alone. Compare the exact model, current ratings, fabric, fit, care instructions, availability, and employer requirements.' },
 { q: 'Do I need a welding jacket if I\'m wearing FR?', a: 'That decision depends on the welding process, amperage, position, spatter, heat, base garments, and employer PPE program. Ask the employer safety lead to define the required layers.' },
 { q: 'Can welder uniforms be embroidered without losing the FR rating?', a: 'Do not assume any thread or decoration preserves a garment rating. Get written confirmation for the exact garment, thread, backing, placement, and method from the manufacturer and employer safety lead.' },
 { q: 'Are uniform rental services worth it for a welding shop?', a: 'Compare rental and ownership programs using total cost, garment control, fit, inspection, repair, replacement, laundering, and documentation requirements.' },
 { q: 'Where can I get welder uniforms in Las Vegas?', a: 'Bighorn Threads provides Las Vegas account management and coordinates qualifying garments and decoration through production partners. The employer remains responsible for PPE selection and approval.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Welder Uniforms Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Welder Uniforms in Las Vegas',
 serviceType: 'Welder uniform product and decoration coordination',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Welder Uniforms</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  FR + Leather Kit
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Welder Uniform Planning in Las Vegas <span class="text-gold-400">with product-specific safety review.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Review base garments, protective layers, gloves, helmets, and decoration against the employer's documented hazards and current product guidance.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Stack -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Layered System</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">A welder uniform isn't one shirt — it's a kit.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Standards table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Standards</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">The standards your welders need to meet.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Standards and site requirements vary by operation. The employer and qualified safety lead must define the applicable requirements.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Standard</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Covers</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">When It Applies</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {standards.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Layer detail -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Each Layer</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">The full kit, one piece at a time.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {layers.map((l) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{l.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{l.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Welder uniforms for Vegas welding shops and contractors.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Welding PPE should be treated as a complete system. The required base garments, jackets, sleeves, gloves, helmets, and other protection depend on the documented hazards. Employers should review <a href="https://www.osha.gov/laws-regs/regulations/standardnumber/1910/1910.252" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener" target="_blank">OSHA 1910.252</a>, applicable standards, and site rules with a qualified safety professional.
 </p>
 <p>
 Product labels such as FR, arc rated, and <a href="https://www.nfpa.org/codes-and-standards/all-codes-and-standards/list-of-codes-and-standards/detail?code=2112" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500" rel="noopener nofollow" target="_blank">NFPA 2112</a> describe different properties or standards. Verify the exact model, current certificate, hazard rating, fit, and care instructions before approval.
 </p>
 <p>
 Protective-layer decisions depend on the process, heat, spatter, welding position, duration, environment, and site rules. A qualified safety lead should decide whether a jacket, sleeves, or another system is required.
 </p>
 <p>
 Decoration can affect a protective garment. Bighorn does not approve PPE or guarantee that a decoration preserves a rating. The exact garment, thread, backing, placement, method, and current manufacturer guidance require written review before production.
 </p>
 <p>
 For deeper reads, see our <a href="/blog/welder-uniforms-las-vegas-buyer-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">welder uniforms buyer's guide</a>, the <a href="/blog/welder-uniforms-fr-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">welder FR shirts deep-dive</a>, and the <a href="/blog/nfpa-2112-fr-coveralls-buyer-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">NFPA 2112 FR coveralls guide</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Welder uniform questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/industries/steel-iron-workers-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Steel & Iron Workers</h3>
 <p class="mt-2 text-sm text-ash">Industry kit for Vegas steel-trade welders and fabricators.</p>
 </a>
 <a href="/brands/bulwark-fr-custom-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Bulwark FR</h3>
 <p class="mt-2 text-sm text-ash">Brand-page deep-dive on Excel-FR ComforTouch and the SLU2.</p>
 </a>
 <a href="/catalog/fr-clothing/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse FR Catalog</h3>
 <p class="mt-2 text-sm text-ash">Browse possible FR products, then verify ratings and availability by item.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to outfit your welders?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your roster size and program spec.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Request a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
