---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import NationalLinks from '@/components/NationalLinks.astro'
import ProofStrip from '@/components/ProofStrip.astro'

const page = {
 title: 'Cintas, UniFirst & Aramark Alternatives: Own Your Uniforms | Bighorn Threads',
 description:
 'Alternatives to UniFirst, Cintas and Aramark: rental competitors like Alsco and Vestis, or stop renting and own your uniforms. Compare costs, contracts and how to switch. Written quotes, no multi-year term.',
 url: 'https://bighornthreads.com/cintas-unifirst-aramark-alternatives-las-vegas/',
}

const compare = [
 { row: 'Contract', rental: 'Multi-year term, often auto-renewing, with a notice window to cancel', owned: 'No term. Order when you need garments.' },
 { row: 'Garment choice', rental: 'The rental fleet catalog', owned: 'Any brand: Red Kap, Carhartt, Port Authority, Bulwark, Dickies, and more' },
 { row: 'Cost model', rental: 'Weekly fee per wearer, plus emblem, prep, and replacement charges', owned: 'Per-garment purchase, priced in writing before you approve' },
 { row: 'Laundering', rental: 'Included, on a route schedule', owned: 'Yours: home wash, in-house laundry, or a local commercial laundry' },
 { row: 'Lost or damaged garments', rental: 'Replacement charges under the contract', owned: 'You own it. Reorder at the quoted price.' },
 { row: 'Logo', rental: 'Sewn-on emblem', owned: 'Direct embroidery or print, matched to your brand standard' },
 { row: 'Headcount changes', rental: 'Contract minimums and change fees', owned: 'Order more or fewer next time' },
 { row: 'Who you deal with', rental: 'National route driver and call center', owned: 'A Las Vegas account manager who quotes, proofs, and reorders' },
]

const alternatives = [
 { option: 'National rental services (Alsco, Vestis, Prudential Overall Supply)', suits: 'Teams that need daily industrial laundering and have no laundry of their own', contract: 'Multi-year term with a weekly fee per wearer', laundering: 'Included, on a route schedule' },
 { option: 'Regional rental launderers', suits: 'Businesses that want rental service from a local route', contract: 'Rental agreement; terms vary by provider', laundering: 'Included' },
 { option: 'Direct purchase from workwear brands (Red Kap, Carhartt, Dickies)', suits: 'Buyers who want garments only, with no logo program', contract: 'Per-order purchase', laundering: 'Yours' },
 { option: 'Owned program with embroidery and a company store (Bighorn Threads)', suits: 'Crews, casinos, clinics, and service teams that wash their own uniforms', contract: 'No term; per-garment price quoted in writing', laundering: 'Yours: home wash, in-house laundry, or a local commercial laundry' },
]

const switchTemplate = [
 { line: 'Weekly invoice', rental: '$______ x 52 = $______ per year', owned: 'No weekly fee' },
 { line: 'First issue', rental: 'Bundled into the weekly fee', owned: '$______ from the written quote' },
 { line: 'Replacements and new hires', rental: '$______ in contract charges', owned: '$______ in reorders at the quoted price' },
 { line: 'Laundering', rental: 'Included', owned: '$______ (home, in-house, or commercial laundry)' },
 { line: 'Year one total', rental: '$______', owned: '$______' },
 { line: 'Each later year', rental: '$______', owned: '$______' },
]

const faqs = [
 { q: "What are the best alternatives to Cintas or UniFirst uniform rental if I'd rather own my uniforms?", a: 'If you would rather own your uniforms, the best alternative to Cintas or UniFirst rental is an owned program: buy brand-name garments once, have your logo embroidered, and reorder through a company store. Bighorn Threads runs that model for Las Vegas businesses with written quotes and no multi-year contract. Laundering becomes yours: home wash, in-house laundry, or a local commercial laundry.' },
 { q: 'Is it cheaper to rent uniforms or buy them?', a: 'For a team that can launder its own uniforms, owning is usually cheaper over the life of the program: you pay for garments once instead of a weekly fee per wearer for years, and there are no replacement or change charges. Rental can still win where garments are heavily soiled every day and industrial laundering is mandated, or where the business has no laundry capacity at all. Bighorn quotes the owned program in writing so you can compare it to your current weekly invoice.', html: 'For a team that can launder its own uniforms, owning is usually cheaper over the life of the program: you pay for garments once instead of a weekly fee per wearer for years, and there are no replacement or change charges. Rental can still win where garments are heavily soiled every day and industrial laundering is mandated, or where the business has no laundry capacity at all. Bighorn quotes the owned program in writing so you can <a href="/uniform-program-cost-per-employee/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">compare it to your current weekly invoice</a>.' },
 { q: 'What are the alternatives to Cintas in Las Vegas?', a: 'National rental alternatives include UniFirst, Aramark (now Vestis), Alsco, and Prudential Overall Supply, all of which run route-based rental programs. The other alternative is to stop renting: buy brand-name uniforms once, have them embroidered, and reorder through a company store. Bighorn Threads runs that owned model for Las Vegas crews, casinos, clinics, and service companies.' },
 { q: 'How do I get out of a uniform rental contract?', a: 'Read the term and the cancellation clause. Most rental agreements run several years, renew automatically, and require written notice inside a specific window before the renewal date. Some carry a buyout for early termination. This is not legal advice; check the contract and, if the amount is significant, have counsel read it. Bighorn can size and stage an owned program to start the week the rental ends.' },
 { q: 'Do you launder uniforms?', a: 'No. Bighorn supplies uniforms you own. Most Las Vegas teams wash their own; casinos and hotels typically run in-house laundry; crews with heavy soil can use a local commercial laundry on a per-piece basis without a garment contract.' },
 { q: 'Can an owned uniform program handle a large team?', a: 'Yes. A private company store holds the approved garments and lets employees pick their sizes, so a 200-person property or a multi-crew contractor reorders without a new project each time. See the company store page for how it works.' },
 { q: 'What is the minimum order to switch from rental to owned?', a: 'Minimums depend on the garment and decoration method, and embroidery allows small runs. A switch usually starts with a size run per employee and a first issue of several garments each. Bighorn confirms the count, the price, and the ship date in writing.' },
 { q: 'Where can I get an owned uniform program in Las Vegas?', a: 'Bighorn Threads runs owned uniform programs for Las Vegas, Henderson, and North Las Vegas businesses with a Las Vegas account team and production through partners. Send your current garment list, headcount by role, and your rental renewal date for a written quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Uniforms Las Vegas', item: 'https://bighornthreads.com/custom-uniforms-las-vegas/' },
 { '@type': 'ListItem', position: 3, name: 'Rental Alternatives', item: page.url },
 ],
}

const articleSchema = {
 '@context': 'https://schema.org',
 '@type': 'Article',
 headline: 'Alternatives to Cintas, UniFirst, and Aramark uniform rental in Las Vegas',
 description: page.description,
 datePublished: '2026-09-10',
 dateModified: '2026-11-11',
 author: { '@type': 'Organization', name: 'Bighorn Threads', url: 'https://bighornthreads.com/' },
 publisher: { '@type': 'Organization', name: 'Bighorn Threads', logo: { '@type': 'ImageObject', url: 'https://bighornthreads.com/images/logos/bighorn-logo-color.png' } },
 mainEntityOfPage: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: page.url,
 datePublished: '2026-09-10',
 dateModified: '2026-11-11',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero -->
 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/custom-uniforms-las-vegas/" class="hover:text-gold-700">Custom Uniforms</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Rental Alternatives</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Rent vs Own
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 A Las Vegas alternative to Cintas, UniFirst, and Aramark: <span class="text-gold-700">own your uniforms.</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 For Las Vegas businesses that can launder their own uniforms, the alternative to a rental program is an owned program: buy brand-name garments once, have them embroidered, and reorder through a company store. Bighorn Threads runs owned uniform programs for <a href="/branded-apparel-construction-las-vegas/" class="text-charcoal underline decoration-gold-500/60 underline-offset-4 hover:text-gold-700">crews</a>, <a href="/casino-hospitality-uniforms-las-vegas/" class="text-charcoal underline decoration-gold-500/60 underline-offset-4 hover:text-gold-700">casinos</a>, <a href="/healthcare-uniforms-scrubs-las-vegas/" class="text-charcoal underline decoration-gold-500/60 underline-offset-4 hover:text-gold-700">clinics</a>, and service companies with written quotes and no multi-year contract.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Rent vs buy — answer-first -->
 <section class="border-t border-hairline bg-concrete py-16">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight sm:text-3xl">Is it better to rent uniforms or buy and brand your own?</h2>
 <p class="text-lg leading-relaxed text-ash">For teams that can launder their own uniforms, buying and branding your own is usually the better long-run choice: you pay for garments once, choose any brand, and skip multi-year terms and weekly per-wearer fees. Renting still wins when garments need daily industrial laundering or the business has no laundry capacity.</p>
 <div class="mt-8 grid gap-5 sm:grid-cols-2">
 <div class="border border-hairline bg-panel p-6">
 <h3 class="mb-2 font-heading text-base font-bold uppercase tracking-tight text-charcoal">Buy and brand: pros</h3>
 <ul class="mb-4 list-disc space-y-1 pl-5 text-base leading-relaxed text-ash"><li>Pay for garments once, no weekly per-wearer fee</li><li>Any brand, embroidered to your standard</li><li>No multi-year term or change fees</li></ul>
 <h3 class="mb-2 font-heading text-base font-bold uppercase tracking-tight text-charcoal">Cons</h3>
 <ul class="list-disc space-y-1 pl-5 text-base leading-relaxed text-ash"><li>Full first issue paid up front</li><li>You handle laundering and reorders</li></ul>
 </div>
 <div class="border border-hairline bg-panel p-6">
 <h3 class="mb-2 font-heading text-base font-bold uppercase tracking-tight text-charcoal">Rent: pros</h3>
 <ul class="mb-4 list-disc space-y-1 pl-5 text-base leading-relaxed text-ash"><li>Laundering and replacement bundled in</li><li>Weekly cost instead of an up-front purchase</li></ul>
 <h3 class="mb-2 font-heading text-base font-bold uppercase tracking-tight text-charcoal">Cons</h3>
 <ul class="list-disc space-y-1 pl-5 text-base leading-relaxed text-ash"><li>Multi-year contract with a notice window</li><li>Rental-fleet catalog and sewn-on emblems</li><li>Fees run whether or not garments are worn</li></ul>
 </div>
 </div>
 </div>
 </section>

 <!-- Alternatives list: answer-first -->
 <section class="border-t border-hairline bg-paper py-16 sm:py-20">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-3xl">
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight sm:text-3xl">Which companies are alternatives to UniFirst and Cintas?</h2>
 <p class="speakable-answer text-lg leading-relaxed text-ash">Rental alternatives to UniFirst and Cintas include Alsco, Vestis (formerly Aramark Uniform Services), Prudential Overall Supply, and regional rental launderers. The non-rental alternative is a direct-purchase owned program like Bighorn Threads, which supplies brand-name garments embroidered through production partners, plus a private company store, with written quotes and no multi-year contract.</p>
 <p class="mt-4 text-lg leading-relaxed text-ash">When people look for companies like Cintas, they usually mean uniform companies like Cintas that rent garments and launder them on a route. That is one of four ways to outfit a team:</p>
 </div>
 <div class="overflow-x-auto border border-hairline bg-panel">
 <table class="w-full min-w-[640px]">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Option type</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Who it suits</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Contract model</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Laundering</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {alternatives.map((a) => (
 <tr>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{a.option}</td>
 <td class="px-6 py-5 align-top text-sm text-ash">{a.suits}</td>
 <td class="px-6 py-5 align-top text-sm text-ash">{a.contract}</td>
 <td class="px-6 py-5 align-top text-sm text-ash">{a.laundering}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p class="mt-6 max-w-3xl text-base leading-relaxed text-ash">Bighorn Threads does not launder uniforms. Teams with heavy soil can use a local commercial laundry on a per-piece basis without a garment contract, as covered in the FAQ below.</p>
 </div>
 </section>

 <!-- Comparison table -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Rental vs Owned</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What actually changes when you stop renting.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Rental programs bundle garments, laundering, and replacement into one weekly fee. Owning separates them. Here is the line-by-line.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Line</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Rental Program</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Owned Program (Bighorn)</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {compare.map((c) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{c.row}</td>
 <td class="px-6 py-5 align-top text-sm text-ash">{c.rental}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{c.owned}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Deep dive -->
 <ProofStrip tone="paper" />

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 When rental still wins, when owning wins, and how to switch without a gap.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Rental programs exist for a reason. If your crew comes off a shift in garments that need industrial laundering every day, or a regulation requires it, or you have no laundry capacity and no appetite to build any, a route-based program from Cintas, UniFirst, Aramark, or Alsco does the whole job for a weekly fee. The tradeoff is the contract: a multi-year term, a catalog limited to the rental fleet, an emblem sewn on instead of embroidery, and per-wearer charges that keep running whether or not the garment is worn. Rental can also be the better fit when spreading cost weekly matters more than the total spent over time: owning means paying for a full first issue of garments up front, in exchange for no per-wearer fee afterward.
 </p>
 <p>
 Owning wins for most Las Vegas teams that can wash their own uniforms, which is most of them. <a href="/casino-hospitality-uniforms-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Casinos and hotels</a> run in-house laundry. <a href="/industries/construction-trades/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Contractors' crews</a> wash workwear at home. <a href="/industries/healthcare/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Clinics</a> launder scrubs on site or at home under their own policy. For those teams, an owned program means choosing the actual garment, such as a <a href="/custom-work-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Red Kap or Carhartt work shirt</a> or a <a href="/custom-polo-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">performance polo</a>, embroidering it to your brand standard, and paying once. The <a href="/custom-uniforms-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom uniforms page</a> covers garments by team.
 </p>
 <h3 class="pt-4 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">How do I switch from uniform rental to owned uniforms?</h3>
 <p>
 To switch from uniform rental to owned uniforms, time the change to your rental contract's renewal date, size every employee, and issue owned garments the week the rental ends. Bighorn Threads quotes the same headcount in writing and loads the approved garments into a company store, so replacements and new hires become a reorder.
 </p>
 <ol class="list-decimal space-y-2 pl-6">
 <li>Find the renewal date and the notice window in the rental agreement.</li>
 <li>Collect your last twelve weekly rental invoices.</li>
 <li>Run sizes for every employee, grouped by role.</li>
 <li>Request a written quote for the same headcount and garments.</li>
 <li>Place the first issue, several garments per person, timed to the week the rental ends so nobody is short.</li>
 <li>Load the approved garments, sizes, and department rules into a <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store</a>.</li>
 </ol>
 <p>
 The <a href="/company-stores/setup-guide-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store setup guide</a> and the <a href="/blog/company-store-vs-bulk-ordering/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">store vs bulk ordering comparison</a> lay out the two ways to run it. Use the template below to put your own numbers side by side.
 </p>
 <div class="overflow-x-auto border border-hairline bg-panel">
 <table class="w-full min-w-[560px]">
 <thead class="bg-paper">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Line</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Rental program</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Owned program</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {switchTemplate.map((t) => (
 <tr>
 <td class="px-6 py-4 align-top font-mono text-sm font-bold text-gold-700">{t.line}</td>
 <td class="px-6 py-4 align-top text-sm text-ash">{t.rental}</td>
 <td class="px-6 py-4 align-top text-sm text-charcoal">{t.owned}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p>
 Two cautions. Flame-resistant and hi-vis garments are decorated only within the manufacturer's guidance whether you rent or own; see the <a href="/safety-compliance/nfpa-70e-embroidery-guide/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">NFPA 70E embroidery guide</a>. And the numbers are yours to compare: put your last twelve weekly rental invoices next to Bighorn's written quote for the same headcount, and compare the totals over the life of the program. For the cost drivers behind a first issue, see <a href="/cost-custom-apparel-team-of-50/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">cost of custom apparel for a team of 50</a>. For the same comparison against online print shops rather than rental, read <a href="/customink-alternatives/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">CustomInk alternatives for crews</a> and <a href="/online-vs-local-print-shop/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">online vs local print shop</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Rental alternative questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 {f.html ? <p class="pb-5 text-base leading-relaxed text-ash" set:html={f.html} /> : <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>}
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related -->
 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Go Deeper</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-uniforms-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Uniforms Las Vegas</h3>
 <p class="mt-2 text-sm text-ash">Garments by team: crews, casinos, clinics, and service companies.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">How reorders, sizes, and budgets run once you own the program.</p>
