---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Custom Team Shirts in Las Vegas | Sports, Corporate, Event Apparel — Bighorn Threads',
 description:
 'Custom team shirts in Las Vegas — youth and adult sports, corporate teams, charity walks, school groups, family reunions. Screen-printed, embroidered, or DTF. Names and numbers on request. Get a quote.',
 url: 'https://bighornthreads.com/custom-team-shirts-las-vegas/',
}

const stack = [
 { label: 'The garment', body: 'Cotton tees, performance polyester (moisture-wicking), tri-blends, mesh jerseys, raglans, hoodies, long-sleeves. Picked for where it gets worn: court, field, office, or event.' },
 { label: 'The decoration', body: 'Screen printing for high-volume color blocks, DTF for full-color or photographic art, embroidery for premium polos, sublimation for full-coverage jerseys.' },
 { label: 'Names and numbers', body: 'Send the roster with sizes, names, and numbers. Your quote shows what they add to the price and the schedule.' },
 { label: 'Use cases', body: 'Youth and adult sports leagues, corporate softball / kickball / dodgeball, charity walks and 5Ks, family reunions, school spirit groups, bachelor / bachelorette events.' },
]

const garments = [
 { row: 'Cotton tee', use: 'Casual events, family reunions, charity walks, school spirit', notes: 'Usually the budget pick, and comfortable when nobody is running.' },
 { row: 'Performance polyester', use: 'Active sports, summer outdoor events, jobsite team shirts', notes: 'Moisture-wicking, dries fast. Sport-Tek ST350 is the workhorse blank. Sublimation-friendly.' },
 { row: 'Tri-blend tee', use: 'Premium soft-feel for corporate or event tier', notes: 'Cotton-poly-rayon blend. Drapes well, feels expensive. Common for company tee programs.' },
 { row: 'Mesh jersey', use: 'Basketball, soccer, hockey, lacrosse', notes: 'Breathable mesh, sublimation-friendly. Augusta and Sport-Tek are the standard team-jersey brands.' },
 { row: 'Raglan / baseball tee', use: 'Softball, baseball, retro-style team apparel', notes: 'Two-tone color block on sleeves. Strong visual identity at distance.' },
 { row: 'Hoodie', use: 'Cold-weather sideline, post-game team layer', notes: 'Cotton-poly fleece. Common for team store apparel and parent gear.' },
 { row: 'Long-sleeve performance', use: 'Outdoor sports in cooler months, sun-protective base layers', notes: 'Ask for a UPF-rated style if your team plays outdoors year-round.' },
]

const teamTypes = [
 { name: 'Youth sports leagues', detail: 'Give us the age range and the roster, and we find shirts in the youth sizes you need.' },
 { name: 'Adult rec leagues', detail: 'Corporate softball, kickball, dodgeball, volleyball. Often ordered as one-off season runs with team name + sponsor logo.' },
 { name: 'Corporate event teams', detail: 'Company softball, charity 5K teams, all-hands team-building events. Branded with company logo and a team or event identifier.' },
 { name: 'Charity walks and 5Ks', detail: 'Cause name on the front, sponsor logos on the back. We plan the order back from the event date.' },
 { name: 'School spirit groups', detail: 'Class shirts, club shirts, booster club, parent groups. A bigger count usually brings the per-shirt price down.' },
 { name: 'Family reunions and events', detail: 'Reunion shirts with family name + year, bachelor/bachelorette parties, milestone birthdays. Smaller runs, higher per-piece personalization.' },
]

const faqs = [
 { q: 'Can I get team shirts with names and numbers on each one?', a: 'Yes, where the shirt and method allow it. Your quote shows the placement, price, and timing.' },
 { q: 'What fabric should we compare for team shirts in Las Vegas heat?', a: 'For active play, look at performance polyester. For standing around at an event, cotton or a blend is fine. If your league or employer has rules about the shirt, send them along.' },
 { q: 'How many shirts should I order per team member?', a: 'For a single-season league, one shirt per player is standard. For event teams (charity 5Ks, reunions, single-day events), one shirt per participant. For ongoing recreational teams or company programs, two to three per player covers wash rotation and replacement. Order a few spares, because kids and adults both lose shirts.' },
  { q: 'What\'s the minimum team shirt order?', a: 'It depends on the shirt and how it is decorated. Send your roster and we will tell you what works.' },
 { q: 'Can you sublimate full-coverage jerseys?', a: 'Yes, on polyester jerseys that can take it. We check which ones are in stock and a production partner handles the printing.' },
 { q: 'Should I screen print or use DTF for team shirts?', a: 'Screen printing usually wins on big runs with simple art. DTF makes more sense for small batches or full-color art. We compare both on your order before you approve.' },
 { q: 'Where can I get custom team shirts in Las Vegas?', a: 'Bighorn Threads handles team shirt orders for Vegas groups. Send your roster, the shirt you want, and your event date for a quote.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Custom Team Shirts Las Vegas', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Custom Team Shirts in Las Vegas',
 serviceType: 'Custom team apparel for sports, corporate teams, charity walks, and event groups',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <section class="border-b border-hairline bg-concrete pt-16 pb-20 sm:pt-16 sm:pb-28">
 <div class="page-hero-grid relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Custom Team Shirts</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5">
  <span class="h-px w-8 bg-gold-500"></span>
  Team Apparel
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Custom Team Shirts in Las Vegas: <span class="text-gold-700">sports, corporate, charity, event.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Cotton, performance polyester, mesh jerseys, raglans, hoodies. Screen-printed, sublimated, embroidered, or DTF. Add names and numbers from your roster.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What You Get</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">What goes into a team shirt order.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {stack.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Garments</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Pick the garment that matches the use case.</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 The blank you pick changes the price and how the shirt feels on a hot field.
 </p>
 </div>
 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Garment</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Use Case</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">Notes</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {garments.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.use}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.notes}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Team Types</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Six groups that order team shirts.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {teamTypes.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Custom team shirts for Vegas leagues, events, and groups.
 </h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Little League, corporate softball, a charity 5K, a family reunion, a bachelor party. The order looks different each time, but the job is the same: get everyone in the same shirt by the same date, at a per-shirt price the group can live with.
 </p>
 <p>
 Start with what the shirt has to do. For basketball, soccer, baseball, or lacrosse, go with performance polyester or a mesh jersey, because it dries fast enough to play in Vegas heat without turning into a wet rag. Cotton gets heavy and stays wet. For reunions, charity walks, school spirit, or office events, a cotton tee is the budget pick and a tri-blend feels softer. For staff who wear the shirt on shift, see <a href="/custom-polo-shirts-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">custom polo shirts for staff uniforms in Las Vegas</a>.
 </p>
 <p>
          The decoration comes down to your quantity, your art, and the fabric. Screen printing, DTF, and sublimation each suit different orders, and we price the ones that fit yours. For small runs and polyester jerseys, see <a href="/dtf-printing-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">DTF, DTG and dye sublimation printing in Las Vegas</a>.
 </p>
 <p>
          Names and numbers are what make it look like a real team. Heat-applied vinyl works for one-color names and numbers, and sublimation can build them into a polyester jersey. Send the roster early, since personalization adds to the price and the schedule.
 </p>
 <p>
 See our <a href="/services/screen-printing-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">screen printing service page</a>, our <a href="/dtf-printing-las-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">DTF printing guide</a>, and our <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">shirts-per-crew math</a> to work out how many to order. If you have been ordering online, see <a href="/customink-alternatives/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Custom Ink alternatives for team shirts</a>.
 </p>
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Team shirt questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/services/screen-printing-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Screen Printing</h3>
 <p class="mt-2 text-sm text-ash">Big team runs, usually the lowest cost per shirt.</p>
 </a>
 <a href="/dtf-printing-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">DTF Printing</h3>
 <p class="mt-2 text-sm text-ash">Small-batch teams and full-color or photographic art.</p>
 </a>
 <a href="/catalog/t-shirts/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse T-Shirt Catalog</h3>
          <p class="mt-2 text-sm text-ash">Cotton, performance, blend, and jersey options.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="bg-charcoal py-20">
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to outfit your team?</h2>
 <p class="mb-8 text-lg text-white/80">Send your team name, roster, and event date.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
