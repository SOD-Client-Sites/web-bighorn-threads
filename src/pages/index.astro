---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Image, Picture } from 'astro:assets'
import heroPhoto from '@/assets/generated/hero-ram.jpg'
import foremanPhoto from '@/assets/generated/founder-steve-desk.jpg'

const faqs = [
 {
 q: "What's the minimum order?",
 a: 'Minimums vary by garment, decoration method, supplier, and order specifications. We confirm the current minimum in your quote.',
 },
 {
 q: 'How fast can you turn around a rush job?',
 a: "Share the required date before ordering. We will check current garment availability and partner production capacity, then confirm any available rush option in writing.",
 },
 {
 q: 'Do you handle hi-vis and FR compliance?',
 a: 'We can source hi-vis and flame-resistant garments and coordinate decoration. The employer must select the required protection. Each proposed product and decoration must be reviewed against the exact garment manufacturer’s current written instructions before approval.',
 },
 {
 q: 'Can you match our existing logo colors?',
 a: 'Share your brand standards and current artwork. Available ink and thread colors, proofing steps, and tolerances are confirmed for the quoted decoration method.',
 },
 {
 q: 'What’s a company store and do we need one?',
 a: 'A company store can help teams manage approved products and recurring orders. Whether it fits depends on your ordering volume, roles, budgets, and fulfillment needs.',
 },
 {
 q: 'Do we have to commit to a subscription?',
 a: 'Program, portal, and pricing terms are confirmed in your proposal. Ask for a written comparison between a one-time order and an ongoing company store.',
 },
 {
 q: "Can you ship to job sites or employees' homes?",
 a: 'Available delivery destinations and any split-shipment terms are confirmed for each order before production.',
 },
 {
 q: 'How do you handle reorders?',
 a: 'Available artwork and production specifications can support a reorder. Garment availability, colors, placement, pricing, and current production conditions are reviewed before approval.',
 },
]

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}

const services = [
 {
 title: 'Screen Printing',
 desc: 'Screen printing coordinated for crew apparel and branded programs. Garment, ink, quantity, setup, and current minimums are confirmed in the quote.',
 img: '/images/generated/service-screen-printing.jpg',
 href: '/services/screen-printing-las-vegas/',
 tag: 'Decoration',
 },
 {
 title: 'Embroidery',
 desc: 'Embroidery coordinated for polos, jackets, beanies, and approved workwear. Digitizing, thread colors, placement, minimums, and protective-garment requirements are confirmed per order.',
 img: '/images/generated/service-embroidery.jpg',
 href: '/services/embroidery-las-vegas/',
 tag: 'Decoration',
 },
 {
 title: 'Branded Apparel',
 desc: 'Role-based kits for crew, supervisor, and office staff. Hi-vis tees and vests (ANSI/ISEA 107), FR shirts (NFPA 70E), embroidered polos, softshells, and branded hard hats.',
 img: '/images/generated/service-branded-apparel.jpg',
 href: '/services#branded-apparel',
 tag: 'Apparel',
 },
 {
 title: 'Promotional Products',
 desc: 'Branded swag for trade shows, golf tournaments, and client gifts. Drinkware, bags, safety gear, tech.',
 img: '/images/generated/product-stack.jpg',
 href: '/promo-products-las-vegas/',
 tag: 'Promo',
 },
]

const trades = [
 {
 name: 'Construction & Trades',
 href: '/industries/construction-trades/',
 items: ['Hi-vis tees & vests (ANSI 107)', 'FR-rated shirts (NFPA 70E)', 'Embroidered work polos & jackets', 'Branded hard hats & beanies'],
 },
 {
 name: 'Corporate & Office',
 href: '/industries/corporate/',
 items: ['Embroidered polos & softshells', 'Performance quarter-zips', 'New-hire onboarding kits', 'Branded drinkware & client gifts'],
 },
 {
 name: 'Education',
 href: '/industries/education/',
 items: ['Staff & faculty polos', 'Spirit wear & fan gear', 'Athletics & team apparel', 'Embroidered outerwear'],
 },
 {
 name: 'Healthcare',
 href: '/industries/healthcare/',
 items: ['Embroidered scrubs', 'Lab coats & jackets', 'Front-desk & admin polos', 'Name + credential embroidery'],
 },
 {
 name: 'Government & Public',
 href: '/industries/government/',
 items: ['Department uniforms & polos', 'ANSI hi-vis safety apparel', 'Public-works field gear', 'Branded outerwear & caps'],
 },
 {
 name: 'Gaming & Hospitality',
 href: '/industries/gaming-hospitality/',
 items: ['Guest-services & front-desk polos', 'F&B shirts & aprons', 'Housekeeping & back-of-house', 'Embroidered vests & outerwear'],
 },
 {
 name: 'Events & Teams',
 href: '/industries/events/',
 items: ['Event & booth staff apparel', 'Trade-show polos & outerwear', 'Team & league uniforms', 'Attendee giveaways & merch'],
 },
]

const industries = [
 { name: 'Corporate & Office', href: '/industries/corporate/', desc: 'Embroidered polos, onboarding kits, client gifts, event apparel' },
 { name: 'Education', href: '/industries/education/', desc: 'Staff apparel, campus spirit wear, athletics, district uniforms' },
 { name: 'Government & Public', href: '/industries/government/', desc: 'Agency uniforms, public-works field gear, ANSI hi-vis safety wear' },
 { name: 'Healthcare', href: '/industries/healthcare/', desc: 'Embroidered scrubs, lab coats, admin gear across multiple sites' },
 { name: 'Gaming & Hospitality', href: '/industries/gaming-hospitality/', desc: 'Casino, resort, and F&B uniforms from front of house to back' },
 { name: 'Events & Teams', href: '/industries/events/', desc: 'Trade-show gear, activations, and team uniforms scoped to the event' },
]

const whyPoints = [
 { title: 'Branded Programs, Not One-Offs.', desc: 'We plan branded apparel programs for corporate, education, government, healthcare, gaming, event, and trade teams. Each quote confirms the garment, decoration, proof, timing, and reorder terms.' },
 { title: 'A Deadline You Can Plan Around.', desc: 'Tell us the required date. We will check garment availability and partner production capacity before confirming the schedule in writing.' },
 { title: 'A Defined Reorder Path.', desc: 'A proposed company store can organize approved products and artwork when the selected platform supports those features. Ordering, budgets, retention, and fulfillment are confirmed in the approved program.' },
 { title: 'Las Vegas Account Management.', desc: 'Work with a Las Vegas contact who coordinates quotes, proofs, production partners, and the written terms for each order.' },
]

const process = [
 { n: '01', meta: 'Quote', title: 'Scope the Job', desc: 'Tell us crew size, gear types, deadline, and any compliance requirements such as ANSI, FR, or color matching. Quote timing depends on the complete request and partner response.' },
 { n: '02', meta: 'Proofs', title: 'Review the Proof', desc: 'Review the proposed logo placement, colors, garment, and decoration details before authorizing production.' },
 { n: '03', meta: 'Production', title: 'Partner Production', desc: 'Bighorn coordinates printing and embroidery through production partners against the approved order specification.' },
 { n: '04', meta: 'Delivery', title: 'Confirm Fulfillment', desc: 'Shipping destination, delivery method, timing, and any split-shipment terms are confirmed in the quote.' },
]

const storeSteps = [
 { n: '01', meta: 'Plan', title: 'Define The Proposed Store', desc: 'The company store proposal documents requested logos, colors, garments, users, and ordering rules. Features remain prospective until the platform is approved.' },
 { n: '02', meta: 'Configure', title: 'Confirm User Capabilities', desc: 'Catalog access, budgets, payment, reporting, and user ordering depend on the approved platform and program configuration.' },
 { n: '03', meta: 'Operate', title: 'Confirm Recurring Terms', desc: 'Artwork retention, inventory, production, fulfillment, and reorder capabilities are confirmed for the approved program.' },
]

const blogLinks = [
 { href: '/blog/what-is-embroidery-buyers-guide/', label: 'What is embroidery — buyer’s guide' },
 { href: '/blog/what-is-screen-printing/', label: 'What is screen printing — primer' },
 { href: '/blog/nfpa-70e-fr-shirts-vegas-electricians/', label: 'NFPA 70E FR shirts for Vegas electricians' },
 { href: '/blog/nevada-osha-heat-rules-2026-workwear/', label: 'Nevada OSHA heat rules — 2026 workwear' },
 { href: '/blog/hvac-uniforms-service-tech-apparel/', label: 'HVAC uniforms — service tech apparel' },
 { href: '/blog/how-to-outfit-a-construction-crew-vegas/', label: 'How to outfit a construction crew in Vegas' },
]

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/',
 name: 'Company stores & branded gear for every team that wears your logo',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title="Branded Apparel and Company Stores | Bighorn Threads"
 description="Plan branded apparel, screen printing, embroidery, and company stores with a Las Vegas account team coordinating approved orders through production partners."
>
 <!-- ════ HERO — full-bleed photographic dark band ════ -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <Picture
 src={heroPhoto}
 alt="The Bighorn Threads ram logo embroidered in gold thread on a navy company polo"
 widths={[768, 1280, 1920]}
 sizes="100vw"
 formats={['avif', 'webp']}
 fallbackFormat="jpg"
 loading="eager"
 fetchpriority="high"
 decoding="async"
 class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
 />
 <!-- Tint: dark enough for white copy, weighted to the left where text sits -->
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 sm:pt-10 lg:px-8 lg:pb-20 lg:pt-14">
 <div class="max-w-2xl">
 <p class="kicker mb-3 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Company Stores &amp; Branded Gear · Las Vegas Account Management
 </p>
 <h1 class="font-heading text-5xl font-extrabold uppercase leading-[0.92] tracking-tight text-white sm:text-6xl lg:text-[5.25rem]">
 Company stores &amp; branded gear for every team that
 <span class="text-gold-400"> wears your logo.</span>
 </h1>
 <p class="speakable-answer mt-7 max-w-xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn Threads is a Las Vegas custom apparel company that builds private company stores,
 embroidery, uniforms, and branded workwear for teams across construction, corporate, education,
 healthcare, and government. We manage the account and coordinate production through qualified partners.
 </p>
 <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
 702.904.8923
 </a>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ TRUSTED-BY STRIP — paper ════ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">Who We Outfit</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 One partner for <span class="text-gold-600">every team.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Construction crews, corporate offices, schools, hospitals, and public agencies all need a clear
 path for branded gear, sizing, and reorders. Bighorn can scope a company store around an approved platform and written program terms.
 </p>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 <a href="/industries/construction-trades/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Construction &amp; Trades</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">GCs, electrical, plumbing, HVAC, roofing, concrete, steel — hi-vis &amp; FR to spec.</p>
 </a>
 <a href="/industries/corporate/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Corporate &amp; Office</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">Employee gear, onboarding kits, client gifts, and event apparel.</p>
 </a>
 <a href="/industries/education/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Education</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">Districts, campuses, and athletics — staff apparel and spirit wear.</p>
 </a>
 <a href="/industries/healthcare/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Healthcare</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">Embroidered scrubs, lab coats, and admin gear across multiple sites.</p>
 </a>
 <a href="/industries/government/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Government &amp; Public</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">Agency uniforms, public-works field gear, and ANSI hi-vis safety apparel.</p>
 </a>
 <a href="/industries/gaming-hospitality/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Gaming &amp; Hospitality</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">Casinos, resorts, and F&amp;B — front-of-house to back-of-house uniforms.</p>
 </a>
 <a href="/industries/events/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">Events &amp; Teams</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">Trade shows, activations, and team uniforms — on deadline, sized right.</p>
 </a>
 <a href="/industries/" class="group flex items-center justify-between border border-hairline bg-charcoal p-6 transition-colors hover:bg-navy-900">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-concrete">See all industries</h3>
 <svg class="h-5 w-5 text-gold-400 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
 </section>

 <!-- ════ SERVICES — concrete ════ -->
 <section class="bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What We Do</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 One account team. <span class="text-ash">A documented ordering path.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 From an initial team order to a managed company store, Bighorn coordinates screen printing,
 embroidery, hi-vis, protective garments, and branded apparel through production partners.
 Every quote documents the garment, decoration, proof, timing, and reorder terms.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {services.map((service) => (
 <a href={service.href} class="group flex flex-col border border-hairline bg-panel transition-colors duration-200 hover:border-gold-500">
 <div class="relative aspect-[5/4] overflow-hidden">
 <img src={service.img} alt={service.title} width="600" height="480" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
 <span class="spec absolute left-3 top-3 bg-concrete/95 px-2 py-1 text-charcoal">{service.tag}</span>
 </div>
 <div class="flex flex-1 flex-col p-6">
 <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">{service.title}</h3>
 <p class="mt-2 flex-1 text-sm leading-relaxed text-ash">{service.desc}</p>
 <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs font-medium uppercase tracking-wider text-gold-600 transition-all group-hover:gap-2.5">
 Learn more
 <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </span>
 </div>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- ════ COMPANY STORES — paper ════ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-3xl">
 <p class="kicker mb-3">Company Stores</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 How a proposed company store <span class="text-gold-600">can work.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Requested catalogs, user access, ordering controls, budgets, payment, reporting, and fulfillment are confirmed in the approved platform proposal.
 </p>
 </div>

 <ol class="grid gap-5 md:grid-cols-3">
 {storeSteps.map((step) => (
 <li class="border border-hairline bg-panel p-7">
 <div class="mb-5 flex items-baseline justify-between">
 <span class="font-heading text-5xl font-extrabold leading-none text-gold-600">{step.n}</span>
 <span class="spec border border-hairline px-2 py-1 text-ash">{step.meta}</span>
 </div>
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{step.title}</h3>
 <p class="mt-2 text-sm leading-relaxed text-ash">{step.desc}</p>
 </li>
 ))}
 </ol>

 <div class="mt-8">
 <a href="/company-stores/" class="btn-secondary text-sm">
 Review company store options
 <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
 </section>

 <!-- ════ INDUSTRIES — concrete ════ -->
 <section class="bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Industries We Serve</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 Built for the teams that run <span class="text-gold-600">Las Vegas and beyond.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Corporate, education, government, healthcare, gaming, events, and the trades. Whatever your team does, we coordinate a branded apparel program around the written specification you approve.
 </p>
 </div>

 <!-- Featured: Construction & Trades (one vertical of several) -->
 <div class="mb-5 border-l-4 border-gold-500 bg-panel">
 <div class="flex flex-col gap-6 border border-l-0 border-hairline p-7 sm:p-9 lg:flex-row lg:items-center">
 <div class="flex-1">
 <span class="spec mb-3 inline-block bg-gold-500 px-2 py-1 text-charcoal">Featured Vertical</span>
 <h3 class="font-heading text-2xl font-bold uppercase tracking-tight text-charcoal sm:text-3xl">Construction &amp; Trades</h3>
 <p class="mt-3 text-ash">
 Bighorn can plan requested apparel for GCs, electrical, plumbing, HVAC, roofing, concrete, and steel teams.
 Employers select any protective product for the exact hazard and must approve decoration against current manufacturer instructions.
 Products, company-store features, production, and fulfillment are confirmed in writing.
 </p>
 <div class="mt-4 flex flex-wrap gap-2">
 {['Hi-vis safety wear', 'Branded hard hats', 'Company stores', 'Crew uniforms', 'Client gifts'].map((tag) => (
 <span class="spec border border-hairline px-2.5 py-1 text-ash">{tag}</span>
 ))}
 </div>
 </div>
 <a href="/get-a-quote/" class="btn-primary shrink-0 text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {industries.map((industry) => (
 <a href={industry.href} class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">{industry.name}</h3>
 <p class="mt-1.5 text-sm leading-relaxed text-ash">{industry.desc}</p>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- ════ WHY BIGHORN — paper, with photo ════ -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Why Bighorn Threads</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 Las Vegas account support. <span class="text-gold-600">Written order terms.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Contact the Las Vegas account team for product planning, artwork coordination, proofs, and current order terms. Response timing and any on-site service are confirmed for the request.
 </p>
 <div class="mt-8 divide-y divide-hairline border-y border-hairline">
 {whyPoints.map((item) => (
 <div class="flex gap-4 py-5">
 <svg class="mt-0.5 h-5 w-5 shrink-0 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
 <div>
 <h3 class="font-heading text-base font-bold uppercase tracking-tight text-charcoal">{item.title}</h3>
 <p class="mt-1 text-sm leading-relaxed text-ash">{item.desc}</p>
 </div>
 </div>
 ))}
 </div>
 </div>

 <div class="border border-hairline bg-panel p-2">
 <Picture
 src={foremanPhoto}
 alt="Representative branded-apparel account team member in a navy polo"
 widths={[480, 768, 1024]}
 sizes="(min-width: 1024px) 50vw, 100vw"
 formats={['avif', 'webp']}
 fallbackFormat="jpg"
 loading="lazy"
 decoding="async"
 class="h-full w-full object-cover"
 />
 </div>
 </div>
 </div>
 </section>

 <!-- ════ GEAR BY INDUSTRY — concrete ════ -->
 <section class="bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-3xl">
 <p class="kicker mb-3">Gear by Industry</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 Product options <span class="text-gold-600">by team.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Product needs vary by role, use, employer requirements, care process, and budget.
 Bighorn can request current options from brands such as Carhartt, Bulwark, Port Authority, ML Kishigo, and Red Kap.
 Availability, performance, decoration, and manufacturer instructions are reviewed for the exact quoted product.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {trades.map((trade) => (
