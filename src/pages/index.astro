---
import { Image } from 'astro:assets'
import apparelHero from '@/assets/bighorn-apparel-hero.png'
import stevePhoto from '@/assets/steve-dodson-ref.jpg'
import { productPhotos } from '@/data/productPhotos'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProofStrip from '@/components/ProofStrip.astro'

const link = 'text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500'

const faqs = [
 {
 q: "What's the minimum order?",
 a: 'Each garment and decoration method has its own minimum. Send the item you want and a rough count, and we will tell you the minimum for that job. Our MOQ guide explains why the numbers differ.',
 html: `Each garment and decoration method has its own minimum. Send the item you want and a rough count, and we will tell you the minimum for that job. Our <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="${link}">MOQ guide</a> explains why the numbers differ.`,
 },
 {
 q: 'How much does custom apparel cost for a team?',
 a: 'Three things set the price: the garment, how it is decorated, and how many you order. Our cost breakdown for a team of 50 and our guide to uniform cost per employee show how each one moves the number.',
 html: `Three things set the price: the garment, how it is decorated, and how many you order. Our <a href="/cost-custom-apparel-team-of-50/" class="${link}">cost breakdown for a team of 50</a> and our guide to <a href="/uniform-program-cost-per-employee/" class="${link}">uniform cost per employee</a> show how each one moves the number.`,
 },
 {
 q: 'How fast can you turn around a rush job?',
 a: 'Call with your date before you order. We check whether the garment is in stock and whether a shop has room, then tell you if the date works. See rush order options.',
 html: `Call with your date before you order. We check whether the garment is in stock and whether a shop has room, then tell you if the date works. See <a href="/services/rush-orders-las-vegas/" class="${link}">rush order options</a>.`,
 },
 {
 q: 'Do you handle hi-vis and FR gear?',
 a: 'Yes. You tell us the protection level the job calls for, and we find garments rated for it. Some FR and hi-vis gear limits how and where a logo can go, so we check the maker’s instructions before anything is made. Our safety and compliance guides cover ANSI/ISEA 107 and NFPA 70E.',
 html: `Yes. You tell us the protection level the job calls for, and we find garments rated for it. Some FR and hi-vis gear limits how and where a logo can go, so we check the maker’s instructions before anything is made. Our <a href="/safety-compliance/" class="${link}">safety and compliance guides</a> cover ANSI/ISEA 107 and NFPA 70E.`,
 },
 {
 q: 'Can you match our logo colors?',
 a: 'Send your logo and any brand colors you have. You will see the colors and placement on a proof before you approve the order.',
 },
 {
 q: 'What’s a company store and do we need one?',
 a: 'It is a private online store with your approved gear, where your people order their own sizes. It pays off when you reorder often, hire often, or have staff in several places. For a one-time order, a regular quote is simpler.',
 },
 {
 q: 'Do we have to commit to a subscription?',
 a: 'Not for a regular order. If you want a company store, your proposal spells out any setup or monthly charge before you agree.',
 },
 {
 q: "Can you ship to job sites or employees' homes?",
 a: 'Yes. We ship anywhere in the US, to one address or several. Send the list of addresses and we will price the shipping.',
 },
 {
 q: 'How do you handle reorders?',
 a: 'Call or email us and tell us what you want again. We check that the garment and color are still available and send you the current price.',
 },
 {
 q: 'Can you outfit teams in other states?',
 a: 'Yes. We ship nationwide, including to teams spread across several locations.',
 html: `Yes. We <a href="/locations/nationwide/" class="${link}">ship nationwide</a>, including to teams spread across several locations.`,
 },
]

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}

const services = [
 { title: 'Printed Shirts & Hoodies', desc: 'Company shirts, event tees, and sweatshirts with your design.', ...productPhotos.tee, href: '/services/screen-printing-las-vegas/' },
 { title: 'Embroidered Apparel', desc: 'Your logo stitched onto polos, jackets, and caps.', ...productPhotos.polo, href: '/services/embroidery-las-vegas/' },
 { title: 'Workwear & Uniforms', desc: 'Work shirts, crew uniforms, and safety apparel for the job.', ...productPhotos.workShirt, href: '/services/#branded-apparel' },
 { title: 'Promotional Products', desc: 'Branded drinkware, bags, and gifts for customers and events.', ...productPhotos.tumbler, href: '/promo-products-las-vegas/' },
]

const industries = [
 { name: 'Construction & Trades', href: '/industries/construction-trades/', desc: 'Crew shirts, hi-vis, FR options, and branded hard hats' },
 { name: 'Corporate & Office', href: '/industries/corporate/', desc: 'Polos, new-hire kits, client gifts, and event gear' },
 { name: 'Education', href: '/industries/education/', desc: 'Staff polos, spirit wear, and athletics' },
 { name: 'Healthcare', href: '/industries/healthcare/', desc: 'Embroidered scrubs, lab coats, and front-desk polos' },
 { name: 'Government & Public', href: '/industries/government/', desc: 'Department polos and public-works field gear' },
 { name: 'Gaming & Hospitality', href: '/industries/gaming-hospitality/', desc: 'Casino, resort, and food-service uniforms' },
 { name: 'Events & Teams', href: '/industries/events/', desc: 'Booth staff apparel, team uniforms, and giveaways' },
]

const process = [
 { n: '1', title: 'Tell us the job', desc: 'Send your logo, what you want, how many, and the date you need it.' },
 { n: '2', title: 'See it first', desc: 'You get a price and a proof showing the garment, colors, and logo placement.' },
 { n: '3', title: 'We get it made', desc: 'Once you approve, a production partner suited to the job makes it.' },
 { n: '4', title: 'It ships to you', desc: 'One address or several. Need more later? Call us and we pull up your order.' },
]

const blogLinks = [
 { href: '/blog/what-is-embroidery-buyers-guide/', label: 'What to know before you order embroidery' },
 { href: '/blog/what-is-screen-printing/', label: 'How screen printing works' },
 { href: '/cost-custom-apparel-team-of-50/', label: 'What apparel costs for a team of 50' },
 { href: '/how-to-choose-custom-apparel-company/', label: 'How to choose an apparel company' },
 { href: '/blog/hvac-uniforms-service-tech-apparel/', label: 'Uniforms for HVAC service techs' },
 { href: '/screen-printing-vs-dtg-vs-embroidery/', label: 'Screen printing vs DTG vs embroidery' },
]

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'
const phoneIcon = 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/',
 name: 'Custom screen printing, embroidery, and company stores',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1','.speakable-answer'],
 },
}
---

<BaseLayout
 title="Custom Screen Printing, Embroidery & Company Stores Nationwide | Bighorn Threads"
 description="Custom screen printing, embroidery, uniforms, and private company stores for crews and teams across the US. Send your logo and get a price and a proof."
>
 <!-- Hero: real product photography on the light canvas -->
 <section class="bg-concrete">
 <div class="page-hero-home mx-auto grid max-w-7xl items-center gap-6 px-4 pb-10 pt-6 sm:px-6 lg:grid-cols-[1fr_1.2fr] lg:gap-14 lg:px-8 lg:pb-20 lg:pt-14">
 <div>
 <p class="kicker mb-4">Las Vegas · Shipping nationwide</p>
 <h1 class="font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-6xl">
 Custom apparel<br />for your team.
 </h1>
 <p class="mt-4 font-subheading text-lg font-semibold text-ash sm:text-2xl">Screen printing, embroidery, and company stores</p>
 <p class="speakable-answer mt-4 max-w-xl text-base leading-relaxed text-charcoal sm:text-lg">
 Choose your gear. Send your logo. We handle the printing or embroidery and ship your order nationwide.
 </p>
 <div class="mt-5 flex flex-wrap items-center gap-3">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 <a href="tel:+17029048923" class="hidden items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal sm:inline-flex transition-colors hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={phoneIcon} /></svg>
 702.904.8923
 </a>
 </div>
 </div>
 <figure>
 <Image src={apparelHero} alt="Bighorn ram logo shown as screen print on a T-shirt and embroidery on a navy cap and charcoal polo" widths={[640, 960, 1536]} sizes="(min-width: 1024px) 55vw, 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" class="aspect-[3/2] w-full object-cover" />
 <figcaption class="mt-2 text-xs text-ash">Bighorn apparel mockup · Screen printing &amp; embroidery</figcaption>
 </figure>
 </div>
 </section>

 <ProofStrip tone="paper" />

 <!-- What we make -->
 <section class="bg-concrete py-16 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Start with the gear</h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Shop shirts, uniforms, hats, and gifts in our <a href="/catalog/" class={link}>product catalog</a>. Need help choosing? Tell us who you’re ordering for and your budget.
 </p>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {services.map((service) => (
 <a href={service.href} class="group flex flex-col border border-hairline bg-panel transition-colors duration-200 hover:border-gold-500">
 <div class="border-b border-hairline">
 <img src={service.src} alt={service.alt} width="300" height="300" loading="lazy" decoding="async" class="aspect-[5/4] w-full bg-white object-contain p-6" />
 </div>
 <div class="flex flex-1 flex-col p-6">
 <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-700">{service.title}</h3>
 <p class="mt-2 flex-1 text-sm leading-relaxed text-ash">{service.desc}</p>
 </div>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- How an order works: a real sequence, so the numbers stay -->
 <section class="border-y border-hairline bg-paper py-16 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-10 max-w-2xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">How an order works</h2>
 <ol class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
 {process.map((step) => (
 <li class="border-t-2 border-charcoal pt-4">
 <span class="font-mono text-sm text-gold-700">Step {step.n}</span>
 <h3 class="mt-1 font-heading text-xl font-bold uppercase tracking-tight text-charcoal">{step.title}</h3>
 <p class="mt-2 leading-relaxed text-ash">{step.desc}</p>
 </li>
 ))}
 </ol>
 </div>
 </section>

 <!-- Who we outfit + company stores -->
 <section class="bg-concrete py-16 sm:py-24">
 <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.4fr_1fr] lg:gap-16 lg:px-8">
 <div>
 <h2 class="mb-8 font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Who we outfit</h2>
 <ul class="divide-y divide-hairline border-y border-hairline">
 {industries.map((industry) => (
 <li>
 <a href={industry.href} class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-6">
 <span class="shrink-0 font-heading text-lg font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-700 sm:w-64">{industry.name}</span>
 <span class="text-sm leading-relaxed text-ash">{industry.desc}</span>
 </a>
 </li>
 ))}
 </ul>
 </div>
 <aside class="self-start border border-hairline bg-panel p-7 sm:p-8">
 <p class="kicker mb-4">Company stores</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal">Let your team order their own sizes.</h2>
 <p class="mt-4 leading-relaxed text-ash">
 Give employees one place to order your approved apparel. We help you choose the products and work out pricing, ordering, and delivery before the store is set up.
 </p>
 <a href="/company-stores/" class="btn-secondary mt-6 text-sm">
 How company stores work
 <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </aside>
 </div>
 </section>

 <!-- The person behind it -->
 <section id="meet-steve" aria-labelledby="founder-heading" class="border-y border-hairline bg-paper py-12 sm:py-20">
 <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 sm:px-6 md:grid-cols-[minmax(0,418px)_1fr] md:gap-14 lg:px-8 lg:gap-20">
 <figure class="w-full max-w-[418px]">
 <Image src={stevePhoto} alt="Steve Dodson in his Las Vegas office" width={418} height={418} format="webp" quality={90} loading="lazy" class="aspect-square h-auto w-full object-cover" />
 <figcaption class="mt-3 font-subheading text-base text-ash">Steve Dodson · Founder, Bighorn Threads &amp; VP Promos</figcaption>
 </figure>
 <div>
 <p class="kicker mb-4">Meet the founder</p>
 <h2 id="founder-heading" class="font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-6xl">Steve Dodson</h2>
 <p class="mt-6 text-xl leading-relaxed text-charcoal">Steve founded Bighorn Threads and its parent company, VP Promos, in Las Vegas.</p>
 <p class="mt-4 text-lg leading-relaxed text-ash">His team helps you choose the apparel, coordinates the logo work with production partners, and follows your order through delivery.</p>
 <blockquote class="mt-7 border-t border-hairline pt-6">
 <p class="text-lg leading-relaxed text-charcoal">“I've worked with them for over 14 years for all my event promotional needs.”</p>
 <footer class="mt-2 text-sm text-ash">Nadia G. · Client review</footer>
 </blockquote>
 <a href="/about/" class="btn-secondary mt-7">More about Steve &amp; Bighorn</a>
 </div>
 </div>
 </section>

 <!-- FAQ -->
 <section class="bg-concrete py-16 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-8 font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Questions we get</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((item) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <span class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{item.q}</span>
 <svg class="h-5 w-5 shrink-0 text-gold-700 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
 </summary>
 {item.html ? <p class="pb-5 leading-relaxed text-ash" set:html={item.html} /> : <p class="pb-5 leading-relaxed text-ash">{item.a}</p>}
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="bg-paper py-12">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-5 font-heading text-2xl font-extrabold uppercase tracking-tight">Guides</h2>
 <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
 {blogLinks.map((item) => (
 <li><a href={item.href} class={`text-sm font-medium ${link}`}>{item.label}</a></li>
 ))}
 </ul>
 </div>
 </section>

 <!-- Closing call to action -->
 <section class="border-t border-hairline bg-paper">
 <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
 <div>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">Have a logo and a date?</h2>
 <p class="mt-3 text-lg text-ash">That is enough to get started.</p>
 </div>
 <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 <a href="tel:+17029048923" class="px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal hover:text-gold-700">702.904.8923</a>
 </div>
 </div>
 </section>

 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify({
 '@context': 'https://schema.org',
 '@type': 'WebSite',
 name: 'Bighorn Threads',
 url: 'https://bighornthreads.com',
 potentialAction: {
 '@type': 'SearchAction',
 target: {
 '@type': 'EntryPoint',
 urlTemplate: 'https://bighornthreads.com/catalog/search/?q={search_term_string}',
 },
 'query-input': 'required name=search_term_string',
 },
 })} />
</BaseLayout>
