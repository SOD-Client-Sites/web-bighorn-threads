---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const areas = [
 {
 href: '/service-areas/henderson-nv/',
 name: 'Henderson, NV',
 blurb:
 'Master-planned community build-out, south-valley service trades, and Henderson commercial work.',
 },
 {
 href: '/service-areas/north-las-vegas/',
 name: 'North Las Vegas',
 blurb:
 'Apex Industrial Park, Aliante build-out, and the north-valley GC ecosystem. Heavy industrial and distribution crews running long days in hot conditions.',
 },
 {
 href: '/service-areas/summerlin/',
 name: 'Summerlin',
 blurb:
 'West-side residential and mixed-use commercial. Downtown Summerlin, Red Rock, and The Ridges. Clean-presentation crews for visible work.',
 },
 {
 href: '/service-areas/spring-valley/',
 name: 'Spring Valley',
 blurb:
 'Mid-valley service trades and smaller commercial fit-out. HVAC, plumbing, and electrical shops running daily calls across the west side.',
 },
 {
 href: '/service-areas/boulder-city/',
 name: 'Boulder City',
 blurb:
 'Hoover Dam, Eldorado Valley solar fields, and Railroad Pass industrial. Solar EPCs and utility crews.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://bighornthreads.com/service-areas/' },
 ],
}
---

<BaseLayout
 title="Las Vegas Branded Apparel Service Areas | Bighorn Threads"
 description="Work with a Las Vegas account team for branded apparel and promotional products. Your quote confirms production, shipping, delivery, and fulfillment terms."
 canonical="https://bighornthreads.com/service-areas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-6xl px-4 pb-16 pt-14 sm:px-6 sm:pb-20 sm:pt-16 lg:px-8">
 <nav class="mb-5 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Service Areas</span>
 </nav>

 <p class="kicker mb-3">Las Vegas Valley · Southern Nevada</p>
 <h1 class="mb-5 font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Branded Apparel <span class="text-gold-700">Service Areas</span>
 </h1>
 <p class="max-w-3xl text-lg leading-relaxed text-ash sm:text-xl">
 Branded apparel for teams across the Las Vegas Valley, from a team based in town. Your quote lists stock, timing, and delivery.
 </p>
  <HeroProducts />
 </div>
 </section>

 <!-- Areas grid — concrete -->
 <section class="bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {areas.map((a) => (
 <a href={a.href} class="group flex flex-col border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <span class="spec mb-2 text-gold-600">Las Vegas Valley</span>
 <h2 class="mb-3 font-heading text-xl font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">{a.name}</h2>
 <p class="mb-5 flex-1 text-sm leading-relaxed text-ash">{a.blurb}</p>
 <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-bold uppercase tracking-wider text-gold-600">
 View details
 <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </span>
 </a>
 ))}
 </div>

 <p class="mt-10 max-w-3xl text-base leading-relaxed text-ash">
 Still deciding whether a branded program pays off? Read <a href="/is-branded-apparel-worth-it/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">is branded apparel worth it for a service business</a>.
 </p>

 <div class="mt-12 border-l-4 border-gold-500 bg-panel">
 <div class="border border-l-0 border-hairline p-8 text-center sm:p-10">
 <h2 class="mb-3 font-heading text-2xl font-extrabold uppercase tracking-tight text-charcoal sm:text-3xl">Outside these areas?</h2>
 <p class="mx-auto mb-6 max-w-2xl text-base leading-relaxed text-ash">
We ship anywhere in the US. Call us with the locations and your deadline, and your quote will list shipping to each.
 </p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
 <a href="tel:+17029048923" class="btn-primary text-base">Call 702.904.8923</a>
 <a href="/contact/" class="btn-secondary text-base">Send us a note</a>
 </div>
 </div>
 </div>
 </div>
 </section>
</BaseLayout>
