---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Branded Apparel Planning for Summerlin Teams',
 description:
 'Branded-apparel planning for Summerlin contractors and service teams. Products, decoration, quantities, production, and delivery are confirmed in each quote.',
 h1Pre: 'Summerlin',
 hero: '/images/generated/cta-bluehour.jpg',
}

const localContext = [
 {
 code: 'Project Context',
 title: 'Residential and commercial planning',
 body: 'For projects in Summerlin, the apparel request can be organized by role, work setting, employer requirements, product, artwork, quantity, and deadline.',
 },
 {
 code: 'Active Trades',
 title: 'Options for local trade teams',
 body: 'General contractors, service trades, pool and landscape teams, and finish trades can request role-based apparel. Current service area, products, decoration, and delivery terms are confirmed per quote.',
 },
 {
 code: 'What Crews Need Locally',
 title: 'Products selected for each role',
 body: 'Customer-facing teams may prefer embroidered polos over printed tees. Bighorn can quote selected Port Authority, Carhartt, and OGIO options. Product availability and repeat-order details require a current review.',
 },
]

const trades = [
 {
 name: 'General Contractors',
 detail: 'Foreman and field-crew differentiation for general-contractor and commercial fit-out roles.',
 href: '/industries/general-contractors-las-vegas/',
 img: '/images/generated/kit-office-sales.jpg',
 },
 {
 name: 'Plumbing & HVAC',
 detail: 'Embroidered service polos for techs walking into Summerlin Cliffs and Mesa Ridge custom homes.',
 href: '/industries/plumbing-hvac-las-vegas/',
 img: '/images/generated/kit-plumbing-hvac.jpg',
 },
 {
 name: 'Electrical Contractors',
 detail: 'Service polos and FR layers for residential and commercial electrical across the Summerlin master plan.',
 href: '/industries/electrical-contractors-las-vegas/',
 img: '/images/generated/kit-electrical.jpg',
 },
 {
 name: 'Roofing & Solar',
 detail: 'Branded crew tees and hi-vis for tile, solar, and high-end residential roof work in Summerlin estates.',
 href: '/industries/roofing-solar-las-vegas/',
 img: '/images/generated/service-screen-printing.jpg',
 },
]

const useCases = [
 'Embroidered button-downs requested for customer-facing general-contractor roles',
 'Branded polos with company identification and client-approved license artwork',
 'Foreman polos requested for commercial fit-out teams',
 'Embroidered polos requested for HVAC, plumbing, or electrical service roles',
 'Branded long-sleeves reviewed for the exact work, use, care, and manufacturer instructions',
 'Promotional products requested for local association or community events',
]

const faqs = [
 {
 q: 'How should we plan apparel for customer-facing Summerlin residential work?',
 a: 'Some teams choose polos for customer-facing technicians and branded tees for shop or ride-along roles. Your brand, work conditions, budget, product availability, decoration, and written order terms should guide the final program.',
 },
 {
 q: 'Do you have polo colors that work on light stucco and natural-stone properties?',
 a: 'Port Authority K500 polos are available in multiple supplier colors. Current availability, logo treatment, thread colors, and placement are confirmed in the quote and proof.',
 },
 {
 q: 'How fast can you turn around a new uniform program for a Summerlin commercial fit-out crew?',
  a: 'Production timing depends on the selected partner, product availability, artwork approval, quantity, and order details. File retention and reorder timing are confirmed in the approved program and current quote.',
 },
 {
 q: 'Can you do company-store setup so each crew can order their own approved kit?',
 a: 'A managed company store can be useful for a growing service team. Access, allowances, payment, inventory responsibility, production, shipping, and fees depend on the approved configuration.',
 },
 {
 q: 'Do you deliver to Summerlin commercial addresses?',
  a: 'Service-area eligibility, delivery, pickup, and cost are not assumed. The written quote must confirm the exact destination and handoff plan before approval.',
 },
 {
 q: 'What\'s the minimum for an embroidered polo run?',
 a: 'Minimum quantities depend on the product, decoration method, and production partner. Share your quantity and deadline. Bighorn will confirm current terms in the quote.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://bighornthreads.com/service-areas/' },
 { '@type': 'ListItem', position: 3, name: 'Summerlin', item: 'https://bighornthreads.com/service-areas/summerlin/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/service-areas/summerlin/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/service-areas/" class="hover:text-gold-400">Service Areas</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Summerlin</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Planning Branded Apparel for <span class="text-gold-400">Summerlin Teams.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Summerlin teams can request a branded-apparel quote. Service-area eligibility, products, decoration, quantity, production, delivery, and handoff terms require written confirmation.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Local context — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Plan apparel around <span class="text-gold-600">the exact project.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Residential, service, and commercial teams may need different products by role. Bighorn coordinates requested artwork and proofs with production partners, then documents current order terms.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {localContext.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline px-2.5 py-1 text-gold-600">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Trades we serve here — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Trades</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Planning by trade for <span class="text-gold-600">Summerlin teams.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Service teams can compare polos, tees, work shirts, and outerwear for customer-facing, field, shop, and warehouse roles. The exact product, use, care, employer requirements, and manufacturer instructions guide the selection.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {trades.map((t) => (
 <a href={t.href} class="group flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={t.img} alt={t.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">{t.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{t.detail}</p>
 </div>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- Typical orders — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Planning Scenarios</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options for <span class="text-gold-600">Summerlin shops.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Customer-facing teams may compare polos, tees, and outerwear. Minimums, product availability, reorder cadence, and timing depend on the approved program.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="space-y-3">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 border border-hairline bg-panel p-4 transition-colors hover:border-gold-500">
 <span class="shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Local context — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom branded apparel for Summerlin contractors, service trades, and HOA operations.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 Summerlin customer-facing teams can request an apparel-program quote. Service-area eligibility, production partner, delivery, products, pricing, and timing require written confirmation.
 </p>
 <p>
 Summerlin landscape, irrigation, pool service, and pest control teams may consider moisture-wicking polos, work shirts, pants, or shorts. Bighorn can request current product options and coordinate approved decoration through a selected production partner. Employers remain responsible for heat planning and final garment approval.
 </p>
 <p>
 Summerlin residential general contractors and luxury home builders may prefer premium apparel for customer-facing roles. Bighorn can manage quotes for selected polos, softshells, and field workwear, with production coordinated through approved partners. Product availability, decoration, quantities, and timing are confirmed in writing.
 </p>
 <p>
 Summerlin HOA grounds-maintenance and community services contracts may include specific branding requirements. Bighorn can organize approved logo, license-number, color, and placement details for review by a selected production partner. Current artwork, product, and decoration terms are confirmed for each order.
 </p>
 <p>
 Delivery availability, destination, shipping, and fees require confirmation in the written quote. Any proposed allowances, inventory responsibility, reorder cadence, and store capabilities require separate written approval.
 </p>
 <p>
 Related planning resources for Summerlin: <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Class 2 hi-vis</a>, <a href="/blog/rush-order-shirts-las-vegas-whats-possible/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">rush orders</a>, <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">new hire checklist</a>, and <a href="/industries/plumbing-hvac-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">plumbing &amp; HVAC service uniforms</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Questions to ask before ordering.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Nearby &amp; Related</p>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 <a href="/service-areas/spring-valley/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Spring Valley</h3>
 <p class="mt-2 text-sm text-ash">Service-trade programs with terms confirmed in each quote.</p>
 </a>
 <a href="/service-areas/henderson-nv/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Henderson, NV</h3>
 <p class="mt-2 text-sm text-ash">Master-planned community build-out — the other end of the valley.</p>
 </a>
 <a href="/service-areas/boulder-city/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Boulder City</h3>
 <p class="mt-2 text-sm text-ash">Solar-farm and utility crews along the US-93 corridor.</p>
 </a>
 <a href="/industries/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">All Industries</h3>
 <p class="mt-2 text-sm text-ash">Trade-specific gear, brands, and compliance — pick your industry.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Plan apparel for <span class="text-gold-400">your Summerlin team.</span></h2>
 <p class="mb-8 text-lg text-navy-200">Send the roles, requested products, artwork, quantities, and deadline for a current quote.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
