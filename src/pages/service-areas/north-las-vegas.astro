---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Branded Apparel Planning for North Las Vegas Teams',
 description:
 'North Las Vegas teams can request branded-apparel planning. Service-area eligibility, products, production, timing, and handoff terms require a current written quote.',
 h1Pre: 'North Las Vegas',
}

const localContext = [
 {
 code: 'Major Projects',
 title: 'Plan around the project and crew',
 body: 'Tell us each role, the site rules, and your start date, and we will build the order around them.',
 },
 {
 code: 'Active Trades',
 title: 'Trades to plan for',
 body: 'The local contractor mix can include industrial electrical, mechanical, process-piping, steel-erection, concrete, and fire-protection teams. ',
 },
 {
 code: 'What Crews Need Locally',
 title: 'Safety rules come first',
 body: 'Data center general contractors and warehouse owners run tight safety programs. The employer or site safety team must define each requirement. Bighorn handles the quote and gets the approved products decorated.',
 },
]

const trades = [
 {
 name: 'Electrical Contractors',
 detail: 'Employer-selected arc-rated and hi-vis apparel options for electrical and data center fit-out crews.',
 href: '/industries/electrical-contractors-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=549020207&RS=300',
 },
 {
 name: 'General Contractors',
 detail: 'Sub identification, foreman differentiation, and onboarding kits for industrial and warehouse builds.',
 href: '/industries/general-contractors-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52969&P=968353380&RS=300',
 },
 {
 name: 'Plumbing & HVAC',
 detail: 'Mechanical and process piping crews on Apex and VVSEP warehouse and data center mechanical packages.',
 href: '/industries/plumbing-hvac-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=68414&P=945769040&RS=300',
 },
 {
 name: 'Roofing & Solar',
 detail: 'TPO and rooftop solar crews on industrial and warehouse roof systems across NLV.',
 href: '/industries/roofing-solar-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=722090562&RS=300',
 },
]

const useCases = [
 'Data center electrical subcontractors using employer-approved protective apparel and site identification',
 'Steel erection crews using employer-approved hi-vis garments and branded-apparel options',
 'Warehouse mechanical contractors in embroidered work shirts with name patches',
 'Fire sprinkler crews in branded button-downs with license number on the sleeve',
 'GC superintendents in differentiated polos for industrial and warehouse jobs',
 'Onboarding kits built from employer-approved garments and quantities for new industrial hires',
]

const faqs = [
 {
 q: 'We\'re running an electrical crew at a Vegas data center. Can you do FR-rated gear with our company branding?',
 a: 'Bighorn can source proposed protective garments from brands such as Bulwark and Carhartt. The employer selects the required rating through a task-specific hazard assessment, and each garment and decoration must be reviewed against the exact current manufacturer instructions before approval.',
 },
 {
 q: 'How fast can you turn around hi-vis for a North Las Vegas industrial crew that just landed a new contract?',
  a: 'Give us your date and we will check it against product stock and production capacity. Existing approved program files can reduce setup time on reorders.',
 },
 {
 q: 'Can you quote ANSI Class 2 hi-vis in bulk for an 80-plus-shirt order?',
 a: 'Bighorn can check current availability and pricing for you. Your employer must approve the exact product and classification before the order is placed.',
 },
 {
 q: 'Can you do gate-visible sub identification, different shirts for each subcontractor on the same data center build?',
 a: 'A program can include approved colorways and decoration plans for different subcontractors. The GC controls site identification rules, and each new order is subject to product availability, partner capacity, artwork approval, and quoted timing.',
 },
 {
 q: 'Do you deliver to Apex Industrial Park and the VVSEP corridor?',
  a: 'Send the site address and gate rules, and your quote will show the delivery plan and cost.',
 },
 {
 q: 'What\'s the minimum for branded crew gear?',
 a: 'Your quote lists the minimum for the product and decoration you pick. Share your quantities and project schedule so the written proposal can define the order terms.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://bighornthreads.com/service-areas/' },
 { '@type': 'ListItem', position: 3, name: 'North Las Vegas', item: 'https://bighornthreads.com/service-areas/north-las-vegas/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/service-areas/north-las-vegas/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/service-areas/" class="hover:text-gold-700">Service Areas</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">North Las Vegas</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Planning Branded Apparel for <span class="text-gold-700">North Las Vegas Teams.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Branded apparel quotes for North Las Vegas crews, offices, and teams. Tell us the job and we confirm products, timing, and delivery in writing.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Local context — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">North Las Vegas is <span class="text-gold-600">industrial Vegas.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Apex, VVSEP, and the I-15 corridor support industrial fit-out, warehouse, and data center construction. Employers and site safety teams define protective-apparel requirements, while each quote confirms product availability and production timing.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {localContext.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline px-2.5 py-1 text-gold-600">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Trades we serve here — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Trades</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Planning by trade for <span class="text-gold-600">North Las Vegas teams.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 The local mix includes electrical, mechanical, general-contracting, roofing, and solar teams supporting industrial and warehouse work. Pick a trade to see what those crews wear.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {trades.map((t) => (
 <a href={t.href} class="group flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={t.img} alt={t.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">{t.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{t.detail}</p>
 </div>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- Typical orders — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Planning Scenarios</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options for <span class="text-gold-600">NLV industrial crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Larger project orders and recurring programs can be scoped around written safety requirements. Quantities, reorder cadence, and production timing are confirmed for each quote.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="space-y-3">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 border border-hairline bg-panel p-4 transition-colors hover:border-gold-500">
 <span class="shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Local context — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom branded apparel for North Las Vegas contractors and industrial trades.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
North Las Vegas teams work with our Las Vegas contact. Your written quote covers products, delivery, timing, and cost.
 </p>
 <p>
 The trade contractor mix in North Las Vegas leans heavily industrial. Steel erectors, electrical contractors, mechanical and HVAC shops, and structural concrete crews may need branded workwear at scale. We source the garments and arrange the decoration for each project. Employers and site safety teams approve any FR or hi-vis requirement.
 </p>
 <p>
 Industrial and data center projects in North Las Vegas can require large, phased workwear programs. The employer defines the approved kit for each role. Bighorn quotes the products and decoration, and confirms shipping and hire-date timing before you approve.
 </p>
 <p>
 North Las Vegas also has a strong mechanical and HVAC service contractor presence. Fleet programs may include industrial work shirts, pants, embroidered logos, name patches, and laundry compatibility. Tell us what you have in mind and we will check whether it can be done.
 </p>
 <p>
 Tell us where the order needs to go and we will quote the delivery.
 </p>
 <p>
 Related planning resources for North Las Vegas: <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Class 2 hi-vis</a>, <a href="/blog/rush-order-shirts-las-vegas-whats-possible/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">rush orders</a>, <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">new hire checklist</a>, and <a href="/industries/oil-gas-mechanical-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">oil, gas &amp; mechanical uniforms</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Questions to ask before ordering.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Nearby &amp; Related</p>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 <a href="/service-areas/henderson-nv/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Henderson, NV</h3>
 <p class="mt-2 text-sm text-ash">Master-planned community build-out: Cadence, Inspirada, Skye Canyon.</p>
 </a>
 <a href="/service-areas/spring-valley/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Spring Valley</h3>
 <p class="mt-2 text-sm text-ash">Service-trade dense: HVAC, plumbing, electrical residential and commercial.</p>
 </a>
 <a href="/service-areas/boulder-city/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Boulder City</h3>
 <p class="mt-2 text-sm text-ash">Solar-farm and utility crews along the US-93 corridor.</p>
 </a>
 <a href="/industries/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">All Industries</h3>
 <p class="mt-2 text-sm text-ash">Trade-specific gear, brands, and compliance. Pick your industry.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Outfitting a North Las Vegas crew? <span class="text-gold-400">Send us the list.</span></h2>
 <p class="mb-8 text-lg text-white/80">Send what your crew needs and your safety requirements. We will find the products and get your logo on them.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
