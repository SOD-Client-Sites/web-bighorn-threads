---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Branded Apparel Planning for Boulder City, NV Teams',
 description:
 'Boulder City teams can request branded-apparel planning. Service-area eligibility, products, production, timing, and handoff terms require a current written quote.',
 h1Pre: 'Boulder City, NV',
 hero: '/images/generated/cta-bluehour.jpg',
}

const localContext = [
 {
 code: 'Major Projects',
 title: 'Plan around the project and crew',
 body: 'A Boulder City apparel request can be organized by role, work setting, employer requirements, product, artwork, quantity, and deadline.',
 },
 {
 code: 'Active Trades',
 title: 'Utility electrical, solar PV, and federal subs',
 body: 'The local project mix can include electrical contractors, solar PV installation crews, racking and tracker subcontractors, civil and grading teams, and federal subcontractors. Protective apparel must come from the employer\'s task-specific hazard assessment.',
 },
 {
 code: 'What Crews Need Locally',
 title: 'Plan apparel requirements ahead',
  body: 'Boulder City orders require a clear production and handoff plan. Standing reorders can help. For protective apparel, your safety program and the garment manufacturer must set the required specification.',
 },
]

const trades = [
 {
 name: 'Electrical Contractors',
 detail: 'Employer-selected arc-rated and hi-vis apparel options for utility electrical and dam-area substation crews.',
 href: '/industries/electrical-contractors-las-vegas/',
 img: '/images/generated/kit-electrical.jpg',
 },
 {
 name: 'Roofing & Solar',
 detail: 'Employer-approved apparel options for solar PV installation and racking roles.',
 href: '/industries/roofing-solar-las-vegas/',
 img: '/images/generated/service-screen-printing.jpg',
 },
 {
 name: 'General Contractors',
 detail: 'Civil, grading, and federal-sub GC crews on dam, substation, and solar farm builds.',
 href: '/industries/general-contractors-las-vegas/',
 img: '/images/generated/kit-office-sales.jpg',
 },
 {
 name: 'Plumbing & HVAC',
 detail: 'Mechanical service for federal facilities, dam-area infrastructure, and Boulder City municipal work.',
 href: '/industries/plumbing-hvac-las-vegas/',
 img: '/images/generated/kit-plumbing-hvac.jpg',
 },
]

const useCases = [
 'Utility-scale solar PV crews using employer-approved branded apparel and hi-vis products',
 'Electrical subcontractors using the exact protective apparel selected by their employer',
 'Civil and grading crews using employer-approved hi-vis garments with approved decoration',
 'Federal subcontractor teams requesting clean foreman polos for project walk-throughs',
 'Solar racking and tracker subcontractors in branded shirts selected under the employer heat plan',
 'Program-specific reorder schedules with timing confirmed in writing',
]

const faqs = [
 {
 q: 'Do you actually deliver to Boulder City, or do we have to drive into Las Vegas?',
  a: 'Service-area eligibility, delivery, pickup, availability, and cost are not assumed. The written quote must confirm the exact destination and handoff plan before approval.',
 },
 {
 q: 'How fast can you turn around an order for an Eldorado Valley solar crew?',
  a: 'Production timing depends on artwork approval, product availability, and the selected partner. Share your project date early and we will quote a realistic schedule.',
 },
 {
 q: 'We\'re running a federal sub on dam-area work. Can you handle the safety spec our prime needs on file?',
 a: 'Bighorn can request quotes for selected brands. Your employer or prime contractor must approve the required rating, and the garment manufacturer and selected production partner must approve the decoration method and placement.',
 },
 {
 q: 'Eldorado Valley summer is brutal. What can you quote for crews working open desert in high heat?',
 a: 'Bighorn can source quotes for lightweight garments, long-sleeve products with published UPF ratings, hi-vis products, and employer-selected FR products. Your employer sets the task-specific hazard and heat plan, then approves the exact garment from current manufacturer documentation.',
 },
 {
 q: 'Can we plan recurring reorders for a long-running project?',
 a: 'A recurring order plan may be included in your program. Each order schedule, recipient list, price, production partner, and delivery method must be confirmed in writing before work begins.',
 },
 {
 q: 'What\'s the minimum for branded crew gear?',
 a: 'Minimums depend on the selected product, decoration method, production partner, and current quote. Share your quantities and project schedule so the written proposal can define the order terms.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://bighornthreads.com/service-areas/' },
 { '@type': 'ListItem', position: 3, name: 'Boulder City, NV', item: 'https://bighornthreads.com/service-areas/boulder-city/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/service-areas/boulder-city/"
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/85"></div>

 <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-300" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-500">/</span>
 <a href="/service-areas/" class="hover:text-gold-400">Service Areas</a>
 <span class="px-2 text-navy-500">/</span>
 <span class="text-gold-400">Boulder City, NV</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Planning Branded Apparel for <span class="text-gold-400">Boulder City, NV Teams.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Boulder City teams can request a branded-apparel quote. Service-area eligibility, products, production partner, timing, and handoff terms require written confirmation.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 <svg class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- Local context — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Boulder City is <span class="text-gold-600">utility country.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Smaller town, bigger work. Solar arrays sprawl across Eldorado Valley. The dam and substation infrastructure feed the Southwest. Long-running projects may benefit from a written reorder plan built around approved products and confirmed schedules.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {localContext.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline px-2.5 py-1 text-gold-600">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Trades we serve here — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Trades</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Planning by trade for <span class="text-gold-600">Boulder City teams.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Utility electrical, solar PV, civil, grading, and federal-subcontractor teams can compare educational planning considerations and product categories. Service-area eligibility requires a current written quote.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {trades.map((t) => (
 <a href={t.href} class="group flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={t.img} alt={t.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">{t.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{t.detail}</p>
 </div>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- Typical orders — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Planning Scenarios</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options for <span class="text-gold-600">Boulder City crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Phase orders and recurring programs can be scoped around a project plan. Quantities, safety requirements, reorder cadence, and production timing are confirmed for each quote.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="space-y-3">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 border border-hairline bg-panel p-4 transition-colors hover:border-gold-500">
 <span class="shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Local context — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom branded apparel for Boulder City contractors and Hoover Dam-adjacent trades.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
Teams in Boulder City can request Las Vegas based account management. Service area, products, production, destination, handoff, timing, and cost require a current written quote.
 </p>
 <p>
 Boulder City contractors can support dam-area infrastructure, federal facilities, and solar projects in Eldorado Valley. Those settings may involve electrical, traffic, heat, and other hazards, but the project type does not determine a garment rating or visibility class. Each employer must select protective apparel through a task-specific hazard assessment and the exact current manufacturer documentation.
 </p>
 <p>
 For Boulder City solar EPCs and operations crews, manufacturers such as Bulwark and Carhartt publish information for specific flame-resistant garments. The employer must select the required protection through a task-specific hazard assessment. Bighorn reviews the exact current garment documentation, decoration method, and placement with the selected production partner. Service area, shipping destinations, and delivery terms are confirmed in the quote.
 </p>
 <p>
 The marine and recreation contractor sector in Boulder City has different apparel needs. Options may include performance polos for marina staff, workwear for boat-service techs, and lightweight long-sleeve UPF shirts. Bighorn coordinates selected products and decoration through production partners, with garment performance based on current manufacturer information.
 </p>
 <p>
 For Boulder City municipal contractors and city services contractors, branded uniforms can support clear crew identification. Bighorn can manage quotes for polos, service uniforms, and employer-approved hi-vis products. Reorder and delivery options depend on the selected partner, destination, and written order terms.
 </p>
 <p>
 Related planning resources for Boulder City: <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Class 2 hi-vis</a>, <a href="/blog/rush-order-shirts-las-vegas-whats-possible/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">rush orders</a>, <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">new hire checklist</a>, and <a href="/industries/general-contractors-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">general contractor uniforms</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Questions to ask before ordering.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Nearby &amp; Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/service-areas/henderson-nv/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Henderson, NV</h3>
 <p class="mt-2 text-sm text-ash">Right up US-93 — master-planned community build-out.</p>
 </a>
 <a href="/service-areas/north-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">North Las Vegas</h3>
 <p class="mt-2 text-sm text-ash">Industrial and data center fit-out — big electrical and mechanical.</p>
 </a>
 <a href="/industries/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">All Industries</h3>
 <p class="mt-2 text-sm text-ash">Trade-specific gear, brands, and compliance — pick your industry.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Written requirements. <span class="text-gold-400">Confirmed order terms.</span></h2>
 <p class="mb-8 text-lg text-navy-200">Talk to a real human about your project, employer-approved safety requirements, and order plan.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
