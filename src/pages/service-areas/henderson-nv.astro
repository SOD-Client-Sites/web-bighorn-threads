---
import HeroProducts from '@/components/HeroProducts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Branded Apparel Planning for Henderson, NV Teams',
 description:
 'Henderson teams can request branded-apparel planning. Service-area eligibility, products, production, timing, and handoff terms require a current written quote.',
 h1Pre: 'Henderson, NV',
}

const localContext = [
 {
 code: 'Major Projects',
 title: 'Plan around the project and crew',
 body: 'Sort the order by role and site. You tell us any jobsite rules, and we price the gear.',
 },
 {
 code: 'Active Trades',
 title: 'Trades to plan for',
 body: 'General contractors, electrical, plumbing and HVAC, and roofing and solar crews.',
 },
 {
 code: 'What Crews Need Locally',
 title: 'Sharper presentation, clear order terms',
 body: 'A clean, matching shirt helps homeowners and site teams tell who’s who. You get product, timing, and delivery in writing.',
 },
]

const trades = [
 {
 name: 'General Contractors',
 detail: 'Crew shirts, sub branding, foreman/super differentiation for Henderson tract work and commercial fit-out.',
 href: '/industries/general-contractors-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=116377398&RS=300',
 },
 {
 name: 'Electrical Contractors',
 detail: 'NFPA 70E FR, ANSI Class 2 hi-vis, and embroidered service polos for crews running Cadence and Inspirada.',
 href: '/industries/electrical-contractors-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=52278&P=549020207&RS=300',
 },
 {
 name: 'Plumbing & HVAC',
 detail: 'Embroidered service polos with name + title for residential service techs working Anthem and Green Valley.',
 href: '/industries/plumbing-hvac-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=68414&P=945769040&RS=300',
 },
 {
 name: 'Roofing & Solar',
 detail: 'Sun-protective hi-vis and crew tees for rooftop work across MacDonald Highlands and Seven Hills installs.',
 href: '/industries/roofing-solar-las-vegas/',
 img: 'https://www.promoplace.com/ws/ws.dll/QPic?SN=50042&P=373505618&RS=300',
 },
]

const useCases = [
 'Branded tees and hats for field crews',
 'Embroidered polos for customer-facing service roles',
 'Protective apparel your employer selects for electrical work',
 'A different shirt for supervisors and field crews',
 'Long-sleeve options for sun exposure',
 'Lighter-weight polos for office and estimating roles',
]

const faqs = [
 {
 q: 'Do you deliver to Henderson, or do we have to drive to your shop?',
  a: 'Tell us where you want it. Your quote lists the delivery method and cost, so there is no need to plan on a drive to a shop.',
 },
 {
 q: 'How fast can you turn an order around for a Henderson contractor?',
  a: 'The clock starts when you approve the artwork. Give us your date and we will tell you if it works.',
 },
 {
 q: 'We\'re a sub running multiple Cadence and Inspirada phases. Can you keep our gear consistent across reorders?',
 a: 'Yes. We keep the garment, color, artwork, and logo placement you approved, so a reorder starts from there. We recheck stock each time, since styles can change.',
 },
 {
 q: 'Can you handle a fleet of service trucks getting wrapped at the same time as the crew gets uniforms?',
 a: 'Send the wrap artwork and your brand colors, and we will match the apparel as closely as garments and thread allow. You see a proof first.',
 },
 {
 q: 'Do you stock anything for hot-weather Henderson summer work?',
 a: 'We don’t hold stock, but we can quote lightweight polos, long-sleeve sun shirts, hi-vis, and FR. Your heat plan and safety lead decide what’s required.',
 },
 {
 q: 'What\'s the minimum order for branded gear?',
 a: 'It varies by garment and decoration. Send your quantities and we will tell you the minimum and any setup charge.',
 },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://bighornthreads.com/service-areas/' },
 { '@type': 'ListItem', position: 3, name: 'Henderson, NV', item: 'https://bighornthreads.com/service-areas/henderson-nv/' },
 ],
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({
 '@type': 'Question',
 name: f.q,
 acceptedAnswer: { '@type': 'Answer', text: f.a },
 })),
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical="https://bighornthreads.com/service-areas/henderson-nv/"
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <!-- Hero — full-bleed photographic dark band -->
 <section class="border-b border-hairline bg-concrete">
 <div class="page-hero-grid mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-16 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-ash" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-700">Home</a>
 <span class="px-2 text-ash">/</span>
 <a href="/service-areas/" class="hover:text-gold-700">Service Areas</a>
 <span class="px-2 text-ash">/</span>
 <span class="text-gold-700">Henderson, NV</span>
 </nav>

 <p class="kicker mb-3">{page.h1Pre}</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-5xl lg:text-6xl">
 Planning Branded Apparel for <span class="text-gold-700">Henderson, NV Teams.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-ash sm:text-xl">
 Branded apparel quotes for Henderson crews, offices, and teams. Tell us the job and we confirm products, timing, and delivery in writing.
 </p>

 <div class="mt-10 flex flex-wrap items-center gap-3">
 <a href="/contact/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-charcoal transition-colors hover:text-gold-700">
 <svg class="h-4 w-4 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
 702.904.8923
 </a>
 </div>
  <HeroProducts />
 </div>
 </section>

 <!-- Local context — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Planning gear for <span class="text-gold-600">Henderson crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Henderson’s work leans residential and master-planned, so many crews need to look right at a customer’s door as well as on site. Start with who wears what.
 </p>
 </div>

 <div class="grid gap-5 md:grid-cols-3">
 {localContext.map((c) => (
 <div class="border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <span class="spec mb-4 inline-block border border-hairline px-2.5 py-1 text-gold-600">{c.code}</span>
 <h3 class="mb-3 font-heading text-xl font-bold uppercase leading-tight tracking-tight text-charcoal">{c.title}</h3>
 <p class="text-sm leading-relaxed text-ash">{c.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Trades we serve here — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">The Trades</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Planning by trade for <span class="text-gold-600">Henderson teams.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Most Henderson work falls into one of these four buckets. Click through for the gear, brands, and compliance specifics for each trade.
 </p>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
 {trades.map((t) => (
 <a href={t.href} class="group flex flex-col border border-hairline bg-panel transition-colors hover:border-gold-500">
 <div class="aspect-[4/3] overflow-hidden">
 <img src={t.img} alt={t.name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="600" height="450" />
 </div>
 <div class="p-5">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">{t.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{t.detail}</p>
 </div>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- Typical orders — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
 <div>
 <p class="kicker mb-3">Planning Scenarios</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Program options for <span class="text-gold-600">Henderson crews.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Tract framing crews, residential service techs, commercial fit-out subs, hospital-expansion electrical and mechanical. The Henderson order mix leans residential and master-planned, different from off-Strip industrial.
 </p>
 <div class="mt-8 flex flex-wrap gap-3">
 <a href="/services/" class="btn-secondary text-sm">All Services →</a>
 <a href="/company-stores/" class="btn-secondary text-sm">Company Stores →</a>
 </div>
 </div>

 <ul class="space-y-3">
 {useCases.map((u, i) => (
 <li class="flex items-start gap-4 border border-hairline bg-panel p-4 transition-colors hover:border-gold-500">
 <span class="shrink-0 font-mono text-xs font-bold text-gold-600">{String(i + 1).padStart(2, '0')}</span>
 <span class="text-base leading-relaxed text-charcoal">{u}</span>
 </li>
 ))}
 </ul>
 </div>
 </div>
 </section>

 <!-- Local context — paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">Local Context</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight text-charcoal sm:text-4xl">
 Custom branded apparel for Henderson contractors and trade businesses.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
Henderson teams work with our account team in Las Vegas. Your written quote lists products, timing, delivery, and cost.
 </p>
 <p>
 Contractors usually need gear for field, supervisor, office, and customer-facing roles. We price them line by line.
 </p>
 <p>
 Henderson HOA grounds-maintenance, irrigation, and landscape firms often use branded uniforms to identify crews. Bighorn can quote polos, caps, and employer-approved hi-vis products.
 </p>
 <p>
 Data center projects can require FR-rated electrical apparel and ANSI 107 hi-vis. The employer or site safety team must define and approve the required product. We source the products and arrange the decoration, following the manufacturer instructions.
 </p>
 <p>
 
 </p>
 <p>
 Related planning resources for Henderson: <a href="/blog/ansi-107-class-2-vs-class-3-hi-vis-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">Class 2 hi-vis</a>, <a href="/blog/rush-order-shirts-las-vegas-whats-possible/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">rush orders</a>, <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">new hire checklist</a>, and <a href="/industries/data-center-contractors-las-vegas/" class="text-gold-600 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">data center contractor uniforms</a>.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQs — concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal sm:text-4xl">Questions to ask before ordering.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related — paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Nearby &amp; Related</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/service-areas/summerlin/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Summerlin</h3>
 <p class="mt-2 text-sm text-ash">High-end residential and commercial, master-planned community territory across the valley.</p>
 </a>
 <a href="/service-areas/boulder-city/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Boulder City</h3>
 <p class="mt-2 text-sm text-ash">Solar farm and utility work just down US-93 from Henderson.</p>
 </a>
 <a href="/industries/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">All Industries</h3>
 <p class="mt-2 text-sm text-ash">Trade-specific gear, brands, and compliance. Pick your industry.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA — full-bleed photographic dark band -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Confirm options for <span class="text-gold-400">Henderson.</span></h2>
 <p class="mb-8 text-lg text-white/80">Send the project location, roles, requested products, quantities, and deadline for a current written quote.</p>
 <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
