---
import LandingLayout from '@/layouts/LandingLayout.astro'
import LeadCaptureForm from '@/components/LeadCaptureForm.astro'

const faqs = [
  { q: 'What is the offer?', a: 'Safety-yellow long-sleeve cooling performance hoodies with your custom logo, advertised at $19 each with a 100-piece minimum. The original offer includes full-color front and back printing. Bighorn confirms artwork, print placement, available sizes, shipping, taxes and your final total before you approve an order.' },
  { q: 'Can I see my logo on the hoodie first?', a: 'Yes. Request your mockup below. The Bighorn Threads team will follow up for your logo and review the artwork and placement with you before production.' },
  { q: 'Can we order different sizes?', a: 'Send your size breakdown with the request. Bighorn will confirm available sizes and any size-specific pricing before you approve the order. The offer requires at least 100 pieces in total.' },
  { q: 'Is this an ANSI-rated or flame-resistant garment?', a: 'Safety yellow is a color, not a safety certification. This offer does not claim an ANSI/ISEA class or flame-resistant rating. If your job requires certified PPE, tell us before ordering so the garment specifications can be checked against your requirements.' },
  { q: 'When will our hoodies arrive?', a: 'Include your required delivery date in the request. Availability, artwork approval, production time and shipping determine the schedule; Bighorn confirms that schedule before you place the order.' },
  { q: 'Does this form charge my card?', a: 'No. This is a mockup and order-details request, not a checkout. No payment is taken and no order is placed by submitting it.' },
]
---

<LandingLayout
  title="$19 Custom Safety Hoodies | 100-Piece Crew Offer | Bighorn Threads"
  description="Outfit your crew in safety-yellow cooling performance hoodies with your logo. $19 each, 100-piece minimum. Request your custom mockup from Bighorn Threads."
  canonical="https://bighornthreads.com/offers/safety-hoodie/"
  ogImage="https://bighornthreads.com/images/offers/safety-hoodie-gold.webp"
  noindex={true}
  standalone={true}
>
  <div class="hoodie-offer">
    <section class="offer-hero" aria-labelledby="offer-title">
      <div class="offer-wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> For construction, landscaping & trade crews</p>
          <h1 id="offer-title">Cooling hoodies<br />with your logo.</h1>
          <p class="hero-intro">Outfit your crew for hot days on the job. Lightweight, moisture-wicking hoodies in safety yellow, printed with your company logo.</p>
          <div class="price-row"><strong>$19</strong><div><span>per hoodie</span><small>100-piece minimum</small></div></div>
          <p class="print-line">Full-color front + back printing · Your company logo</p>
          <a class="offer-button" href="#request">Get my hoodie mockup <span aria-hidden="true">↗</span></a>
          <p class="cta-note">See your logo on the hoodie before placing an order.</p>
          <div class="hero-specs" aria-label="Product highlights"><span>Safety yellow</span><span>Long sleeve</span><span>Moisture-wicking</span></div>
        </div>
        <figure class="hero-image">
          <img src="/images/offers/safety-hoodie-gold.webp" width="1080" height="1350" alt="Bighorn Threads $19 safety-yellow cooling hoodie offer, showing a custom-logo chest placement" fetchpriority="high" />
          <figcaption>The hoodie offer from our Facebook campaign. Product ratings and availability are confirmed before ordering.</figcaption>
        </figure>
      </div>
    </section>

    <section class="trade-strip" aria-label="Who this offer is for"><div class="offer-wrap">Built for your crew <span>Construction / Landscaping / Roofing / Warehouses / Events</span></div></section>

    <section class="benefit-section">
      <div class="offer-wrap">
        <div class="section-heading"><p class="eyebrow">Cooling performance / Custom printing</p><h2>Long sleeves without<br />a heavy sweatshirt.</h2></div>
        <div class="benefit-grid">
          <article><span class="feature-number">01 / COMFORT</span><h3>Skip the heavy layer.</h3><p>Lightweight, moisture-wicking performance fabric for long days on the job. Long sleeves and a hood give your crew coverage without a bulky sweatshirt.</p></article>
          <article><span class="feature-number">02 / IDENTITY</span><h3>Put your name on it.</h3><p>Your logo on safety yellow. Give every crew member a consistent look instead of a mix of old tees, faded prints and different colors.</p></article>
          <article><span class="feature-number">03 / CLARITY</span><h3>See it before production.</h3><p>Start with your quantity and logo mockup. Review the artwork, sizes, delivery schedule and final pricing with Bighorn before placing the order.</p></article>
        </div>
      </div>
    </section>

    <section class="request-section" id="request" aria-labelledby="request-title">
      <div class="offer-wrap request-grid">
        <div class="request-copy">
          <p class="eyebrow">Make it your crew’s hoodie</p>
          <h2 id="request-title">See these hoodies<br /><em>with your company logo.</em></h2>
          <p>Tell us how many hoodies you need and when you need them. We’ll follow up for your logo and put the details together.</p>
          <ol class="steps">
            <li><strong>01</strong><div><h3>Send your request</h3><p>100 pieces or more. Add your company and deadline.</p></div></li>
            <li><strong>02</strong><div><h3>Review your mockup</h3><p>Confirm your logo, placement and size breakdown.</p></div></li>
            <li><strong>03</strong><div><h3>Approve the order details</h3><p>Review the final total and delivery schedule before payment.</p></div></li>
          </ol>
          <div class="offer-terms"><strong>The offer, plainly.</strong><p>$19 per hoodie. 100-piece minimum. Full-color front and back printing. Shipping, taxes, size availability and any artwork requirements are confirmed with your final order details.</p></div>
        </div>
        <div class="request-form">
          <!-- Replace this request form with the client-approved Bighorn GHL payment embed when supplied. Never collect card data in this site's endpoint. -->
          <LeadCaptureForm vertical="trades" offer="safety-hoodie-19" heading="Get my hoodie mockup" blurb="100-piece minimum. Tell us your quantity and deadline. Bighorn Threads will follow up with the next steps." submitLabel="Send my hoodie request →" />
        </div>
      </div>
    </section>

    <section class="faq-section"><div class="offer-wrap faq-wrap"><p class="eyebrow">Before you order</p><h2>Straight answers.</h2><div class="faq-list">{faqs.map(({ q, a }) => (<details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>))}</div></div></section>
    <section class="closing-section"><div class="offer-wrap closing-inner"><div><p class="eyebrow">100+ hoodies. One crew identity.</p><h2>Ready to outfit<br /><em>your crew?</em></h2></div><div><a class="offer-button" href="#request">Get my hoodie mockup <span aria-hidden="true">↗</span></a><p class="cta-note">$19 each · 100-piece minimum · No payment today</p></div></div></section>
    <aside class="mobile-cta" aria-label="Hoodie offer"><span><strong>$19</strong> each <small>100 minimum</small></span><a href="#request">Get my mockup <span aria-hidden="true">↗</span></a></aside>
  </div>
</LandingLayout>

<style>
  .hoodie-offer { --offer-gold: #eac05c; --offer-ink: #111311; --offer-muted: #c0c4bb; background: var(--offer-ink); color: #f5f3eb; }
  .offer-wrap { width: min(1180px, calc(100% - 48px)); margin-inline: auto; }
  .offer-hero { padding: 32px 0 36px; background: radial-gradient(ellipse at 90% 10%, #3a321b 0, transparent 50%), #111311; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: start; }
  .eyebrow { color: var(--offer-gold); font-family: var(--font-mono, monospace); font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; margin-bottom: 22px; }
  .eyebrow span { display: inline-block; width: 7px; height: 7px; background: var(--offer-gold); margin-right: 9px; }
  h1, h2, h3 { font-family: var(--font-heading, sans-serif); }
  h1 { font-size: clamp(42px, 4.6vw, 62px); line-height: 1.02; letter-spacing: -.045em; font-weight: 800; }
  em { color: var(--offer-gold); font-style: normal; }
  .hero-intro { color: var(--offer-muted); font-size: 18px; line-height: 1.65; max-width: 460px; margin: 18px 0; }
  .price-row { display: flex; align-items: center; gap: 20px; margin-top: 24px; }
  .price-row > strong { color: var(--offer-gold); font-family: var(--font-heading, sans-serif); font-size: 72px; line-height: 1; letter-spacing: -.07em; }
  .price-row span { font-size: 18px; font-weight: 700; }
  .price-row small { display: block; color: var(--offer-gold); margin-top: 5px; font-size: 16px; font-weight: 700; }
  .print-line { font-size: 14px; margin: 18px 0 24px; }
  .offer-button { display: inline-flex; justify-content: space-between; align-items: center; gap: 28px; min-height: 56px; padding: 15px 24px; background: var(--offer-gold); color: #111311; font-weight: 800; font-size: 16px; text-decoration: none; border: 1px solid var(--offer-gold); }
  .offer-button:hover { background: #ffdb80; }
  a:focus-visible, summary:focus-visible { outline: 3px solid #fff; outline-offset: 5px; }
  .cta-note { font-size: 12px; color: var(--offer-muted); margin-top: 12px; line-height: 1.6; }
  .hero-specs { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 20px; border-top: 1px solid #34382e; padding-top: 14px; color: var(--offer-muted); font-size: 12px; }
  .hero-image { margin: 0 auto; max-width: 416px; }
  .hero-image img { display: block; width: 100%; height: auto; border: 1px solid #665330; }
  figcaption { font-size: 11px; color: #b4b9ad; line-height: 1.6; margin-top: 10px; }
  .trade-strip { border-block: 1px solid #34382e; padding-block: 22px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--offer-gold); }
  .trade-strip .offer-wrap { display: flex; justify-content: space-between; gap: 20px; }
  .trade-strip span { color: var(--offer-muted); }
  .benefit-section { padding: 80px 0; }
  h2 { font-size: clamp(32px, 4vw, 48px); line-height: 1.1; font-weight: 800; letter-spacing: -.035em; }
  .benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; margin-top: 40px; }
  .benefit-grid article { border-top: 1px solid #625535; padding-top: 24px; }
  .feature-number { font-size: 10px; letter-spacing: .13em; color: var(--offer-gold); font-family: monospace; }
  h3 { font-size: 21px; line-height: 1.25; margin: 16px 0 12px; font-weight: 700; }
  .benefit-grid p, .request-copy > p, .steps p { color: var(--offer-muted); font-size: 15px; line-height: 1.75; }
  .request-section { background: #1d201b; padding: 80px 0; border-block: 1px solid #34382e; scroll-margin-top: 20px; }
  .request-grid { display: grid; grid-template-columns: .9fr 1fr; gap: 80px; align-items: start; }
  .request-copy > p { margin-top: 24px; }
  .request-copy > .eyebrow { color: var(--offer-gold); font-size: 11px; }
  .steps { margin-top: 32px; list-style: none; padding: 0; }
  .steps li { display: flex; gap: 18px; padding: 20px 0; border-bottom: 1px solid #393e32; }
  .steps li > strong { color: var(--offer-gold); font-size: 14px; padding-top: 3px; }
  .steps h3 { margin: 0 0 5px; font-size: 18px; }
  .steps p { font-size: 14px; }
  .offer-terms { border-left: 3px solid var(--offer-gold); padding-left: 20px; margin-top: 36px; }
  .offer-terms p { color: var(--offer-muted); font-size: 13px; line-height: 1.8; margin-top: 8px; }
  .request-form { min-width: 0; }
  .request-form :global(#lp-form-card) { scroll-margin-top: 20px; }
  .faq-section { padding: 80px 0; }
  .faq-wrap { max-width: 820px; }
  .faq-list { margin-top: 32px; }
  details { border-bottom: 1px solid #34382e; }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 18px; min-height: 64px; padding: 18px 0; cursor: pointer; font-size: 17px; font-weight: 600; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--offer-gold); font-size: 24px; }
  details[open] summary span { transform: rotate(45deg); }
  details > p { color: var(--offer-muted); padding-bottom: 24px; font-size: 15px; line-height: 1.8; }
  .closing-section { border-top: 1px solid #34382e; padding: 64px 0; background: #191c16; }
  .closing-inner { display: flex; align-items: center; justify-content: space-between; gap: 36px; }
  .mobile-cta { display: none; }
  @media (max-width: 900px) { .hero-grid { gap: 28px; } .request-grid { gap: 36px; } .hero-intro { font-size: 16px; } .price-row > strong { font-size: 72px; } }
  @media (max-width: 700px) {
    .offer-wrap { width: calc(100% - 36px); }
    .offer-hero { padding: 36px 0; }
    .hero-grid, .request-grid, .benefit-grid { grid-template-columns: 1fr; }
    .hero-copy { max-width: 520px; }
    h1 { font-size: clamp(42px, 11vw, 64px); }
    .hero-image { max-width: 480px; margin-inline: auto; margin-top: 12px; }
    .trade-strip .offer-wrap { flex-direction: column; gap: 8px; line-height: 1.8; }
    .benefit-section, .request-section, .faq-section { padding: 48px 0; }
    .benefit-grid { gap: 28px; margin-top: 28px; }
    .request-grid { gap: 32px; }
    .closing-inner { flex-direction: column; align-items: flex-start; }
    .offer-button { width: 100%; }
    .closing-section { padding: 48px 0 100px; }
    .mobile-cta { display: flex; position: fixed; bottom: 0; inset-inline: 0; z-index: 40; padding: 12px 18px calc(12px + env(safe-area-inset-bottom)); background: #111311; border-top: 1px solid #625535; align-items: center; justify-content: space-between; gap: 12px; }
    .mobile-cta > span { font-size: 12px; }
    .mobile-cta strong { color: var(--offer-gold); font-size: 23px; }
    .mobile-cta small { display: block; color: var(--offer-muted); font-size: 10px; }
    .mobile-cta a { background: var(--offer-gold); color: #111311; padding: 13px 18px; font-size: 14px; font-weight: 800; min-height: 46px; }
    .request-form :global(#lp-form-card) { padding: 24px 18px; }
    :global(body:has(.hoodie-offer) > footer) { padding-bottom: 112px; }
  }
  @media (prefers-reduced-motion: reduce) { .hoodie-offer * { scroll-behavior: auto; transition: none; } }
</style>
