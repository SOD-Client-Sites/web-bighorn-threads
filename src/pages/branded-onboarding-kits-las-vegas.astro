---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Branded Employee Onboarding Kits for Construction Companies in Las Vegas | Bighorn Threads',
 description:
 'Branded employee onboarding kits for construction companies in Las Vegas. Embroidered polo, hi-vis vest, hard hat, and branded bag, kitted and shipped to your office or the new hire. Minimum 10 kits, 10 to 14 day turnaround. Get a quote.',
 hero: '/images/generated/kit-gc.jpg',
 url: 'https://bighornthreads.com/branded-onboarding-kits-las-vegas/',
}

const kit = [
 { label: 'Embroidered polo', body: 'A company polo with your logo stitched on the chest. The new hire looks like part of the crew from day one. Pick the color and we match it across every kit.' },
 { label: 'Hi-vis vest', body: 'An ANSI 107 Class 2 or Class 3 vest, branded with your logo. Meets the jobsite visibility rule and carries the company name on the back.' },
 { label: 'Hard hat', body: 'An ANSI Z89.1 shell with manufacturer-approved decals. We brand the front and sides without voiding the certification.' },
 { label: 'Branded bag', body: 'A drawstring or duffel that holds the kit and doubles as the gear bag. Logo embroidered or printed. It makes the whole package feel like a real welcome.' },
]

const process = [
 { row: '1. You pick the items', meaning: 'Approve the kit contents', use: 'Send your logo and choose the polo, vest, hard hat, and bag. We mock it up so you see it before we build.' },
 { row: '2. We digitize and decorate', meaning: 'One logo file, every kit', use: 'We digitize your logo once and decorate every item. Embroidery on the polo and bag, decals on the hard hat, print on the vest.' },
 { row: '3. We kit and assemble', meaning: 'Packed per head', use: 'Each kit is packed as one bundle. Sizes are sorted by name when you give us a roster, so nothing gets mixed up.' },
 { row: '4. We ship where you want', meaning: 'Office or new hire', use: 'Ship the batch to your office for handout, or send a single kit straight to a new hire before their start date.' },
]

const whoFor = [
 { name: 'General contractors', detail: 'Standardize what every new framer, laborer, and finisher gets on day one. One kit spec across the whole crew.' },
 { name: 'Electrical and HVAC shops', detail: 'Pair a branded polo and bag with the trade PPE your techs need. Class E hard hat options for electrical crews.' },
 { name: 'Solar and roofing crews', detail: 'High turnover means frequent onboarding. A standing kit spec means you reorder in minutes, not hours.' },
 { name: 'Concrete and site work', detail: 'Hi-vis vest, hard hat, and a tough bag built for the dust and the heat. Branded so the crew reads as one company.' },
 { name: 'Growing companies hiring fast', detail: 'Add a head and a kit ships. No scrambling to assemble gear the night before a start date.' },
 { name: 'Safety managers', detail: 'Every new hire gets the same compliant PPE every time. No gaps, no guesswork, one documented kit.' },
]

const diyVsKit = [
 { ok: false, label: 'DIY assembly', body: 'Someone in the office orders a polo here, a vest there, and a hard hat from a third site. Then they sort sizes and pack it by hand. Hours per hire.' },
 { ok: true, label: 'Done-for-you kit', body: 'You approve the spec once. We build, pack, and ship every kit. Your team spends zero time on it after the first approval.' },
 { ok: false, label: 'Mismatched branding', body: 'Buy from three vendors and the logo looks different on each piece. The crew reads as a patchwork, not a company.' },
 { ok: true, label: 'One consistent look', body: 'One digitized logo file decorates every item. The polo, the vest, and the bag all match. The crew looks unified.' },
 { ok: false, label: 'Last-minute scrambles', body: 'A new hire starts Monday and the gear is not ready. Someone runs to the store. The first impression is chaos.' },
 { ok: true, label: 'Ship on demand', body: 'Add a name, a kit ships. We can send it to your office or straight to the new hire ahead of day one.' },
]

const faqs = [
 { q: 'What goes in a construction onboarding kit?', a: 'A standard kit holds an embroidered company polo, an ANSI 107 hi-vis vest, an ANSI Z89.1 hard hat, and a branded bag. You can add a beanie, a t-shirt, gloves, or a water bottle. We build the kit around what your trade needs and what your budget allows. Every item carries your logo, decorated the right way for that material.' },
 { q: "What's the minimum order for branded onboarding kits?", a: 'The minimum is 10 kits. That covers your first batch of hires and lets us digitize your logo once for the whole run. After the first order, reorders are easy. Add a name and we build and ship a single kit on demand, so you never have to assemble gear the night before a start date.' },
 { q: 'How fast can onboarding kits ship?', a: 'Typical turnaround is 10 to 14 business days from artwork approval. The first order takes the longest because we digitize your logo and source the items. After that, reorders move faster since the artwork is already on file. Tell us your start dates and we plan the batch around them. Rush options are available when a hire starts sooner.' },
 { q: 'Can you ship kits directly to new hires?', a: 'Yes. Give us a name and address and we ship a single kit straight to the new hire before day one. A welcome kit on the doorstep makes the company look organized and the hire feel wanted. You can also ship the whole batch to your office for handout at orientation. You pick the model that fits your process.' },
 { q: 'How does pricing work on onboarding kits?', a: 'Pricing is per kit. You approve the contents and we quote one all-in price per head. That covers the items, the decoration, the assembly, and the packing. No separate setup line on reorders since the artwork stays on file. Add or remove items and the per-head price adjusts. You always know the cost before we build.' },
 { q: 'Do you handle the logo digitizing and decoration?', a: 'Yes. We digitize your logo once and decorate every item in house. Embroidery on the polo and bag, manufacturer-approved decals on the hard hat, and a print on the hi-vis vest. You send the logo and approve the mockup. We handle the rest. The same file works across every future reorder, so your branding stays consistent.' },
]

const breadcrumb = {
 '@context': 'https://schema.org',
 '@type': 'BreadcrumbList',
 itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Branded Onboarding Kits', item: page.url },
 ],
}

const serviceSchema = {
 '@context': 'https://schema.org',
 '@type': 'Service',
 name: 'Branded Employee Onboarding Kits for Construction Companies in Las Vegas',
 serviceType: 'Branded Apparel and Promotional Products',
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 areaServed: [
 { '@type': 'City', name: 'Las Vegas' },
 { '@type': 'City', name: 'Henderson' },
 { '@type': 'City', name: 'North Las Vegas' },
 { '@type': 'City', name: 'Summerlin' },
 { '@type': 'City', name: 'Spring Valley' },
 ],
 description: page.description,
 url: page.url,
}

const faqSchema = {
 '@context': 'https://schema.org',
 '@type': 'FAQPage',
 mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

const speakableSchema = {
 '@context': 'https://schema.org',
 '@type': 'WebPage',
 url: 'https://bighornthreads.com/branded-onboarding-kits-las-vegas/',
 speakable: {
 '@type': 'SpeakableSpecification',
 cssSelector: ['h1', '.speakable-answer'],
 },
}
---

<BaseLayout
 title={page.title}
 description={page.description}
 canonical={page.url}
 heroImage={page.hero}
>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(speakableSchema)} />

 <!-- Hero: full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>

 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Branded Onboarding Kits</span>
 </nav>

 <p class="kicker mb-4 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 New Hire Kits
 </p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Branded Employee Onboarding Kits for Construction Companies. <span class="text-gold-400">Built, kitted, and shipped.</span>
 </h1>
 <p class="speakable-answer max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn Threads builds branded employee onboarding kits for construction companies in Las Vegas. An embroidered polo, hi-vis vest, hard hat, and branded bag, kitted and shipped to your office or straight to the employee. Minimum 10 kits. Typical turnaround is 10 to 14 business days. We handle digitizing, decoration, and assembly.
 </p>

 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">
 702.904.8923
 </a>
 </div>
 </div>
 </section>

 <!-- What's in a kit: concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">What Goes in a Kit</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Branded employee onboarding kits for construction companies, built around your crew.</h2>
 </div>

 <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
 {kit.map((s) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{s.label}</h3>
 <p class="text-sm leading-relaxed text-ash">{s.body}</p>
 </div>
 ))}
 </div>

 <p class="mt-8 max-w-3xl text-base leading-relaxed text-ash">
 That is the standard four. You can add a beanie, a t-shirt, gloves, a water bottle, or a hoodie. We build the kit around your trade and your budget.
 </p>
 </div>
 </section>

 <!-- How it works: paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-10 max-w-2xl">
 <p class="kicker mb-3">How It Works</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Four steps from <span class="text-gold-600">logo to doorstep.</span></h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 You approve the kit once. We build it, pack it per head, and ship it where you want. Your team is done after the first sign-off.
 </p>
 </div>

 <div class="overflow-hidden border border-hairline bg-panel">
 <table class="w-full">
 <thead class="bg-concrete">
 <tr class="border-b border-hairline">
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">Step</th>
 <th class="px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600">What Happens</th>
 <th class="hidden px-6 py-4 text-left font-mono text-xs font-bold uppercase tracking-wider text-gold-600 lg:table-cell">The Detail</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline">
 {process.map((r) => (
 <tr>
 <td class="px-6 py-5 align-top font-mono text-sm font-bold text-gold-700">{r.row}</td>
 <td class="px-6 py-5 align-top font-heading text-base font-bold text-charcoal">{r.meaning}</td>
 <td class="hidden px-6 py-5 align-top text-sm text-ash lg:table-cell">{r.use}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <!-- Who it's for: concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Who It's For</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Built for Vegas crews that hire often.</h2>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {whoFor.map((u) => (
 <div class="border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="mb-2 font-heading text-lg font-bold uppercase tracking-tight text-charcoal">{u.name}</h3>
 <p class="text-sm leading-relaxed text-ash">{u.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- DIY vs kit: paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Why It Beats DIY</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Assembling kits in house costs more than you think.</h2>
 </div>

 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {diyVsKit.map((d) => (
 <div class={`border p-6 ${d.ok ? 'border-hairline bg-panel' : 'border-red-300 bg-red-50'}`}>
 <div class="mb-3 flex items-center gap-2">
 <span class={`flex h-6 w-6 items-center justify-center text-xs font-bold ${d.ok ? 'bg-gold-500 text-charcoal' : 'bg-red-200 text-red-700'}`}>
 {d.ok ? '✓' : '✕'}
 </span>
 <h3 class="font-heading text-base font-bold uppercase tracking-tight text-charcoal">{d.label}</h3>
 </div>
 <p class="text-sm leading-relaxed text-ash">{d.body}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Deep dive: paper -->
 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">
 Onboarding kits for Vegas contractors, done as a standing program.
 </h2>

 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A branded onboarding kit is the gear a new hire gets on day one, packed as one bundle and carrying your logo on every piece. For a Las Vegas construction company, that usually means an embroidered polo, an ANSI 107 hi-vis vest, an ANSI Z89.1 hard hat, and a branded bag to hold it. The point is simple. A new hire who shows up in matching company gear reads as part of the crew, not a stranger on the site.
 </p>
 <p>
 The work most companies dread is the assembly. Someone in the office orders a polo from one vendor, a vest from another, and a hard hat from a third. Then they sort sizes, match the branding, and pack each bundle by hand. That is hours per hire, and the branding rarely lines up. We take that whole job off your desk. You approve the kit spec once, we digitize your logo once, and we build and pack every kit from there.
 </p>
 <p>
 The real value shows up after the first order. Once your logo is on file and your kit spec is locked, a reorder takes minutes. Add a name to the list and a kit ships. The minimum is 10 kits on the first run, which covers a starting batch and lets us set up the artwork. After that, single-kit reorders are easy, so you are never assembling gear the night before a start date. Typical turnaround runs 10 to 14 business days, and reorders move faster since nothing needs setup again.
 </p>
 <p>
 You also choose where the kit lands. Ship the whole batch to your office and hand kits out at orientation, or send a single kit straight to a new hire before their first day. A welcome kit on the doorstep makes the company look organized and makes the hire feel wanted. Both models work, and you can mix them.
 </p>
 <p>
 For deeper reads, see our <a href="/blog/new-hire-workwear-checklist-las-vegas-contractors/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">new hire workwear checklist</a>, our guide on <a href="/blog/how-to-outfit-a-construction-crew-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">how to outfit a construction crew</a>, and our <a href="/company-stores/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">company store</a> option for ongoing reorders.
 </p>
 </div>
 </div>
 </section>

 <!-- FAQ: concrete -->
 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Onboarding kit questions, answered.</h2>

 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <!-- Related: paper -->
 <section class="border-y border-hairline bg-paper py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/custom-hard-hats-las-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Custom Hard Hats</h3>
 <p class="mt-2 text-sm text-ash">ANSI Z89.1 shells branded with decals for the kit's hard hat.</p>
 </a>
 <a href="/company-stores/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Company Stores</h3>
 <p class="mt-2 text-sm text-ash">A private store so reorders and per-employee kits run on autopilot.</p>
 </a>
 <a href="/catalog/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Browse Catalog</h3>
 <p class="mt-2 text-sm text-ash">Polos, hi-vis vests, bags, and PPE. Every item we kit.</p>
 </a>
 </div>
 </div>
 </section>

 <!-- CTA: full-bleed photographic dark band -->
 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Ready to set up your onboarding kits?</h2>
 <p class="mb-8 text-lg text-navy-200">Send your logo, your kit list, and how many heads. We quote one price per kit.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Free Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
