---
import BaseLayout from '@/layouts/BaseLayout.astro'

const page = {
 title: 'Cost of Custom Apparel for a Team of 50 | Pricing Breakdown — Bighorn Threads',
 description:
 'What shapes the cost of outfitting a 50-person crew? Build a specification by role, garment, decoration, quantity, and jobsite requirements before requesting an itemized quote.',
 hero: '/images/generated/kit-office-sales.jpg',
 url: 'https://bighornthreads.com/cost-custom-apparel-team-of-50/',
}

const pricing = [
 { garment: 'Embroidered polo', perUnit: 'Quote required', note: 'Garment, stitch count, artwork, and quantity affect cost' },
 { garment: 'Screen-printed tee', perUnit: 'Quote required', note: 'Garment, colors, placements, artwork, and quantity affect cost' },
 { garment: 'Specialty work shirt', perUnit: 'Quote required', note: 'Confirm garment and decoration requirements for the work environment' },
 { garment: 'Hi-vis tee or vest', perUnit: 'Quote required', note: 'Confirm garment classification and decoration placement requirements' },
 { garment: 'Embroidered softshell or jacket', perUnit: 'Quote required', note: 'Garment, stitch count, placement, artwork, and quantity affect cost' },
]

const tiers = [
 { qty: '50 people, 1 shirt each', total: '50 decorated pieces', detail: 'Define the garment and decoration by role' },
 { qty: '50 people, 2 shirts each', total: '100 decorated pieces', detail: 'Separate field and client-facing requirements where needed' },
 { qty: '50 people, 3 shirts each', total: '150 decorated pieces', detail: 'Specify each garment before requesting a total' },
]

const faqs = [
 { q: 'How much does custom apparel cost for a team of 50?', a: 'There is no reliable total without a garment and decoration specification. Define the roles, pieces per person, garments, artwork, decoration, delivery, and any jobsite requirements, then request an itemized quote.' },
 { q: 'What drives the price range so wide for the same garment?', a: 'Garment, artwork, colors, placements, quantity, setup, partner capacity, and delivery can all affect price. Protective apparel also requires employer approval and current manufacturer decoration instructions.' },
 { q: 'Does the price include the embroidery digitizing fee?', a: 'Confirm whether artwork preparation or digitizing is included as a separate line item. Reorder terms should also be documented in the quote.' },
 { q: 'Is it cheaper to mix screen printing and embroidery for a 50-person crew?', a: 'It can be. Split the quote by role, garment, and decoration method. Compare the same approved specifications before choosing.' },
 { q: 'How do protective apparel requirements change the budget for 50 people?', a: 'Price each employer-approved protective garment separately. The exact rating, product, size range, documentation, decoration permission, and quantity affect the quote.' },
 { q: 'How fast can Bighorn Threads quote a 50-person order?', a: 'Quote timing depends on whether the garment, artwork, decoration, quantity, delivery, and jobsite requirements are complete. Send those details for an itemized quote and a current response estimate.' },
]

const leadAnswer = 'The cost of outfitting a 50-person crew depends on the roles, pieces per person, garments, artwork, decoration, quantity, delivery, and any jobsite requirements. Build that specification first, then request an itemized quote that separates each garment and service.'

const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
 { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://bighornthreads.com/' },
 { '@type': 'ListItem', position: 2, name: 'Cost for a Team of 50', item: page.url },
] }
const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: page.title, description: page.description, url: page.url, publisher: { '@type': 'Organization', name: 'Bighorn Threads' }, datePublished: '2026-07-08', dateModified: '2026-08-21' }
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }
---

<BaseLayout title={page.title} description={page.description} canonical={page.url} heroImage={page.hero}>
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
 <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

 <section class="relative isolate overflow-hidden bg-navy-950 pt-16 pb-20 sm:pt-16 sm:pb-28">
 <img src={page.hero} alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/90 to-navy-950/55"></div>
 <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <nav class="mb-6 font-mono text-xs text-navy-200" aria-label="Breadcrumb">
 <a href="/" class="hover:text-gold-400">Home</a>
 <span class="px-2 text-navy-200/60">/</span>
 <span class="text-gold-400">Cost for a Team of 50</span>
 </nav>
 <p class="kicker mb-4 flex items-center gap-2.5"><span class="h-px w-8 bg-gold-500"></span>Pricing</p>
 <h1 class="mb-6 max-w-4xl font-heading text-4xl font-extrabold uppercase leading-[1.0] tracking-tight text-white sm:text-5xl lg:text-6xl">
 What 50 people in custom gear <span class="text-gold-400">actually costs.</span>
 </h1>
 <p class="max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Build a specification by garment and decoration method, then request current per-piece pricing.
 </p>
 <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
 <a href="/get-a-quote/" class="btn-primary text-base">
 Get a Quote
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
 </a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-sm font-medium tracking-wide text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>

 <section class="border-b border-hairline bg-paper py-14">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="speakable-answer text-xl leading-relaxed text-charcoal sm:text-2xl">
 {leadAnswer}
 </p>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Per-Piece Pricing</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Garment-by-garment cost.</h2>
 </div>
 <div class="overflow-hidden border border-hairline">
 <table class="w-full text-left">
 <thead>
 <tr class="bg-paper">
 <th class="px-4 py-3 font-heading text-sm font-bold uppercase tracking-wider text-gold-700">Garment</th>
 <th class="px-4 py-3 font-heading text-sm font-bold uppercase tracking-wider text-gold-700">Per Unit</th>
 <th class="hidden px-4 py-3 font-heading text-sm font-bold uppercase tracking-wider text-gold-700 sm:table-cell">Note</th>
 </tr>
 </thead>
 <tbody class="divide-y divide-hairline text-charcoal">
 {pricing.map((row, i) => (
 <tr class={i % 2 === 0 ? 'bg-paper/60' : ''}>
 <td class="px-4 py-3 font-semibold">{row.garment}</td>
 <td class="px-4 py-3 text-gold-700">{row.perUnit}</td>
 <td class="hidden px-4 py-3 text-sm text-ash sm:table-cell">{row.note}</td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-2xl">
 <p class="kicker mb-3">Total Budget</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">50-person kit cost by quantity tier.</h2>
 </div>
 <div class="grid gap-5 md:grid-cols-3">
 {tiers.map((t) => (
 <div class="border border-hairline bg-panel p-6">
 <h3 class="mb-3 font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{t.qty}</h3>
 <p class="mb-2 font-mono text-2xl font-bold text-gold-600">{t.total}</p>
 <p class="text-sm leading-relaxed text-ash">{t.detail}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="bg-concrete py-20 sm:py-24">
 <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">The Buyer's Read</p>
 <h2 class="mb-8 font-heading text-3xl font-extrabold uppercase leading-tight tracking-tight sm:text-4xl">How to budget for 50 people without guessing.</h2>
 <div class="space-y-5 text-lg leading-relaxed text-ash">
 <p>
 A 50-person apparel budget becomes clearer when you separate roles. Build each group around the required garment, decoration, quantity, and job conditions.
 </p>
 <p>
 To get a useful number, split your 50 by role and define each garment and decoration method. Ask the quote to show any artwork preparation, setup, reuse, and retention terms. Our <a href="/blog/how-much-to-embroider-a-shirt/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidered shirt pricing guide</a> and <a href="/blog/how-much-to-embroider-a-polo/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">embroidered polo pricing guide</a> explain common cost drivers.
 </p>
 <p>
 If any role needs protective or high-visibility apparel, price the employer-approved product separately. Follow the exact manufacturer's current decoration instructions. Thread choice alone does not preserve a garment rating or certification.
 </p>
 <p>
 Quantity can affect setup and unit pricing. Our <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">minimum order quantity guide</a> explains what to confirm. Use our <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="text-gold-700 underline decoration-gold-500/40 underline-offset-4 hover:decoration-gold-500">shirts per crew member guide</a> as a planning prompt, then quote your actual roster.
 </p>
 <p>
 Ask Bighorn Threads for an itemized quote by garment, role, decoration, setup, production, and fulfillment so the 50-person budget can be reviewed before approval.
 </p>
 </div>
 </div>
 </section>

 <section class="border-y border-hairline bg-paper py-20 sm:py-24">
 <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-3">FAQ</p>
 <h2 class="mb-12 font-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Cost questions, answered.</h2>
 <div class="divide-y divide-hairline border-y border-hairline">
 {faqs.map((f) => (
 <details class="group">
 <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-left">
 <h3 class="font-heading text-lg font-bold uppercase leading-tight tracking-tight text-charcoal">{f.q}</h3>
 <svg class="h-5 w-5 shrink-0 text-gold-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
 </summary>
 <p class="pb-5 text-base leading-relaxed text-ash">{f.a}</p>
 </details>
 ))}
 </div>
 </div>
 </section>

 <section class="bg-concrete py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <p class="kicker mb-6">Pair It With</p>
 <div class="grid gap-5 md:grid-cols-3">
 <a href="/blog/how-much-to-embroider-a-shirt/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Embroidered Shirt Pricing</h3>
 <p class="mt-2 text-sm text-ash">What drives embroidery cost up or down.</p>
 </a>
 <a href="/blog/how-many-shirts-per-crew-member-vegas/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Shirts Per Crew Member</h3>
 <p class="mt-2 text-sm text-ash">Plan headcount by role, not just total shirts.</p>
 </a>
 <a href="/blog/minimum-order-quantity-embroidery-screen-printing/" class="group border border-hairline bg-panel p-6 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-lg font-bold uppercase tracking-tight text-charcoal group-hover:text-gold-600">Minimum Order Quantities</h3>
 <p class="mt-2 text-sm text-ash">Where small batches make sense vs. bulk.</p>
 </a>
 </div>
 </div>
 </section>

 <section class="relative isolate overflow-hidden bg-navy-950 py-20">
 <img src="/images/generated/cta-bluehour.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-navy-950/80"></div>
 <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-4xl">Get an itemized quote for your 50.</h2>
<p class="mb-8 text-lg text-navy-200">Send your headcount by role for an itemized, specification-based quote.</p>
 <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="inline-flex items-center gap-2 px-2 py-3 font-mono text-base font-medium text-white transition-colors hover:text-gold-400">702.904.8923</a>
 </div>
 </div>
 </section>
</BaseLayout>
