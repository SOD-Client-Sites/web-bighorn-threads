 {['Heavyweight 6oz+ Tees', 'Reinforced Work Pants', 'ANSI Class 2 Vests', 'Embroidered Polos', 'Branded Knee Pads', 'Hard Hat Decals', 'Office Button-Downs'].map((tag) => (
