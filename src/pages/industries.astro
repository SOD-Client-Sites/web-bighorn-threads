 <!-- ════ Industry 6: Concrete & Masonry — paper ════ -->
 <section id="industry-concrete-masonry" class="scroll-mt-20 border-y border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
