---
import BaseLayout from '@/layouts/BaseLayout.astro'

const industries = [
 {
 slug: 'general-contractors',
 name: 'General Contractors & Construction',
 href: '#industry-general-contractors',
 },
 {
 slug: 'electrical',
 name: 'Electrical Contractors',
 href: '#industry-electrical',
 },
 {
 slug: 'plumbing-hvac',
 name: 'Plumbing & HVAC',
 href: '#industry-plumbing-hvac',
 },
 {
 slug: 'roofing-solar',
 name: 'Roofing & Solar',
 href: '#industry-roofing-solar',
 },
 {
 slug: 'landscaping',
 name: 'Landscaping & Outdoor Services',
 href: '#industry-landscaping',
 },
 {
 slug: 'concrete-masonry',
 name: 'Concrete & Masonry',
 href: '#industry-concrete-masonry',
 },
 {
 slug: 'steel-iron',
 name: 'Steel & Iron Workers',
 href: '#industry-steel-iron',
 },
 {
 slug: 'oil-gas-mechanical',
 name: 'Oil, Gas & Mechanical',
 href: '#industry-oil-gas-mechanical',
 },
 {
 slug: 'data-center',
 name: 'Data Center & Mission-Critical',
 href: '/industries/data-center-contractors-las-vegas/',
 badge: 'Vegas #1 growth sector',
 },
]

// Vertical hubs for the industries Bighorn serves. Each links to its own hub page.
const verticals = [
 {
 name: 'Construction & Trades',
 href: '/industries/construction-trades/',
 blurb: 'Hi-vis, FR workwear, and branded crew gear that survives the job site.',
 },
 {
 name: 'Corporate',
 href: '/industries/corporate/',
 blurb: 'Branded apparel and a company store for office, tech, finance, and pro-services teams.',
 },
 {
 name: 'Education',
 href: '/industries/education/',
 blurb: 'Spirit wear and staff apparel for districts, schools, universities, and booster clubs.',
 },
 {
 name: 'Healthcare',
 href: '/industries/healthcare/',
 blurb: 'Branded scrubs, embroidered lab coats, and role-based gear for clinics and hospitals.',
 },
 {
 name: 'Government',
 href: '/industries/government/',
 blurb: 'Uniforms and ANSI hi-vis for cities, public works, utilities, and transit agencies.',
 },
 {
 name: 'Gaming & Hospitality',
 href: '/industries/gaming-hospitality/',
 blurb: 'Department uniforms and branded gear for casinos, resorts, and hotels.',
 },
 {
 name: 'Events & Teams',
 href: '/industries/events/',
 blurb: 'Custom merch and on-demand stores for trade shows, conferences, and sports teams.',
 },
]

const collectionSchema = {
 '@context': 'https://schema.org',
 '@type': 'CollectionPage',
 name: 'Industries We Serve | Bighorn Threads',
 description:
 'Managed company-store and branded-apparel programs for construction and trades, corporate, education, healthcare, government, gaming and hospitality, and events.',
 url: 'https://bighornthreads.com/industries',
 mainEntity: {
 '@type': 'ItemList',
 itemListElement: verticals.map((vertical, i) => ({
 '@type': 'ListItem',
 position: i + 1,
 item: {
 '@type': 'Service',
 name: vertical.name,
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 url: `https://bighornthreads.com${vertical.href}`,
 },
 })),
 },
}

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'
---

<BaseLayout
 title="Branded Apparel by Industry | Bighorn Threads"
 description="Explore branded apparel and managed company-store programs for construction, corporate, education, healthcare, government, hospitality, and event teams."
>
 <!-- ════ HERO — full-bleed photographic dark band ════ -->
 <section class="relative isolate overflow-hidden bg-navy-950">
 <img src="/images/generated/crew-vegas.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover object-center" loading="eager" fetchpriority="high" decoding="async" />
 <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-950/85 to-navy-950/40"></div>

 <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-20">
 <div class="max-w-3xl">
 <p class="kicker mb-5 flex items-center gap-2.5">
 <span class="h-px w-8 bg-gold-500"></span>
 Industries We Serve
 </p>
 <h1 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl">
 Managed company stores and branded gear for <span class="text-gold-400">different teams.</span>
 </h1>
 <p class="mt-6 max-w-2xl text-lg leading-relaxed text-navy-200 sm:text-xl">
 Bighorn manages branded apparel programs for crews, offices, schools, clinics, agencies, and event teams. Selected production partners handle approved decoration. Program and service-area terms are confirmed in writing.
 </p>
 <div class="mt-8 flex flex-wrap gap-2.5">
 {verticals.map((vertical) => (
 <a
 href={vertical.href}
 class="inline-flex min-h-[44px] items-center gap-2 border border-navy-700 bg-navy-900/60 px-4 py-2 font-mono text-xs font-medium uppercase tracking-wider text-navy-200 transition-colors hover:border-gold-500 hover:text-gold-300"
 >
 {vertical.name}
 </a>
 ))}
 </div>
 </div>
 </div>
 </section>

 <!-- ════ Vertical hubs index — paper ════ -->
 <section class="border-b border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="mb-12 max-w-3xl">
 <p class="kicker mb-3">Pick Your Vertical</p>
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight sm:text-5xl">
 Seven industries. One <span class="text-gold-600">company store.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Every team runs differently. Find your vertical below for the gear, the decoration methods, and the store setup that fit how your people actually work.
 </p>
 </div>
 <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
 {verticals.map((vertical) => (
 <a href={vertical.href} class="group flex flex-col border border-hairline bg-panel p-7 transition-colors hover:border-gold-500">
 <h3 class="font-heading text-xl font-bold uppercase tracking-tight text-charcoal transition-colors group-hover:text-gold-600">{vertical.name}</h3>
 <p class="mt-3 flex-1 text-ash">{vertical.blurb}</p>
 <span class="mt-5 inline-flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-wider text-gold-600">
 Explore
 <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </span>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- ════ Construction & Trades deep-dive — header ════ -->
 <section class="scroll-mt-20 border-b border-hairline bg-concrete py-16 sm:py-20">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="max-w-3xl">
 <p class="kicker mb-3">Construction & Trades</p>
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-4xl">
 Where Bighorn <span class="text-gold-600">started.</span>
 </h2>
 <p class="mt-4 text-lg leading-relaxed text-ash">
 Trade crews are our roots, so we go deep here. Below is the gear, the compliance, and the company-store playbook by trade. Want the full hub? <a href="/industries/construction-trades/" class="font-semibold text-gold-700 underline decoration-gold-500/40 underline-offset-2 hover:decoration-gold-500">See Construction & Trades</a>.
 </p>
 <div class="mt-6 flex flex-wrap gap-2">
 <a href="/industries/general-contractors-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">General Contractors</a>
 <a href="/industries/electrical-contractors-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Electrical</a>
 <a href="/industries/plumbing-hvac-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Plumbing & HVAC</a>
 <a href="/industries/roofing-solar-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Roofing & Solar</a>
 <a href="/industries/landscaping-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Landscaping</a>
 <a href="/industries/concrete-masonry-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Concrete & Masonry</a>
 <a href="/industries/steel-iron-workers-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Steel & Iron</a>
 <a href="/industries/oil-gas-mechanical-las-vegas/" class="spec border border-hairline px-2.5 py-1 text-ash transition-colors hover:border-gold-500 hover:text-gold-700">Oil, Gas & Mechanical</a>
 <a href="/industries/data-center-contractors-las-vegas/" class="spec border border-gold-500 bg-gold-500/10 px-2.5 py-1 text-gold-700 transition-colors hover:bg-gold-500/20">Data Center & Mission-Critical</a>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ Trade 1: General Contractors (Featured) — concrete ════ -->
 <section id="industry-general-contractors" class="scroll-mt-20 bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="border-l-4 border-gold-500 bg-panel">
 <div class="grid items-start gap-10 border border-l-0 border-hairline p-7 sm:p-10 lg:grid-cols-[auto_1fr]">
 <div class="h-24 w-24 flex-shrink-0 overflow-hidden border border-hairline sm:h-32 sm:w-32">
 <img
 src="/images/generated/kit-gc.jpg"
 alt="General contractor crew gear kit — hi-vis tees, embroidered polos, branded hard hat"
 width="400"
 height="400"
 loading="lazy"
 decoding="async"
 class="h-full w-full object-cover"
 />
 </div>
 <div>
 <div class="mb-3 flex flex-wrap items-center gap-3">
 <span class="spec text-gold-600">General Contractors & Construction</span>
 <span class="spec inline-flex items-center gap-1.5 bg-gold-500 px-2.5 py-1 text-charcoal">
 <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
 Our Specialty
 </span>
 </div>
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-4xl">
 The crew that builds Vegas deserves gear that holds up.
 </h2>
 <div class="mt-5 space-y-4 text-lg leading-relaxed text-ash">
 <p>
 Construction apparel may face heat, sweat, dust, and abrasion. Bighorn can quote selected heavyweight tees, employer-approved hi-vis products, hard hats, and identification options. Current manufacturer information and the employer's safety requirements control product selection.
 </p>
 <p>
 A proposed company store could support approved products and user requests if the selected platform and approved configuration do. No platform has been selected or launched. Access, pricing, payment, inventory, reporting, fulfillment, and implementation require separate written approval.
 </p>
 <p>
 Examples to evaluate with the employer include hi-vis products, embroidered polos, employer-selected hard hats, outerwear, repeat-order planning, and site-identification garments. Every product and decoration requires current approval and quoted terms.
 </p>
 </div>
 <div class="mt-6 flex flex-wrap gap-2">
 {['Hi-Vis ANSI Class 2/3', 'Hard Hats', 'Heavyweight Tees', 'Embroidered Polos', 'Branded Jackets', 'Company Stores', 'Safety Vests'].map((tag) => (
 <span class="spec border border-hairline px-2.5 py-1 text-ash">{tag}</span>
 ))}
 </div>
 <div class="mt-8">
 <a href="/contact?industry=general-contractors" class="btn-primary text-base">
 Get a Quote for General Contractors
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ Industry 2: Electrical — paper ════ -->
 <section id="industry-electrical" class="scroll-mt-20 border-y border-hairline bg-paper py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-10 lg:grid-cols-[auto_1fr]">
 <div class="h-20 w-20 flex-shrink-0 overflow-hidden border border-hairline sm:h-28 sm:w-28">
 <img
 src="/images/generated/kit-electrical.jpg"
 alt="Electrical crew gear — FR-rated shirts, embroidered softshell jacket, beanie"
 width="400"
 height="400"
 loading="lazy"
 decoding="async"
 class="h-full w-full object-cover"
 />
 </div>
 <div>
 <span class="spec mb-3 inline-block text-gold-600">Electrical Contractors</span>
 <h2 class="font-heading text-3xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal sm:text-4xl">
 Arc-rated apparel planning around your employer-approved requirements.
 </h2>
 <div class="mt-5 space-y-4 text-lg leading-relaxed text-ash">
 <p>
 Electrical employers must select apparel through a documented hazard assessment. Bighorn can quote selected FR and AR garments after receiving the written requirement. The employer and manufacturer approve the final product and decoration plan.
 </p>
 <p>
 Decoration can affect a protective garment. The employer and manufacturer must approve the method, materials, backing, and placement. Bighorn coordinates the written requirement with a selected production partner. Office apparel and promotional items can be quoted separately.
 </p>
 <p>
 Common orders: FR/AR button-downs and tees, embroidered FR jackets, hi-vis FR hoodies, branded polos for service techs, beanies, and work hats.
 </p>
 </div>
 <div class="mt-6 flex flex-wrap gap-2">
 {['FR/AR Rated (NFPA 70E)', 'CAT 1 & CAT 2', 'Embroidered Polos', 'FR Patches', 'Branded Beanies', 'Service Tech Uniforms', 'Leave-Behind Promo'].map((tag) => (
 <span class="spec border border-hairline px-2.5 py-1 text-ash">{tag}</span>
 ))}
 </div>
 <div class="mt-8">
 <a href="/contact?industry=electrical" class="btn-primary text-base">
 Get a Quote for Electrical
 <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- ════ Industry 3: Plumbing & HVAC — concrete ════ -->
 <section id="industry-plumbing-hvac" class="scroll-mt-20 bg-concrete py-20 sm:py-28">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <div class="grid items-start gap-10 lg:grid-cols-[auto_1fr]">
 <div class="h-20 w-20 flex-shrink-0 overflow-hidden border border-hairline sm:h-28 sm:w-28">
