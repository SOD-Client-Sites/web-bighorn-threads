---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { photo } from '@/data/pagePhotos'

// Trade pages. Each id keeps the old on-page anchor working for outside links.
const trades = [
 { id: 'industry-general-contractors', name: 'General Contractors', href: '/industries/general-contractors-las-vegas/' },
 { id: 'industry-electrical', name: 'Electrical', href: '/industries/electrical-contractors-las-vegas/' },
 { id: 'industry-plumbing-hvac', name: 'Plumbing & HVAC', href: '/industries/plumbing-hvac-las-vegas/' },
 { id: 'industry-roofing-solar', name: 'Roofing & Solar', href: '/industries/roofing-solar-las-vegas/' },
 { id: 'industry-landscaping', name: 'Landscaping', href: '/industries/landscaping-las-vegas/' },
 { id: 'industry-concrete-masonry', name: 'Concrete & Masonry', href: '/industries/concrete-masonry-las-vegas/' },
 { id: 'industry-steel-iron', name: 'Steel & Iron', href: '/industries/steel-iron-workers-las-vegas/' },
 { id: 'industry-oil-gas-mechanical', name: 'Oil, Gas & Mechanical', href: '/industries/oil-gas-mechanical-las-vegas/' },
 { id: 'industry-data-center', name: 'Data Center', href: '/industries/data-center-contractors-las-vegas/' },
]

// Vertical hubs for the industries Bighorn serves. Each links to its own hub page.
const verticals = [
 {
 name: 'Construction & Trades',
 href: '/industries/construction-trades/',
 blurb: 'Hi-vis, FR workwear, and branded crew gear that survives the job site.',
 },
 {
 name: 'Corporate',
 href: '/industries/corporate/',
 blurb: 'Branded apparel and a company store for office, tech, finance, and pro-services teams.',
 image: 'new-hire-kit',
 },
 {
 name: 'Education',
 href: '/industries/education/',
 blurb: 'Spirit wear and staff apparel for districts, schools, universities, and booster clubs.',
 image: 'school-staff-polos',
 },
 {
 name: 'Healthcare',
 href: '/industries/healthcare/',
 blurb: 'Branded scrubs, embroidered lab coats, and role-based gear for clinics and hospitals.',
 image: 'apparel-flat-lay',
 },
 {
 name: 'Government',
 href: '/industries/government/',
 blurb: 'Uniforms and ANSI hi-vis for cities, public works, utilities, and transit agencies.',
 image: 'public-works-crew',
 },
 {
 name: 'Gaming & Hospitality',
 href: '/industries/gaming-hospitality/',
 blurb: 'Department uniforms and branded gear for casinos, resorts, and hotels.',
 image: 'hotel-front-desk',
 },
 {
 name: 'Events & Teams',
 href: '/industries/events/',
 blurb: 'Custom merch and on-demand stores for trade shows, conferences, and sports teams.',
 image: 'trade-show-booth',
 },
]
const [construction, ...others] = verticals

const collectionSchema = {
 '@context': 'https://schema.org',
 '@type': 'CollectionPage',
 name: 'Industries We Serve | Bighorn Threads',
 description:
 'Managed company-store and branded-apparel programs for construction and trades, corporate, education, healthcare, government, gaming and hospitality, and events.',
 url: 'https://bighornthreads.com/industries',
 mainEntity: {
 '@type': 'ItemList',
 itemListElement: verticals.map((vertical, i) => ({
 '@type': 'ListItem',
 position: i + 1,
 item: {
 '@type': 'Service',
 name: vertical.name,
 provider: { '@id': 'https://bighornthreads.com/#organization' },
 url: `https://bighornthreads.com${vertical.href}`,
 },
 })),
 },
}

const arrow = 'M13 7l5 5m0 0l-5 5m5-5H6'
---

<BaseLayout
 title="Branded Apparel by Industry | Bighorn Threads"
 description="Explore branded apparel and managed company-store programs for construction, corporate, education, healthcare, government, hospitality, and event teams."
>
 <!-- Intro -->
 <section class="bg-concrete">
 <div class="mx-auto max-w-7xl px-4 pb-10 pt-14 sm:px-6 sm:pt-16 lg:px-8">
 <p class="kicker mb-4">Industries We Serve</p>
 <div class="grid gap-5 lg:grid-cols-[7fr_5fr] lg:items-end lg:gap-12">
 <h1 class="font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal lg:text-7xl">
 Branded gear for the team you run.
 </h1>
 <p class="text-lg leading-relaxed text-ash">
 One Las Vegas account team, production partners for the decoration, and terms in writing. Pick your industry.
 </p>
 </div>
 </div>
 </section>

 <!-- Construction & Trades: full-bleed photo band -->
 <section class="relative isolate flex min-h-[28rem] items-end bg-navy-950 lg:min-h-[34rem]">
 <img src={photo('home-hero-jobsite-crew').file} alt={photo('home-hero-jobsite-crew').alt} width="1376" height="768" fetchpriority="high" decoding="async" class="absolute inset-0 -z-10 h-full w-full object-cover" />
 <div class="absolute inset-0 -z-10 bg-[rgba(0,24,42,0.55)]"></div>
 <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
 <h2 class="font-heading text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-white lg:text-6xl">{construction.name}</h2>
 <p class="mt-3 max-w-xl text-lg leading-relaxed text-white">{construction.blurb}</p>
 <a href={construction.href} class="btn-primary mt-6 text-base">See construction and trades</a>
 </div>
 </section>

 <!-- Trade links -->
 <section class="bg-paper py-10 sm:py-12">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal">By trade</h2>
 <ul class="grid border-t border-hairline sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-3">
 {trades.map((trade) => (
 <li id={trade.id} class="scroll-mt-24 border-b border-hairline">
 <a href={trade.href} class="group flex min-h-[52px] items-center justify-between gap-3 py-2 font-subheading text-xl font-semibold text-charcoal hover:text-gold-700">
 {trade.name}
 <svg class="h-4 w-4 shrink-0 text-gold-700 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={arrow} /></svg>
 </a>
 </li>
 ))}
 </ul>
 </div>
 </section>

 <!-- Other industries -->
 <section class="bg-concrete py-14 sm:py-16">
 <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
 <h2 class="mb-8 font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-charcoal lg:text-5xl">Beyond the job site</h2>
 <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
 {others.map((vertical) => (
 <a href={vertical.href} class="group block">
 <img src={photo(vertical.image!).file} alt={photo(vertical.image!).alt} width="1376" height="768" loading="lazy" decoding="async" class="aspect-video w-full object-cover sm:aspect-[3/2]" />
 <h3 class="mt-4 font-heading text-3xl font-extrabold uppercase tracking-tight text-charcoal group-hover:text-gold-700">{vertical.name}</h3>
 <p class="mt-1 text-ash">{vertical.blurb}</p>
 </a>
 ))}
 </div>
 <p class="mt-10 text-sm text-ash">Sample photos, shown to illustrate each industry. They do not show Bighorn customers or staff. For regulated PPE, the employer and garment manufacturer approve the product and any decoration.</p>
 </div>
 </section>

 <!-- Final CTA -->
 <section class="bg-charcoal">
 <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32 lg:px-8">
 <h2 class="font-heading text-4xl font-extrabold uppercase leading-[0.95] tracking-tight text-white sm:text-5xl">
 Don't see your industry?
 </h2>
 <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-white/80">
 Nonprofits, restaurants, retail, real estate, fitness, faith groups. Tell us what your team needs.
 </p>
 <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
 <a href="/get-a-quote/" class="btn-primary text-base">Get a Quote</a>
 <a href="tel:+17029048923" class="px-2 py-3 font-mono text-sm font-medium tracking-wide">(702) 904-8923</a>
 </div>
 </div>
 </section>

 <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</BaseLayout>
