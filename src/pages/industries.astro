 src="/images/generated/kit-plumbing-hvac.jpg"
 alt="Plumbing and HVAC service gear — embroidered service polo, work jacket, ball cap"
 width="400"
 height="400"
 loading="lazy"
 decoding="async"
 class="h-full w-full object-cover"
 />
 </div>
