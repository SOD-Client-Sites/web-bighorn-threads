---
import SEOHead from '@/components/SEOHead.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import TrackingHead from '@/components/TrackingHead.astro'
import '@/styles/global.css'

interface Props {
 title: string
 description: string
 canonical?: string
 ogImage?: string
 type?: 'website' | 'article'
 publishedDate?: string
 noindex?: boolean
 heroImage?: string
 lang?: string
 alternates?: { hreflang: string; href: string }[]
}

const { heroImage, lang = 'en', alternates = [], ...props } = Astro.props
---

<!doctype html>
<html lang={lang}>
 <head>
 <SEOHead {...props} />
 {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" />}
 {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
 <TrackingHead />
 </head>
 <body class="min-h-screen bg-concrete pb-[60px] text-charcoal antialiased min-[1120px]:pb-0">
 <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-paper focus:px-4 focus:py-3 focus:text-charcoal">Skip to main content</a>
 <Header />
 <main id="main-content" class="pt-[65px]">
 <slot />
 </main>
 <Footer />
 </body>
</html>
